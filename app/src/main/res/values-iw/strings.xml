    <string name="settings_detailed_title">מעקב מפורט</string>
    <string name="settings_detailed_body">מוסיף אוזניות חוטיות וזמן השמעה. android מדווח על חיבור חוטי רק לאפליקציה שרצה, ולכן זה משאיר התראה שקטה במגירת ההתראות. אחרי bluetooth עוקבים כך או כך.</string>
    <string name="settings_detailed_unavailable">לא זמין עד שתינתן גישה ל-bluetooth: הגרסה הזאת מצהירה רק על סוג השירות connectedDevice, ש-android 14+ קושר להרשאת bluetooth.</string>
    <string name="settings_playback_only_title">לספור רק השמעה</string>
    <string name="settings_playback_only_body">הסטטיסטיקה סופרת את הזמן שבו האודיו באמת התנגן במקום את זמן החיבור. רק הפעלות שנרשמו כשמעקב מפורט היה פעיל מדדו השמעה; השאר נשארות בחוץ.</string>
    <string name="settings_language">שפה</string>
    <string name="settings_language_system">שפת המערכת</string>
    <string name="settings_devices">התקנים</string>
    <string name="settings_devices_body">בטלו את הסימון של כל מה שאינו אוזניות — מערכת שמע ברכב או רמקול — כדי להפסיק לרשום אותו.</string>
