    <string name="settings_troubleshooting">פתרון תקלות</string>
    <string name="settings_battery_body">אם מפגשים מפסיקים להירשם, בדקו ש-ylih פטור מאופטימיזציית סוללה — אפליקציה שנעצרה בכפייה לא מקבלת יותר שידורי חיבור עד שפותחים אותה.</string>
    <string name="settings_battery_button">הגדרות סוללה</string>
    <string name="settings_battery_path">הגדרות ← אפליקציות ← ylih ← סוללה ← ללא הגבלה.</string>
    <string name="settings_hibernation_body">אם ylih לא נפתח כמה חודשים, android עוצר אותו ולוקח בחזרה את ההרשאות שלו, ושום דבר לא מתועד שוב עד שתפתח אותו. כיבוי זה הוא מה שמאפשר לזוג להמשיך להיספר לאורך עונה שאתה אפילו לא חושב בה על האפליקציה.</string>
    <string name="settings_hibernation_on">android עלול לעצור את ylih.</string>
    <string name="settings_hibernation_off">ylih פטור וממשיך לתעד.</string>
    <string name="settings_hibernation_button">הגדרות אפליקציות לא בשימוש</string>
