    <!-- הפעלה ראשונה -->
    <string name="welcome_title">ברוכים הבאים ל-ylih</string>
    <string name="welcome_intro">ylih רושם כמה זמן כל זוג אוזניות מחובר, כדי שגם בעוד שנים תוכלו לענות על השאלה היחידה שחשובה באמת לגבי זוג אוזניות: כמה שעות הן החזיקו?</string>
    <string name="welcome_point_auto_title">מחברים ושוכחים</string>
    <string name="welcome_point_auto_body">אוזניות bluetooth נרשמות מעצמן, מרגע החיבור. שום דבר לא צריך להישאר פעיל.</string>
    <string name="welcome_point_lifetime_title">זוג אחד, חיים אחד</string>
    <string name="welcome_point_lifetime_body">כשזוג מת, הוציאו אותו לגמלאות: הסך הכול שלו קופא שם, והזוג הבא של אותן אוזניות מתחיל מחדש מאפס.</string>
    <string name="welcome_point_detailed_title">חוט והשמעה</string>
    <string name="welcome_point_detailed_body">מעקב מפורט, בהגדרות, מוסיף אוזניות חוטיות ומודד כמה מהזמן באמת התנגנה מוזיקה.</string>
    <string name="welcome_privacy">הכול נשאר בטלפון הזה. אין חשבון, ולאפליקציה אין הרשאת אינטרנט.</string>
    <string name="welcome_start">אפשר להתחיל</string>
    <string name="hibernation_title">תמשיך לספור גם כשתשכח ממנו</string>
    <string name="hibernation_body">android עוצר אפליקציות שלא נפתחו כמה חודשים ולוקח בחזרה את ההרשאות שלהן, מה שיגרום ל-ylih לא לתעד שום דבר עד שתפתח אותו שוב. להישכח זו בדיוק המטרה של האפליקציה הזו, אז כדאי לכבות את זה כבר עכשיו.</string>
    <string name="action_not_now">לא עכשיו</string>

