    <string name="welcome_bluetooth_title">ব্লুটুথ য়ৌবা</string>
    <string name="welcome_bluetooth_why">করম্বা ব্লুটুথ ডিভাইস শম্নবগে অমসুং মদুগী মিং করিনো হায়বদু এপ অদুদা ব্লুটুথ য়ৌবা লৈরবতা android না তাক্কনি. মসিনা ylih না হেদফোন অমা গাড়িগী স্টিরিও অমদগী খন্নবা অমসুং হেদফোন অমা অতোপ্পা অমদগী খংবা ঙম্বনি.</string>
    <string name="welcome_bluetooth_with">মসিগা লোয়ননা: হেদফোন খুদিংমক শম্নবা মতমদগী হৌনা ইশিল্লি, করিগুম্বা অমত্তা চৎনহনবা তাবা নত্তে অমসুং করিগুম্বা অমত্তা নম্বা নিংশিংবা তাবা নত্তে.</string>
    <string name="welcome_bluetooth_without">মসি য়াওদনা: ব্লুটুথ হেদফোন অমত্তা ইশিনবা ঙমদে. এপ অসিগী অতোপ্পা শরুকশিংনা থবক তৌরি, অমসুং মসি নহাক্না মতুংদা android গী এপ সেটিংসদা পীবা ঙমগনি.</string>
    <string name="welcome_notifications_title">খংহনবশিং</string>
    <string name="welcome_notifications_why">অকুপ্পা ইশিনবনা অপিকপা বেকগ্রাউন্ড সার্ভিস অমা চৎনহল্লি, অমসুং মসি তৌরিবা এপ খুদিংমক্না মতম অদুদা উবা ফংবা খংহনবা অমা থম্নবা android না তংগাইফদে.</string>
    <string name="welcome_notifications_with">মসিগা লোয়ননা: খংহনবনা হৌজিক করি ইশিল্লিবগে হায়বদু উৎলি, মদুদি অকুপ্পা ইশিনবা অদু হিংলি হায়বগী অখন্নবা খুদম অদুনি.</string>
    <string name="welcome_notifications_without">মসি য়াওদনা: অকুপ্পা ইশিনবনা চৎলি অমসুং ইশিল্লি. android না মদুগী খংহনবা অদু উৎলোই খক্তনি.</string>
    <string name="hibernation_title">নহাক্না কাউথোকপা মতমদা মখা তানা মশিং থিরি</string>
    <string name="hibernation_body">থা খরগী মনুংদা হাংদবা এপশিংবু android না লেপহল্লি অমসুং মখোয়গী অয়াবশিং লৌথোকখি, মদুনা নহাক্না অমুক হাংদ্রিফাওবা ylih না করিগুম্বা অমত্তা ইশিনলোই. কাউথোকপা হায়বসি এপ অসি লৈবগী মরু ওইবা মরমনি, মরম অদুনা হৌজিক মদু থিংবা কান্নই.</string>
