    <string name="welcome_title">ylih দা তরাম্না ওকচরি</string>
    <string name="welcome_intro">হেদফোন খুদিংমক্না করম্বা মতম চুপ্না শম্নরিবগে হায়বদু ylih না ইশিল্লি, মদুনা চহি কয়াগী মতুংদাশু হেদফোন অমগী মরমদা অখন্নবা ৱাহং অদুগী পাউখুম নহাক্না পীবা ঙমগনি: মখোয়না পুংজা কয়া চৎলম্বগে?</string>
    <string name="welcome_point_auto_title">শম্নরুরগা কাউথোকখো</string>
    <string name="welcome_point_auto_body">ব্লুটুথ হেদফোনশিং শম্নবা মতমদগী হৌনা মখোয়না মশানা ইশিল্লি. করিগুম্বা অমত্তা চৎনহনবা তাবা নত্তে.</string>
    <string name="welcome_point_lifetime_title">হেদফোন অমা, পুন্সি অমা</string>
    <string name="welcome_point_lifetime_body">হেদফোন অমা শোকখ্রবদি মদুবু পুন্সি লোয়শিনহল্লু: মদুগী অপুনবা মশিং মফমদুদা লেপ্পগনি অমসুং মথং হেদফোন অদুগী অনৌবা অমা ফুংগদগী অমুক হৌগনি.</string>
    <string name="welcome_point_detailed_title">ৱায়র অমসুং প্লেবেক</string>
    <string name="welcome_point_detailed_body">সেটিংসদা লৈবা অকুপ্পা ইশিনবনা ৱায়রগী হেদফোন হাপচিল্লি অমসুং মতম অদুগী করম্বা মখল অশেংবা মওংদা চৎলম্বগে হায়বদু চাংয়েংই.</string>
    <string name="welcome_privacy">পুম্নমক ফোন অসিদা লৈহৌই. একাউন্ট অমত্তা লৈতে, অমসুং এপ অসিদা ইন্টরনেটকী অয়াবা লৈতে.</string>
