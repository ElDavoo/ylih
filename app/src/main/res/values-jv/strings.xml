    <string name="welcome_step">langkah %1$d saka %2$d</string>
    <string name="welcome_bluetooth_title">akses bluetooth</string>
    <string name="welcome_bluetooth_why">android cuma ngomong app apa sing bluetooth perangkat nyambung, lan apa jenenge, yen app nduweni akses bluetooth. iki carane ylih mbedakna rong headphone saka speaker mobil, lan carane ngerti rong siji saka liyane.</string>
    <string name="welcome_bluetooth_with">karo iku: saben rong ditulis wiwit saat nyambung, tanpa ono sing kudu ngangge lan ora ono sing kudu diinget tekan.</string>
    <string name="welcome_bluetooth_without">tanpa iku: headphone bluetooth ora ditulis. bagian liya aplikasi isih gumana, lan sampeyan bisa maringi nuhun mengko ing setingan aplikasi android.</string>
    <string name="welcome_notifications_title">notifikasi</string>
    <string name="welcome_notifications_why">tracking detail ngangge layanan background cilik, lan android butuh aplikasi apa wae sing nindakake iku supaya tetep katon notifikasi waktu ngangge.</string>
    <string name="welcome_notifications_with">karo iku: notifikasi nuduhna apa sing ditulis saiki, sing mung tandha tracking detail isih urip.</string>
    <string name="welcome_notifications_without">tanpa iku: tracking detail isih ngangge lan isih nulis. android mung ora mudun notifikasi.</string>
    <string name="hibernation_title">terus hitung nalika lali</string>
    <string name="hibernation_body">android medel aplikasi sing ora ana dibukak pirang wulan lan balik ijine, sing bakal tinggalna ylih ora nulis apa-apa nganti sampeyan mbukak maneh. dilalekna iku kudune aplikasi iki, dadi lumaku mateni saiki.</string>
