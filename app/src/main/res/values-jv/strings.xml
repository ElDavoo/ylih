    <string name="welcome_title">sugeng rawuh ing ylih</string>
    <string name="welcome_intro">ylih nyatat pira suwe saben rong headphone tetep nyambung, supaya taon ngarep sampeyan isih bisa mangsuli pitakon siji-sijine sing paling penting bab rong iki: pira jam umure?</string>
    <string name="welcome_point_auto_title">sambung terus lali</string>
    <string name="welcome_point_auto_body">headphone bluetooth ditulis dhewe, wiwit saat nyambung. ora ono sing kudu ditinggal ngangge.</string>
    <string name="welcome_point_lifetime_title">rong siji, umur siji</string>
    <string name="welcome_point_lifetime_body">nalika rong mati, enggalsewaktu: jumlah cukup ana kono lan rong sabanjure bab headphone padha mulai maneh saka nol.</string>
    <string name="welcome_point_detailed_title">headphone kabel lan playback</string>
    <string name="welcome_point_detailed_body">tracking detail, ing setingan, nambah headphone kabel lan ngukur pira bagian wektune bener-bener mutar.</string>
    <string name="welcome_privacy">kabeh tetep ana ing ponsel iki. ora ono akun, lan app ora duwe ijin internet.</string>
    <string name="welcome_start">mulai</string>
    <string name="welcome_next">sabanjure</string>
