    <string name="settings_detailed_title">tracking detail</string>
    <string name="settings_detailed_body">nambah headphone kabel lan wektu playback. android mung ngomong acara plug kabel kang headphone kanggo aplikasi sing ngangge, dadi iki tetep nuduhna notifikasi anteng. bluetooth dilacak tah piye.</string>
    <string name="settings_detailed_unavailable">durung ana nganti akses bluetooth dipareng: build iki mung nyatakna jenis layanan perangkat sing nyambung, sing android 14+ pasangna ing ijin bluetooth.</string>
    <string name="settings_playback_only_title">hitung mutar mung</string>
    <string name="settings_playback_only_body">statistik nitung wektu audio bener-bener mutar tinimbang wektu nyambung. sesi mung sing ditulis karo tracking detail nyala diukur playback; liyane kabeh ditinggal metu.</string>
