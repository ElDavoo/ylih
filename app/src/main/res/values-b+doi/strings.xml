    <!-- पहली बार चलाना -->
    <string name="welcome_title">ylih में स्वागत है</string>
    <string name="welcome_intro">ylih दर्ज करता है कि हर हेडफोन की जोड़ी कितने समय तक कनेक्ट रहती है, ताकि वर्षों बाद आप एक जोड़ी के बारे में सबसे महत्वपूर्ण सवाल का जवाब दे सकें: उन्होंने कितने घंटे चले?</string>
    <string name="welcome_point_auto_title">कनेक्ट करो और भूल जाओ</string>
    <string name="welcome_point_auto_body">bluetooth हेडफोन अपने आप से दर्ज होते हैं, जिस क्षण वे कनेक्ट होते हैं। कुछ भी चलाए रखने की जरूरत नहीं है।</string>
    <string name="welcome_point_lifetime_title">एक जोड़ी, एक जीवनकाल</string>
    <string name="welcome_point_lifetime_body">जब एक जोड़ी खराब हो जाती है, इसे सेवानिवृत्त करो: इसका कुल वहीं जम जाता है और उसी हेडफोन की अगली जोड़ी शून्य से फिर से शुरू होती है।</string>
    <string name="welcome_point_detailed_title">तार और प्लेबैक</string>
    <string name="welcome_point_detailed_body">विस्तृत ट्रैकिंग, सेटिंग्स में, तार वाले हेडफोन जोड़ता है और मापता है कि कितना समय वास्तव में प्लेबैक था।</string>
    <string name="welcome_privacy">सब कुछ इस फोन पर रहता है। कोई खाता नहीं है, और ऐप्लिकेशन के पास कोई इंटरनेट अनुमति नहीं है।</string>
    <string name="welcome_start">शुरू करो</string>

