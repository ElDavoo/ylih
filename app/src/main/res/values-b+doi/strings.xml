    <string name="settings_tracking">ट्रैकिंग</string>
    <string name="settings_detailed_title">विस्तृत ट्रैकिंग</string>
    <string name="settings_detailed_body">तार वाले हेडफोन और प्लेबैक समय जोड़ता है। android केवल चलती हुई ऐप्लिकेशन को तार की प्लग इवेंट की सूचना देता है, इसलिए यह शेड में एक चुप अधिसूचना रखता है। bluetooth किसी भी स्थिति में ट्रैक किया जाता है।</string>
    <string name="settings_detailed_unavailable">bluetooth पहुंच प्रदान किए जाने तक अनुपलब्ध: यह बिल्ड केवल connectedDevice सेवा प्रकार घोषित करता है, जिसे android 14+ एक bluetooth अनुमति से बांधता है।</string>
    <string name="settings_playback_only_title">सिर्फ प्लेबैक गिनो</string>
    <string name="settings_playback_only_body">आंकड़े जुड़े दे रौह्ने दे वक्त दी थां ऑडियो असल च चल्ले दा वक्त गिनदे न। सिर्फ ओह् सैशन जेह्ड़े विस्तृत ट्रैकिंग चालू होने पर रिकार्ड होए, उनेंगी प्लेबैक मापेया; बाकी छड्डे जंदे न।</string>
    <string name="settings_language">भाशा</string>
    <string name="settings_language_system">सिस्टम दी भाशा</string>
    <string name="settings_devices">डिवाइस</string>
    <string name="settings_devices_body">जो कुछ भी हेडफोन नहीं है - एक कार स्टीरियो या एक स्पीकर - इसे रिकॉर्ड करना बंद करने के लिए इसे अनचेक करो।</string>
    <string name="settings_device_subtitle">%1$s · पहली बार %2$s देखा गया</string>
    <string name="settings_data">डेटा</string>
    <string name="settings_export">json निर्यात</string>
    <string name="settings_import">आयात</string>
    <string name="settings_import_warning">आयात वर्तमान में संग्रहीत सब कुछ को बदल देता है।</string>
    <string name="settings_troubleshooting">समस्या निवारण</string>
    <string name="settings_battery_body">यदि सत्र रिकॉर्ड किए जाना बंद हो जाते हैं, तो जांचें कि ylih बैटरी अनुकूलन से मुक्त है - एक बलपूर्वक बंद की गई ऐप्लिकेशन को फिर से खोलने तक कनेक्शन प्रसारण नहीं मिलता है।</string>
    <string name="settings_battery_button">बैटरी सेटिंग्स</string>
    <string name="settings_battery_path">सेटिंग्स → ऐप्लिकेशन → ylih → बैटरी → असीमित।</string>
    <string name="settings_about">के बारे में</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — हेडफोन घंटे, स्थानीय और हमेशा के लिए रखे जाते हैं।</string>
    <string name="settings_import_confirm_title">सभी डेटा को बदलो?</string>
    <string name="settings_import_confirm_body">इस बैकअप को आयात करने से प्रत्येक डिवाइस, जोड़ी और सत्र जो अभी संग्रहीत है, हटा दिया जाता है।</string>

