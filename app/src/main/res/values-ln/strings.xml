    <string name="settings_import_warning">import ezali kobanda bililingi nyonso oyo kino.</string>
    <string name="settings_troubleshooting">kusolanya te ya makambo mabe</string>
    <string name="settings_battery_body">soki bilakisi ezali lokaki kosama, yeba soki ylih te ezali na mpalangi ya moteka - app oyo esikwa te te ekoka ata teyi ya singa ezali kovanda ata wokoni koyambáka.</string>
    <string name="settings_battery_button">makambo ma moteka</string>
    <string name="settings_battery_path">makambo → app → ylih → moteka → te na limitasio.</string>
    <string name="settings_hibernation_body">soki ylih te koyambaka mingi na mibu, android ezali konionda yango mpe ekonzwa mayibi, mpe te na kosama te ata wokoni koyambáka. kutunga likambo oyo ezali komonya makambo na motema na mokapo oyo te koyambaki.</string>
    <string name="settings_hibernation_on">android okoki konionda ylih.</string>
    <string name="settings_hibernation_off">ylih te na konionda mpe ezali kolinga kosama.</string>
    <string name="settings_hibernation_button">makambo ma app oyo te na kosalela</string>
    <string name="settings_about">likambo</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — myele ya makelele, kobenga na etuka mpe kolanga.</string>
    <string name="settings_import_confirm_title">banda bililingi nyonso?</string>
    <string name="settings_import_confirm_body">import ya backup oyo ezali kosika bilokolo, makambo mpe bilakisi nyonso oyo kino.</string>

