    <string name="settings_language_system">lokota ya sisitimu</string>
    <string name="settings_devices">bilokolo</string>
    <string name="settings_devices_body">longola bililingi te oyo te makelele te - stereo ya motuka te lokokoli - bonzela kosama te.</string>
    <string name="settings_device_subtitle">%1$s · makanga eyebi %2$s</string>
