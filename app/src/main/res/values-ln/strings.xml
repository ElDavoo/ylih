    <string name="settings_tracking">kosama</string>
    <string name="settings_detailed_title">kosala kya koa kya makambo makingi</string>
    <string name="settings_detailed_body">elongi makelele mwa sima mpe motema ya somi. android te kolobela app te oyo ezali komona makambo ma sima soki app te esali, yango wana likambo oyo bazali na kobenga sabela ya ndoto. bluetooth ezali kosama na mambimbi ya bililingi.</string>
    <string name="settings_detailed_unavailable">te na motema ata bluetooth te: bilakisi oyo te ya komanda kina se ya connectedDevice, oyo android 14+ ezali na bluetooth.</string>
    <string name="settings_playback_only_title">mbalá somi kina ko</string>
    <string name="settings_playback_only_body">statistike ezali kobakala motema oyo somi esali verament invezi de motema oyo kovanda. kina se bilakisi eleki na kosala kya koa kya makingi eleki somi; mosusu ezali lasama.</string>
