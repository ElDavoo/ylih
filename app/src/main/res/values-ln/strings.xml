    <string name="welcome_title">boyambí na ylih</string>
    <string name="welcome_intro">ylih ezali kosala biso motema monene moye oyo makelele esali kovanda, ndimelo na bango mibu moye to okoki lisusu kotatola yango solo yo moaye oyo esaleli: myele mingi mwa motema ino esali?</string>
    <string name="welcome_point_auto_title">linkisa na mamela</string>
    <string name="welcome_point_auto_body">makelele ya bluetooth ezali kosama na yango, wuta na motema esika esikaka ezali kovanda. te na kosalela bato te ko.</string>
    <string name="welcome_point_lifetime_title">makambo moko, motema moko</string>
    <string name="welcome_point_lifetime_body">soki makambo moko ezali kokufa, lakisá yango: motema na yango esali makasi wana mpe makambo mosusu ya makelele ezali kolamuka wuta na nol.</string>
    <string name="welcome_point_detailed_title">mwa sima na somi</string>
    <string name="welcome_point_detailed_body">kosala kya koa kya makingi, o makambo ma lokumu, elongi makelele mwa sima mpe esali esango ya motema na somi.</string>
    <string name="welcome_privacy">bililingi nyonso ezali kokala o singa yako. te na konte, mpe app te na ya moyibi makambo.</string>
    <string name="welcome_start">tangáka</string>
    <string name="welcome_next">olangi</string>
    <string name="welcome_allow">tiká</string>
    <string name="welcome_step">motuka %1$d na %2$d</string>
    <string name="welcome_bluetooth_title">tikisano ya bluetooth</string>
    <string name="welcome_bluetooth_why">android ezali kolobela app okola kang esano ya bluetooth ezali kovanda, mpe olia esango nini soki app elia na tikisano ya bluetooth. tina na kokata ylih kobasana makambo ma somi ya makelele mwa monene, mpe komfuni te komfuni.</string>
    <string name="welcome_bluetooth_with">na yango: makambo nyonso esami kosama wuta esika ezali kovanda, na kosambela oyo moku moku.</string>
    <string name="welcome_bluetooth_without">te na: makelele ya bluetooth te na kosama. app mosusu ezali kosala ndoto te, mpe okoki tiká balanda.</string>
    <string name="welcome_notifications_title">makambo ma sabela</string>
    <string name="welcome_notifications_why">kosala kya koa kya makambo makingi esali bililingi ya koa, mpe android azali komanda app oyo kobenga na yango kobenga sabela ya ndoto atika lokumu.</string>
    <string name="welcome_notifications_with">na yango: sabela ezali komonisa oyo esala kosamama kino, kina kina ko wa singa kobonga kya koa esali ete.</string>
    <string name="welcome_notifications_without">te na: kosala kya koa kya makambo makingi ezali kolinga mpe kosama. android te ekoka monisa sabela.</string>
    <string name="hibernation_title">motema te makambo oyoko te</string>
    <string name="hibernation_body">android ezali konionda app oyo te koyambaka mingi na mibu mpe ekonzwa mayibi, yango wana ylih te esama te ata wokoni koyambáka. koyambi te kina se oyo app ino ekofanda, ndimelo na bango likambo.</string>
