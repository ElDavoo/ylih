    <string name="settings_language_system">lìngua de su sistema</string>
    <string name="settings_devices">dispositivus</string>
    <string name="settings_devices_body">tollit sa marca dae cudda cosa chi no est cuffias - un caravana o un altoparlante - pro istopada de reghistrare issa.</string>
    <string name="settings_device_subtitle">%1$s · prima bida %2$s</string>
