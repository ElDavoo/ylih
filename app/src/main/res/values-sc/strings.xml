    <string name="settings_export">exporta json</string>
    <string name="settings_import">importa</string>
    <string name="settings_import_warning">importare cambiat totu sa cosa sa est archiviada in custu momentu.</string>
    <string name="settings_troubleshooting">risoluzione de problemas</string>
    <string name="settings_battery_body">si is sessiones istopant de essida registratas, controlat chi ylih est dispensada dae optimizatzione de baterìa - un’apa ca est istada detzada a forza no recbet més de custu momentu fintzas ca no est abelada.</string>
    <string name="settings_battery_button">cunfiguratzionis de baterìa</string>
    <string name="settings_battery_path">cunfiguratzionis → apa → ylih → baterìa → ilimitadu.</string>
    <string name="settings_hibernation_body">si ylih at istadu non abelta pro pausas meses, android a pasat e a tollit is permissus bake, e nulla est reghistradu de nou fintzas ca no ti abeltas. girare isse off est sa modu ca deascieit una para abanti contande per sa stagione chi ti no pensas de s’apa.</string>
    <string name="settings_hibernation_on">android podada pausare ylih.</string>
    <string name="settings_hibernation_off">ylih est dispensadu e abanti a reghistrare.</string>
    <string name="settings_hibernation_button">cunfiguratzionis de apa no impreadda</string>
    <string name="settings_about">a depas</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — oras de cuffias, archiviadas in logu e pro sempre.</string>
    <string name="settings_import_confirm_title">cambiat is datos totu?</string>
