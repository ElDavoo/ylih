    <string name="welcome_title">benvenidu a ylih</string>
    <string name="welcome_intro">ylih reghistrat quantu tempus durad sa connessioine de kada para de cuffias, cusì ca dopo annos podeis ancora rispondere sa dumanda chi calat: quantas oras durarana?</string>
    <string name="welcome_point_auto_title">conneti e iscordia</string>
    <string name="welcome_point_auto_body">is cuffias bluetooth sunt registratas in automàticu, dae sa momentu ca si connetent. nulla depet èssere lassadu funzionade.</string>
    <string name="welcome_point_lifetime_title">una para, una bida</string>
    <string name="welcome_point_lifetime_body">cando una para murit, pensionala: sa totale si gela lì e sa prochima para de is matessi cuffias incumintza dae zero.</string>
    <string name="welcome_point_detailed_title">cun filu e riprodutzione</string>
    <string name="welcome_point_detailed_body">sa tracciadura detallada, in is cunfiguratzionis, adigit is cuffias cun filu e mesurat quantas oras estava in riprodutzione.</string>
    <string name="welcome_privacy">tottu rimant in custu telèfonu. nono b’at contu, e s’apa nono at permissu de internet.</string>
    <string name="welcome_start">incumintza</string>
    <string name="welcome_next">prossima</string>
    <string name="welcome_allow">permiti</string>
    <string name="welcome_step">pasu %1$d de %2$d</string>
    <string name="welcome_bluetooth_title">accèssu bluetooth</string>
    <string name="welcome_bluetooth_why">android narat a s’apa su dispositivu bluetooth connetidu, e su nòmine su at, si s’apa tenit accèssu bluetooth. custu est sa modu ca ylih distint una para de cuffias dae una caravana, e sa modu ca sait una para dae sa otra.</string>
    <string name="welcome_bluetooth_with">cun issa: kada para est registrata dae sa momentu ca si connete, cun nulla lassadu funzionade e nulla de reminni de premere.</string>
    <string name="welcome_bluetooth_without">senza issa: nulla cuffias bluetooth sunt registratas. sa residu de s’apa funzionat ancora, e podeis permítilu dae in is cunfiguratzionis de android.</string>
    <string name="welcome_notifications_title">notìficas</string>
    <string name="welcome_notifications_why">sa tracciadura detallada est que servidu de fundu, e android cunticat chi kala apa ca faet custu depet mantene una notìfica bìsìbile mentre o faet.</string>
    <string name="welcome_notifications_with">cun issa: sa notìfica ammustra sa sa est reghistradu in custu momentu, chi est sa ùnica sinna ca sa tracciadura detallada est biva.</string>
    <string name="welcome_notifications_without">senza issa: sa tracciadura detallada funzionat ancora e ancora reghistrat. android non mustraraai sa notìfica.</string>
    <string name="hibernation_title">abanti contande mentre ti isscordis</string>
    <string name="hibernation_body">android pasat is apa chi non sunt abeltas pro pausas meses e tollit sa permissus bake, chi deparachiraai ylih no reghistrade nudda fintzas ca ti abeltas. essida iscordida est prus tantu sa modu de custu apa, cusì che est bale girare isse off in custu momentu.</string>
