<?xml version="1.0" encoding="utf-8"?>
<!--
  Romanian. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources>
    <string name="app_title">ylih - viața ta în căști</string>

    <!-- Navigare -->
    <string name="nav_headphones">căști</string>
    <string name="nav_stats">statistici</string>
    <string name="nav_settings">setări</string>

    <!-- Tipuri de dispozitiv -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">prin cablu</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">necunoscut</string>

    <!-- Prima pornire -->
    <string name="welcome_title">bine ai venit în ylih</string>
    <string name="welcome_intro">ylih înregistrează cât timp rămâne conectată fiecare pereche de căști, ca peste ani să poți încă răspunde la singura întrebare care contează despre o pereche: câte ore a rezistat?</string>
    <string name="welcome_point_auto_title">conectează și uită</string>
    <string name="welcome_point_auto_body">căștile bluetooth sunt înregistrate de la sine, din momentul conectării. nu trebuie lăsat nimic pornit.</string>
    <string name="welcome_point_lifetime_title">o pereche, o durată de viață</string>
    <string name="welcome_point_lifetime_body">când o pereche moare, retrage-o: totalul ei se blochează acolo, iar următoarea pereche a acelorași căști pornește din nou de la zero.</string>
    <string name="welcome_point_detailed_title">cablu și redare</string>
    <string name="welcome_point_detailed_body">urmărirea detaliată, din setări, adaugă căștile prin cablu și măsoară cât din acel timp s-a redat efectiv sunet.</string>
    <string name="welcome_privacy">totul rămâne pe acest telefon. nu există niciun cont, iar aplicația nu are permisiune de internet.</string>
    <string name="welcome_start">să începem</string>

