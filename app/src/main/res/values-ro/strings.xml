    <!-- Setări -->
    <string name="settings_tracking">urmărire</string>
    <string name="settings_detailed_title">urmărire detaliată</string>
    <string name="settings_detailed_body">adaugă căștile prin cablu și timpul de redare. android raportează evenimentele mufei doar unei aplicații deja pornite, așa că rămâne o notificare silențioasă în bara de notificări. bluetooth este urmărit oricum.</string>
    <string name="settings_detailed_unavailable">indisponibil până nu acorzi acces la bluetooth: această versiune declară doar tipul de serviciu connectedDevice, pe care android 14+ îl leagă de o permisiune bluetooth.</string>
    <string name="settings_devices">dispozitive</string>
    <string name="settings_devices_body">debifează ce nu sunt căști — un sistem auto sau o boxă — ca să nu mai fie înregistrat.</string>
    <string name="settings_device_subtitle">%1$s · văzut prima dată %2$s</string>
    <string name="settings_data">date</string>
    <string name="settings_export">exportă json</string>
    <string name="settings_import">importă</string>
    <string name="settings_import_warning">importul înlocuiește tot ce este stocat acum.</string>
    <string name="settings_troubleshooting">depanare</string>
    <string name="settings_battery_body">dacă sesiunile nu se mai înregistrează, verifică dacă ylih este scutită de optimizarea bateriei — o aplicație oprită forțat nu mai primește evenimente de conectare până nu este deschisă din nou.</string>
    <string name="settings_battery_button">setări baterie</string>
    <string name="settings_battery_path">setări → aplicații → ylih → baterie → fără restricții.</string>
    <string name="settings_about">despre</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — orele căștilor tale, păstrate local și pentru totdeauna.</string>
    <string name="settings_import_confirm_title">înlocuiești toate datele?</string>
    <string name="settings_import_confirm_body">importul acestei copii de rezervă șterge fiecare dispozitiv, pereche și sesiune stocate acum.</string>

