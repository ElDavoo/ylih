<?xml version="1.0" encoding="utf-8"?>
<!--
  Norwegian Bokmål. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_title">ylih - livet ditt i hodetelefoner</string>

    <!-- Navigasjon -->
    <string name="nav_headphones">hodetelefoner</string>
    <string name="nav_stats">statistikk</string>
    <string name="nav_settings">innstillinger</string>

    <!-- Enhetstyper -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">kablet</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">ukjent</string>

    <!-- Førstegangsoppstart -->
    <string name="welcome_title">velkommen til ylih</string>
    <string name="welcome_intro">ylih registrerer hvor lenge hvert par hodetelefoner er tilkoblet, slik at du om mange år fortsatt kan svare på det eneste spørsmålet som betyr noe for et par: hvor mange timer varte de?</string>
    <string name="welcome_point_auto_title">koble til og glem</string>
    <string name="welcome_point_auto_body">bluetooth-hodetelefoner registreres helt automatisk, fra det øyeblikket de kobles til. ingenting trenger å kjøre i bakgrunnen.</string>
    <string name="welcome_point_lifetime_title">ett par, ett liv</string>
    <string name="welcome_point_lifetime_body">når et par dør, pensjoner du det: totalen fryses der, og neste par av samme hodetelefoner starter på nytt fra null.</string>
    <string name="welcome_point_detailed_title">kablet og avspilling</string>
    <string name="welcome_point_detailed_body">detaljert sporing, i innstillinger, legger til kablede hodetelefoner og måler hvor mye av tiden som faktisk gikk til avspilling.</string>
    <!-- "Internett" is normally capitalised in Norwegian; the house style is lowercase everywhere,
         which is the same reason action_cancel carries a ButtonCase suppression. -->
    <string name="welcome_privacy" tools:ignore="Typos">alt blir på denne telefonen. det finnes ingen konto, og appen har ikke internett-tilgang.</string>
    <string name="welcome_start">kom i gang</string>
    <string name="welcome_next">neste</string>
    <string name="welcome_allow">tillat</string>
    <string name="welcome_step">trinn %1$d av %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth-tilgang</string>
    <string name="welcome_bluetooth_why">android forteller bare en app hvilken bluetooth-enhet som koblet til, og hva den heter, hvis appen har bluetooth-tilgang. det er slik ylih skiller et par hodetelefoner fra et bilanlegg, og ett par fra et annet.</string>
    <string name="welcome_bluetooth_with">med tilgang: hvert par registreres fra øyeblikket det kobler til, uten at noe må kjøre og uten at du må huske å trykke på noe.</string>
    <string name="welcome_bluetooth_without">uten tilgang: ingen bluetooth-hodetelefoner registreres i det hele tatt. resten av appen virker fortsatt, og du kan gi tilgangen senere i androids appinnstillinger.</string>
    <string name="welcome_notifications_title">varsler</string>
    <string name="welcome_notifications_why">detaljert sporing kjører en liten bakgrunnstjeneste, og android krever at enhver app som gjør det holder et varsel synlig.</string>
    <string name="welcome_notifications_with">med tillatelse: varselet viser hva som registreres akkurat nå, som er det eneste tegnet på at detaljert sporing lever.</string>
    <string name="welcome_notifications_without">uten tillatelse: detaljert sporing kjører og registrerer likevel. android viser bare ikke varselet.</string>
    <string name="hibernation_title">fortsetter å telle mens du glemmer den</string>
    <string name="hibernation_body">android setter apper som ikke blir åpnet på et par måneder på pause og tar tillatelsene deres tilbake, noe som ville latt ylih registrere ingenting før du åpnet den igjen. å bli glemt er nettopp det denne appen er til for, så det er verdt å slå det av nå.</string>
    <string name="action_not_now">ikke nå</string>

    <!-- Liste over hodetelefoner -->
    <string name="devices_in_use">i bruk</string>
    <string name="devices_retired">pensjonert</string>
    <string name="devices_empty_title">ingen hodetelefoner ennå</string>
    <string name="devices_empty_body">koble til et par bluetooth-hodetelefoner, så dukker de opp her. kablede hodetelefoner krever detaljert sporing, i innstillinger.</string>
