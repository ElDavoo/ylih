    <!-- Innstillinger -->
    <string name="settings_tracking">sporing</string>
    <string name="settings_detailed_title">detaljert sporing</string>
    <string name="settings_detailed_body">legger til kablede hodetelefoner og avspillingstid. android rapporterer kun kabelhendelser til en app som kjører, så dette holder en stille varsling i varslingspanelet. bluetooth spores uansett.</string>
    <string name="settings_detailed_unavailable">utilgjengelig til bluetooth-tilgang er gitt: denne utgaven deklarerer bare tjenestetypen connectedDevice, som android 14+ knytter til en bluetooth-tillatelse.</string>
    <string name="settings_playback_only_title">tell bare avspilling</string>
    <string name="settings_playback_only_body">statistikken teller tiden lyden faktisk spilte i stedet for tiden tilkoblet. bare økter som ble registrert med detaljert sporing på, målte avspilling; resten holdes utenfor.</string>
    <string name="settings_language">språk</string>
    <string name="settings_language_system">systemspråk</string>
    <string name="settings_devices">enheter</string>
    <string name="settings_devices_body">fjern haken for alt som ikke er hodetelefoner — et bilstereoanlegg eller en høyttaler — for å slutte å registrere det.</string>
    <string name="settings_device_subtitle">%1$s · først sett %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">eksportér json</string>
    <string name="settings_import">importér</string>
    <string name="settings_import_warning">import erstatter alt som er lagret nå.</string>
    <string name="settings_troubleshooting">feilsøking</string>
    <string name="settings_battery_body">hvis økter slutter å bli registrert, sjekk at ylih er unntatt fra batterioptimalisering — en app som er tvangsstoppet, mottar aldri tilkoblingshendelser igjen før den åpnes på nytt.</string>
    <string name="settings_battery_button">batteriinnstillinger</string>
    <string name="settings_battery_path">innstillinger → apper → ylih → batteri → ubegrenset.</string>
    <string name="settings_hibernation_body">hvis ylih ikke blir åpnet på et par måneder, setter android den på pause og tar tillatelsene tilbake, og ingenting registreres igjen før du åpner den. å slå det av er det som lar et par fortsette å telle gjennom en sesong der du aldri tenker på appen.</string>
    <string name="settings_hibernation_on">android kan sette ylih på pause.</string>
    <string name="settings_hibernation_off">ylih er unntatt og fortsetter å registrere.</string>
    <string name="settings_hibernation_button">innstillinger for ubrukte apper</string>
    <string name="settings_about">om</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — hodetelefontimer, lagret lokalt og for alltid.</string>
    <string name="settings_import_confirm_title">erstatte alle data?</string>
    <string name="settings_import_confirm_body">import av denne sikkerhetskopien sletter hver enhet, hvert par og hver økt som er lagret nå.</string>
    <string name="widget_lifetime_label">ylih · levetid</string>
    <string name="widget_lifetime_description">timer per par, med en levende teller på det som er tilkoblet</string>
    <string name="widget_activity_label">ylih · aktivitet</string>
    <string name="widget_activity_description">timene til alle par samlet, pluss i dag, 7 dager og 30 dager</string>
    <string name="widget_chart_label">ylih · 30 dager</string>
    <string name="widget_chart_description">daglige lyttetimer de siste 30 dagene</string>

    <!-- Delte handlinger -->
    <string name="action_save">lagre</string>
    <string name="action_cancel">avbryt</string>
    <string name="action_delete">slett</string>
    <string name="action_import">importér</string>

    <!-- Varsling -->
    <string name="channel_tracking">hodetelefonsporing</string>
    <string name="channel_tracking_description">vises mens ylih ser etter kablede hodetelefoner og avspilling. android leverer ikke kabelhendelser til apper som ikke kjører.</string>
