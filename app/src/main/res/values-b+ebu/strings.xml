    <string name="settings_import">ruta mwarũngu</string>
    <string name="settings_import_warning">ruta mwarũngu rĩgĩthamba gĩothe kĩa haarũ.</string>
    <string name="settings_troubleshooting">ruo rũa mahoya</string>
    <string name="settings_battery_body">ruo mahinda maruta ĩmenyithia, menyaga kana ylih ĩrĩ na mahoya kwa kĩruta - kĩruta kĩa android ĩtaarĩ na mahoya o nakĩo kuuma kana kĩooyitwo nĩngĩ.</string>
    <string name="settings_battery_button">ĩmenyithia ya kĩruta</string>
    <string name="settings_battery_path">ĩmenyithia → mĩruta → ylih → kĩruta → gũtũũ gwa makĩĩo.</string>
    <string name="settings_hibernation_body">ylih ĩngĩtiga kũhingũrwo ĩmĩeri mĩingĩ, android nĩĩgĩtigithagia na ĩgatunya mahoya makĩo, ndĩgacooka koma ũndũ kuuma ĩyo nginya wanahingũra ringĩ. kana ũndũ ũyũ nĩguo kĩruta kĩgayanie gũkarania o na ĩrĩa wariganirwo nĩ kĩruta gĩkĩ ihinda iraihu.</string>
    <string name="settings_hibernation_on">android no ĩtigithie ylih.</string>
    <string name="settings_hibernation_off">ylih ndĩrĩ na kĩmenyithia — ĩrathiĩ na mbere kũreka.</string>
    <string name="settings_hibernation_button">ĩmenyithia ya kĩruta gĩtekũtũmagĩrwo</string>
    <string name="settings_about">o ylih</string>
