    <string name="settings_import">derve bike</string>
    <string name="settings_import_warning">derve kirina vî hemû tişt ku ni-ve bike.</string>
    <string name="settings_troubleshooting">koçin saribillî</string>
    <string name="settings_battery_body">heke danefînî du bike neda, mihr, ylih ji xera bateryê bi azadî ye — sepanî ku berdewan hate, pêwîst û na girê xeber heta tu vî pirre bike.</string>
    <string name="settings_battery_button">sazkirî bateryê</string>
    <string name="settings_battery_path">sazkirî → sepanî → ylih → bateryê → serbest.</string>
    <string name="settings_hibernation_body">heke ylih ji bo mangên hinek vekiranê, android dubare bike û maf bistîne, û tiştek na toman heta tu vî vekerî. vî berdewan kirina ku cotek du bike di misiyek a we tu nivîsin sepan de.</string>
    <string name="settings_hibernation_on">android dikî ylih dubare bike.</string>
    <string name="settings_hibernation_off">ylih azad ye û du toman bike.</string>
    <string name="settings_hibernation_button">sazkirî sepana nebikar</string>
    <string name="settings_about">derbare</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — saetên gasnav, di vî gayê de û bê dawê.</string>
    <string name="settings_import_confirm_title">hemû danekin guhert bike?</string>
    <string name="settings_import_confirm_body">vî derzey derve kirin hemû cî, cotek û danefîn jîrke bike.</string>

