    <string name="settings_tracking">guhdarî</string>
    <string name="settings_detailed_title">guhdariya bilalî</string>
    <string name="settings_detailed_body">gasnav hêzûn û dema lêxistinê lêzêde dike. android tenê cî denghêzûnan ji bo sepana berdewan nîşan dide, wexta vî xebir sivik di şewitê de dimîne. bluetooth her carî guhdar dibe.</string>
    <string name="settings_detailed_unavailable">heta mafî bluetooth dayîne. vî çêker tenê qad kî connectedDevice tê nîşan dide, ku android 14+ bi mafî bluetooth girê dike.</string>
    <string name="settings_playback_only_title">tenê lêxistinê jimartî bike</string>
    <string name="settings_playback_only_body">statîstîk dema ku deng rast tê lêxistin, ne dema girê. tenê danefînî ku bi guhdariya bilalî ve hatine tomar kirin lêxistinê jêhatî ne; ên din jê dikevin dûr.</string>
    <string name="settings_language">ziman</string>
    <string name="settings_language_system">ziman ya pergalê</string>
    <string name="settings_devices">cihê</string>
    <string name="settings_devices_body">ji hemû dê nabe gasnav — radioya mobîl an guharîn — jêbirin da ku rû nave bike.</string>
    <string name="settings_device_subtitle">%1$s · pêşîn dît %2$s</string>
