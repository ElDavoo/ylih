<?xml version="1.0" encoding="utf-8"?>
<!--
  Taita. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources>
    <string name="app_title">ylih — uhai wako in masikilizaji</string>

    <!-- Navigation -->
    <string name="nav_headphones">masikilizaji</string>
    <string name="nav_stats">takwimu</string>
    <string name="nav_settings">mipangilio</string>

    <!-- Device kinds -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">wenye waya</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">haijulikani</string>

    <!-- First run -->
    <string name="welcome_title">karibu kwa ylih</string>
    <string name="welcome_intro">ylih inaweka rekodi ya kiasi cha muda kila jozi ya masikilizaji inabaki iliyounganishwa, ili miaka kadhaa kutoka sasa unaweza bado kujibu swali moja tu linalokuwa muhimu kuhusu jozi: saati ngapi zilipigania?</string>
    <string name="welcome_point_auto_title">unganisha na kusahau</string>
    <string name="welcome_point_auto_body">bluetooth masikilizaji hurekodiwa wenyewe, tangu wakati wa kuunganishwa. hakuna kitu ambacho lazima kuachwa kuendelea.</string>
    <string name="welcome_point_lifetime_title">jozi moja, maisha moja</string>
    <string name="welcome_point_lifetime_body">wakati jozi ikapofa, kuondoa: jumla yake imefungwa hapo na jozi inayofuata ya masikilizaji sawa inaanza tena kutoka sifuri.</string>
    <string name="welcome_point_detailed_title">waya na kucheza muziki</string>
    <string name="welcome_point_detailed_body">ufuataji wa kina, katika mipangilio, inaongeza masikilizaji wenye waya na kupima ni kiasi gani cha muda ulichokuwa kucheza muziki.</string>
    <string name="welcome_privacy">kila kitu kinabaki katika simu hii. hakuna akaunti, na programu haina ruhusa ya intaneti.</string>
    <string name="welcome_start">anza</string>
    <string name="welcome_next">mbee</string>
    <string name="welcome_allow">ruhusu</string>
    <string name="welcome_step">ndughu %1$d kwa %2$d</string>
    <string name="welcome_bluetooth_title">ruhusa ya bluetooth</string>
    <string name="welcome_bluetooth_why">android imwambia programu ni kifaa kiche cha bluetooth chiungirwe, na chikutambulika ni, kama tu programu ina ruhusa ya bluetooth. ndo vila ylih itofautisha vifaa vya kusikira na redio ya gari, na jozi imwenga na inge.</string>
    <string name="welcome_bluetooth_with">na ruhusa: kila jozi iandikwa kuchia wakati iungirwe, bila kilekwa kintu kikifanya kazi na bila kukumbukira kubonyeza kintu.</string>
    <string name="welcome_bluetooth_without">bila ruhusa: kunavo vifaa vya kusikira vya bluetooth viandikwavo. sehemu inge ya programu ikafanya kazi, na undaweza kutoa ruhusa baadaye kwenye mipangilio ya programu ya android.</string>
    <string name="welcome_notifications_title">arifa</string>
    <string name="welcome_notifications_why">ufuatiliaji wa kina ifanya huduma ndodo ya nyuma, na android ilonda kila programu ifanyayo vivyo kuvika arifa ikionekana.</string>
    <string name="welcome_notifications_with">na ruhusa: arifa ilaghusa kicho chiandikwacho sasa, ndo dalili imwenga tu kukwamba ufuatiliaji wa kina u hai.</string>
    <string name="welcome_notifications_without">bila ruhusa: ufuatiliaji wa kina ukafanya kazi na ukaandika. android tu haitalaghusa arifa yake.</string>
    <string name="hibernation_title">yaendelea kuhesabu hata ukisahau</string>
    <string name="hibernation_body">android inasitisha programu zisizofunguliwa kwa miezi, na inaondoa ruhusa zake. hapo ylih haitaandika chochote mpaka uifungue tena. kusahaulika ndiyo kazi ya programu hii, hivyo tatakamatia jambo hili sasa.</string>
    <string name="action_not_now">sio sasa</string>

