    <!-- Settings -->
    <string name="settings_tracking">ufuataji</string>
    <string name="settings_detailed_title">ufuataji wa kina</string>
    <string name="settings_detailed_body">inaongeza masikilizaji wenye waya na muda wa kucheza. android inakubali matukio ya waya tu kwa programu inayoendelea, kwa hiyo hii inabaki notisi yenye sauti ndogo katika maeneo. bluetooth inafuatwa kila wakati.</string>
    <string name="settings_detailed_unavailable">haipatikani mpaka ruhusa ya bluetooth itolewe: jumba hili linashangilia aina tu ya huduma ya connectedDevice, ambayo android 14+ inaambatana na ruhusa ya bluetooth.</string>
    <string name="settings_playback_only_title">hesabu kucheza tu</string>
    <string name="settings_playback_only_body">takwimu zinahesabu muda ambao sauti ilicheza kweli badala ya muda wa kuunganishwa. vipindi vilivyorekodiwa ufuataji wa kina ukiwa umewashwa pekee ndivyo vilivyopima kucheza; vingine vinaachwa.</string>
    <string name="settings_language">lugha</string>
    <string name="settings_language_system">lugha ya mfumo</string>
    <string name="settings_devices">vifaa</string>
    <string name="settings_devices_body">burudisha kila kitu ambacho si masikilizaji — stereo ya gari au spika — kuacha kurekodi.</string>
    <string name="settings_device_subtitle">%1$s · iliyoonekana kwanza %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">hamisha json</string>
    <string name="settings_import">ingiza</string>
    <string name="settings_import_warning">kuingiza kunabadilisha kila kitu kinachohifadhiwa sasa.</string>
    <string name="settings_troubleshooting">kukamatia matatizo</string>
    <string name="settings_battery_body">ikiwa mkutano unaacha kurekodi, hakikisha ylih imepunguzwa kutoka ubora wa betri — programu iliyosimamishwa kwa nguvu hairithi ujumbe wa kuunganishwa mpaka haiwakiwi tena.</string>
    <string name="settings_battery_button">mipangilio ya betri</string>
    <string name="settings_battery_path">mipangilio → programu → ylih → betri → haihidiwa.</string>
    <string name="settings_hibernation_body">ikiwa ylih haitafunguliwa kwa miezi, android inaisitisha na kuondoa ruhusa yake, na haiandiki tena mpaka uifungue. tatakamatia jambo hili ili ylih iendelee kuhesabu hata katika kipindi usipowaza juu ya programu hii.</string>
    <string name="settings_hibernation_on">android inaweza kusitisha ylih.</string>
    <string name="settings_hibernation_off">ylih haihusiki — inaendelea kuandika.</string>
    <string name="settings_hibernation_button">mipangilio ya programu zisizotumika</string>
    <string name="settings_about">kuhusu</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — saati za masikilizaji, zilizohifadhiwa mahali na kila wakati.</string>
    <string name="settings_import_confirm_title">badilisha data yote?</string>
    <string name="settings_import_confirm_body">kuingiza kichanuo hiki kunafuta kila kifaa, jozi na mkutano uliohifadhiwa sasa.</string>
    <string name="widget_lifetime_label">ylih · maisha</string>
    <string name="widget_lifetime_description">saa kwa kila jozi, na saa hai kwa iliyounganishwa</string>
    <string name="widget_activity_label">ylih · shughuli</string>
    <string name="widget_activity_description">saa za jozi zote pamoja, na leo, siku 7 na siku 30</string>
    <string name="widget_chart_label">ylih · siku 30</string>
    <string name="widget_chart_description">saa za kusikiliza kila siku katika siku 30 zilizopita</string>

