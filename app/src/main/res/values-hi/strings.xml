    <string name="settings_troubleshooting">समस्या निवारण</string>
    <string name="settings_battery_body">अगर सत्र दर्ज होना बंद हो जाएं, तो जांचें कि ylih बैटरी ऑप्टिमाइज़ेशन से मुक्त है — जिस ऐप को ज़बरदस्ती रोका गया हो, वह खोले जाने तक फिर कभी कनेक्शन ब्रॉडकास्ट नहीं पाता।</string>
    <string name="settings_battery_button">बैटरी सेटिंग्स</string>
    <string name="settings_battery_path">सेटिंग्स → ऐप्स → ylih → बैटरी → अप्रतिबंधित।</string>
    <string name="settings_hibernation_body">अगर ylih कुछ महीनों तक न खोला जाए, तो android इसे रोक देता है और इसकी अनुमतियां वापस ले लेता है, और जब तक आप इसे नहीं खोलते तब तक कुछ भी दोबारा रिकॉर्ड नहीं होता। इसे बंद करना ही वह है जो एक जोड़ी को उस मौसम में भी गिनती जारी रखने देता है जिसमें आप ऐप के बारे में सोचते तक नहीं।</string>
    <string name="settings_hibernation_on">android ylih को रोक सकता है।</string>
    <string name="settings_hibernation_off">ylih को छूट है और यह रिकॉर्ड करता रहता है।</string>
    <string name="settings_hibernation_button">अप्रयुक्त ऐप सेटिंग</string>
    <string name="settings_about">जानकारी</string>
