    <string name="welcome_title">salve in ylih</string>
    <string name="welcome_intro">ylih recorda quantce tempe quallibet par de auricula resti connectat, ut yu posse responde post annos al singel question quem importa: quantos hor duraban ili pares?</string>
    <string name="welcome_point_auto_title">connecte et obliva</string>
    <string name="welcome_point_auto_body">bluetooth auricula es recordat automaticim ex momento dum li se connecte. noll nese restar currende</string>
    <string name="welcome_point_lifetime_title">un par, un vita</string>
    <string name="welcome_point_lifetime_body">dum un par muere, li retire: li total fixa dar e li sequent par de sam auricula recommence ab zero</string>
    <string name="welcome_point_detailed_title">filific et audition</string>
    <string name="welcome_point_detailed_body">tracta detalliat in configurationen adde filific auricula et mesura quantce de li tempe verament audiet</string>
    <string name="welcome_privacy">tot resti in yu telefone. noll conto existit, et li app noll internet-permission have</string>
    <string name="welcome_start">comence</string>
    <string name="welcome_next">sequent</string>
    <string name="welcome_allow">permitte</string>
    <string name="welcome_step">pas %1$d de %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth-acces</string>
    <string name="welcome_bluetooth_why">android solmen dice a un app quel bluetooth-aparate es connectat et qualnom li have, si li app bluetooth-acces possess. so ylih potent distingue auricula de un auto-stereo, et saper distingue un par ab altri</string>
    <string name="welcome_bluetooth_with">con it: quallibet par es recordat ex dum se connecte, sin noll restar currende et sin noll memorar</string>
    <string name="welcome_bluetooth_without">sin it: null bluetooth-auricula es recordat. li rest de li app functiona sempre, et yu posse it concede plus tard in android-configurationes</string>
    <string name="welcome_notifications_title">notifikacionen</string>
    <string name="welcome_notifications_why">tracta detalliat executat un petti background-servicio, et android require que quallibet app facende so tenga un visibel notifikacion</string>
    <string name="welcome_notifications_with">con it: li notifikacion monstra quo recordat es nunc, quo es li singel signum dum tracta detalliat vive</string>
    <string name="welcome_notifications_without">sin it: tracta detalliat sempre executat et sempre recordat. android simplimen ne monstra li notifikacion</string>
    <string name="hibernation_title">continue counter dum yu obliva</string>
    <string name="hibernation_body">android pausat apps queles resti non-aperit por alquant menses et revoke li permissionen, quo caussarea ylih nil recorder usque yu next apertura. esser oblivisit es exactim pro quo ti app existe, dunce vale la pena disactivat it nunc</string>
