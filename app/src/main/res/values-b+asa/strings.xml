    <!-- Kwambula kwanza -->
    <string name="welcome_title">karibu kwa ylih</string>
    <string name="welcome_intro">ylih irekodi muda gani kila pair ya iburani inatuma kuunga, ili baada ya miaka yote uweze kusalia kujibu swali linalosadiki juu ya pair: saa ngapi zilimwendea?</string>
    <string name="welcome_point_auto_title">kuunga na kusahau</string>
    <string name="welcome_point_auto_body">bluetooth iburani inarekodi yenyewe, kuanzia saa imbapo zinaunganisha. hakuna chochote kinachopaswa kuendelea.</string>
    <string name="welcome_point_lifetime_title">pair moja, maisha moja</string>
    <string name="welcome_point_lifetime_body">saa imbapo pair inapofa, kuzibu: jumla iliyomo humo na pair ijayo ya iburani moja inaanzia kutena tena kutoka sifuri.</string>
    <string name="welcome_point_detailed_title">sambamano na kuiga</string>
    <string name="welcome_point_detailed_body">irekodi ileile, mu mawania, inaongeza sambamano iburani na kusuubu saa ngapi ileile ilikuwa inaiga.</string>
    <string name="welcome_privacy">vitu vyote vinabakia mu simu ino. hakuna akaunti, na app haina ruhusa ya intaneti.</string>
    <string name="welcome_start">anza</string>

