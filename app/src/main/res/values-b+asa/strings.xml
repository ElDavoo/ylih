    <string name="settings_import">kuweka</string>
    <string name="settings_import_warning">kuweka kunabadilisha vitu vyote vinavyohifadhiwa sasa.</string>
    <string name="settings_troubleshooting">kurekebisha matatizo</string>
    <string name="settings_battery_body">ikiwa mgogoro haujarikibishwa kurekodiwwa, angalia kwamba ylih haijahusivwa kutokamizwa bateria — app iliyosimama mwenyewe hairisii matukio ya kuunga, saa imbapo haijafunguliwa.</string>
    <string name="settings_battery_button">mawania ya bateria</string>
    <string name="settings_battery_path">mawania → apps → ylih → bateria → ingizwa.</string>
    <string name="settings_about">kuhusu</string>
