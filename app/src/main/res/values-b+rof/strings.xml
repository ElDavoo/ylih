    <string name="settings_tracking">ufuataji</string>
    <string name="settings_detailed_title">ufuataji wa kina</string>
    <string name="settings_detailed_body">huongeza kopesi za waya na muda wa kutoa sauti. android inajuaje matukio ya kujaza waya kwa programu inayofanya kazi tu, kwa hiyo hii inahifadhi arifa nyimbo katika upande. bluetooth hushugulikwa kwa njia yoyote.</string>
    <string name="settings_detailed_unavailable">haipatikani hadi ruhusa ya bluetooth itolewe: mhadhimuni huu unajulikana tu aina ya huduma ya connectedDevice, ambayo android 14+ inaandika kwa ruhusa ya bluetooth.</string>
    <string name="settings_playback_only_title">hesabu kutoa sauti tu</string>
    <string name="settings_playback_only_body">takwimusi huhesabu muda wa kutoa sauti, si muda wa kuunganisha. vikao vya kushugulikwa na ufuataji wa kina unakamatia muda wa kutoa sauti tu; wengine wanaacha nje.</string>
    <string name="settings_language">lugha</string>
    <string name="settings_language_system">lugha ya mfumo</string>
    <string name="settings_devices">mitambo</string>
    <string name="settings_devices_body">ondoa alama yoyote isiyo kopesi - sauti ya gari au mzunguko - kumwacha ishugulikwe.</string>
    <string name="settings_device_subtitle">%1$s · ilionekana kwanza %2$s</string>
