    <string name="welcome_title">karibu ylih</string>
    <string name="welcome_intro">ylih inashugulikia muda gani kila jozi ya kopesi inaonakili, ili miaka baadaye unaweza kujibu swali linalo muhimu: jozi hii ilidumu saa ngapi?</string>
    <string name="welcome_point_auto_title">unganisha na sahau</string>
    <string name="welcome_point_auto_body">kopesi za bluetooth zimeshugulikwa kiotomatiki, tangu wakati wa kuunganisha. hakuna haja kuwa na kitu kinachofanya kazi.</string>
    <string name="welcome_point_lifetime_title">jozi moja, maisha moja</string>
    <string name="welcome_point_lifetime_body">wakati jozi inakufa, kutoza: jumla yake huzama hapo na jozi mpya ya kopesi sawa inaanza tena.</string>
    <string name="welcome_point_detailed_title">kwa waya na kutoa sauti</string>
    <string name="welcome_point_detailed_body">ufuataji wa kina, katika seti, huongeza kopesi za waya na kupima muda wa kutoa sauti.</string>
    <string name="welcome_privacy">kila kitu kinabaki katika simu hii. hakuna akaunti, na programu haina ruhusa ya intaneti.</string>
    <string name="welcome_start">kuanza</string>
    <string name="welcome_next">inayofuata</string>
    <string name="welcome_allow">ruhusu</string>
    <string name="welcome_step">hatua %1$d kati ya %2$d</string>
    <string name="welcome_bluetooth_title">ruhusa ya bluetooth</string>
    <string name="welcome_bluetooth_why">android inajuaje programu ipi kwa alineza kwa bluetooth, na jina lake, kama programu ina ruhusa ya bluetooth. kwa njia hii ylih inaweza kutofautiana jozi ya kopesi na sauti za gari.</string>
    <string name="welcome_bluetooth_with">kwa hii: kila jozi inashugulikwa tangu wakati wa kuunganisha, bila kitu kinachofanya kazi.</string>
    <string name="welcome_bluetooth_without">bila hii: hakuna kopesi za bluetooth zimeshugulikwa. sehemu nyingine ya programu huishi kazi, na unaweza kutoa ruhusa baadaye katika seti za android.</string>
    <string name="welcome_notifications_title">arifa</string>
    <string name="welcome_notifications_why">ufuataji wa kina unafanya kazi ya huduma ndogo ya nyuma, na android inahitaji programu yoyote inayofanya hii ili kuendelea na ilani iliyoonekana.</string>
    <string name="welcome_notifications_with">kwa hii: arifa inaonyesha kile kinachoshugulikwa sasa, ambacho ni dalili pekee ya ufuataji wa kina kufa na kazi.</string>
    <string name="welcome_notifications_without">bila hii: ufuataji wa kina unafanya kazi na hushugulikia. android haitaonyesha ilani yake.</string>
    <string name="hibernation_title">endelea kuhesabu wakati wa kusahau</string>
    <string name="hibernation_body">android inasimamisha programu ambazo hazifunguliwi kwa baadhi ya miezi na kuondoa ruhusa zao, ambayo ingeacha ylih isishugulikiwe hadi utayafungua tena. kukamatiana na programu ni haswa kile programu hii inasambaza, kwa hiyo inastahili kutumiia sasa.</string>
