    <string name="settings_import_warning">kuagiza inabadilisha kila kitu kilichohifadhiwa.</string>
    <string name="settings_troubleshooting">kutatua matatizo</string>
    <string name="settings_battery_body">kama vikao havishugulikwi, angalia kuwa ylih haina utengano wa betri - programu iliyokamata si sira haipatikani tena hadi itafunguliwa.</string>
    <string name="settings_battery_button">seti za betri</string>
    <string name="settings_battery_path">seti → programu → ylih → betri → pasipo kizuizi.</string>
    <string name="settings_hibernation_body">ikiwa ylih haifunguliwi kwa baadhi ya miezi, android inatumaini kama inapotezewa na inapokea ruhusa zake, nta kitu kiliweza kushugulikwa hadi utayafungua. kutumiia hii kwa jozi kuendelea kuhesabu wakati wa msimu ambao hauwezi kufikiri kuhusu programu.</string>
    <string name="settings_hibernation_on">android inaweza kusimamisha ylih.</string>
    <string name="settings_hibernation_off">ylih haina kizuizi na inaendelea kushugulikia.</string>
    <string name="settings_hibernation_button">seti za programu isiyo na matumizi</string>
    <string name="settings_about">kuhusu</string>
    <string name="settings_about_body">ylih %1$s (%2$s) - masaa ya kopesi, yaliyohifadhiwa ndani na milele.</string>
    <string name="settings_import_confirm_title">badilisha data zote?</string>
    <string name="settings_import_confirm_body">kuagiza zaa hii inafuta kila kifaa, jozi na kikao kilichohifadhiwa.</string>

