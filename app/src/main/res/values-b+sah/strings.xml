    <string name="welcome_point_auto_body">bluetooth yumukchit-yumukchit ol isiterge toguruhu sannabyt. khampyr khaam baaryy sallataxyy kiele.</string>
    <string name="welcome_point_lifetime_title">bir yumukchit toguruhu - bir kihin</string>
    <string name="welcome_point_lifetime_body">yumukchit khatyna emes ettighe, sallat: annya yhaal buollar. khara toguruu aha kulustuhe tutula nannyy kelle hannyy.</string>
    <string name="welcome_point_detailed_title">tithe tuis taas</string>
    <string name="welcome_point_detailed_body">mannyy sallat diite, tithe yumukchit taas tuis kaaqhyhy. onon mannyy aajy-tuis cayaan eberibyt.</string>
