    <string name="welcome_title">ylih-ge kelem</string>
    <string name="welcome_intro">ylih har bir yumukchit-yumukchit toguruhu tolonnu suluullaabyt sannattyy. amma aastakh yyllar songor gyn, ebit kysmyt: yumukchittar sanne kaaq caasqa toluonnullar?</string>
