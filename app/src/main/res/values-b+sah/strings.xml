    <string name="welcome_bluetooth_title">bluetooth permisyon</string>
    <string name="welcome_bluetooth_why">android-ta app ahagha bluetooth-yantra tyyllybyt tyusy, onon bluetooth khol hanara sabaryna billiyte. ylih-ta yumukchit ottajajayt machina taas ondollaabyt, aajy-taas ondollaabyt.</string>
    <string name="welcome_bluetooth_with">bayta: har bir yumukchit toguruu isiterge toguruhu sannabyt, baaryy sallataxyy kylla.</string>
    <string name="welcome_bluetooth_without">baytaha: bluetooth yumukchit kylla sannabyta. app-ta ootin-ootin uonna oiionnaah, sallataxyy aha android-ta app sallat aajybita.</string>
    <string name="welcome_notifications_title">annyy</string>
    <string name="welcome_notifications_why">mannyy treksing-ta kyshtaan sallata ispes-ispes, android-ta app annyy daa argyraat sallataxyy kiele.</string>
    <string name="welcome_notifications_with">bayta: annyy nyu sannabyt byt bahaabyn, mannyy treksing onn yaaskan killiine.</string>
    <string name="welcome_notifications_without">baytaha: mannyy treksing onn yaaskan killiine. android-ta annyy kylla koruosuokkun killiine.</string>
