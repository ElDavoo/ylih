    <string name="settings_tracking">rrijistru</string>
    <string name="settings_detailed_title">rrijistru ditilyadu</string>
    <string name="settings_detailed_body">ta adisioná kutulunan fiu no tempu di toka. android sómente ta komunika evéntu fiu ku alikasõis ta tha koréndu, ilo ta manti notifikasõ kuity na zona. bluetooth ta tha rrijistrádu kwálker manera.</string>
    <string name="settings_detailed_unavailable">nó ta disponívil até asésu bluetooth ta tha dadu: sta bersõ sómente ta deklarà tipu servisu connectedDevice, ke android 14+ ta atá ku lisénsa bluetooth.</string>
    <string name="settings_playback_only_title">kunta sómente toka</string>
    <string name="settings_playback_only_body">stadístika ta kunta tempu som ta tha toka realmente invéz di tempu konektádu. sómente sésõis rrijistrádu nason rrijistru ditilyadu ta mididu toka; restanti ta tha skalidu fora.</string>
    <string name="settings_language">língu</string>
    <string name="settings_language_system">língu di sistema</string>
    <string name="settings_devices">dispusitivus</string>
    <string name="settings_devices_body">marka off kwálker ki nó é kutulunan — som di kár ou falanti — pa stopa rrijistrándu.</string>
    <string name="settings_device_subtitle">%1$s · primeru vistu %2$s</string>
