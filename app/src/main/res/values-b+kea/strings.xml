    <string name="settings_export">eksportá json</string>
    <string name="settings_import">importá</string>
    <string name="settings_import_warning">importá ta troka tud ki ta tha armázenádu agora.</string>
    <string name="settings_troubleshooting">rezóbe próblema</string>
    <string name="settings_battery_body">se sésõis ta pa di sé rrijistrádu, verifikà ki ylih ta tha izentu di optimizasõ batéria — alikasõ ki ta forsa-paradádu nó ta risibí broadcast koneksõ atena até ta abrídu.</string>
    <string name="settings_battery_button">stinísi batéria</string>
    <string name="settings_battery_path">stinísi → alikasõis → ylih → batéria → sen limitasõ.</string>
    <string name="settings_hibernation_body">se ylih ta tha fexádu pá uns pukes, android ta pausá kile no ta tira lisénsa, no nada nó ta tha rrijistrádu até ku abri. dishligá ilay ta ke ta leva par ku kontinu ku kunta, dum tempu wé ta skési alikasõ.</string>
    <string name="settings_hibernation_on">android ta podi pausá ylih.</string>
    <string name="settings_hibernation_off">ylih ta izentu no ta konténúa rrijistrándu.</string>
    <string name="settings_hibernation_button">stinísi di alikasõis sen uzu</string>
    <string name="settings_about">sôbri</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — uras kutulunan, manti lokálenti no sempri.</string>
    <string name="settings_import_confirm_title">troka tud dádus?</string>
    <string name="settings_import_confirm_body">importá esta sálva ta supre kada dispusitivu, par no sésõ arkmazenádu agora.</string>

