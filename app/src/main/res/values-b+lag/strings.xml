    <string name="welcome_title">karibu kwenye ylih</string>
    <string name="welcome_intro">ylih inarekodi kwa muda gani kila jozi ya mipimo hubaki iliyounganishwa, ili hata miaka baadaye bado uweze kujibu swali moja tu linalohesabu kuhusu jozi: saa ngapi walidumu?</string>
    <string name="welcome_point_auto_title">unganisha na usisahau</string>
    <string name="welcome_point_auto_body">mipimo ya bluetooth inarekodwa yenyewe, kuanzia wakati wa kuunganisha. hakuna kitu kinachohitaji kuendelea.</string>
    <string name="welcome_point_lifetime_title">jozi moja, uhai mmoja</string>
    <string name="welcome_point_lifetime_body">Jozi kufa, karibia: jumla yake inaganda hapa na jozi inayofuata ya mipimo ile ile inaanza tena kutoka kwa sifuri.</string>
    <string name="welcome_point_detailed_title">wenye waya na uchezaji</string>
    <string name="welcome_point_detailed_body">ufuatiliaji wa kina katika mipangilio unajumlisha mipimo ya waya na kupima sehemu ipi ya muda uliyokuwa unacheza.</string>
    <string name="welcome_privacy">kila kitu kinabaki kwenye simu hii. hakuna akaunti, na programu haina ruhusa ya mtandao.</string>
    <string name="welcome_start">kuanza</string>
    <string name="welcome_next">inayofuata</string>
    <string name="welcome_allow">ruhusu</string>
    <string name="welcome_step">hatua %1$d ya %2$d</string>
    <string name="welcome_bluetooth_title">ushindi wa bluetooth</string>
    <string name="welcome_bluetooth_why">Android inajuza programu ni vile vile programu inayounganisha kwa bluetooth na kile kinachoitwa, ikiwa programu inabaki ushindi wa bluetooth. Ni jinsi ylih inayotoa jozi ya mipimo kutoka kwa stereo ya gari, na jinsi inayojua jozi moja kutoka kwa nyingine.</string>
    <string name="welcome_bluetooth_with">nayo: kila jozi inarekodwa kuanzia wakati wa kuunganisha, na hakuna kitu kinachohitaji kuendelea.</string>
    <string name="welcome_bluetooth_without">bila nayo: mipimo ya bluetooth haiarekodiwi kwa makini. sehemu nyingine ya programu bado inafanya kazi, na unaweza kuipa baadaye katika mipangilio ya programu ya Android.</string>
    <string name="welcome_notifications_title">arifa</string>
    <string name="welcome_notifications_why">ufuatiliaji wa kina unafanya huduma ndogo ya nyuma, na Android inahitaji programu yoyote inayofanya hivyo kuendelea na arifa inayoonekana huku inavyofanya.</string>
    <string name="welcome_notifications_with">nayo: arifa inaonyesha kile kinachorekodiwa sasa, ambalo ni dalili tu kwamba ufuatiliaji wa kina upo.</string>
    <string name="welcome_notifications_without">bila nayo: ufuatiliaji wa kina unaendelea kurekodi. Android tu hautatumia arifa yake.</string>
    <string name="hibernation_title">endelea kuhesabu wakati unakosahau</string>
    <string name="hibernation_body">Android inaacha programu ambazo hazifunguliwi kwa miezi michache na kurudisha ruhusa zake, ambayo ingeacha ylih isirekodiwe hata sifuri mpaka ufukazie. kusahauliwa ni kabisa sababu ya programu hii, kwa hivyo inastahili kuizima sasa.</string>
