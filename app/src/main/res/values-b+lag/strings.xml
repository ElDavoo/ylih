    <string name="settings_import_warning">kuingia kunabadilisha kila kitu kinachohifadhiwa sasa.</string>
    <string name="settings_troubleshooting">kusuluhisha matatizo</string>
    <string name="settings_battery_body">ikiwa kiwango kinaacha kurekodi, angalia kwamba ylih haipo na usiotheza chaji — programu iliyoacha kwa nguvu haipatikani arafa ya kuunganisha zaidi hata sifuri kuifungua.</string>
    <string name="settings_battery_button">mipangilio ya betri</string>
    <string name="settings_battery_path">mipangilio → programu → ylih → chaji → haziambatano.</string>
    <string name="settings_hibernation_body">ikiwa ylih inabaki haifunguliwi kwa miezi michache, Android inaacha na kurudisha ruhusa zake, na hakuna kitu kinachorekodiwa tena hadi ufukazie. kuizima ni jinsi jozi inayobaki kuhesabu wakati wa msimu hawakulikia programu.</string>
    <string name="settings_hibernation_on">Android inaweza kusimama ylih.</string>
    <string name="settings_hibernation_off">ylih ni huru na kurekodi.</string>
    <string name="settings_hibernation_button">mipangilio ya programu isiyotumiwa</string>
    <string name="settings_about">kuhusu</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — saa za mipimo, iliyohifadhiwa kwa ndani na kwa abadi.</string>
    <string name="settings_import_confirm_title">kubadilisha takwimu zote?</string>
    <string name="settings_import_confirm_body">kuingia kina hiki kuondoa kila kitu kinachohifadhiwa sasa.</string>

