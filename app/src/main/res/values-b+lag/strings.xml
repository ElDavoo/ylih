    <string name="settings_language_system">lugha ya mfumo</string>
    <string name="settings_devices">vifaa</string>
    <string name="settings_devices_body">sanidi kile kile ambacho si mipimo — stereo ya gari au spika — kusimamisha kurekodi.</string>
