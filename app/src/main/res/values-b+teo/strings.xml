    <string name="welcome_title">ejokuna ylih</string>
    <string name="welcome_intro">ylih egirakini ainapetait kere apesur naka isukulen kanu erubunete, kotoma ikaru luipu ijai jo abeit aboŋokin akiŋisianakin naerai adiakan naka apesur: kanu isawan aiŋai kekaŋin?</string>
    <string name="welcome_point_auto_title">rub kosi imuj</string>
    <string name="welcome_point_auto_body">isukulen luka bluetooth egirakinete kesi bon, kanuka apak na erubunete. mam ijai nu emwanar aitodolikin.</string>
    <string name="welcome_point_lifetime_title">apesur adiope, akiyar adiope</string>
    <string name="welcome_point_lifetime_body">ne emwanar apesur, itodoli: ipu keŋ ecodete kane kosi apesur nace naka isukulen luketoi kegeuni kanuka zero.</string>
    <string name="welcome_point_detailed_title">ewaya kosi aiperar</string>
    <string name="welcome_point_detailed_body">aiŋisianakin naepolot, kotoma aisisianakin, ekicoloŋi isukulen luka ewaya kosi epimaki ainapetait naka apak na eperarit alosit.</string>
    <string name="welcome_privacy">iboro kere ejaasi kotoma esimu lo. mam ijai akaunt, kosi mam eyauni app apuwan naka intaneti.</string>
    <string name="welcome_start">geun</string>
    <string name="welcome_next">nace</string>
    <string name="welcome_allow">iny</string>
    <string name="welcome_step">akitodol %1$d kanuka %2$d</string>
    <string name="welcome_bluetooth_title">aitodol naka bluetooth</string>
    <string name="welcome_bluetooth_why">android elimokini app ebe ainyo bluetooth erubunit, kosi ebe ainyo ekiror keŋ, ne eyauni app aitodol naka bluetooth. kanuka lo epedori ylih ajenun apesur naka isukulen kanuka eredio loka emotoka, kosi ajenun apesur adiope kanuka nace.</string>
    <string name="welcome_bluetooth_with">kosi ŋesi: apesur kere egirakini kanuka apak na erubunete, mam ijai nu etodolikinit kosi mam ijai nu emwanar aitodikin.</string>
    <string name="welcome_bluetooth_without">mam kosi ŋesi: mam ijai isukulen luka bluetooth luigirakinete. iboro luce luka app etiyakinete, kosi ipedori jo ainy kosodi kotoma aisisianakin naka app luka android.</string>
    <string name="welcome_notifications_title">aitodolikinet</string>
    <string name="welcome_notifications_why">aiŋisianakin naepolot etiyakini aswam nakidiit naka opoloit, kosi ecamit android app kere na etiyai ŋun aiyaun aitodolikinet naeitodolikinete kotoma apak ŋin.</string>
    <string name="welcome_notifications_with">kosi ŋesi: aitodolikinet eitodolikini nu egirakinete kolo, ŋesi bon aitodolikinet naka ebe ejai aiŋisianakin naepolot.</string>
    <string name="welcome_notifications_without">mam kosi ŋesi: aiŋisianakin naepolot etiyakini kosi egirakini bon. android mam bon eitodolikin aitodolikinet keŋ.</string>
    <string name="hibernation_title">etiaki aparasia ne imujari jo</string>
    <string name="hibernation_body">android ecodikini app lu mam eŋaleitai kotoma ilapio luce kosi eyauni apuwan kec, na ebeikini ylih mam agirakin ibore aŋai ne eŋalei jo kosodi. aimujarit ŋesi bon apolou naka app lo, kotoma ejok aitodoli ŋun kolo.</string>
