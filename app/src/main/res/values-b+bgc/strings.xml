    <!-- सेटिंग्स -->
    <string name="settings_tracking">ट्रैकिंग</string>
    <string name="settings_detailed_title">विस्तृत ट्रैकिंग</string>
    <string name="settings_detailed_body">तार वाले हेडफोन्स और प्लेबैक समय जोड़ता है। android केवल चलते ऐप को तार वाले प्लग इवेंट की रिपोर्ट करता है, इसलिए यह छाया में एक शांत सूचना रखता है। bluetooth किसी भी तरह से ट्रैक किया जाता है।</string>
    <string name="settings_detailed_unavailable">जब तक bluetooth एक्सेस नहीं दिया जाता तब तक उपलब्ध नहीं है: यह बिल्ड केवल connectedDevice सेवा प्रकार घोषित करता है, जिसे android 14+ एक bluetooth अनुमति से जोड़ता है।</string>
    <string name="settings_playback_only_title">बस प्लेबैक गिणो</string>
    <string name="settings_playback_only_body">आंकड़े जुड़े रहण के टेम की जगह ऑडियो असल म्ह चालण का टेम गिणै सै। बस वे सेशन जो विस्तृत ट्रैकिंग चालू होण पै रिकॉर्ड होए, उननै प्लेबैक नापी; बाकी छोड़ दिए जावै सै।</string>
    <string name="settings_language">भाषा</string>
    <string name="settings_language_system">सिस्टम की भाषा</string>
    <string name="settings_devices">डिवाइस</string>
    <string name="settings_devices_body">कुछ भी जो हेडफोन्स नहीं है—कार स्टीरियो या स्पीकर—को अनचेक करें ताकि इसे रिकॉर्ड करना बंद हो जाए।</string>
    <string name="settings_device_subtitle">%1$s · पहली बार %2$s को देखा गया</string>
    <string name="settings_data">डेटा</string>
    <string name="settings_export">json निर्यात करें</string>
    <string name="settings_import">आयात करें</string>
    <string name="settings_import_warning">आयात वर्तमान में संग्रहीत सब कुछ को बदल देता है।</string>
    <string name="settings_troubleshooting">समस्या निवारण</string>
    <string name="settings_battery_body">यदि सत्र रिकॉर्ड किए जाना बंद हो जाएं, तो जांचें कि ylih बैटरी अनुकूलन से छूट प्राप्त है—एक जबरन बंद किया गया ऐप तब तक कनेक्शन प्रसारण नहीं प्राप्त करता है जब तक इसे फिर से नहीं खोला जाता।</string>
    <string name="settings_battery_button">बैटरी सेटिंग्स</string>
    <string name="settings_battery_path">सेटिंग्स → ऐप्स → ylih → बैटरी → प्रतिबंधित नहीं।</string>
    <string name="settings_hibernation_body">जै ylih कई महीनां तक ना खोल्या जावै, तो android इसनै रोक देवै सै अर इसकी अनुमति वापस ले लेवै सै, अर जब तक थम इसनै ना खोलो, कुछ भी दुबारा रिकॉर्ड न्ही होवैगा। इसनै बंद करणा ए वो सै जो जोड़ी नै उस मौसम म्ह भी गिनती करदे रहण दे सै जिब्बे थम ऐप का सोचो ए न्ही।</string>
    <string name="settings_hibernation_on">android ylih नै रोक सकै सै।</string>
    <string name="settings_hibernation_off">ylih छूट म्ह सै अर रिकॉर्ड करदा रहवै सै।</string>
    <string name="settings_hibernation_button">बिना इस्तेमाल ऐप की सेटिंग्स</string>
    <string name="settings_about">के बारे में</string>
