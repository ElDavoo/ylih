    <string name="welcome_title">murakaze kuri ylih</string>
    <string name="welcome_intro">ylih irikora igihe icyo inyanda zose zifitanye ahubwo, kugira ngo mu mwaka ubwambara wongera kwibuza ibibazo bimwe gusa: saa zingahe zahasize?</string>
    <string name="welcome_point_auto_title">fushe kandi wireke</string>
    <string name="welcome_point_auto_body">inyanda ya bluetooth zimikora kwaricwa igihe cyo kufitanya. nta kintu kigomba kuva gihora.</string>
    <string name="welcome_point_lifetime_title">inzira imwe, ubwami bwimwe</string>
    <string name="welcome_point_lifetime_body">iyo inzira irapfakire, ifatanije: igice cyayo kirazama kuri aho kandi inzira nshya ya inyanda nzira yumunsi zacyatangira.</string>
    <string name="welcome_point_detailed_title">ugufi kandi guceca</string>
    <string name="welcome_point_detailed_body">kurikira no mu mahoro, mu igenga, onje inyanda zugufi kandi gupima igihe cyose gari gari.</string>
    <string name="welcome_privacy">ikintu cyose kirahita mu telefoni iyi. ntagenwe ni konti, kandi gusenya ntiwumvu internet.</string>
    <string name="welcome_start">tangira</string>
    <string name="welcome_next">ikibazo kiriya</string>
    <string name="welcome_allow">emeza</string>
    <string name="welcome_step">urwego %1$d kuri %2$d</string>
    <string name="welcome_bluetooth_title">ubwumvire bwa bluetooth</string>
    <string name="welcome_bluetooth_why">android igera kuri gusenya inyaburuko iyhe ya bluetooth ifitanye, kandi inzira yayo, niba gusenya ari na ubwumvire bwa bluetooth. niyo ndyo ylih ihitamo inzira y\'inyanda kuva mu mugambi w\'umwanya.</string>
    <string name="welcome_bluetooth_with">hamwe niyo: inzira zose zimikora icyambat cyo kufitanya, nta kintu kigomba kuva gihora.</string>
    <string name="welcome_bluetooth_without">utarimo: nta nyanda ya bluetooth zimikora. ibindi bya gusenya biracyakora, kandi urashobora gutanga kinyarwanda mu igenga ry\'android.</string>
    <string name="welcome_notifications_title">abimenyetso</string>
    <string name="welcome_notifications_why">kurikira no mu mahoro niguo serivisi nto mu mwanya, kandi android isaba kuri gusenya kigomba kurinda abimenyetso bivugwa.</string>
    <string name="welcome_notifications_with">hamwe niyo: abimenyetso byerekeza ikintu cyose gikora, niyo ntyo ishyaka ry\'ikuri no mu mahoro rihama.</string>
    <string name="welcome_notifications_without">utarimo: kurikira no mu mahoro biracyakora kandi birikora. android idategura abimenyetso.</string>
    <string name="hibernation_title">komeza kubara mugihe wese wireky</string>
    <string name="hibernation_body">android irumva gusenya ntifungukwa mu nyungu kandi ifata impushya, ikintu cyo gusenya ylih ntigerekwa kugeza iyo kigurwa. kuva guhagururwa ni ikintu iyo gusenya ikubwira, kuburyo harya bigize inzira.</string>
