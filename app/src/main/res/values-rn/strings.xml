    <string name="settings_import_warning">kwinjiza bikunashyiramo ikintu cyose kimenyeshwa.</string>
    <string name="settings_troubleshooting">gukumira ibibazo</string>
    <string name="settings_battery_body">niba isiganiro nterimikora, rerekana ko ylih itari mu mibare y\'amavuta - gusenya rifatwe ntiyubwayo impushya kugeza iyo gigurwa.</string>
    <string name="settings_battery_button">igenga ry\'amavuta</string>
    <string name="settings_battery_path">igenga → gusenya → ylih → amavuta → utarimo umuperi.</string>
    <string name="settings_hibernation_body">niba ylih ntifungukwa mu nyungu, android irumva kandi ifata impushya, nta kintu kimikora kugeza iyo kigurwa. kunga iyo ikintu kigira ko inzira ikomeza kubara mu myaka iyo wese ntacyumva gusenya.</string>
    <string name="settings_hibernation_on">android irashobora kunyina ylih.</string>
    <string name="settings_hibernation_off">ylih irashyira kandi ikomeza kubara.</string>
    <string name="settings_hibernation_button">igenga ry\'ubwiyunge ntaburengeri</string>
    <string name="settings_about">kubyerekeranye</string>
    <string name="settings_about_body">ylih %1$s (%2$s) - amasaha y\'inyanda, akavulwa cyangwa utarimo.</string>
    <string name="settings_import_confirm_title">shyira amakuru yose aho?</string>
    <string name="settings_import_confirm_body">kwinjiza iyi vuriro sibuje inyaburuko, inzira kandi isiganiro rimenyeshwa.</string>

