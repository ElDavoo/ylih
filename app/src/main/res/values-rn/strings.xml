    <string name="settings_tracking">kurikira</string>
    <string name="settings_detailed_title">kurikira no mu mahoro</string>
    <string name="settings_detailed_body">onje inyanda zugufi kandi igihe cyamwiceka. android igera mu nyanda zugufi kuri gusenya gikora gusa, kuburyo igira imenyetso nto mu mahoro. bluetooth irikora iyo aricyo arihe.</string>
    <string name="settings_detailed_unavailable">ntihabwa kugeza ubwumvire bwa bluetooth budatanzwe: iri banki rigucira ubwumvire bwa connectedDevice, ikintu android 14+ iguhuza ku bwumvire bwa bluetooth.</string>
    <string name="settings_playback_only_title">kubara amwiceka gusa</string>
    <string name="settings_playback_only_body">ibaruhuuko bayubara igihe cyamwiceka aho cyo gufitanya. isiganiro rimenyeshwa hamwe na kurikira no mu mahoro yibwabukishije amwiceka gusa; ibindi bipwibwa.</string>
