    <string name="pair_retire_supporting">підсумки зупиняються тут. повторне підключення того самого пристрою починає нову пару з нуля.</string>
    <string name="pair_price_title">сплачена ціна</string>
    <string name="pair_price_label">сума (цілі одиниці)</string>
