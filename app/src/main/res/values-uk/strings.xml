<?xml version="1.0" encoding="utf-8"?>
<!--
  Ukrainian. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources>
    <string name="app_title">ylih - твоє життя в навушниках</string>

    <!-- Нижня навігація -->
    <string name="nav_headphones">навушники</string>
    <string name="nav_stats">статистика</string>
    <string name="nav_settings">налаштування</string>

    <!-- Типи пристроїв -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">дротові</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">невідомо</string>

    <!-- Перший запуск -->
    <string name="welcome_title">ласкаво просимо до ylih</string>
    <string name="welcome_intro">ylih записує, скільки часу кожна пара навушників залишається підключеною, щоб через роки ти й далі міг відповісти на єдине важливе питання про пару навушників: скільки годин вони протримались?</string>
    <string name="welcome_point_auto_title">підключи і забудь</string>
    <string name="welcome_point_auto_body">bluetooth-навушники записуються самі, з моменту підключення. нічого не потрібно тримати запущеним.</string>
    <string name="welcome_point_lifetime_title">одна пара, один термін служби</string>
    <string name="welcome_point_lifetime_body">коли пара виходить з ладу, спиши її: її підсумок зупиняється, а наступна пара тих самих навушників починає відлік з нуля.</string>
    <string name="welcome_point_detailed_title">дріт і відтворення</string>
    <string name="welcome_point_detailed_body">детальне відстеження, у налаштуваннях, додає дротові навушники та вимірює, скільки з цього часу справді відтворювався звук.</string>
    <string name="welcome_privacy">усе залишається на цьому телефоні. немає жодного облікового запису, і застосунок не має дозволу на інтернет.</string>
    <string name="welcome_start">почати</string>
    <string name="welcome_next">далі</string>
    <string name="welcome_allow">дозволити</string>
    <string name="welcome_step">крок %1$d з %2$d</string>
    <string name="welcome_bluetooth_title">доступ до bluetooth</string>
    <string name="welcome_bluetooth_why">android повідомляє застосунку, який пристрій bluetooth підключився і як він називається, лише якщо застосунок має доступ до bluetooth. саме так ylih відрізняє навушники від автомагнітоли, а одну пару від іншої.</string>
    <string name="welcome_bluetooth_with">з доступом: кожна пара записується з миті підключення, без нічого запущеного і без потреби щось натискати.</string>
    <string name="welcome_bluetooth_without">без доступу: жодні навушники bluetooth не записуються. решта застосунку працює, а доступ можна надати пізніше в налаштуваннях застосунків android.</string>
    <string name="welcome_notifications_title">сповіщення</string>
    <string name="welcome_notifications_why">детальне відстеження запускає невелику фонову службу, і android вимагає від будь-якого застосунку, що так робить, тримати сповіщення видимим.</string>
    <string name="welcome_notifications_with">з дозволом: сповіщення показує, що записується просто зараз, і це єдина ознака того, що детальне відстеження живе.</string>
    <string name="welcome_notifications_without">без дозволу: детальне відстеження все одно працює і все одно записує. android просто не показуватиме його сповіщення.</string>
    <string name="hibernation_title">рахуй далі, навіть коли забудеш про нього</string>
    <string name="hibernation_body">android зупиняє застосунки, які не відкривали кілька місяців, і забирає їхні дозволи, через що ylih нічого не записуватиме, поки ти не відкриєш його знову. бути забутим — це саме те, для чого існує цей застосунок, тож варто вимкнути це просто зараз.</string>
    <string name="action_not_now">не зараз</string>

    <!-- Список навушників -->
    <string name="devices_in_use">використовується</string>
    <string name="devices_retired">списані</string>
    <string name="devices_empty_title">поки що немає навушників</string>
    <string name="devices_empty_body">підключи пару bluetooth-навушників, і вони з\'являться тут. для дротових навушників потрібне детальне відстеження, у налаштуваннях.</string>
