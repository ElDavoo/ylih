    <!-- Налаштування -->
    <string name="settings_tracking">відстеження</string>
    <string name="settings_detailed_title">детальне відстеження</string>
    <string name="settings_detailed_body">додає дротові навушники та час відтворення. android повідомляє про підключення дротового роз\'єму лише запущеному застосунку, тож у шторці залишається тихе сповіщення. bluetooth відстежується у будь-якому разі.</string>
    <string name="settings_detailed_unavailable">недоступно, доки не надано доступ до bluetooth: ця збірка оголошує лише тип служби connectedDevice, який android 14+ прив\'язує до дозволу bluetooth.</string>
    <string name="settings_playback_only_title">рахувати лише відтворення</string>
    <string name="settings_playback_only_body">статистика рахує час, коли звук справді грав, а не час підключення. відтворення виміряли лише сеанси, записані з увімкненим детальним відстеженням; решта не враховується.</string>
    <string name="settings_language">мова</string>
    <string name="settings_language_system">мова системи</string>
    <string name="settings_devices">пристрої</string>
    <string name="settings_devices_body">зніми позначку з усього, що не є навушниками — автомагнітоли чи колонки, — щоб припинити це записувати.</string>
    <string name="settings_device_subtitle">%1$s · вперше побачено %2$s</string>
    <string name="settings_data">дані</string>
    <string name="settings_export">експортувати json</string>
    <string name="settings_import">імпортувати</string>
    <string name="settings_import_warning">імпорт замінює все, що зараз збережено.</string>
    <string name="settings_troubleshooting">усунення несправностей</string>
    <string name="settings_battery_body">якщо сесії перестали записуватися, перевір, що ylih звільнено від оптимізації акумулятора — примусово зупинений застосунок більше не отримує сповіщень про з\'єднання, доки його не відкриють знову.</string>
    <string name="settings_battery_button">налаштування акумулятора</string>
    <string name="settings_battery_path">налаштування → застосунки → ylih → акумулятор → без обмежень.</string>
    <string name="settings_hibernation_body">якщо ylih не відкривати кілька місяців, android зупиняє його і забирає його дозволи, і нічого не записується знову, доки ти його не відкриєш. вимкнення цього дає змогу парі рахуватися далі навіть у сезон, коли ти взагалі не думаєш про застосунок.</string>
    <string name="settings_hibernation_on">android може зупинити ylih.</string>
    <string name="settings_hibernation_off">ylih звільнено від обмежень і він продовжує запис.</string>
    <string name="settings_hibernation_button">налаштування невикористовуваних застосунків</string>
    <string name="settings_about">про застосунок</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — години в навушниках, збережені локально й назавжди.</string>
    <string name="settings_import_confirm_title">замінити всі дані?</string>
    <string name="settings_import_confirm_body">імпорт цієї резервної копії видалить кожен пристрій, пару й сесію, збережені зараз.</string>
    <string name="widget_lifetime_label">ylih · напрацювання</string>
    <string name="widget_lifetime_description">години на кожну пару та живий таймер на підключеній</string>
    <string name="widget_activity_label">ylih · активність</string>
    <string name="widget_activity_description">години всіх пар разом, а також сьогодні, 7 днів і 30 днів</string>
    <string name="widget_chart_label">ylih · 30 днів</string>
    <string name="widget_chart_description">щоденні години прослуховування за останні 30 днів</string>

