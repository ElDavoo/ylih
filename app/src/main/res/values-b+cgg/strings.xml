    <string name="settings_tracking">okuwandika</string>
    <string name="settings_detailed_title">okuwandika okukweru</string>
    <string name="settings_detailed_body">akongeza mahembe agacwire n\'amasigara ga okusigira. android abamanya okumanya amasigara ga agacwire kuko ku applicesheni itazikira okukora, abasigalira okukuba okukwereza mu ntiniti. bluetooth andikibwa kigwe.</string>
    <string name="settings_detailed_unavailable">ntakiboneka kuza kwoha ichaato ca bluetooth: akakakona guno kasigala kananga connectDevice ekika kya service, ekyuma ka android 14+ ekikwata ku ichaato ca bluetooth.</string>
    <string name="settings_playback_only_title">bara okusigira kwonka</string>
    <string name="settings_playback_only_body">ebibaruzo nibibara obwire amaraka gaabaire nigasigirwa buzima, ti obwire bw\'okwehanguraho. sesyoni ezaandiikirwe okuwandika okukweru kuriho zonka nizo zaapimire okusigira; ezindi nizirekwa.</string>
    <string name="settings_language">orurimi</string>
    <string name="settings_language_system">orurimi rwa sisitemu</string>
    <string name="settings_devices">ekyuma</string>
    <string name="settings_devices_body">tangura ekyuma ekitali mahembe — emotoka oba espeekeri — kwonka okukumaniza okuwandika.</string>
    <string name="settings_device_subtitle">%1$s · okwambuka okukora %2$s</string>
    <string name="settings_data">amakumbi</string>
    <string name="settings_export">kukyata json</string>
    <string name="settings_import">okushyira</string>
    <string name="settings_import_warning">okushyira kubabyiza byona ekakumaniza nkano.</string>
    <string name="settings_troubleshooting">okurindaganya okutagasima</string>
    <string name="settings_battery_body">nkoba okussozo taandikibwa, tekeza atiyini ylih antakwere nka ekikumaaniza — applicesheni eyafirize yaayagirwe tategembana okuwandika kuza ekikwata aba ntakwengereza okwacumbura ichaato.</string>
    <string name="settings_battery_button">amateekate ga batireeri</string>
    <string name="settings_battery_path">amateekate → applicesheni → ylih → batireeri → etakyamibaza.</string>
    <string name="settings_hibernation_body">ylih yaataijukurwe emyezi mingi, android neegihi n\'okugihakwo ichaato zaayo, kandi tikirimu kubara kintu kihi kutungatunga oshoboole kwiguza. gabana kinu ngu applicesheni ecomorre kubara n\'omu mwanya ogu otaijukira applicesheni egi.</string>
    <string name="settings_hibernation_on">android nibaasa gabana ylih.</string>
    <string name="settings_hibernation_off">ylih tigabaine — neegukomeza kubara.</string>
    <string name="settings_hibernation_button">amateekate g\'applicesheni ezitakuguzirwe</string>
    <string name="settings_about">ku ka egi</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — saati mu mahembe, ekuuma locally n\'inini.</string>
    <string name="settings_import_confirm_title">babyiza byona?</string>
    <string name="settings_import_confirm_body">okushyira oku ka gakuba gubabyiza ekyuma, enandi n\'okussozo kusosere kose kusigala nkano.</string>
