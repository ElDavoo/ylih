    <string name="welcome_title">ylih मे स्वागत</string>
    <string name="welcome_intro">ylih रिकॉर्ड करे कि कैसे हरेक जोड़ी हेडफुन जुड़ी रहेत, तो बरसु आगे तुमु अभी वो एक सवाल जवाब दे सकु: कितनु घंटे तक यह चल्लु?</string>
    <string name="welcome_point_auto_title">जुड़ु अने भुलु</string>
    <string name="welcome_point_auto_body">ब्लूटुथ हेडफुन अपने आप से रिकॉर्ड होतु, जब ये जुड़तु। कुछ भी नहीं रखनु पड़तु।</string>
    <string name="welcome_point_lifetime_title">एक जोड़ी, एक जीवन</string>
    <string name="welcome_point_lifetime_body">जब एक जोड़ी खराब होतु, तो इसु सेवनिवृत्त करु: इसका कुल यहाँ जम जातु अने अगली जोड़ी फिरु से शुरु होतु।</string>
    <string name="welcome_point_detailed_title">तारदार अने चलचित्र</string>
    <string name="welcome_point_detailed_body">विस्तृत ट्रैकिंग, सेटिंगस मे, तारदार हेडफुन जोडु अने नापु कि कितनु समय चल्लु।</string>
    <string name="welcome_privacy">सब कुछ इस फोन मे रहतु। कोई खाता नहीं, अने ऐप को इंटरनेट कि अनुमति नहीं।</string>
    <string name="welcome_start">शुरु करु</string>
    <string name="welcome_next">अगला</string>
    <string name="welcome_allow">अनुमति दु</string>
    <string name="welcome_step">चरण %1$d का %2$d</string>
    <string name="welcome_bluetooth_title">ब्लूटुथ पहुंच</string>
    <string name="welcome_bluetooth_why">एंड्रॉयड ऐप को सिर्फ बताता है कि कौन सा ब्लूटुथ डिवाइस जुड़ा, अगर ऐप ब्लूटुथ पहुंच रखु। यह है कि ylih कैसे हेडफुन को कार स्टीरियो से अलग करु।</string>
    <string name="welcome_bluetooth_with">इसके साथ: हरेक जोड़ी रिकॉर्ड होतु जब जुड़तु, कोई चल नहीं।</string>
    <string name="welcome_bluetooth_without">इसके बिना: कोई ब्लूटुथ हेडफुन रिकॉर्ड नहीं होतु। ऐप अभी काम करु, अने तुमु बाद मे अनुमति दे सकु।</string>
    <string name="welcome_notifications_title">सूचनाए</string>
    <string name="welcome_notifications_why">विस्तृत ट्रैकिंग एक छोटु पृष्ठभूमि सेवा चलाता है, अने एंड्रॉयड चाहता है कि कोई भी ऐप सूचना दिखाए।</string>
    <string name="welcome_notifications_with">इसके साथ: सूचना दिखातु है कि अभी क्या रिकॉर्ड हो रहु है।</string>
    <string name="welcome_notifications_without">इसके बिना: विस्तृत ट्रैकिंग अभी चलतु है। एंड्रॉयड सिर्फ सूचना नहीं दिखातु।</string>
    <string name="hibernation_title">गिनने वाले रहु जब भुल जाओ</string>
    <string name="hibernation_body">एंड्रॉयड ऐप को रोक देता है अगर महीनु नहीं खोलु, अने अनुमति लेता है। ylih कुछ रिकॉर्ड नहीं करु जब तक तुमु फिरु से खोलो। यह ऐप के लिए ही है।</string>
