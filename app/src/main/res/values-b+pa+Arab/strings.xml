    <string name="settings_devices">ڈیوائس</string>
    <string name="settings_devices_body">جیہڑا وی ہیڈفون نہیں اے — کار دا سٹیریو یا سپیکر — اوہنوں درج ہون توں روکن لئی نشان ہٹاؤ۔</string>
