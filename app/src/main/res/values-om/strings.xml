    <string name="settings_battery_button">qindaaʼina baatirii</string>
    <string name="settings_battery_path">qindaaʼina → appii → ylih → baatirii → daangaa hin qabu.</string>
    <string name="settings_hibernation_body">yoo ylih jiʼoota muraasaaf hin banamne, android ni dhaaba, hayyama isaas deebisee fudhata, hanga ati bantutti wanti tokkoyyuu hin galmaaʼu. kana dhaamsuun cimdiin tokko yeroo ati waaʼee appii yaadu dhabdu guutuu keessa lakkaaʼuu akka itti fufu godha.</string>
    <string name="settings_hibernation_on">android ylih dhaabuu dandaʼa.</string>
    <string name="settings_hibernation_off">ylih bilisa taʼeera, galmeessuus itti fufa.</string>
    <string name="settings_hibernation_button">qindaaʼina appii hin fayyadamne</string>
