    <string name="welcome_bluetooth_title">bluetooth licenseesi</string>
    <string name="welcome_bluetooth_why">android application gafii device bluetooth maal jedhamu sana, akkuma akka jedhamu taʼuu dha device bluetooth hidhaa yoo qabate. akka ylih mataa iraa tokko fi tuulo yeroo gara gara beekuu, akkasumas mataa iraa tokko biraa.</string>
    <string name="welcome_bluetooth_with">waliin: mataa iraa tokko tokko yeroo hidhamu jalqabee, wanti kamuu hidhaa keessatti hataalluu fi wanti kamuu yaadachuu hin barbaadu.</string>
    <string name="welcome_bluetooth_without">akkasiin utuu: mataa iraa bluetooth hidhaa hin taʼu. app keenyaa hunda ho hojjeta, akkasumas akka booda android app qabiyyee keessatti hayyuu dandeessa.</string>
    <string name="welcome_notifications_title">notifications</string>
    <string name="welcome_notifications_why">hidhaa balʼaa tajaajila duubura xixinnaa taasisa, android app kamuu yeroo isii wanta sana taasisu kanaafuu notification ijaarsa.</string>
    <string name="welcome_notifications_with">waliin: notification amma hidhaa taʼu kam taʼetti argisisa, kunis hidhaa balʼaa jira jedhu malaa tokko.</string>
    <string name="welcome_notifications_without">akkasiin utuu: hidhaa balʼaa taasisa keessa taasisa. android sana notification itti hin bongesu.</string>
    <string name="hibernation_title">jidhaa lakkaa yoo ilaalatte keessatti</string>
    <string name="hibernation_body">android applications yeroo fogaasaa hidhaa hin taʼan kaasisa license isaa deddeebii, kunis ylih wanti kamuu hidhaa hin taʼuu hanga yeroo dandeessite jalqaba. ilaalatta isii hanqina akka app kana taʼa, kanaafuu amma galchuu jetta.</string>
