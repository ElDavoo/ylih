    <string name="settings_detailed_title">detailed tracking</string>
    <string name="settings_detailed_body">hedfoonii sararaa fi yeroo taphachuu dabala. android taʼuu sararaa appii hojjetu qofaaf gabaasa, kanaaf kun beeksisa calʼisaa tokko qaba. bluetooth haala kamiinuu ni hordofama.</string>
