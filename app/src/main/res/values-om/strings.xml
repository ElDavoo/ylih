    <string name="welcome_title">akka ylih wajjin gara</string>
    <string name="welcome_intro">ylih yeroo mataa iraa tokko tokko walitti hidhamiinsa jidhaa, kanaafuu wagga dhufaa keessatti gaaffi beek qabu jedhu ajajaa: saaa meeqa turan?</string>
    <string name="welcome_point_auto_title">hidhaa fi dhiiseeffadhu</string>
    <string name="welcome_point_auto_body">mataa iraa bluetooth ofuma hidhaa ta\'u, yeroo walitti hidu jalqabee. wanti kamuu hidhaa keessatti hataalluu.</string>
    <string name="welcome_point_lifetime_title">mataa iraa tokko, umrii tokko</string>
    <string name="welcome_point_lifetime_body">mataa iraa tokko duʼu, of ilaallaa: baay\'ina isaa cufa jalqaba mataa iraa biro yeroo hunda jalqaba zeero irraa.</string>
    <string name="welcome_point_detailed_title">wired fi dheggarsa</string>
    <string name="welcome_point_detailed_body">hidhaa bal\'aa, qabiyyee keessatti, mataa iraa wired dabalee seensa yeroo haala dhugoo ta\'etti jidhaa.</string>
    <string name="welcome_privacy">wanti hundi foon kee irra hafa. herrega hinqabu, app internet licenseesi hinqabu.</string>
    <string name="welcome_start">jalqaba</string>
    <string name="welcome_next">ittaanu</string>
    <string name="welcome_allow">hayyuu</string>
    <string name="welcome_step">tarkaanfi %1$d %2$d keessatti</string>
    <string name="welcome_bluetooth_title">bluetooth licenseesi</string>
    <string name="welcome_bluetooth_why">android application gafii device bluetooth maal jedhamu sana, akkuma akka jedhamu ta\'uu dha device bluetooth hidhaa yoo qabate. akka ylih mataa iraa tokko fi tuulo yeroo gara gara beekuu, akkasumas mataa iraa tokko biraa.</string>
    <string name="welcome_bluetooth_with">waliin: mataa iraa tokko tokko yeroo hidhamu jalqabee, wanti kamuu hidhaa keessatti hataalluu fi wanti kamuu yaadachuu hin barbaadu.</string>
    <string name="welcome_bluetooth_without">akkasiin utuu: mataa iraa bluetooth hidhaa hin ta\'u. app keenyaa hunda ho hojjeta, akkasumas akka booda android app qabiyyee keessatti hayyuu dandeessa.</string>
    <string name="welcome_notifications_title">notifications</string>
    <string name="welcome_notifications_why">hidhaa bal\'aa tajaajila duubura xixinnaa taasisa, android app kamuu yeroo isii wanta sana taasisu kanaafuu notification ijaarsa.</string>
    <string name="welcome_notifications_with">waliin: notification amma hidhaa ta\'u kam ta\'etti argisisa, kunis hidhaa bal\'aa jira jedhu malaa tokko.</string>
    <string name="welcome_notifications_without">akkasiin utuu: hidhaa bal\'aa taasisa keessa taasisa. android sana notification itti hin bongesu.</string>
    <string name="hibernation_title">jidhaa lakkaa yoo ilaalatte keessatti</string>
    <string name="hibernation_body">android applications yeroo fogaasaa hidhaa hin ta\'an kaasisa license isaa deddeebii, kunis ylih wanti kamuu hidhaa hin ta\'uu hanga yeroo dandeessite jalqaba. ilaalatta isii hanqina akka app kana ta\'a, kanaafuu amma galchuu jetta.</string>
