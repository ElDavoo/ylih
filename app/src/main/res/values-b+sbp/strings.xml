    <string name="welcome_title">mukunga ku-ylih</string>
    <string name="welcome_intro">ylih ikasava ngani amagabwa agaale amakw’ingusi amee, kwa kusu amiaka mibila mnene mungi ntiti ungie kwisa - amagabwa agaale akagumikire saa ngani?</string>
    <string name="welcome_point_auto_title">kuongesha andu kubililia</string>
    <string name="welcome_point_auto_body">amagabwa ga-bluetooth agakasava mwenyewe, kusukuma agasumbana. ndinapaswa kuacha nono wakati mmofu.</string>
    <string name="welcome_point_lifetime_title">amagabwa agaale moja, igabw moja</string>
    <string name="welcome_point_lifetime_body">amagabwa agaale akikufa, kushangalia - amakw’ingusi agasimama hapo andu amagabwa mapya ya-bluetooth nayo yajua mwanzo nene.</string>
    <string name="welcome_point_detailed_title">amaleni na amakoya</string>
    <string name="welcome_point_detailed_body">kusava kwa anzia, isuusu-ni, amaleni amagabwa nandu amakoya agakabililia saa ngani ikiaga amakaw.</string>
    <string name="welcome_privacy">kusava kwote kwalwe simu- iyi. hakuna akaunti, andu app haina internet wao.</string>
    <string name="welcome_start">jua jua</string>
    <string name="welcome_next">shukulieni</string>
    <string name="welcome_allow">kumkubali</string>
    <string name="welcome_step">kilo %1$d kwa %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth wanakuwezesha</string>
    <string name="welcome_bluetooth_why">android ndiimanya app ya amagabwa-bluetooth agasumbana, ifikiri lineno, ikiwa app ina bluetooth wanakuwezesha. ylih ndi mara ya kukasunga amagabwa kwa chargers, andu mara ya kukasunga agaale agakufa moja kwa moja.</string>
    <string name="welcome_bluetooth_with">kwa muiyya: amagabwa agaale agaasava mwenyewe kusukuma agasumbana, hakuna kuweka wakati isuusu.</string>
    <string name="welcome_bluetooth_without">bila iyi: amagabwa ga-bluetooth haina kusava. app ndia yoste ikilikwa, andu ungie kumkubali nere mu-android-asya app isuusu.</string>
    <string name="welcome_notifications_title">amakubililia</string>
    <string name="welcome_notifications_why">kusava kwa anzia igana gakagana nyakazi - android indarike app yoyote kusangira amakubililia agaale wakati igana ikagana.</string>
    <string name="welcome_notifications_with">kwa muiyya: amakubililia yagakamanya nkamwa ikasava nda, igana ndiikagana amandike.</string>
    <string name="welcome_notifications_without">bila iyi: igana ikagana nda. android nditakapia amakubililia.</string>
    <string name="hibernation_title">kuacha kumona wakati usumbufu</string>
    <string name="hibernation_body">android ikakapia app ifupi miezi-ne andu ikatambua wanakuwezesha nayo, ylih-asya app haina kusava wakati itabuye. app iyi ndi kwa hili, jua kwamba kilo iyi ni maamuzi nzuri.</string>
