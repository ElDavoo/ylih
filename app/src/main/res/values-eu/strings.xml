    <!-- Ezarpenak -->
    <string name="settings_tracking">zenbaketa</string>
    <string name="settings_detailed_title">zenbaketa zehatza</string>
    <string name="settings_detailed_body">entzule kableak eta erreprodukzio denbora gehitzen ditu. android-ek kable plug gertaerak abian dagoen aplikazio bati soilik jakinarazten dizkio, beraz notifikazio isioa atmospferan geratzen da. bluetooth beti zenbatzen da.</string>
    <string name="settings_detailed_unavailable">disponible ez dela bitartean bluetooth sarbidea baimendu arte: eraikian hau connectedDevice zerbitzuaren mota bakarrik deklaratzen du, android 14+ bluetooth baimena lekutzen duena.</string>
    <string name="settings_playback_only_title">zenbatu erreprodukzioa bakarrik</string>
    <string name="settings_playback_only_body">estatistikek audioa benetan erreproduzitzen egon den denbora zenbatzen dute, konektatuta egon den denboraren ordez. zenbaketa zehatza piztuta zegoela grabatutako saioek bakarrik neurtu zuten erreprodukzioa; gainerakoak kanpoan geratzen dira.</string>
    <string name="settings_language">hizkuntza</string>
    <string name="settings_language_system">sistemaren hizkuntza</string>
    <string name="settings_devices">gailuak</string>
    <string name="settings_devices_body">kendu markak gauzak ez direnak entzuleak — auto estereo edo bozgorailuak — grabatzea gelditzeko.</string>
    <string name="settings_device_subtitle">%1$s · lehenengo aldiz ikusia %2$s</string>
    <string name="settings_data">datuak</string>
    <string name="settings_export">export json</string>
    <string name="settings_import">importatu</string>
    <string name="settings_import_warning">inportazioak gaur egun gordeta dagoen guztia ordezkatzen du.</string>
    <string name="settings_troubleshooting">arazoak konpontzea</string>
    <string name="settings_battery_body">saio zenbaketa gelditzen bada, ziurtatu ylih bateria optimizaziotik kanpo dagoela — beherra geldia aplikazio batek ez du konexio emisioak jaso berriro konexio irekitzen den arte.</string>
    <string name="settings_battery_button">bateria ezarpenak</string>
    <string name="settings_battery_path">ezarpenak → aplikazioak → ylih → bateria → mugagabea.</string>
    <string name="settings_hibernation_body">ylih hilabete batzuetan irekitzen ez bada, androidek pausatu eta baimenak kentzen dizkio, eta ez da ezer grabatzen ireki arte. hori desaktibatzeak uzten dio entzungailu pare bati kontatzen jarraitzen aplikazioan inoiz pentsatzen ez duzun garai batean.</string>
    <string name="settings_hibernation_on">androidek ylih pausatu dezake.</string>
    <string name="settings_hibernation_off">ylih salbuetsita dago eta grabatzen jarraitzen du.</string>
    <string name="settings_hibernation_button">erabili gabeko aplikazioen ezarpenak</string>
    <string name="settings_about">honi buruz</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — entzuleak ordutan, tokian eta beti zeratzen.</string>
    <string name="settings_import_confirm_title">datu guztiak ordeztu?</string>
    <string name="settings_import_confirm_body">backup honen inportazioak gaur egun gordetako gailu, pare eta saio bakoitza ezabatzen du.</string>

