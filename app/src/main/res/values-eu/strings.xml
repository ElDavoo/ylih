    <!-- Gailu motak -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">kableak</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">ezezaguna</string>

    <!-- Lehenengo abioa -->
    <string name="welcome_title">ongi etorri ylih-ra</string>
    <string name="welcome_intro">ylih-ek entzulearen pare bakoitza zenbat denbora lotuta egoten den zenbatzen du, denbora aste batzuetan, entzuleren pare baten inguruko galdera garrantzitsuena erantzun ahal izateko: zenbat ordu iraun zituzten?</string>
    <string name="welcome_point_auto_title">konektatu eta ahaztu</string>
    <string name="welcome_point_auto_body">bluetooth entzuleak automatikoki zenbatzen dira, konektatu ordutik. ez da ezer abian mantendu beharrik.</string>
    <string name="welcome_point_lifetime_title">pare bat, bizi bat</string>
    <string name="welcome_point_lifetime_body">pare bat hondatzen denean, jubilatua: totala bertan izoztu eta beste pare baten konexio berriak zero-tik hasten da.</string>
    <string name="welcome_point_detailed_title">kableak eta erreprodukzioa</string>
    <string name="welcome_point_detailed_body">zenbaketa zehatza, ezarpenetan, entzule kableak gehitzen ditu eta zenbat denbora erreprodukzio egon den neurtzen du.</string>
    <string name="welcome_privacy">denak telefono honetan geratzen dira. ez da kontua, eta aplikazioak ez du interneterako baimenik.</string>
    <string name="welcome_start">hasi</string>
    <string name="hibernation_title">kontatzen jarraitzen du zuk ahaztu bitartean</string>
    <string name="hibernation_body">androidek hilabete batzuetan irekitzen ez diren aplikazioak pausatu eta baimenak kentzen dizkie, eta horrek ylih ezer grabatu gabe utziko luke hurrengoz ireki arte. ahaztua izatea da hain zuzen ere aplikazio honen zeregina, beraz merezi du hori orain desaktibatzea.</string>
    <string name="action_not_now">orain ez</string>

