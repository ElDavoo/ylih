    <string name="settings_tracking">[luy] tracking</string>
    <string name="settings_detailed_title">[luy] detailed tracking</string>
    <string name="settings_detailed_body">[luy] adds wired headphones and playback time. android only reports wired plug events to a running app, so this keeps a silent notification in the shade. bluetooth is tracked either way.</string>
    <string name="settings_detailed_unavailable">[luy] unavailable until bluetooth access is granted: this build only declares the connectedDevice service type, which android 14+ ties to a bluetooth permission.</string>
    <string name="settings_playback_only_title">[luy] count only playback</string>
    <string name="settings_playback_only_body">[luy] stats count the time audio was actually playing instead of the time connected. only sessions recorded with detailed tracking on measured playback; the rest are left out.</string>
    <string name="settings_language">[luy] language</string>
    <string name="settings_language_system">[luy] system language</string>
    <string name="settings_devices">[luy] devices</string>
    <string name="settings_devices_body">[luy] uncheck anything that isn’t headphones — a car stereo or a speaker — to stop recording it.</string>
    <string name="settings_device_subtitle">[luy] %1$s · first seen %2$s</string>
    <string name="settings_data">[luy] data</string>
    <string name="settings_export">[luy] export json</string>
    <string name="settings_import">[luy] import</string>
    <string name="settings_import_warning">[luy] importing replaces everything currently stored.</string>
    <string name="settings_troubleshooting">[luy] troubleshooting</string>
    <string name="settings_battery_body">[luy] if sessions stop being recorded, check that ylih is exempt from battery optimisation — an app that has been force-stopped never receives connection broadcasts again until it is opened.</string>
    <string name="settings_battery_button">[luy] battery settings</string>
    <string name="settings_battery_path">[luy] settings → apps → ylih → battery → unrestricted.</string>
    <string name="settings_hibernation_body">[luy] if ylih goes unopened for a few months, android pauses it and takes its permissions back, and nothing is recorded again until you open it. turning that off is what lets a pair keep counting through a season you never think about the app.</string>
    <string name="settings_hibernation_on">[luy] android may pause ylih.</string>
    <string name="settings_hibernation_off">[luy] ylih is exempt and keeps recording.</string>
    <string name="settings_hibernation_button">[luy] unused app settings</string>
