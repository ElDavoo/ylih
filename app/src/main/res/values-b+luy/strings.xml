    <string name="settings_tracking">okhulondelela</string>
    <string name="settings_detailed_title">okhulondelela okhwimanyisia</string>
    <string name="settings_detailed_body">khumetanga bindu bie waya nende ebise bio khwimba. android abolelanga app ekhola butswa khu waya, kho shino shibikanga eshimanyisio eshitawimba. bluetooth shilondelelwa ata endi.</string>
    <string name="settings_detailed_unavailable">shibulaho okhula obwiyangu bwe bluetooth bubuhanwe: omukanda kuno kubolanga butswa omutu kwe connectedDevice, android 14+ akwatania nende obwiyangu bwe bluetooth.</string>
    <string name="settings_playback_only_title">bala okhwimba butswa</string>
    <string name="settings_playback_only_body">tsinamba tsibalanga ebise omwimbo kwari nikwimba khukhwene khubwene bwe ebise bikwatane. ebise ebiandikwa nende okhulondelela okhwimanyisia nikhuli khusima nibyo bienyene byapima okhwimba; ebindi bilekhwa.</string>
