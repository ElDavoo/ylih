    <string name="welcome_title">okhwikhala mu ylih</string>
    <string name="welcome_intro">ylih yandika ebise buli bindu bio khuulira bibiri bikhalanga nibikwatane, kho nikali tsingaki tsinyingi wenyala okhukalusia eshifune shilala eshiri neshichila khu bindu: byakhalanga tsisaa tsinga?</string>
    <string name="welcome_point_auto_title">kwatanie mala wibirire</string>
    <string name="welcome_point_auto_body">bindu bio khuulira bie bluetooth biandikwanga bienyene, okhurula ebise bikwatananga. shibulaho eshindu shiokhuleshela nishikhola.</string>
    <string name="welcome_point_lifetime_title">bindu bibiri, obulamu bulala</string>
    <string name="welcome_point_lifetime_body">olwa bindu bifwa, birusie mu mulimo: tsinamba tsiabyo tsiemanga aho ne bindu bio khuulira ebindi ebie khubukhala bitanga khandi okhurula khu bulala tawe.</string>
    <string name="welcome_point_detailed_title">waya nende okhwimba</string>
    <string name="welcome_point_detailed_body">okhulondelela okhwimanyisia, mu tsindukhano, khumetanga bindu bie waya ne khupimanga ebise binga byari nibimba khukhwene.</string>
    <string name="welcome_privacy">buli eshindu shikhalanga khu simu ino. shibulaho akaunti, ne app shili nende obwiyangu bwe intaneti tawe.</string>
    <string name="welcome_start">tanga</string>
    <string name="welcome_next">eshilondangakho</string>
    <string name="welcome_allow">chamila</string>
    <string name="welcome_step">eshikhonyi %1$d khu %2$d</string>
    <string name="welcome_bluetooth_title">okhwinjila mu bluetooth</string>
    <string name="welcome_bluetooth_why">android abolelanga app eshindu shie bluetooth eshikwatane, nende elira liashio, nikali app ali nende obwiyangu bwe bluetooth. eno niyo injila ylih amanyila bindu bio khuulira okhurula khu redio ye emotoka, ne amanya bindu bilala okhurula khu bindi.</string>
    <string name="welcome_bluetooth_with">nende obwo: buli bindu biandikwanga okhurula ebise bikwatananga, nishibulaho eshiolesia nishikhola ne nishibulaho eshiokhwitsulila okhukhupa.</string>
    <string name="welcome_bluetooth_without">nibubulaho: shibulaho bindu bio khuulira bie bluetooth ebiandikwa tawe. ebindi bie app bikhola, ne wenyala okhubuhana inyuma mu tsindukhano tsie app tsie android.</string>
    <string name="welcome_notifications_title">tsinjila tsio khumanyia</string>
    <string name="welcome_notifications_why">okhulondelela okhwimanyisia khukholanga omulimo omutiti khu mukongo, ne android asabanga buli app ekhola endio okhubika eshimanyisio eshilolekhana mu bise ebio.</string>
    <string name="welcome_notifications_with">nende tsio: eshimanyisio shilolesia eshiandikwa lelo, ne shino nisho shonyene eshimanyisio shili okhulondelela okhwimanyisia khuli nobulamu.</string>
    <string name="welcome_notifications_without">nitsibulaho: okhulondelela okhwimanyisia khukholanga ne khwandikanga. android shalolesia eshimanyisio shiashio tawe butswa.</string>
    <string name="hibernation_title">khubalanga ne wewe nowibirire</string>
    <string name="hibernation_body">android emiaka app tsishikalilwe mu myesi chindi ne arusia obwiyangu bwatsio, eshindu eshiolekha ylih nishiandika eshindu tawe okhula olwa wakalila khandi. okhwibililwa niko eshichila app ino iliho, kho ni shilayi okhusima ako lelo.</string>
