    <string name="settings_about_body">[luy] ylih %1$s (%2$s) — headphone hours, kept locally and forever.</string>
    <string name="settings_import_confirm_title">[luy] replace all data?</string>
    <string name="settings_import_confirm_body">[luy] importing this backup deletes every device, pair and session stored now.</string>

