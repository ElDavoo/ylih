    <string name="settings_language_system">olulimi lwe sistemu</string>
    <string name="settings_devices">ebindu</string>
    <string name="settings_devices_body">rusia eshimanyisio khu shindu shioosi shishili bindu bio khuulira tawe — redio ye emotoka nohomba spika — kho shirekhe okhwandikwa.</string>
