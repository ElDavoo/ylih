    <string name="settings_import_warning">okhwinjisia khukalushinjia buli eshindu eshibikilwe lelo.</string>
    <string name="settings_troubleshooting">okhurusiakho amabii</string>
    <string name="settings_battery_body">nikali ebise birekha okhwandikwa, lola nikali ylih arusilwe khu khulinda betri — app eyakhalibwa khu maani shiyibukulanga tsinjila tsio khukwatana khandi okhula niyakalilwa tawe.</string>
    <string name="settings_battery_button">tsindukhano tsie betri</string>
    <string name="settings_battery_path">tsindukhano → app → ylih → betri → shibulaho eshikalilo.</string>
    <string name="settings_hibernation_body">nikali ylih shikalilwa mu myesi chindi tawe, android amiaka ne arusia obwiyangu bwaye, ne shibulaho eshiandikwa khandi okhula niwakalila. okhusima ako niko eshichila bindu bimeteshelesia okhubala mu bise bioosi ebiotaparanga khu app tawe.</string>
    <string name="settings_hibernation_on">android anyala okhumia ylih.</string>
    <string name="settings_hibernation_off">ylih arusilwe ne achendanga okhwandika.</string>
    <string name="settings_hibernation_button">tsindukhano tsie app tsishikholesibwa tawe</string>
    <string name="settings_about">khulwa</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — tsisaa tsie bindu bio khuulira, tsibikilwe ano ne tsiene tsiosi.</string>
    <string name="settings_import_confirm_title">kalushia amakhuwa koosi?</string>
    <string name="settings_import_confirm_body">okhwinjisia bakapu ino khurusinjia buli eshindu, bindu ne ebise ebibikilwe lelo.</string>

