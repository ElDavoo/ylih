    <string name="settings_language_system">imvugo y’ibigenerageza</string>
    <string name="settings_devices">inyaburuko</string>
    <string name="settings_devices_body">sumurika ikintu kitajuje kopesi - umwanya umugambi cyangwa serikali - kubigira beteta.</string>
    <string name="settings_device_subtitle">%1$s · yambaye %2$s</string>
