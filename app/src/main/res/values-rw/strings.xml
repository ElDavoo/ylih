    <string name="welcome_title">murakaze mu ylih</string>
    <string name="welcome_intro">ylih irikora igihe icyo ibiyobo bya kopesi bifitanye ahubwo, kugira ngo mu mwaka ubwambara wongera kwibuza ibibazo bimwe gusa: saa zingahe zafitanyeho?</string>
    <string name="welcome_point_auto_title">fushe kandi bireke</string>
    <string name="welcome_point_auto_body">kopesi za bluetooth zimikora kwaricwa igihe cyo kufitanya. nta kintu kigomba kuva gihora.</string>
    <string name="welcome_point_lifetime_title">ibiyobo bimwe, ubwami bwimwe</string>
    <string name="welcome_point_lifetime_body">iyo ibiyobo irapfakire, ifatanije: igice cyayo kirazama kuri aho kandi ibiyobo nshya byakopesi nzira yumunsi zacyatangira.</string>
    <string name="welcome_point_detailed_title">hamwe n’imfuka kandi guceca</string>
    <string name="welcome_point_detailed_body">kurikira no mu mahoro, mu ibigenerageza, onje kopesi z’imfuka kandi gupima igihe cyose gari gari.</string>
    <string name="welcome_privacy">ikintu cyose kirahita mu telefoni iyi. ntagenwe ni konti, kandi porogaramu ntiwumvu internet.</string>
    <string name="welcome_start">tangira</string>
    <string name="welcome_next">ikindi</string>
    <string name="welcome_allow">emeza</string>
    <string name="welcome_step">inzira %1$d ku %2$d</string>
    <string name="welcome_bluetooth_title">ubwumvire bwa bluetooth</string>
    <string name="welcome_bluetooth_why">android igera kuri porogaramu inyaburuko iyhe ya bluetooth ifitanye, kandi inzira yayo, niba porogaramu ari na ubwumvire bwa bluetooth. niyo ndyo ylih ihitamo ibiyobo bya kopesi kuva mu mugambi w’umwanya.</string>
    <string name="welcome_bluetooth_with">hamwe niyo: ibiyobo bimwe na bimwe zimikora icyambat cyo kufitanya, nta kintu kigomba kuva gihora.</string>
    <string name="welcome_bluetooth_without">utarimo: nta kopesi za bluetooth zimikora. ibindi bya porogaramu biracyakora, kandi urashobora gutanga kinyarwanda mu ibigenerageza ry’android.</string>
    <string name="welcome_notifications_title">abimenyetso</string>
    <string name="welcome_notifications_why">kurikira no mu mahoro niguo serivisi nto mu mwanya, kandi android isaba kuri porogaramu kigomba kurinda abimenyetso bivugwa.</string>
    <string name="welcome_notifications_with">hamwe niyo: abimenyetso byerekeza ikintu cyose gikora, niyo ntyo ishyaka ry’ikuri no mu mahoro rihama.</string>
    <string name="welcome_notifications_without">utarimo: kurikira no mu mahoro biracyakora kandi birikora. android idatugira abimenyetso.</string>
    <string name="hibernation_title">komeza kubara mugihe wese wireky</string>
    <string name="hibernation_body">android irumva porogaramu ntifungukwa mu nyungu kandi ifata impushya, ikintu cyo porogaramu ylih ntigerekwa kugeza iyo kigurwa. kuva guhagururwa ni ikintu iyo porogaramu ikubwira, kuburyo harya bigize inzira.</string>
