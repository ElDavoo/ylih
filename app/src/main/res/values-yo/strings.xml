    <string name="welcome_title">kaabo si ylih</string>
    <string name="welcome_intro">ylih naa akiwé ise ti alalade kọọkan wa ninu ise isalaye, ki o le beere laipe sile: ise melo logun ni iwa alalade?</string>
    <string name="welcome_point_auto_title">ba sile ki o mã ba ní àkiyesi</string>
    <string name="welcome_point_auto_body">alalade bluetooth naa jija fun ara wọn, lati ibi ti won ba nsopẹ. ohun kii ni alailé sile.</string>
    <string name="welcome_point_lifetime_title">alalade kan, ise kan</string>
    <string name="welcome_point_lifetime_body">nigba ti alalade ba ku, tẹ: ise ti o wa naa da ninu ibẹ, alalade titun ti ẹgbẹ ọlọ naa bẹẹ gidi biẹ lati òdo.</string>
    <string name="welcome_point_detailed_title">waya ati isalaye</string>
    <string name="welcome_point_detailed_body">akiwé eto, ninu eto, a dabaa waya alalade ati iwe ise ti alaye naa waa.</string>
    <string name="welcome_privacy">ohun gbogbo wa lori fonu yii. ko si akọọnu, ati app naa ki lo ete ina.</string>
    <string name="welcome_start">bẹrẹ</string>
    <string name="welcome_next">atẹle</string>
    <string name="welcome_allow">gba</string>
    <string name="welcome_step">ẹsẹ %1$d ti %2$d</string>
    <string name="welcome_bluetooth_title">ẹsẹ bluetooth</string>
    <string name="welcome_bluetooth_why">android ko sọ fun app alalade ipadosi ti bluetooth wo, ati kini a pe ẹ, ti kosi ẹsẹ bluetooth. eyi ni awon akọọnu ti ylih nkan alalade lati ọkunrin kariọkọ, ati bi o ti mọ alalade kan lati iwa kan.</string>
    <string name="welcome_bluetooth_with">ti o ba ni: alalade kọọkan jija lati ibi ti won ba nsopẹ, kosi ohun alailé sile ati kosi nkankan lati ranti lati titẹ.</string>
    <string name="welcome_bluetooth_without">ti ko ba ni: alalade bluetooth ko jija o. ilẹkẹ ilẹ ti app na naa ṣiṣẹ, ati o le gba a laipe ninu eto android app.</string>
    <string name="welcome_notifications_title">ilè àti isèlè</string>
    <string name="welcome_notifications_why">akiwé akiyesi maa ṣiṣẹ service kekere, ati android nilo gba nipa ohun ti yoo ṣe yii lati ha ilè ni akoko ti o ba nṣiṣẹ.</string>
    <string name="welcome_notifications_with">ti o ba ni: ilè yii yoo fi ohun ti a ti ranti ìbálópẹ́ han, eyi ni ẹnikan ti o le ṣe ilè akiyesi nṣiṣẹ.</string>
    <string name="welcome_notifications_without">ti ko ba ni: akiwé akiyesi yii yoo ṣiṣẹ ati ranti. android yii kii ri ilè rẹ o.</string>
    <string name="hibernation_title">tẹ ti o ba ri fun jiyan o ba mã ba ní àkiyesi</string>
    <string name="hibernation_body">android fi app sile pẹlu olupin ọgọ ọdun ati gba ẹsẹ ti o wa naa, eyi yoo fi ylih tan ki o kọ ohunkohun akiyesi gigun ki o ba ti ṣii application naa. jiyẹn loju ohun alaye app yii wa fun, nitorina o bara ti o ka o nkan yi.</string>
