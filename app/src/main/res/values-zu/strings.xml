    <string name="settings_tracking">ukulandelela</string>
    <string name="settings_detailed_title">ukulandelela okuningiliziwe</string>
    <string name="settings_detailed_body">kwengeza amahedfoni anentambo nesikhathi sokudlala. i-android ibika izenzakalo zeplagi enentambo kuphela ku-app esebenzayo, ngakho lokhu kugcina isaziso esithule endaweni yezaziso. i-bluetooth ilandelelwa noma kunjalo.</string>
    <string name="settings_detailed_unavailable">ayitholakali kuze kunikwe ukufinyelela ku-bluetooth: lolu hlelo lumemezela kuphela uhlobo lwesevisi i-connectedDevice, i-android 14+ eluhlanganisa nemvume ye-bluetooth.</string>
    <string name="settings_playback_only_title">bala ukudlala kuphela</string>
    <string name="settings_playback_only_body">izibalo zibala isikhathi umsindo obudlala ngempela esikhundleni sesikhathi sokuxhumeka. amaseshini aqoshwe nokulandelela okuningiliziwe kuvuliwe kuphela akale ukudlala; asele ashiywa ngaphandle.</string>
    <string name="settings_language">ulimi</string>
    <string name="settings_language_system">ulimi lwesistimu</string>
    <string name="settings_devices">amadivayisi</string>
    <string name="settings_devices_body">susa uphawu kunoma yini engewona amahedfoni — umsakazo wemoto noma isipikha — ukuze kuyekwe ukuqopha.</string>
    <string name="settings_device_subtitle">%1$s · kubonwe okokuqala %2$s</string>
