    <string name="welcome_title">siyakwamukela ku-ylih</string>
    <string name="welcome_intro">i-ylih iqopha ukuthi ipheya ngalinye lamahedfoni lihlala isikhathi esingakanani lixhunyiwe, ukuze eminyakeni ezayo usakwazi ukuphendula umbuzo owodwa obalulekile ngepheya: lihlale amahora amangaki?</string>
    <string name="welcome_point_auto_title">xhuma bese uyakhohlwa</string>
    <string name="welcome_point_auto_body">amahedfoni e-bluetooth aqoshwa ngokwawo, kusukela lapho exhumeka khona. akukho okudingeka kushiywe kusebenza.</string>
    <string name="welcome_point_lifetime_title">ipheya elilodwa, impilo eyodwa</string>
    <string name="welcome_point_lifetime_body">uma ipheya lifa, lithathe umhlalaphansi: isamba salo simiswa lapho bese ipheya elilandelayo lawo mahedfoni liqala kabusha kusukela kuziro.</string>
    <string name="welcome_point_detailed_title">intambo nokudlala</string>
    <string name="welcome_point_detailed_body">ukulandelela okuningiliziwe, kwizilungiselelo, kwengeza amahedfoni anentambo futhi kukale ukuthi kungakanani kwaleso sikhathi obekudlala ngempela.</string>
    <string name="welcome_privacy">konke kuhlala kule foni. ayikho i-akhawunti, futhi le app ayinayo imvume ye-inthanethi.</string>
    <string name="welcome_start">qalisa</string>
    <string name="welcome_next">okulandelayo</string>
    <string name="welcome_allow">vumela</string>
    <string name="welcome_step">isinyathelo %1$d kwezingu-%2$d</string>
    <string name="welcome_bluetooth_title">ukufinyelela ku-bluetooth</string>
    <string name="welcome_bluetooth_why">i-android itshela i-app ukuthi yiliphi idivayisi ye-bluetooth exhumekile, nokuthi ibizwa ngani, kuphela uma i-app inokufinyelela ku-bluetooth. yindlela i-ylih ehlukanisa ngayo ipheya lamahedfoni nomsakazo wemoto, nendlela eyazi ngayo elinye ipheya kwelinye.</string>
    <string name="welcome_bluetooth_with">ngakho: ipheya ngalinye liqoshwa kusukela lapho lixhumeka khona, kungashiywanga lutho lusebenza futhi kungekho okudingeka ukhumbule ukukucindezela.</string>
    <string name="welcome_bluetooth_without">ngaphandle kwakho: awekho amahedfoni e-bluetooth aqoshwayo. okunye kwe-app kusasebenza, futhi ungakunika kamuva kwizilungiselelo zama-app e-android.</string>
    <string name="welcome_notifications_title">izaziso</string>
    <string name="welcome_notifications_why">ukulandelela okuningiliziwe kusebenzisa insizakalo encane engemuva, futhi i-android idinga noma iyiphi i-app eyenza lokho ukuthi igcine isaziso esibonakalayo ngesikhathi isebenza.</string>
    <string name="welcome_notifications_with">ngazo: isaziso sikhombisa okuqoshwayo manje, okuwuphawu olulodwa lokuthi ukulandelela okuningiliziwe kuyaphila.</string>
    <string name="welcome_notifications_without">ngaphandle kwazo: ukulandelela okuningiliziwe kusasebenza futhi kusaqopha. i-android nje ngeke isibonise isaziso sayo.</string>
    <string name="hibernation_title">iqhubeka ibala ngenkathi ukhohlwa ngayo</string>
    <string name="hibernation_body">i-android imisa ama-app angavulwa izinyanga ezimbalwa bese ithatha izimvume zawo, okungashiya i-ylih ingaqophi lutho uze uyivule futhi. ukukhohlakala yikhona kanye lokhu le app ekhona ngakho, ngakho kubalulekile ukukuvala lokho manje.</string>
