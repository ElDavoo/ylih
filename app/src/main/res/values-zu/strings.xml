    <string name="settings_import">ngenisa</string>
    <string name="settings_import_warning">ukungenisa kushintsha konke okugcinwe manje.</string>
    <string name="settings_troubleshooting">ukuxazulula izinkinga</string>
    <string name="settings_battery_body">uma amaseshini eyeka ukuqoshwa, hlola ukuthi i-ylih ikhululwe ekulungiseni ibhethri — i-app emiswe ngenkani ayiphinde ithole ukusakazwa kokuxhumeka kuze kuvulwe futhi.</string>
    <string name="settings_battery_button">izilungiselelo zebhethri</string>
    <string name="settings_battery_path">izilungiselelo → ama-app → ylih → ibhethri → akunamkhawulo.</string>
    <string name="settings_hibernation_body">uma i-ylih ingavulwa izinyanga ezimbalwa, i-android iyayimisa bese ithatha izimvume zayo, futhi akukho okuphinde kuqoshwe uze uyivule. ukuvala lokho yikhona okuvumela ipheya ukuthi liqhubeke libala sonke isikhathi ongacabangi ngalo nge-app.</string>
    <string name="settings_hibernation_on">i-android ingase imise i-ylih.</string>
    <string name="settings_hibernation_off">i-ylih ikhululiwe futhi iyaqhubeka iqopha.</string>
    <string name="settings_hibernation_button">izilungiselelo zama-app angasetshenziswa</string>
    <string name="settings_about">mayelana</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — amahora amahedfoni, agcinwe lapha futhi kuze kube phakade.</string>
    <string name="settings_import_confirm_title">shintsha yonke idatha?</string>
    <string name="settings_import_confirm_body">ukungenisa lokhu kukhopha kususa wonke amadivayisi, amapheya namaseshini agcinwe manje.</string>

