    <string name="settings_tracking">ट्रैकिंग</string>
    <string name="settings_detailed_title">विस्तृत ट्रैकिंग</string>
    <string name="settings_detailed_body">तार आळे हैडफोन ते बजणे दा समां जोड़दी ऐ। android तारा दे लगणे दी खबर सिर्फ चलदी ऐपा गी दिंदा ऐ, इस करी ऐ इक चुप्पी सूचना रखदी ऐ। bluetooth दोऐ हालतें च ट्रैक होंदा ऐ।</string>
    <string name="settings_detailed_unavailable">bluetooth दी पहुँच बिना नीं चलदी: ऐ बिल्ड सिर्फ connectedDevice सेवा दस्सदा ऐ, ते android 14+ उसी bluetooth दी इजाज़ता कन्ने बन्नी दिंदा ऐ।</string>
    <string name="settings_playback_only_title">सिर्फ बजणा गिनो</string>
    <string name="settings_playback_only_body">आंकड़े जुड़े रैहणे दे समें दी थाह ओह समां गिनगे जदुं सच्चीं आवाज़ बजा दी ही। सिर्फ विस्तृत ट्रैकिंग कन्ने लिखे गेदे सत्रें च बजणा नापेया गेया; बाकी छड्डी दित्ते जांदे।</string>
    <string name="settings_language">भाषा</string>
    <string name="settings_language_system">सिस्टम दी भाषा</string>
    <string name="settings_devices">उपकरण</string>
    <string name="settings_devices_body">जेह्ड़ा हैडफोन नीं ऐ — गड्डी दा स्पीकर जां कोई होर स्पीकर — उसदा निशान हटाई दिया, तां जे ओह नीं लिखेया जाए।</string>
    <string name="settings_device_subtitle">%1$s · पैहली बरी %2$s गी दिक्खेया</string>
