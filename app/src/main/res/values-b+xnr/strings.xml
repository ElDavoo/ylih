    <string name="settings_import_warning">आयात करने पर हुण जो कुछ रक्खेया ऐ ओह सब बदली जाग।</string>
    <string name="settings_troubleshooting">समस्या दा हल</string>
    <string name="settings_battery_body">जेकर सत्र लिखे जाणे बंद होई जान तां दिक्खो जे ylih बैटरी दी बचत थमां बाहर ऐ — जेह्ड़ी ऐप ज़बरदस्ती रोक्की जंदी ऐ ओह खुलणे तकर जुड़ने दियां खबरां फिरी कदी नीं लैंदी।</string>
    <string name="settings_battery_button">बैटरी दी सैटिंग</string>
    <string name="settings_battery_path">सैटिंग → ऐप → ylih → बैटरी → बिना रोक-टोक।</string>
    <string name="settings_hibernation_body">जेकर ylih कई मैहने नीं खुल्ली तां android उसा गी रोकी दिंदा ते उंदियां इजाज़तां बापस लेई लैंदा ऐ, ते तुंदे खोलणे तकर कुछ बी नीं लिखेया जांदा। इसी बंद करना ई ओह गल्ल ऐ जेह्ड़ी उस मौसम च बी जोड़ी गिनदी रखदी ऐ जदुं तुसां ऐपा दा खिआल बी नीं करदे।</string>
    <string name="settings_hibernation_on">android ylih गी रोकी सकदा ऐ।</string>
    <string name="settings_hibernation_off">ylih बाहर ऐ ते लिखदी रैंदी ऐ।</string>
    <string name="settings_hibernation_button">बिना बरते ऐपा दी सैटिंग</string>
