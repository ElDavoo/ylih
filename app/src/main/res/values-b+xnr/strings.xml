    <string name="welcome_title">ylih anta brānd</string>
    <string name="welcome_intro">ylih rakhel khai mimiñ kānd rāth khāiṇ thāl tāraṅ, tah pir sāl viċ tum dhii sak: khai mimiñ ghañṭā ṭik rahe?</string>
    <string name="welcome_point_auto_title">jor kunḍ bhul</string>
    <string name="welcome_point_auto_body">bluetooth mimiñ kānd ābāl tan, jab jor hun. kuj na run rakh.</string>
    <string name="welcome_point_lifetime_title">ikk jor, ikk jīvan</string>
    <string name="welcome_point_lifetime_body">jab mimiñ mar jān, nish kar: tāl uthē aithē rok jān, aur nayin mimiñ shurun hoi jayn.</string>
    <string name="welcome_point_detailed_title">tangsār aur aavāz</string>
    <string name="welcome_point_detailed_body">vistarīt nazar-rakhā, sanḍbāz vich, tangsār mimiñ kānd aur āvāz smāi kar.</string>
    <string name="welcome_privacy">sab kuj tum kī fon uthē rakh. koi khāt na, aur app kē intarnet nahi hai.</string>
    <string name="welcome_start">shurun kar</string>
    <string name="welcome_next">agle</string>
    <string name="welcome_allow">svīkār kar</string>
    <string name="welcome_step">pag %1$d kē %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth phuñjṭhvāz</string>
    <string name="welcome_bluetooth_why">android app kō sirf tab batāth ki bluetooth device jor huā hai aur uske nām kya hain, jab app kē pāsh bluetooth phuñjṭhvāz hai. ylih mimiñ kānd aur gādi kē stereo kar ar sak, aur ikk mimiñ durse kar sak.</string>
    <string name="welcome_bluetooth_with">is se: har mimiñ nish ho jab jor hun, kunj bhi na run kunj bhi na dar.</string>
    <string name="welcome_bluetooth_without">is vinā: koi bluetooth mimiñ kānd na nish hon. app kā bāki hissa kām kart, aur tum baad mein sanḍbāz vich day sak.</string>
    <string name="welcome_notifications_title">sūchna</string>
    <string name="welcome_notifications_why">vistarīt nazar-rakhā choti background service chalāth, aur android taat ki zarūrat sūchna dekh. </string>
    <string name="welcome_notifications_with">is se: sūchna dikhāth kya nish ho rahe, jishe vistarīt nazar-rakhā jīvit hai.</string>
    <string name="welcome_notifications_without">is vinā: vistarīt nazar-rakhā chalāth aur nish karth. android sūchna nahi dikhāth.</string>
    <string name="hibernation_title">ginn-ti chalā jab bhul jā</string>
    <string name="hibernation_body">android app kō ruk ay jab kuch māhīn khul na, aur permishan vasul kar, ylih kunj na kām kar jab tak tum khol. aisā bhulnā ylih kā kām hai, to ab hī band kar.</string>
