    <string name="welcome_title">ylih च तुंदा सुआगत</string>
    <string name="welcome_intro">ylih ऐ लिखदा ऐ जे हर हैडफोन जोड़ी कितनी देर जुड़ी रैंदी ऐ, ताकि कई साला बाद बी तुसां उस इक्को सुआल दा जवाब देई सकन — ओह कितने घंटे चल्ले?</string>
    <string name="welcome_point_auto_title">जोड़ो ते भुली जाओ</string>
    <string name="welcome_point_auto_body">bluetooth हैडफोन जुड़दे सार अपणे आप लिखे जांदे। कुछ बी चलदा रखणे दी लोड़ नीं।</string>
    <string name="welcome_point_lifetime_title">इक जोड़ी, इक जिंदगी</string>
    <string name="welcome_point_lifetime_body">जदुं जोड़ी मरी जाए तां उसा गी रिटायर करी दिया: उंदा कुल जोड़ उत्थें रुकी जांदा ते उसी हैडफोना दी अगली जोड़ी फिरी सुन्ना थमां शुरू होंदी ऐ।</string>
    <string name="welcome_point_detailed_title">तार आळे ते बजदा आवाज़</string>
    <string name="welcome_point_detailed_body">सैटिंग च विस्तृत ट्रैकिंग तार आळे हैडफोन बी जोड़दी ऐ ते नापदी ऐ जे कितनी देर सच्चीं आवाज़ बजदी रेई।</string>
    <string name="welcome_privacy">सब कुछ इसी फोना च रैंदा ऐ। कोई खाता नीं, ते ऐपा गी इंटरनेट दी इजाज़त बी नीं।</string>
    <string name="welcome_start">शुरू करो</string>
    <string name="welcome_next">अगला</string>
    <string name="welcome_allow">इजाज़त दिया</string>
    <string name="welcome_step">कदम %1$d / %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth दी पहुँच</string>
    <string name="welcome_bluetooth_why">android ऐपा गी तालू ई दस्सदा ऐ जे कुण जिहा bluetooth उपकरण जुड़ेया ते उंदा नां क्या ऐ, जदुं ऐपा कोल bluetooth दी पहुँच होंदी ऐ। इस्सै कन्ने ylih हैडफोना गी गड्डी दे स्पीकरा थमां बक्ख करदा ऐ, ते इक जोड़ी गी दूई थमां पछांदा ऐ।</string>
    <string name="welcome_bluetooth_with">इसदे कन्ने: हर जोड़ी जुड़दे सार लिखी जंदी ऐ, ना कुछ चलदा रखणा पौंदा ते ना कुछ याद रखणा।</string>
    <string name="welcome_bluetooth_without">इसदे बिना: कोई बी bluetooth हैडफोन नीं लिखेया जांदा। बाकी ऐप तालू बी चलदी ऐ, ते तुसां बाद च android दी सैटिंग च इजाज़त देई सकदे ओ।</string>
    <string name="welcome_notifications_title">सूचनां</string>
    <string name="welcome_notifications_why">विस्तृत ट्रैकिंग इक निक्की जिही सेवा चलांदी ऐ, ते android ऐसी ऐपा गी इक सूचना दिक्खदी रखणे गी बोलदा ऐ।</string>
    <string name="welcome_notifications_with">इसदे कन्ने: सूचना दस्सदी ऐ जे हुण क्या लिखेया जा दा ऐ, ते इस्सै थमां पता चलदा ऐ जे विस्तृत ट्रैकिंग जिंदी ऐ।</string>
    <string name="welcome_notifications_without">इसदे बिना: विस्तृत ट्रैकिंग फिरी बी चलदी ऐ ते लिखदी ऐ। android बस उंदी सूचना नीं दस्सग।</string>
    <string name="hibernation_title">तुसां भुली जाओ, ते बी गिनदा रवै</string>
    <string name="hibernation_body">जेकर कोई ऐप कई मैहने नीं खुल्ली तां android उसा गी रोकी दिंदा ते उंदियां इजाज़तां बापस लेई लैंदा ऐ, ते फिरी ylih तुंदे खोलणे तकर कुछ बी नीं लिखग। भुल्ली जाणा ई ते इस ऐपा दा कम्म ऐ, इस करी इसी हुणे ई बंद करी देना ठीक ऐ।</string>
    <string name="action_not_now">हुण नीं</string>

