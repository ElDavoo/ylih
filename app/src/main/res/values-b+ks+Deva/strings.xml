    <string name="settings_tracking">ट्रैकिंग</string>
    <string name="settings_detailed_title">विस्तृत ट्रैकिंग</string>
    <string name="settings_detailed_body">तारयुक्त हेडफोन और प्लेबैक समय जोड़ता है। एंड्रॉइड केवल चलती हुई ऐप को तारयुक्त प्लग ईवेंट बताता है, इसलिए यह शेड में एक मौन सूचना रखता है। ब्लूटूथ किसी भी तरह ट्रैक किया जाता है।</string>
    <string name="settings_detailed_unavailable">ब्लूटूथ पहुंच दिए जाने तक अनुपलब्ध: यह बिल्ड केवल connectedDevice सेवा प्रकार घोषित करता है, जो एंड्रॉइड 14+ ब्लूटूथ अनुमति से बंधा है।</string>
    <string name="settings_playback_only_title">केवल प्लेबैक गिनें</string>
    <string name="settings_playback_only_body">आंकड़े जुड़े समय की बजाय ऑडियो वास्तव में बजते समय को गिनते हैं। केवल विस्तृत ट्रैकिंग के साथ रिकॉर्ड किए गए सत्र ही मापे गए प्लेबैक को गिनते हैं; बाकी को छोड़ दिया जाता है।</string>
    <string name="settings_language">भाषा</string>
    <string name="settings_language_system">सिस्टम भाषा</string>
    <string name="settings_devices">उपकरण</string>
    <string name="settings_devices_body">हेडफोन नहीं होने वाली कोई भी चीज अनचेक करें — कार स्टीरियो या स्पीकर — इसे रिकॉर्ड करना बंद करने के लिए।</string>
    <string name="settings_device_subtitle">%1$s · पहले देखा %2$s</string>
