    <string name="welcome_title">კეთილი იყოს თქვენი მობრძანება ylih-ში</string>
    <string name="welcome_intro">ylih აღრიცხავს, რამდენ ხანს რჩება დაკავშირებული ყურსასმენების თითოეული წყვილი, რათა მომავალი წელი თქვენ მაინც შეძლოთ ერთი მნიშვნელოვანი კითხვის გადაჭრა წყვილის შესახებ: რამდენი საათი გაძრა ისინი?</string>
    <string name="welcome_point_auto_title">დაკავშირება და დავიწყება</string>
    <string name="welcome_point_auto_body">bluetooth ყურსასმენი ირეგისტრირება ავტომატურად, დაკავშირებისთანავე. არ სჭირდება რაიმე ფოновი პროცესი.</string>
    <string name="welcome_point_lifetime_title">ერთი წყვილი, მთელი სიცოცხლე</string>
    <string name="welcome_point_lifetime_body">როდესაც წყვილი გაფუჭდება, გამოიყენეთ: მისი ჯამი იქ იყრება და შემდეგი იგივე ყურსასმენის წყვილი თავიდან იწყება ნულიდან.</string>
    <string name="welcome_point_detailed_title">მავთულიანი და ხმის ჩაწერა</string>
    <string name="welcome_point_detailed_body">დეტალური მეთოდი, პარამეტრებში, დამატებული მავთულიანი ყურსასმენი და ზომავს, რამდენი დროის განმავლობაში იყო რეალურად მუსიკა.</string>
    <string name="welcome_privacy">ყველაფერი ამ ტელეფონზე რჩება. არ არის ანგარიში და აპლიკაციას არ აქვს ინტერნეტის დაშვება.</string>
    <string name="welcome_start">დაწყება</string>
    <string name="welcome_next">შემდეგი</string>
    <string name="welcome_allow">დაშვება</string>
    <string name="welcome_step">ეტაპი %1$d %2$d-დან</string>
    <string name="welcome_bluetooth_title">bluetooth წვდომა</string>
    <string name="welcome_bluetooth_why">android-ი თავის თავში არ ეუბნება აპლიკაციას რომელი bluetooth მოწყობილობა დაკავშირდა და რა ჰქვია მას, თუ აპლიკაციას უფლება არ აქვს bluetooth-ზე წვდომა. ასე იცნობს ylih ყურსასმენის წყვილი მანქანის სტერეოდან და როგორ იცოდის ერთი წყვილი მეორეს.</string>
    <string name="welcome_bluetooth_with">ამის შემთხვევაში: ყველა წყვილი დარეგისტრირდება დაკავშირებამდე, არაფერი არ რჩება აქტიური და არაფერი აგაკეთებელი.</string>
    <string name="welcome_bluetooth_without">ამის გარეშე: bluetooth ყურსასმენი არ დარეგისტრირდება თავიდან. აპლიკაციის დანარჩენი ნაწილი მუშაობს და თქვენ შეძლებთ უფლება მოგვიანებით მიანიჭოთ android-ის აპლიკაციის პარამეტრებში.</string>
    <string name="welcome_notifications_title">შეტყობინებები</string>
    <string name="welcome_notifications_why">დეტალური მეთოდი ახორციელებს პატარა ფოనურ სერვისს, და android მოითხოვს ნებისმიერი აპლიკაციისგან, რომელიც ამას აკეთებს, მის შეტყობინება ხილული დარჩეს.</string>
    <string name="welcome_notifications_with">ამის შემთხვევაში: შეტყობინება აჩვენებს რა ირეგისტრირება ახლა, რაც ერთადერთი ნიშანია, რომ დეტალური მეთოდი ცოცხალია.</string>
    <string name="welcome_notifications_without">ამის გარეშე: დეტალური მეთოდი კვლავ მუშაობს და კვლავ რეგისტრირდება. android უბრალოდ არ აჩვენებს მის შეტყობინებას.</string>
    <string name="hibernation_title">დაითვალი, სიტყვით რომ დაგვიწყა</string>
    <string name="hibernation_body">android აჩერებს აპლიკაციებს, რომლებიც რამდენიმე თვე არ იყო გახსნილი და აბრუნებს მათ უფლებებს, რაც ylih-ს დაეტოვებდა რომელიმე რეგისტრაციის გარეშე. დავიწყება კი არის ის, რაზე ეს აპლიკაცია აკეთებს, ამიტომ ახლა ღირს გამორთვა.</string>
