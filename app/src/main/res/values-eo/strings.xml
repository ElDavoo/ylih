    <!-- Agordoj -->
    <string name="settings_tracking">spurado</string>
    <string name="settings_detailed_title">detala spurado</string>
    <string name="settings_detailed_body">aldonas kablitajn altkurajn aŭdilojn kaj ludtempo. android raportis kablon-konektajn eventojn nur al rulmemora aplikaĵo, do ĉi tio konservas silentajn avizojn en la ombro. bluetooth estas spurata ambaŭokaze.</string>
    <string name="settings_detailed_unavailable">ne disponebla antaŭ ol bluetooth-aliro estas donita: ĉi tiu bildaĵo deklaras nur la connectedDevice-servottipo, kiun android 14+ ligas al bluetooth-permeso.</string>
    <string name="settings_devices">aparatoj</string>
    <string name="settings_devices_body">malmarku kion ajn, kio ne estas altkuraj aŭdiloj — aŭton-stéreo aŭ parolilo — por ĉesi ĝin registri.</string>
    <string name="settings_device_subtitle">%1$s · unue vidita %2$s</string>
    <string name="settings_data">datumoj</string>
    <string name="settings_export">elportu json</string>
    <string name="settings_import">enportu</string>
    <string name="settings_import_warning">enporto anstataŭigas ĉion nuntempe konservita.</string>
    <string name="settings_troubleshooting">ĉaponaro</string>
    <string name="settings_battery_body">se seancoj ĉesas esti registrata, kontrolu ke ylih estas sena de baterij-optimigo — aplikaĵo, kiu estis forcigite-haltigita, neniam alprenas konekt-dissendojn denove antaŭ ol ĝi estas malfermita.</string>
    <string name="settings_battery_button">bateriaj agordoj</string>
    <string name="settings_battery_path">agordoj → aplikaĵoj → ylih → baterij → senlimita.</string>
    <string name="settings_about">pri</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — horoj de altkuraj aŭdiloj, konservita loke kaj ĉiam.</string>
    <string name="settings_import_confirm_title">anstataŭigu ĉiujn datumojn?</string>
    <string name="settings_import_confirm_body">enporto de ĉi tiu sekurejo forviŝas ĉiun aparaton, paron kaj seanco konservita nun.</string>

