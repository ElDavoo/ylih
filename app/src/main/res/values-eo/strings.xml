    <string name="kind_wired">kablita</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">nekonata</string>

    <!-- Unua ĉapo -->
    <string name="welcome_title">bonvenon en ylih</string>
    <string name="welcome_intro">ylih registras kiom longe ĉiu paro de altkuraj aŭdiloj restas konektita, por ke jaroj poste vi ankoraŭ povu respondi la solan gravan demando pri paro: kiom da horoj ili daŭris?</string>
    <string name="welcome_point_auto_title">konektu kaj forgesu</string>
    <string name="welcome_point_auto_body">bluetooth-altkuraj aŭdiloj estas registrataj aŭtomate, de la momento de konekto. nenio devas resti funkcianta.</string>
    <string name="welcome_point_lifetime_title">unu paro, unu viv-daŭro</string>
    <string name="welcome_point_lifetime_body">kiam paro fiaskas, pensigu ĝin: ĝia totalo frostiĝas tie kaj la sekva paro de la sama altkuraj aŭdiloj restartadas de nulo.</string>
    <string name="welcome_point_detailed_title">kablitaj kaj ludado</string>
    <string name="welcome_point_detailed_body">detala spurado, en agordoj, aldonas kablitajn altkurajn aŭdilojn kaj mezuras kiom da la tempo estis vere ludanta.</string>
    <string name="welcome_privacy">ĉio restas en ĉi tiu telefono. nenia konto, kaj la aplikaĵo ne havas interretan permeson.</string>
    <string name="welcome_start">komenci</string>

