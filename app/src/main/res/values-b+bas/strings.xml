    <!-- First run -->
    <string name="welcome_title">wé yan ní ylih</string>
    <string name="welcome_intro">ylih sɔŋ kwé bi ŋgɛ ŋ kuɓ e bun, so ñen mia ŋ bá kuɓ e, ba wó só mbɛn mbón: ndé bi kwé bá dɔ́ ŋgɛ?</string>
