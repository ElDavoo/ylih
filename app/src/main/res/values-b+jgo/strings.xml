    <string name="settings_tracking">tracking</string>
    <string name="settings_detailed_title">detailed tracking</string>
    <string name="settings_detailed_body">adds wired headphɔnes and playback time. andrɔid ɔnly repɔrts wired plug events tɔ a running app, sɔ this keeps a silent nɔtificatiɔn in the shade. bluetɔɔth is tracked either way.</string>
    <string name="settings_detailed_unavailable">unavailable until bluetɔɔth access is granted: this build ɔnly declares the cɔnnectedDevice service type, which andrɔid 14+ ties tɔ a bluetɔɔth permissiɔn.</string>
    <string name="settings_playback_only_title">cɔunt ɔnly playback</string>
    <string name="settings_playback_only_body">stats cɔunt the time audiɔ was actually playing instead ɔf the time cɔnnected. ɔnly sessiɔns recɔrded with detailed tracking ɔn measured playback; the rest are left ɔut.</string>
    <string name="settings_language">language</string>
    <string name="settings_language_system">system language</string>
    <string name="settings_devices">devices</string>
    <string name="settings_devices_body">uncheck anything that isn’t headphɔnes — a car stereo or a speaker — tɔ stɔp recɔrding it.</string>
    <string name="settings_device_subtitle">%1$s · first seen %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">export json</string>
    <string name="settings_import">impɔrt</string>
    <string name="settings_import_warning">impɔrting replaces everything currently stɔred.</string>
    <string name="settings_troubleshooting">trɔubleshɔɔting</string>
    <string name="settings_battery_body">if sessiɔns stɔp being recɔrded, check that ylih is exempt frɔm battery ɔptimisatiɔn — an app that has been fɔrce-stɔpped never receives cɔnnectiɔn bradcasts again until it is ɔpened.</string>
    <string name="settings_battery_button">battery settings</string>
    <string name="settings_battery_path">settings → apps → ylih → battery → unrestricted.</string>
    <string name="settings_hibernation_body">if ylih gɔes unɔpened fɔr a few mɔnths, andrɔid pauses it and takes its permissiɔns back, and nɔthing is recɔrded again until yɔu ɔpen it. turning that ɔff is what lets a pair keep cɔunting thrɔugh a seasɔn yɔu never think abɔut the app.</string>
    <string name="settings_hibernation_on">andrɔid may pause ylih.</string>
    <string name="settings_hibernation_off">ylih is exempt and keeps recɔrding.</string>
    <string name="settings_hibernation_button">unused app settings</string>
    <string name="settings_about">abɔut</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — headphɔne hɔurs, kept lɔcally and fɔrever.</string>
    <string name="settings_import_confirm_title">replace all data?</string>
    <string name="settings_import_confirm_body">impɔrting this backup deletes every device, pair and sessiɔn stɔred nɔw.</string>

