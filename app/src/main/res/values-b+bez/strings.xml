    <string name="pair_longest">mrefu zaidi</string>
    <string name="pair_first_seen">iliyoona kwanza</string>
    <string name="pair_of_measured">ya kipimo</string>
    <string name="pair_measured">kipimo</string>
    <string name="pair_paid">iliyolipwa</string>
    <string name="pair_per_hour">kwa saa</string>
    <string name="pair_bought">iliyonunuliwa</string>
    <string name="pair_daily_hours_14">masaa ya kila siku (siku 14)</string>
    <string name="pair_rename_title">badilisha jina la jozi</string>
    <string name="pair_rename_label">jina</string>
    <string name="pair_retire_title">acha jozi hii</string>
    <string name="pair_retire_label">sababu (kufa, kujualan, kupotea…)</string>
    <string name="pair_retire_confirm">acha</string>
    <string name="pair_retire_supporting">kijumla kinakaa huko. kwa kubandikaisha vifaa sawa huanza jozi mpya kwa sifuri.</string>
    <string name="pair_price_title">bei iliyolipwa</string>
    <string name="pair_price_label">kiasi (vitengo kamili)</string>
    <string name="pair_price_supporting">kutumika kwa kielelezo cha gharama kwa saa.</string>
    <string name="pair_delete_title">futa jozi hii?</string>
    <string name="pair_delete_body">kila kikao kilichosijiliwa kwa ajili yake kinafutwa pia. hii haiwezi kurudi nyuma.</string>

    <!-- Safu za kikao -->
    <string name="session_ongoing">inaendelea</string>
    <string name="session_until">hadi %1$s</string>
    <string name="session_playing">%1$s kucheza</string>
    <string name="session_recovered">kukamatia</string>

    <!-- Mipango -->
    <string name="settings_tracking">kufuatilia</string>
    <string name="settings_detailed_title">kufuatilia kwa undani</string>
    <string name="settings_detailed_body">kunaongeza muti ya kamba na wakati wa kucheza. android tu husambaza matukio ya kamba iliyobandika kwa programu inayoendelea, kwa sababu hii inabaki ikiwa na ifikira lakini bila sauti. bluetooth inafuatiliwa kwa njia yoyote.</string>
    <string name="settings_detailed_unavailable">haipo hadi ruhusa ya bluetooth itolewe: kuundwa hiki kunahakitisha tu aina ya huduma ya connectedDevice, ambayo android 14+ inasungi kwa ruhusa ya bluetooth.</string>
    <string name="settings_devices">vifaa</string>
    <string name="settings_devices_body">ondoa herufi kwenye kile ambacho si muti - stereo ya motokaa au kinzani - ili kusimama kurekodi.</string>
    <string name="settings_device_subtitle">%1$s · iliyoona kwanza %2$s</string>
    <string name="settings_data">takwimu</string>
    <string name="settings_export">toleo la json</string>
    <string name="settings_import">ingiza</string>
    <string name="settings_import_warning">kuingiza kunaambatisha kila kitu kilichohifadhiwa kwa sasa.</string>
    <string name="settings_troubleshooting">kutatua matatizo</string>
    <string name="settings_battery_body">ikiwa vikao vinakoma kurekodi, angalia kuwa ylih imeachwa mbali na uchangamano wa umeme - programu iliyosimamaishwa kwa lazima haipati tena matukio ya kubandikaisha hadi ikaponekaponekwa.</string>
    <string name="settings_battery_button">mipango ya umeme</string>
    <string name="settings_battery_path">mipango → programu → ylih → umeme → bila kuzuiliwa.</string>
    <string name="settings_about">kuhusu</string>
    <string name="settings_about_body">ylih %1$s (%2$s) - masaa ya muti, yanayohifadhiwa katika ndani na milele.</string>
    <string name="settings_import_confirm_title">kuambatisha takwimu zote?</string>
    <string name="settings_import_confirm_body">kuingiza hii nyuma inafuta kila vifaa, jozi na kikao kilichohifadhiwa kwa sasa.</string>

    <!-- Hatua za kawaida -->
    <string name="action_save">hifadhi</string>
    <string name="action_cancel">tandika</string>
    <string name="action_delete">futa</string>
    <string name="action_import">ingiza</string>

    <!-- Ilani -->
    <string name="channel_tracking">kufuatilia muti</string>
    <string name="channel_tracking_description">inaonyeshwa wakati ylih inaangalia kamba na kucheza. android haisambazi matukio ya kamba iliyobandika kwa programu ambazo haziendelea.</string>
    <string name="notification_title">kufuatilia wakati wa muti</string>
    <string name="notification_starting">kuanza…</string>
    <string name="notification_idle">kusubiri muti</string>
