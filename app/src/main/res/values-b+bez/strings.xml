<?xml version="1.0" encoding="utf-8"?>
<!--
  Bena. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources>
    <string name="app_title">ylih - maisha yako pa muti</string>

    <!-- Kusogeza kwa chini -->
    <string name="nav_headphones">muti</string>
    <string name="nav_stats">takwimu</string>
    <string name="nav_settings">mipango</string>

    <!-- Aina za vifaa -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">kamba</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">haijulikani</string>

    <!-- Mwanzo wa kwanza -->
    <string name="welcome_title">karibu sana ylih</string>
    <string name="welcome_intro">ylih imesijili kumbe kila jozi ya muti inabaki iliyobandika, kwa sababu miaka mingi ijayo unaweza kuweza kujibu swali la muhimu tu kuhusu jozi: saa ngapi walikufa?</string>
    <string name="welcome_point_auto_title">bandika na sahau</string>
    <string name="welcome_point_auto_body">muti ya bluetooth ilisijiliwa yenyewe, tangu inapobandika. hakuna kitu kinachohitajika kusaga wakati wote.</string>
    <string name="welcome_point_lifetime_title">jozi moja, maisha moja</string>
    <string name="welcome_point_lifetime_body">jozi inapokufa, itengeneze: jumla yake inakaa huko na jozi ijayo ya muti huo huanza tena kutoka kwa sifuri.</string>
    <string name="welcome_point_detailed_title">kamba na kucheza</string>
    <string name="welcome_point_detailed_body">kufuatilia kwa undani, katika mipango, kunaongeza kamba na kupima kiasi cha wakati uliyokuwa unacheza.</string>
    <string name="welcome_privacy">kila kitu kinabaki kwenye simu hii. hakuna akaunti, nde simu haina ruhusa ya intaneti.</string>
    <string name="welcome_start">kuanza</string>
    <string name="welcome_next">hwendelela</string>
    <string name="welcome_allow">ruhusu</string>
    <string name="welcome_step">hatua %1$d kwa %2$d</string>
    <string name="welcome_bluetooth_title">ruhusa ya bluetooth</string>
    <string name="welcome_bluetooth_why">android ihumwambila apu ndaki kifaa gani cha bluetooth chihaunganishiwa, na chitambulwagwa ndaki, nzi apu ipagwa na ruhusa ya bluetooth. ndo vila ylih ihutofautisha vifaa vya kupulikila na redio ya gali, na jozi imwe na inyingi.</string>
    <string name="welcome_bluetooth_with">na ruhusa: kila jozi ihuandikwa kuhuma pahala ihaunganishiwa, bila kileka kintu kihubomba na bila kukumbuka kubonyeza kintu.</string>
    <string name="welcome_bluetooth_without">bila ruhusa: kwifutu vifaa vya kupulikila vya bluetooth vihuandikwa. sehemu inyingi ya apu ihubomba, na uweza kutoa ruhusa baadaye mu mipangilio ya apu ya android.</string>
    <string name="welcome_notifications_title">taarifa</string>
    <string name="welcome_notifications_why">ufuatiliaji wa kina ihubomba huduma ndodo ya nyuma, na android ihulonda kila apu ihubomba nzo kuvika taarifa ihuvonekana.</string>
    <string name="welcome_notifications_with">na ruhusa: taarifa ihulaga kiki kihuandikwa hano, ndo ishara imwe tu kwamba ufuatiliaji wa kina uli mgima.</string>
    <string name="welcome_notifications_without">bila ruhusa: ufuatiliaji wa kina bado ihubomba na bado ihuandika. android tu haiyilaga taarifa yake.</string>
    <string name="hibernation_title">ihendelela kuhesabu hata paukisahau</string>
    <string name="hibernation_body">android itandika programu ambazo hazijafunguliwa kwa miezi, na inaondoa ruhusa zake. hapo ylih haitarekodi lolote mpaka uifungue tena. kusahaulika ndiyo kazi ya programu hii, hivyo tandika jambo hili sasa.</string>
    <string name="action_not_now">sio sasa</string>

