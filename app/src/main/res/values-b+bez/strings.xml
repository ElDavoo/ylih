<?xml version="1.0" encoding="utf-8"?>
<!--
  Bena. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources>
    <string name="app_title">ylih - maisha yako pa muti</string>

    <!-- Kusogeza kwa chini -->
    <string name="nav_headphones">muti</string>
    <string name="nav_stats">takwimu</string>
    <string name="nav_settings">mipango</string>

    <!-- Aina za vifaa -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">kamba</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">haijulikani</string>

    <!-- Mwanzo wa kwanza -->
    <string name="welcome_title">karibu sana ylih</string>
    <string name="welcome_intro">ylih imesijili kumbe kila jozi ya muti inabaki iliyobandika, kwa sababu miaka mingi ijayo unaweza kuweza kujibu swali la muhimu tu kuhusu jozi: saa ngapi walikufa?</string>
    <string name="welcome_point_auto_title">bandika na sahau</string>
    <string name="welcome_point_auto_body">muti ya bluetooth ilisijiliwa yenyewe, tangu inapobandika. hakuna kitu kinachohitajika kusaga wakati wote.</string>
    <string name="welcome_point_lifetime_title">jozi moja, maisha moja</string>
    <string name="welcome_point_lifetime_body">jozi inapokufa, itengeneze: jumla yake inakaa huko na jozi ijayo ya muti huo huanza tena kutoka kwa sifuri.</string>
    <string name="welcome_point_detailed_title">kamba na kucheza</string>
    <string name="welcome_point_detailed_body">kufuatilia kwa undani, katika mipango, kunaongeza kamba na kupima kiasi cha wakati uliyokuwa unacheza.</string>
    <string name="welcome_privacy">kila kitu kinabaki kwenye simu hii. hakuna akaunti, nde simu haina ruhusa ya intaneti.</string>
    <string name="welcome_start">kuanza</string>

    <!-- Orodha ya muti -->
    <string name="devices_in_use">inatumika</string>
    <string name="devices_retired">imeacha</string>
    <string name="devices_empty_title">hakuna muti bado</string>
    <string name="devices_empty_body">bandika jozi ya muti ya bluetooth naisimiswe hapa. muti ya kamba inahitaji kufuatilia kwa undani, katika mipango.</string>
    <string name="devices_generation">jozi #%1$d</string>
    <string name="devices_retired_on">imeacha %1$s</string>
    <string name="devices_connected_for">imebandikaisha %1$s</string>
    <string name="devices_recent">%1$s / siku 7</string>

    <!-- Takwimu -->
    <string name="stats_title">muti yote</string>
    <string name="stats_sessions_since">%1$s tangu %2$s</string>
    <string name="stats_last_7">siku 7 za mwisho</string>
    <string name="stats_last_30">siku 30 za mwisho</string>
    <string name="stats_average_session">kikao cha wastani</string>
