        <item quantity="one">imebandikaisha %1$d · %2$s</item>
        <item quantity="other">imebandikaisha %1$d · %2$s</item>
    </plurals>
    <plurals name="notification_active_playing">
        <item quantity="one">imebandikaisha %1$d · %2$s · kucheza</item>
        <item quantity="other">imebandikaisha %1$d · %2$s · kucheza</item>
    </plurals>

    <!-- Ujumbe wa Snackbar -->
    <string name="detailed_needs_bluetooth">kuundwa hiki kinahitaji ruhusa ya bluetooth kabla haiwezi kufuatilia kamba</string>
    <string name="export_done">nyuma iliyokamatia</string>
    <string name="export_failed">toleo lilishindwa</string>
    <string name="import_failed">kuingiza lilishindwa</string>
