    <!-- 설정 -->
    <string name="settings_tracking">추적</string>
    <string name="settings_detailed_title">상세 추적</string>
    <string name="settings_detailed_body">유선 헤드폰과 재생 시간을 추가로 기록합니다. android는 실행 중인 앱에만 유선 연결 이벤트를 전달하므로, 알림창에 조용한 알림이 하나 유지됩니다. 블루투스는 어느 쪽이든 추적됩니다.</string>
    <string name="settings_detailed_unavailable">블루투스 접근 권한을 허용해야 사용할 수 있습니다: 이 빌드는 connectedDevice 서비스 유형만 선언하며, android 14 이상에서는 이를 블루투스 권한과 연결합니다.</string>
    <string name="settings_playback_only_title">재생 시간만 계산</string>
    <string name="settings_playback_only_body">통계가 연결 시간 대신 실제로 오디오가 재생된 시간을 계산합니다. 재생을 측정한 것은 상세 추적을 켠 상태로 기록된 세션뿐이며, 나머지는 제외됩니다.</string>
    <string name="settings_language">언어</string>
    <string name="settings_language_system">시스템 언어</string>
    <string name="settings_devices">기기</string>
    <string name="settings_devices_body">헤드폰이 아닌 것 — 차량 오디오나 스피커 — 은 체크를 해제해 기록을 멈추세요.</string>
    <string name="settings_device_subtitle">%1$s · 처음 발견 %2$s</string>
    <string name="settings_data">데이터</string>
    <string name="settings_export">json으로 내보내기</string>
    <string name="settings_import">가져오기</string>
    <string name="settings_import_warning">가져오기를 하면 현재 저장된 모든 데이터가 대체됩니다.</string>
    <string name="settings_troubleshooting">문제 해결</string>
    <string name="settings_battery_body">세션이 더 이상 기록되지 않는다면 ylih가 배터리 최적화에서 제외되어 있는지 확인하세요 — 강제 종료된 앱은 다시 열기 전까지 연결 브로드캐스트를 전혀 받지 못합니다.</string>
    <string name="settings_battery_button">배터리 설정</string>
    <string name="settings_battery_path">설정 → 앱 → ylih → 배터리 → 제한 없음.</string>
    <string name="settings_hibernation_body">ylih가 몇 달간 열리지 않으면 android가 이를 중지시키고 권한을 회수하며, 다시 열기 전까지 아무것도 기록되지 않습니다. 이 기능을 꺼두면 앱을 전혀 생각하지 않는 계절에도 헤드폰 한 쌍의 기록이 계속됩니다.</string>
    <string name="settings_hibernation_on">android가 ylih를 중지시킬 수 있습니다.</string>
    <string name="settings_hibernation_off">ylih는 예외 처리되어 계속 기록됩니다.</string>
    <string name="settings_hibernation_button">사용하지 않는 앱 설정</string>
    <string name="settings_about">정보</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — 헤드폰 사용 시간을, 로컬에 영원히.</string>
    <string name="settings_import_confirm_title">모든 데이터를 대체할까요?</string>
    <string name="settings_import_confirm_body">이 백업을 가져오면 현재 저장된 모든 기기, 쌍, 세션이 삭제됩니다.</string>
