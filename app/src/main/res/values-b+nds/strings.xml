    <string name="settings_tracking">protokollering</string>
    <string name="settings_detailed_title">detaljert protokollering</string>
    <string name="settings_detailed_body">addiert dröppt kopphörer un avspeeltiet. android reportiert dröppt-toevallen alenks an leavende apps, so dit hellt en still bericht in de schaduw. bluetooth wordt protokolleert elk geval.</string>
    <string name="settings_detailed_unavailable">onbeschieker bet bluetooth-tillang gegeaven wodt: dit build deklariert alenks de connectedDevice-sörtwus, wat android 14+ an en bluetooth-erlaubnis bindt.</string>
    <string name="settings_playback_only_title">tellen avenks avspeel</string>
    <string name="settings_playback_only_body">statistik tellen de tiet, audio aktual avspeel, statt de verbunnenheid-tiet. alenks sitzungen, protokolleert mit detaljert protokollering an, metten avspeel; de rest leavt utenbi.</string>
    <string name="settings_language">spraak</string>
    <string name="settings_language_system">systeem-spraak</string>
    <string name="settings_devices">toestellen</string>
    <string name="settings_devices_body">uncheck wat neet kopphörer is - en autoradio of en spreker - to dat neet mehr protokolliert warrn.</string>
