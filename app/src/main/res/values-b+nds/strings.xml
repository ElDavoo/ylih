    <string name="settings_import">import</string>
    <string name="settings_import_warning">import ersetst alles, nu opslaan.</string>
    <string name="settings_troubleshooting">foutupsporing</string>
    <string name="settings_battery_body">wenn sitzungen neet mehr protokolleert warrn, kontrolleer, dat ylih fry is vun batterij-optimisering - en app, de forst-stopt is, kreegt neet weer verbinnen-utsendingen bet et openmaak warrn.</string>
    <string name="settings_battery_button">batterij-instellingen</string>
    <string name="settings_battery_path">instellingen → apps → ylih → batterij → unbegrenset.</string>
    <string name="settings_hibernation_body">wenn ylih maanden neet openmaak warrn, pauseert android et un nimt erlaubnis torüch, un nix warrn mehr protokolleert bet du et openmaakst. dat utet maaken is, wat en paar tellen holt dör en tietdeel, wo du de app neet denkst.</string>
    <string name="settings_hibernation_on">android kann ylih pauseren.</string>
    <string name="settings_hibernation_off">ylih is fry un holt protokollering.</string>
    <string name="settings_hibernation_button">ongenutte app-instellingen</string>
