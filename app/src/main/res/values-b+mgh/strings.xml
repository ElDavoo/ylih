    <string name="welcome_title">murweleke va ylih</string>
    <string name="welcome_intro">ylih onnilepa okathi ola ifone sa maru sinakhala silattaniwe, wira iyaakha sinceene sohuma anyu munwerye wakhula nikoho nimosaru nootthuneya voohimya ifone: sahaala mahora malingi?</string>
    <string name="welcome_point_auto_title">lattanihani nto muliyaleke</string>
    <string name="welcome_point_auto_body">ifone sa bluetooth sinnilepiwa sohoolo, okathi wa olattaniwa. khivo etthu enttuneya ohiyiwa ekivaraka.</string>
    <string name="welcome_point_lifetime_title">ifone emosa, ekumi emosa</string>
    <string name="welcome_point_lifetime_body">vaavo ifone sinnaakhwa, muhiyeke: mahesabu aya annimala vavaa nto ifone sikina sa nikhuuru nimosaru sinnipacerya khavo.</string>
    <string name="welcome_point_detailed_title">ekamba ni oiwelela</string>
    <string name="welcome_point_detailed_body">olipelela wootepa, mmalagihoni, onnaacenrerya ifone sa ekamba nto onnipima okathi waakhala oiwelela ekekhai.</string>
    <string name="welcome_privacy">sotheene sinnikhala mu telefone ela. khavo ekonta, nto aplikasau ehaana ruhusa ya internet.</string>
    <string name="welcome_start">pacenryani</string>
    <string name="welcome_next">vanikhuma</string>
    <string name="welcome_allow">kupalihani</string>
    <string name="welcome_step">ekapiciro %1$d va %2$d</string>
    <string name="welcome_bluetooth_title">olattela bluetooth</string>
    <string name="welcome_bluetooth_why">android onnihimeeriha aplikasau etthu ya bluetooth elattaniwe, ni nsina naya, akhala aplikasau ohaana olattela bluetooth. tivaa ylih onisuwela ifone sa maru ni radio ya ekaaro, ni onisuwela ifone emosa ni ekina.</string>
    <string name="welcome_bluetooth_with">ni yeeyo: ifone sotheene sinnilepiwa okathi wa olattaniwa, khavo etthu enihiyiwa ekivaraka nto khavo etthu ya wuupuwelela ohaka.</string>
    <string name="welcome_bluetooth_without">ohirina yeeyo: khavo ifone sa bluetooth sinilepiwa. ikina sa aplikasau sinnivara, nto munwerya ovaha muhoolo mmalagihoni a aplikasau a android.</string>
    <string name="welcome_notifications_title">malaleyo</string>
    <string name="welcome_notifications_why">olipelela wootepa onnivarihela ekaaru yaamukhaani ya nnuuni, nto android onnittuneya aplikasau sotheene sinipaka yeeyo okhalana nlaleyo nooneya okathi wootheene.</string>
    <string name="welcome_notifications_with">ni yeeyo: nlaleyo ninnooniherya etthu enilepiwa vano, nto tivaa ekhaikhai emosaru wira olipelela wootepa onnivara.</string>
    <string name="welcome_notifications_without">ohirina yeeyo: olipelela wootepa onnivara nto onnilepa. android khanrowa woonihera nlaleyo naya paahi.</string>
    <string name="hibernation_title">onnitthara ohesabu okathi munliyalela</string>
    <string name="hibernation_body">android onnimaliha aplikasau sihihuliwe miyeeri mikina nto onnaakuxa ruhusa saya, yeeyo enrowa ohiya ylih ehinilepa etthu mpaka nyuwo muhulaka nikina. oliyaleliwa tiyo nthowa na aplikasau ela, nto vanttuneya omaliha yeeyo vano.</string>
    <string name="action_not_now">nne vano</string>

