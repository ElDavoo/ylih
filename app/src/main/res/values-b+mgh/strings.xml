    <string name="settings_tracking">olipelela</string>
    <string name="settings_detailed_title">olipelela wootepa</string>
    <string name="settings_detailed_body">onnaacenrerya ifone sa ekamba ni okathi wa oiwelela. android onnihimya myaha sa ekamba wa aplikasau enivara paahi, nto yeeyo enniikha nlaleyo noomalala. bluetooth onnilipeleliwa mowiipheela.</string>
    <string name="settings_detailed_unavailable">khenivareya mpaka olattela bluetooth ovahiwe: eversau ela ennihimya ekaaru ya connectedDevice paahi, yeeyo android 14+ onnilattanya ni ruhusa ya bluetooth.</string>
    <string name="settings_playback_only_title">ohesabu oiwelela paahi</string>
    <string name="settings_playback_only_body">mahesabu annihesabu okathi audio waavaraka ekekhai ohiya okathi wa olattaniwa. ikathi salepiwa ni olipelela wootepa woovara paahi sapima oiwelela; ikina sinnihiyiwa.</string>
    <string name="settings_language">nttaava</string>
    <string name="settings_language_system">nttaava na esistema</string>
    <string name="settings_devices">itthu</string>
    <string name="settings_devices_body">muhiyeke etthu yookhala ehiri ifone sa maru — radio ya ekaaro walaa ekolomwe — wira ehilepiwe.</string>
    <string name="settings_device_subtitle">%1$s · yoonihiwe woopacerya %2$s</string>
    <string name="settings_data">matthaya</string>
    <string name="settings_export">okuxa json</string>
    <string name="settings_import">ovaha</string>
    <string name="settings_import_warning">ovaha onnilukiha sotheene sihiiwe vano.</string>
    <string name="settings_troubleshooting">omaliha mixankho</string>
    <string name="settings_battery_body">akhala ikathi sinnimala olepiwa, weheryani akhala ylih ohiyiwe mu olipiha bateria — aplikasau yoomaliheriwa khenrowa waakhela malaleyo a olattaniwa mpaka ehuliwe nikina.</string>
    <string name="settings_battery_button">malagiho a bateria</string>
    <string name="settings_battery_path">malagiho → aplikasau → ylih → bateria → khavo makhalelo.</string>
    <string name="settings_hibernation_body">akhala ylih ehihuliwe miyeeri mikina, android onnimmaliha nto onnaakuxa ruhusa saya, nto khavo etthu enilepiwa mpaka nyuwo muhulaka. omaliha yeeyo tiyo enihiya ifone etthareke ohesabu okathi wootheene nyuwo muhinuupuwelela aplikasau.</string>
    <string name="settings_hibernation_on">android onnwerya omaliha ylih.</string>
    <string name="settings_hibernation_off">ylih ohiyiwe nto onnitthara olepa.</string>
    <string name="settings_hibernation_button">malagiho a aplikasau sihinivarihiwa</string>
    <string name="settings_about">voohimya</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — mahora a ifone sa maru, ohiiwa vava ni mahiku ootheene.</string>
    <string name="settings_import_confirm_title">olukiha matthaya ootheene?</string>
    <string name="settings_import_confirm_body">ovaha ebakapu ela onnipuha itthu, ifone ni ikathi sotheene sihiiwe vano.</string>

