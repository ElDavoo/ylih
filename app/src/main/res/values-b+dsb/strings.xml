    <string name="settings_tracking">slepo</string>
    <string name="settings_detailed_title">detalny slepo</string>
    <string name="settings_detailed_body">naršywaš drótne naušniki a čas wótwóźenja. android zdźělujo drótne napšadeje jano žywjemu programej, togola sćě tu cicny powěźomjenje wóstawa. bluetooth se sćě slepowaš.</string>
    <string name="settings_detailed_unavailable">njejo dostupny, dokad bluetooth-towědnosć njejo dana: toś ta wersija jano connectedDevice-tšyp słužby prokljamujaš, što android 14+ na bluetooth-towědnosć wěžujaš.</string>
    <string name="settings_playback_only_title">jano wótwóźenje liczyś</string>
    <string name="settings_playback_only_body">statistika licy cas, gaž zuk napšawdu grajašo, město casa zwězanja. jano pósejźenja, kótarež su se z zapinjonym detalnym slepom nagrawali, su wótwóźenje měrili; te druge se wuwóstaju.</string>
    <string name="settings_language">rěc</string>
    <string name="settings_language_system">rěc systema</string>
    <string name="settings_devices">napšada</string>
    <string name="settings_devices_body">wulašćiš, co njesu naušniki — awtomagnatole abo głośniki — aby ji měł staś nanjesywaś.</string>
    <string name="settings_device_subtitle">%1$s · prwy raz wiźity %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">eksport json</string>
    <string name="settings_import">import</string>
    <string name="settings_import_warning">import wšykno, co se njepšichowujo, wěnšujaš.</string>
    <string name="settings_troubleshooting">wótgrožowanje problemow</string>
    <string name="settings_battery_body">ako sejady njenanjesujuju se wěcej, kontroluš, zo je ylih wót optimizacije akumulatora wuzwolnjeny — program, co je mócnje stopnjeny, nigda wěcej napšadeje wobyšcenja njejo, dokad ga njawěrtaš.</string>
    <string name="settings_battery_button">nastajenja akumulatora</string>
    <string name="settings_battery_path">nastajenja → programy → ylih → akumulator → njewobmjezjeny.</string>
    <string name="settings_hibernation_body">jolic se ylih pśez někotare mjasece njewócynijo, android ju zastanjo a wzejo jej dowólnosći, a nic se wěcej njenagrawa, až doniž ju njewócyniš. to wupinaś jo to, což dowólijo słuchatkam dalej licyś pśez cas, w kótaremž na nałoženje nigda njemysliš.</string>
    <string name="settings_hibernation_on">android móžo ylih zastaś.</string>
    <string name="settings_hibernation_off">ylih jo wuwzeta a nagrawa dalej.</string>
    <string name="settings_hibernation_button">nastajenja njewužywanych nałoženjow</string>
    <string name="settings_about">wó programje</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — hodinow w naušnikach, na smartfonu w wjecy.</string>
    <string name="settings_import_confirm_title">wšykne data wěnšujaš?</string>
