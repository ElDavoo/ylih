    <!-- تنظیمات -->
    <string name="settings_tracking">پیگیری</string>
    <string name="settings_detailed_title">پیگیری دقیق</string>
    <string name="settings_detailed_body">هدفون‌های سیمی و زمان پخش را اضافه می‌کند. android فقط رویدادهای اتصال سیمی را به یک برنامه درحال کار گزارش می‌دهد، بنابراین یک اعلان ساکت در سایه نگه داشته می‌شود. bluetooth در هر صورت پیگیری می‌شود.</string>
    <string name="settings_detailed_unavailable">در دسترس نیست تا زمانی که دسترسی bluetooth اعطا شود: این ساخت فقط نوع سرویس connectedDevice را اعلام می‌کند، که android 14+ آن را به اجازه bluetooth وابسته می‌کند.</string>
    <string name="settings_playback_only_title">فقط پخش شمرده شود</string>
    <string name="settings_playback_only_body">آمار به‌جای زمان اتصال، زمانی را می‌شمارد که صدا واقعاً پخش می‌شده است. فقط جلسه‌هایی که با پیگیری دقیق روشن ضبط شده‌اند پخش را اندازه گرفته‌اند؛ بقیه کنار گذاشته می‌شوند.</string>
    <string name="settings_language">زبان</string>
    <string name="settings_language_system">زبان سیستم</string>
    <string name="settings_devices">دستگاه‌ها</string>
    <string name="settings_devices_body">هر چیزی که هدفون نیست را غیرفعال کن — یک استریو ماشین یا یک بلندگو — تا ضبط آن متوقف شود.</string>
    <string name="settings_device_subtitle">%1$s · اولین مشاهده %2$s</string>
    <string name="settings_data">داده‌ها</string>
    <string name="settings_export">صادرات json</string>
    <string name="settings_import">وارد کردن</string>
    <string name="settings_import_warning">وارد کردن همه چیز ذخیره شده در حال حاضر را جایگزین می‌کند.</string>
    <string name="settings_troubleshooting">عیب‌یابی</string>
    <string name="settings_battery_body">اگر جلسات ضبط شدن متوقف شود، بررسی کنید که ylih از بهینه‌سازی باتری مستثنی است — یک برنامه‌ای که اجباری متوقف شده است، تا زمانی که باز نشود، هرگز دوباره پیام‌های اتصال دریافت نمی‌کند.</string>
    <string name="settings_battery_button">تنظیمات باتری</string>
    <string name="settings_battery_path">تنظیمات → برنامه‌ها → ylih → باتری → محدود نشده.</string>
    <string name="settings_hibernation_body">اگر ylih چند ماه باز نشود، android متوقفش می‌کند و دسترسی‌هایش را پس می‌گیرد، و تا زمانی که بازش نکنی چیزی دوباره ثبت نمی‌شود. خاموش کردن این همان چیزی است که اجازه می‌دهد یک جفت در فصلی که اصلاً به برنامه فکر نمی‌کنی هم به شمارش ادامه دهد.</string>
    <string name="settings_hibernation_on">android ممکن است ylih را متوقف کند.</string>
    <string name="settings_hibernation_off">ylih مستثنی است و همچنان ثبت می‌کند.</string>
    <string name="settings_hibernation_button">تنظیمات برنامه‌های استفاده‌نشده</string>
    <string name="settings_about">درباره</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — ساعات هدفون، ذخیره شده محلی و برای همیشه.</string>
    <string name="settings_import_confirm_title">تمام داده‌ها را جایگزین کنیم؟</string>
    <string name="settings_import_confirm_body">وارد کردن این پشتیبان هر دستگاه، جفت و جلسه ذخیره شده در حال حاضر را حذف می‌کند.</string>
