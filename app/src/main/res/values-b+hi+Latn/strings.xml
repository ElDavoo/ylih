    <string name="settings_battery_body">agar samvet na hon, dekhein ylih bateri optāmazesen se mukkt hai — ek app jo band ho gayā tab tak judetā nahī tak kholā nahī jātā.</string>
    <string name="settings_battery_button">bateri sthiti</string>
    <string name="settings_battery_path">sthiti → upskaran → ylih → bateri → asīmit.</string>
    <string name="settings_hibernation_body">agar ylih kuch mahine tak khul na rahe to android ise rukta hai aur anumati detā hai, aur koī chīz tab tak rekord nahī hotī jab tak kholā nahī jātā. is band karnā us vaqt kā silsilā rkhne deta hai jab āp app bhūl gaye hon.</string>
    <string name="settings_hibernation_on">android ylih ko rukh saktā hai.</string>
    <string name="settings_hibernation_off">ylih mukt hai aur gintī jārī rahtī hai.</string>
    <string name="settings_hibernation_button">ghaṛā gayā app sthiti</string>
    <string name="settings_about">kī bāt</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — hedāfon ghnten, sthānīy aur sada rkhē gayē.</string>
    <string name="settings_import_confirm_title">sab kuch dāta badl den?</string>
    <string name="settings_import_confirm_body">is backup ko āyāt karnā har upskaran, zyda aur samvet ko mtā detā hai jo abhi sañchit hai.</string>

