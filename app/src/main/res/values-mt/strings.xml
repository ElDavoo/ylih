    <string name="settings_tracking">traċċar</string>
    <string name="settings_detailed_title">tracking dettaljat</string>
    <string name="settings_detailed_body">iżżid headphones wired u l-ħin tal-playback. android issolwi jgħid wired plug events biss għal app li jaħdem, allura dan iżommu notifka silenziusa fl-ombra. bluetooth jiġi tracked xantier.</string>
    <string name="settings_detailed_unavailable">mhux disponibbli sal-ħadd li tintgħata aċċess bluetooth: il-build din issolwi jiddikjara l-type ta’ servizz connectedDevice biss, li android 14+ jgħoqqdu ma’ permission ta’ bluetooth.</string>
    <string name="settings_playback_only_title">għodd biss il-playback</string>
    <string name="settings_playback_only_body">stats tgħodd il-ħin li l-awdjo verament kien sejjer minflok il-ħin li kien qabbad. sessions biss rrekordjati b’tracking dettaljat fuq imkejjel playback; ir-resto jiġu ħallija.</string>
    <string name="settings_language">lingwa</string>
    <string name="settings_language_system">lingwa tas-sistema</string>
    <string name="settings_devices">apparati</string>
    <string name="settings_devices_body">waħħal kwalunkwe ħaġa li mhix headphones - car stereo jew speaker - biex twaqqaf tgħodd.</string>
    <string name="settings_device_subtitle">%1$s · l-ewwel ra %2$s</string>
