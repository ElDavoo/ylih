    <string name="settings_import">importa</string>
    <string name="settings_import_warning">l-import ibdel kollox li ġia maħżun.</string>
    <string name="settings_troubleshooting">soluzzjoni ta’ problemi</string>
    <string name="settings_battery_body">jekk sessions jissibu jitwaqqfu li jiġu rrekordjati, iftiex li ylih ikun exempt mill-battery optimisation - app li ġiet force-stopped qatt ma tirċibi broadcastings tal-qbala mill-ġdid sal-ħadd li tiftaħu.</string>
    <string name="settings_battery_button">issettjar tal-batterija</string>
    <string name="settings_battery_path">issettjar → apps → ylih → batterija → mingħajr restrizzjoni.</string>
    <string name="settings_hibernation_body">jekk ylih tmur miftuħa għal ftit xhur, android iwqafha u jieħdu l-permissions tiegħa lura, u xejn ma jirrekorda mill-ġdid sal-ħadd li tiftaħu. it-tlibesx ta’ dan hu li jħalli par tirkompli tuqgħod tgħodd permezz ta’ staġun li inti qatt ma taħsart dwar l-app.</string>
    <string name="settings_hibernation_on">android jista’ jwqaf ylih.</string>
    <string name="settings_hibernation_off">ylih exempt u tirkompli tgħodd.</string>
    <string name="settings_hibernation_button">settings tal-app mhux użata</string>
    <string name="settings_about">dwar</string>
    <string name="settings_about_body">ylih %1$s (%2$s) - sigħat ta’ headphones, maħħuża lokali u għal dejjem.</string>
    <string name="settings_import_confirm_title">ibdel il-data kollha?</string>
    <string name="settings_import_confirm_body">l-import ta’ il-backup din tmħassef kull device, par u session maħżun issa.</string>

