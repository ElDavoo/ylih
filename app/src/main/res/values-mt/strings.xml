    <string name="welcome_title">merħba f’ylih</string>
    <string name="welcome_intro">ylih jirrekorda kemm kull par ta’ headphones jibqa’ konness, sabiex snin minn issa tista’ tuġa’ tawwal fil-unika kwistjoni li twattat: kemm sigħat damet?</string>
    <string name="welcome_point_auto_title">qabbad u nesa</string>
    <string name="welcome_point_auto_body">bluetooth headphones huma rrekordjati waħedhom, mill-mument li qabbadu. xejn ma jrid jibqa’ sejjer.</string>
    <string name="welcome_point_lifetime_title">par wiehed, ħajja waħda</string>
    <string name="welcome_point_lifetime_body">meta par jmut, ritirali: it-totali tiegħu jiffriz hemm u l-par li jmiss ta’ l-istess headphones jibda mill-ġdid minn żero.</string>
    <string name="welcome_point_detailed_title">wired u playback</string>
    <string name="welcome_point_detailed_body">tracking dettaljat, f’settings, iżżid headphones wired u jmissu kemm tal-ħin kien qed tixgħel verament.</string>
    <string name="welcome_privacy">kollox jibqa’ fuq il-telefon tiegħek. m’hemmx account, u l-app m’għandux permess tal-internet.</string>
    <string name="welcome_start">iffetaħ</string>
    <string name="welcome_next">li jmiss</string>
    <string name="welcome_allow">ħalli</string>
    <string name="welcome_step">pass %1$d ta’ %2$d</string>
    <string name="welcome_bluetooth_title">aċċess bluetooth</string>
    <string name="welcome_bluetooth_why">android issolwi jgħid app liema bluetooth device qabbad, u kif jismu, jekk l-app ikollok aċċess bluetooth. dan hu kemm ylih jgħid par ta’ headphones minn car stereo, u kif jaf par wiehed minn iehor.</string>
    <string name="welcome_bluetooth_with">biha: kull par jiġi rrekordjat mill-mument li jqabbad, bl-ebda ħaġa ħamsa u l-ebda ħaġa li tiftakar ti daqq.</string>
    <string name="welcome_bluetooth_without">bla: ebda bluetooth headphones ma jiġu rrekordjati. il-baki tal-app xorta jaħdem, u tista’ tgħaddiha aktar tard fi settings ta’ android.</string>
    <string name="welcome_notifications_title">notifiki</string>
    <string name="welcome_notifications_why">tracking dettaljat jaħdem servizz ta’ background żgħir, u android jeħtieġ li kwalunkwe app li jagħmel dan iġodd notifika viżibbli waqt li jagħmel.</string>
    <string name="welcome_notifications_with">biha: in-notifika turi xiex qed jiġi rrekordjat issa, li hu l-uniku sinjal li tracking dettaljat ħaj.</string>
    <string name="welcome_notifications_without">bla: tracking dettaljat xorta jaħdem u xorta jirrekorda. android sempliċi mhux se juri n-notifika tiegħu.</string>
    <string name="hibernation_title">irkompli tuqgħod tgħodd filwaqt li tansa dwaru</string>
    <string name="hibernation_body">android jowqaf apps li jgħaddu bla miftuħ għal ftit xhur u jieħdu l-permissions tiegħom lura, li jħalli ylih jirrekorda xejn sal-ewwel darba li tiftaħu. li tkonk insejta hu eżattament dwar x’hu l-app din, allura jiswa li tlibesx issa.</string>
    <string name="action_not_now">mhux issa</string>

