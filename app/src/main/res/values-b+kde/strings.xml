    <string name="settings_tracking">kuandika</string>
    <string name="settings_detailed_title">kuandika kina</string>
    <string name="settings_detailed_body">inaongeza kuhuza jumakali na wakati wa kucheza. android inakamatia matukio ya jumakali tu kwa apps inayoendesha, ilo inaeneza arifa sukufi kwa sehemu. bluetooth inandikwa kwa njia yoyote.</string>
    <string name="settings_detailed_unavailable">haitoweza hadi ruhusa ya bluetooth itolewe: muundwa huu unakuja lindi lya connectedDevice tu, ndi yoyo android 14+ inauhusisha kwa ruhusa ya bluetooth.</string>
    <string name="settings_playback_only_title">hesabu kucheza tu</string>
    <string name="settings_playback_only_body">takwimu husabu wakati sauti ilikuwa inacheza badala ya wakati ilioungana. likizo tu lililoandikwa nayo kuandika kina inaweza kupimwa kucheza; zaidi yote hutengana.</string>
    <string name="settings_language">lugha</string>
    <string name="settings_language_system">lugha ya mfumo</string>
    <string name="settings_devices">vidonge</string>
    <string name="settings_devices_body">ondoa dalili kile si kuhuza — simu ya gadi au sauti — kusimama kuandika iyo.</string>
    <string name="settings_device_subtitle">%1$s · ilionekana kwanza %2$s</string>
