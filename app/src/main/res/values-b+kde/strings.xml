    <string name="welcome_title">karibu kwa ylih</string>
    <string name="welcome_intro">ylih inaandika kwa kiasi ki kuhuza kwima, ili baada ya miaka inaweza kujibu swali la kwamba: saa ngapi zililipita?</string>
    <string name="welcome_point_auto_title">jumuisha na kusahau</string>
    <string name="welcome_point_auto_body">kuhuza kwa bluetooth inandikwa yenyewe, kuanzia wakati inapojimu. hakuna kitu kinachohitaji kubaki kikifu.</string>
    <string name="welcome_point_lifetime_title">jumo limu, mazazi moja</string>
    <string name="welcome_point_lifetime_body">wakati jumo limu linakufa, sikiliza: jumla yake yabaki hapo na jumo jingine la kuhuza kilo linakweza kuanzia tena kutoka sifuri.</string>
    <string name="welcome_point_detailed_title">jumakali na kucheza</string>
    <string name="welcome_point_detailed_body">kuandika kina, kwa mipango, inaongeza kuhuza jumakali na kupima kiasi ki kucheza kwaliwepo halisi.</string>
    <string name="welcome_privacy">kila kitu kibaki mukilongi. hakuna akaunti, na app yina hakuna ruhusa ya intaneti.</string>
    <string name="welcome_start">anza</string>
    <string name="welcome_next">inayofuata</string>
    <string name="welcome_allow">vumia</string>
    <string name="welcome_step">hatua %1$d ya %2$d</string>
    <string name="welcome_bluetooth_title">ruhusa ya bluetooth</string>
    <string name="welcome_bluetooth_why">android inasimama tu app nini kidonge kya bluetooth kilijiunga, na kile kinachofanana, kama app ina ruhusa ya bluetooth. ni hivyo ylih inajua jumo la kuhuza kutoka kwa simu ya gadi, na ni hivyo inajua jumo limu kutoka kwa jingine.</string>
    <string name="welcome_bluetooth_with">nayo: jumo limu linandikwa kuanzia wakati inapojimu, bila hakuna kipengele kikifu na bila hakuna kinachohitaji kukamatia.</string>
    <string name="welcome_bluetooth_without">bila yake: kuhuza kwa bluetooth hakuna kinandikwa hata kidogo. sehemu nyingine ya app bado inafanya kazi, na wee wanaweza kukamatia baada ya muda kwa mipango ya android.</string>
    <string name="welcome_notifications_title">arifa</string>
    <string name="welcome_notifications_why">kuandika kina inaendesha huduma ndogo ya nyuma, na android inahitaji app yoyote inayofanya yake kuweka arifa inayoonekana wakati inavyofanya.</string>
    <string name="welcome_notifications_with">nayo: arifa inaonyesha kile kinandikwa sasa, ndi yoyo dalili tu ya kuandika kina kuwa kikifu.</string>
    <string name="welcome_notifications_without">bila yake: kuandika kina bado inaendesha na bado inandika. android tu haitaonyesha arifa yake.</string>
    <string name="hibernation_title">endelea kuhesabu wakati wanakusahau</string>
    <string name="hibernation_body">android inabuni apps nile zisizofunguliwa kwa miezi kadhaa na huondoa ruhusa zake, ndi yoyo ingeweza kuacha ylih isandike kitu hadi wakati unayoifungua tena. kusahauliwa ni haswa kile app iyi inakusudiwa kwa ajili yake, ilo ni stahili kukamatia sasa.</string>
