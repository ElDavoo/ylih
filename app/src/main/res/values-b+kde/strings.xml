    <string name="settings_import">ingiza</string>
    <string name="settings_import_warning">kuingiza kunabadilisha kile kote kilichokamatia sasa.</string>
    <string name="settings_troubleshooting">kutatua matatizo</string>
    <string name="settings_battery_body">kama likizo lisipoandikwa, angalia kwamba ylih haitawaziwa kutoka kwa uboreshaji wa betri — app iliyosimama kwa nguvu haipati ujumbe wa unganisho tena hadi ifunguliwe.</string>
    <string name="settings_battery_button">mipango ya betri</string>
    <string name="settings_battery_path">mipango → apps → ylih → betri → haiwaziwa.</string>
    <string name="settings_hibernation_body">kama ylih ifunguke kwa miezi kadhaa, android inabuni kile na huondoa ruhusa zake, na kitu si kiandikwa tena hadi ufungue. kukamatia yake ni kile kinaloruhusu jumo kuendelea kuhesabu wakati msimu wanakusahau app.</string>
    <string name="settings_hibernation_on">android inaweza kubuni ylih.</string>
    <string name="settings_hibernation_off">ylih haitawaziwa na inaendelea kuandika.</string>
    <string name="settings_hibernation_button">mipango ya apps isiyotumiwa</string>
    <string name="settings_about">juu</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — saa za kuhuza, zikamatia kwa ndani na milele.</string>
    <string name="settings_import_confirm_title">badilisha takwimu yote?</string>
    <string name="settings_import_confirm_body">kuingiza hii kutoleya kinachohifadhiwa kile kote: kidonge, jumo, likizo.</string>

