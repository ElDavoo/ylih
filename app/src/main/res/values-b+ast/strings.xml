    <!-- Axustes -->
    <string name="settings_tracking">rastrexu</string>
    <string name="settings_detailed_title">rastrexu detallau</string>
    <string name="settings_detailed_body">añade auriculares cableáu y tiempu de reproducción. android namái reporta eventos de conexón de cable a una app corriendo, asina que guarda una notificación silenciosa na cortina. bluetooth siempre se rastrea.</string>
    <string name="settings_detailed_unavailable">nun ta disponible hasta que se conceda accesu a bluetooth: esta compilación namái declara’l tipu de serviciu connectedDevice, que android 14+ enlaza a un permisu de bluetooth.</string>
    <string name="settings_playback_only_title">cuntar namás la reproducción</string>
    <string name="settings_playback_only_body">les estadístiques cunten el tiempu que l’audiu tuvo reproduciéndose de verdá en cuenta del tiempu coneutáu. namás les sesiones rexistraes col rastrexu detallau activáu midieron la reproducción; les demás quéden fuera.</string>
    <string name="settings_language">llingua</string>
    <string name="settings_language_system">llingua del sistema</string>
    <string name="settings_devices">dispositivus</string>
    <string name="settings_devices_body">desclinca too lo que nun seya auriculares — un sistema d’auto o un altavoz — pa dexa de grabalo.</string>
    <string name="settings_device_subtitle">%1$s · primera vegada visto %2$s</string>
    <string name="settings_data">datos</string>
    <string name="settings_export">esportar json</string>
    <string name="settings_import">importar</string>
    <string name="settings_import_warning">importar reemplaza too lo qu’agora tá guardáu.</string>
    <string name="settings_troubleshooting">solucionar problemes</string>
    <string name="settings_battery_body">si les sesiones dexen de grabarse, comprueba que ylih ta escluyíu de l’optimización de batería — una app parada a la fuerza nunca vuelve a recibir eventos de conexón hasta que se abre de nuevu.</string>
    <string name="settings_battery_button">axustes de batería</string>
    <string name="settings_battery_path">axustes → apps → ylih → batería → non restrinxíu.</string>
    <string name="settings_hibernation_body">si ylih pasa dellos meses ensin abrise, android detiénla y retira-y los permisos, y nada se vuelve rexistrar hasta que la abras. desactivar eso ye lo que dexa que un par siga contando mientres una temporada na que nin te alcuerdes de la app.</string>
    <string name="settings_hibernation_on">android pue detener ylih.</string>
    <string name="settings_hibernation_off">ylih ta exenta y sigui rexistrando.</string>
    <string name="settings_hibernation_button">axustes d’aplicaciones ensin usar</string>
    <string name="settings_about">acerca de</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — hores en auriculares, guaardaes localmente pa siempre.</string>
    <string name="settings_import_confirm_title">¿reemplazar tolos datos?</string>
    <string name="settings_import_confirm_body">importar esta copia de seguridá desanicia cada dispositivu, par y sesión guardáu agora.</string>
