    <string name="channel_tracking">rastrexu d\'auriculares</string>
    <string name="channel_tracking_description">apaez mentre ylih ta mirando por auriculares cableáu y reproducción. android nun entrega eventos de conexón de cable a apps que nun tán corriendo.</string>
