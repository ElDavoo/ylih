    <string name="welcome_bluetooth_title">bluetooth chosindet</string>
    <string name="welcome_bluetooth_why">android ibichok kwa aap koni bluetooth simu kosiyek, ari engʼa sitit, ikicha aap itekik bluetooth chosindet. se cha ylih imben emwusis koni stereo ngʼa moget, ari se apmit ibenindet.</string>
    <string name="welcome_bluetooth_with">kiwot: emwusis kosiyek osae ne botik miten, iten mibisitin kotek, ari mibisitin kotenget chopiyek.</string>
    <string name="welcome_bluetooth_without">ari mibisitin: emwusis bluetooth mibisitin botiek. ylih taata ikitek, ari ne igosubok later kwa android simu aap saitinsi.</string>
    <string name="welcome_notifications_title">korogeta</string>
    <string name="welcome_notifications_why">sitaatistik mabunyin ibotiyek simu nyini backend, ari android chopiyek aap kotik korogeta rotiyek intabes ne osae.</string>
    <string name="welcome_notifications_with">kiwot: korogeta ibochok engʼa kotok ara, engʼa sitit kobo sitaatistik mabunyin osae.</string>
    <string name="welcome_notifications_without">ari mibisitin: sitaatistik mabunyin ikitek ari kotik. android mibisitin ibochok korogeta.</string>
    <string name="hibernation_title">kotenget kotenget ne botiset</string>
    <string name="hibernation_body">android ibochepak aap ne mibisitin ikimuet ngʼa lacha, ari kotik chosindet, ylih mibisitin botiek intabes ne imiot. kobotweny se cha aap se cha, ikicha ko wengʼito ariki.</string>
