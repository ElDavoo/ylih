    <string name="welcome_title">karibu kwa ylih</string>
    <string name="welcome_intro">ylih ibokisyek indet ya emwusis koktit, ikicha kokwei kolaaki wechi - kobo ngʼa eosek kwa pongeta mot: kobo kotagit?</string>
    <string name="welcome_point_auto_title">inyokosyek ari botiset</string>
    <string name="welcome_point_auto_body">emwusis bluetooth botiyek osae keny ne kokiminik. iten mibisitin ko botek.</string>
    <string name="welcome_point_lifetime_title">emwusis aiot, ubweni aiot</string>
    <string name="welcome_point_lifetime_body">emwusis ki kimatik, titiek: koney kosiyek kuche, ari emwusis kopiisyek emwusis mot tapweny.</string>
    <string name="welcome_point_detailed_title">entaap ari kogo</string>
    <string name="welcome_point_detailed_body">sitaatistik mabunyin, kwa saitinsi, ibotik entaap emwusis ari korekta ngʼa sekisyek.</string>
    <string name="welcome_privacy">saita iten simu inye. mibisitin koniitet, ari ylih mibisitin simu intainet.</string>
