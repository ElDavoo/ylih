    <string name="welcome_title">oyawore e ylih</string>
    <string name="welcome_intro">ylih ndiko kinde ma hedfon ka hedfon siko kotwe, mondo bangʼ higni mangʼeny pod inyal dwoko penjo achiel maduongʼ kuom hedfon: negisiko kuom saa adi?</string>
    <string name="welcome_point_auto_title">twe kendo wiyi owil</string>
    <string name="welcome_point_auto_body">hedfon mag bluetooth indiko kendgi giwegi, chakre sa ma gitwe. onge gimoro monego owe katiyo.</string>
    <string name="welcome_point_lifetime_title">hedfon achiel, ngima achiel</string>
    <string name="welcome_point_lifetime_body">ka hedfon otho, gole tich: kwan mare chungo kanyo kendo hedfon maluwo mar kite achiel chako kendo koa e nono.</string>
    <string name="welcome_point_detailed_title">waya kod wer</string>
    <string name="welcome_point_detailed_body">luwo matut, e chenro, medo hedfon mag waya kendo pimo kinde adier mane wer wuok.</string>
    <string name="welcome_privacy">gik moko duto siko e simboni. onge akaunt, kendo app onge thuolo mar intanet.</string>
    <string name="welcome_start">chak</string>
    <string name="welcome_next">maluwo</string>
    <string name="welcome_allow">yie</string>
    <string name="welcome_step">okang %1$d kuom %2$d</string>
    <string name="welcome_bluetooth_title">yudo bluetooth</string>
    <string name="welcome_bluetooth_why">android nyiso app mana gima bluetooth motwe, kod nyinge, ka app nigi thuolo mar bluetooth. mano e kaka ylih pogo hedfon gi redio mar mtoka, kendo ngʼeyo hedfon achiel gi machielo.</string>
    <string name="welcome_bluetooth_with">ka en: hedfon ka hedfon indiko chakre sa ma otwe, maonge gimoro modongʼ katiyo kendo maonge gima nyaka ipar dino.</string>
    <string name="welcome_bluetooth_without">ka onge: onge hedfon mar bluetooth mindiko. kuonde mamoko mag app pod tiyo, kendo inyalo chiwe bangʼe e chenro mag app mag android.</string>
    <string name="welcome_notifications_title">weche mineno</string>
    <string name="welcome_notifications_why">luwo matut tiyo gi tich matin man tok, kendo android dwaro ni app moro amora matimo kamano orit ranyisi mineno e kindeno.</string>
    <string name="welcome_notifications_with">ka en: ranyisi nyiso gima indiko sani, mano kende e ranyisi ni luwo matut ngima.</string>
    <string name="welcome_notifications_without">ka onge: luwo matut pod tiyo kendo pod ndiko. android mana ok nonyis ranyisine.</string>
    <string name="hibernation_title">medo kwano ka wiyi owil kode</string>
    <string name="hibernation_body">android chungo app ma ok yaw kuom dweche moko kendo kawo thuologi, ma dine oweyo ylih ma ok ndiko gimoro nyaka iyawe kendo. wiyi wil kode e gima omiyo app ni obedie, omiyo ber ni ichung mano sani.</string>
