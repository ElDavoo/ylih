    <string name="welcome_title">ᏑᏓᏩ ᎠᏂᏆᏍᏗ ylih ᏍᏍᎦ</string>
    <string name="welcome_intro">ylih ᎠᏥᏃᏗ ᏰᎳ ᏙᏦᎵ ᎠᏎᎩ ᏒᏂ ᎾᎬᎾᏓ ᎦᏵᏕ ᎦᏴ ᎤᎬᏬᏌᏛ, ᏰᎳ ᎤᏃᏫᏓᏗ ᎬᏒ ᎶᎩᎵᏒ ᏅᎯᏑ ᎤᎧᎨ ᏫᎪᎰᏓ ᏂᏗᏪᏦ ᏫᎪᎵᏒ ᏙᎦᏒ ᎠᏎᎩ: ᏰᎳ ᎨᎮᎵᏍᎬ ᏒᏂ ᎿᏲᏒ?</string>
    <string name="welcome_point_auto_title">ᏙᏦᎵ ᎠᎴ ᏫᎩᏘᏓ</string>
    <string name="welcome_point_auto_body">bluetooth ᎠᏎᎩ ᎠᏥᏃᏗ ᎢᏳᎾᏢᎩ, ᏙᏦᎵ ᎪᏛᎩᏃ ᎦᏴ, ᎾᎿ ᎤᏂᏎᎵᏍ ᏆᎬᏒ ᎠᏃᏗ ᎢᏉᎪᏫ.</string>
    <string name="welcome_point_lifetime_title">ᎡᏚᎭ ᏂᏗᏪᏦ, ᎡᏚᎭ ᎿᏲ</string>
    <string name="welcome_point_lifetime_body">ᏙᏦᎵ ᎧᎵᏍᏗ ᏙᎦᏒ, ᎢᎬᏩᏛᎩᏗ: ᎥᏝ ᏗᏓᎵᏛᏅ ᏰᎳ ᏒᏂ ᎤᏂᏈᎸᏴᏒ, ᎠᎴ ᏙᏦᎵ ᏫᎴ ᏂᎬᎾᏓ ᎦᏴ ᏙᎾᏁᏛ ᎡᏁᎵ ᎢᎬᏩᏛᏛᎾ.</string>
    <string name="welcome_point_detailed_title">ᏗᎲᎵᎭ ᎠᎴ ᎾᎪᎾᏓ</string>
    <string name="welcome_point_detailed_body">ᏰᎩᏂᏃᎩ ᏆᎬᏒ ᏙᏦᎵ, ᎠᏤᏣᏓᏅᏖ ᎤᏙᎦᎵᎩ, ᎠᏕᎥ ᏗᎲᎵᎭ ᎠᏎᎩ ᎠᎴ ᎾᎪᎾᏓ ᎦᏴ ᏭᏗ ᎯᎾᏕᎾ ᎦᏵᏕ.</string>
    <string name="welcome_privacy">ᏚᏁᏇ ᏂᏂ ᎠᏍᏌ ᎠᏍᏗ. ᎾᎿ ᎠᎾᏘᏘ ᎦᏌᏅᎩ ᏆᎬᏒ, ᎠᎴ ᎠᏆᎾᏗ ᎠᏃᏗ ᎤᏂᏈᎸᏴᏒ ᏃᎩᏲᏍ ᏗᎾ.</string>
    <string name="welcome_start">ᏫᎩᏅᏒ</string>
    <string name="hibernation_title">ᎬᏂᎨᏒ ᎢᏳᏍᏗ ᎢᏣᏅᏓᏗᏍᏙᏗ ᎨᏒ ᎢᏳᏃ ᎢᏣᏅᏛᎩ</string>
    <string name="hibernation_body">android ᏗᎪᏢᏔᏅ ᎾᏍᎩ ᎦᏳᎳᏗᏒ ᎾᏛᎪᏔᏅᎾ ᎨᏒ ᏚᏂᏲᎯᎯᏒᎩ, ᎠᎴ ᏓᏂᏲᎯᏎᎲ ᎡᎳᏗᏗᏍᎪᎢ. ᎾᏍᎩ ylih ᎪᎱᏍᏗ ᎥᏝ ᏱᎦᏫᏍᎪ ᏂᎯ ᎢᏣᏂᏱᏍᎬ ᎢᏳᎢᏗᏒ. ᎠᏅᏓᏗᏍᏙᏗ ᎾᏍᎩ ᎠᏓᏅᏙ ᎠᏂ ᎠᏰᎸᏓ ᏥᎩ, ᎾᏍᎩᏃ ᎠᎳᏱᏂᏙᎲ ᎠᏥᎩᏗᏍᏙᏗ ᏂᎦᏓ.</string>
