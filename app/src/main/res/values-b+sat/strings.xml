    <string name="welcome_title">ylih ᱨᱮ ᱡᱚᱦᱟᱨ</string>
    <string name="welcome_intro">ylih ᱚᱞ ᱠᱟᱜᱼᱟ ᱡᱮ ᱢᱤᱫ ᱢᱤᱫ ᱦᱮᱰᱯᱷᱚᱱ ᱡᱚᱲᱟ ᱛᱤᱱᱟᱜ ᱚᱠᱛᱚ ᱡᱩᱲᱟᱣ ᱛᱟᱦᱮᱸᱱᱟ, ᱚᱱᱟ ᱛᱮ ᱵᱚᱪᱷᱚᱨ ᱛᱟᱭᱚᱢ ᱦᱚᱸ ᱟᱢ ᱢᱤᱫ ᱠᱩᱠᱞᱤ ᱨᱮᱭᱟᱜ ᱛᱮᱞᱟ ᱮᱢ ᱫᱟᱲᱮᱭᱟᱜᱼᱟᱢ — ᱛᱤᱱᱟᱜ ᱴᱟᱲᱟᱝ ᱠᱟᱹᱢᱤ ᱠᱮᱫᱟ?</string>
    <string name="welcome_point_auto_title">ᱡᱩᱲᱟᱣ ᱢᱮ ᱟᱨ ᱦᱤᱲᱤᱸᱡᱽ ᱢᱮ</string>
    <string name="welcome_point_auto_body">bluetooth ᱦᱮᱰᱯᱷᱚᱱ ᱡᱩᱲᱟᱣ ᱚᱠᱛᱚ ᱠᱷᱚᱱ ᱟᱡᱮ ᱛᱮ ᱚᱞ ᱦᱩᱭᱩᱜᱼᱟ। ᱡᱟᱦᱟᱸᱱ ᱦᱚᱸ ᱪᱟᱹᱞᱩ ᱫᱚᱦᱚ ᱵᱟᱝ ᱞᱟᱹᱠᱛᱤ।</string>
    <string name="welcome_point_lifetime_title">ᱢᱤᱫ ᱡᱚᱲᱟ, ᱢᱤᱫ ᱡᱤᱭᱚᱱ</string>
    <string name="welcome_point_lifetime_body">ᱡᱚᱲᱟ ᱜᱚᱡᱚᱜ ᱠᱟᱛᱮ ᱚᱱᱟ ᱵᱟᱹᱭ ᱢᱮ: ᱚᱱᱟᱜ ᱞᱮᱠᱷᱟ ᱚᱱᱰᱮ ᱛᱮᱭᱟᱜᱼᱟ, ᱟᱨ ᱚᱱᱟ ᱦᱮᱰᱯᱷᱚᱱ ᱨᱮᱭᱟᱜ ᱮᱴᱟᱜ ᱡᱚᱲᱟ ᱥᱩᱱ ᱠᱷᱚᱱ ᱮᱦᱚᱵᱚᱜᱼᱟ।</string>
    <string name="welcome_point_detailed_title">ᱛᱟᱨ ᱟᱨ ᱟᱹᱡᱚᱢ</string>
    <string name="welcome_point_detailed_body">ᱥᱟᱡᱟᱣ ᱨᱮ ᱵᱤᱥᱛᱟᱨ ᱮᱴᱠᱮᱴᱚᱬ ᱛᱟᱨ ᱦᱮᱰᱯᱷᱚᱱ ᱦᱚᱸ ᱥᱮᱞᱮᱫᱼᱟ ᱟᱨ ᱛᱤᱱᱟᱜ ᱚᱠᱛᱚ ᱥᱟᱰᱮ ᱦᱩᱭ ᱮᱱᱟ ᱚᱱᱟ ᱦᱚᱸ ᱞᱮᱠᱷᱟᱭᱟ।</string>
    <string name="welcome_privacy">ᱡᱚᱛᱚ ᱠᱟᱹᱢᱤ ᱱᱚᱶᱟ ᱯᱷᱚᱱ ᱨᱮ ᱜᱮ ᱛᱟᱦᱮᱸᱱᱟ। ᱡᱟᱦᱟᱸᱱ ᱮᱠᱟᱩᱱᱴ ᱵᱟᱹᱱᱩᱜᱼᱟ, ᱟᱨ ᱟᱯ ᱨᱮ ᱤᱱᱴᱟᱨᱱᱮᱴ ᱦᱩᱠᱩᱢ ᱦᱚᱸ ᱵᱟᱹᱱᱩᱜᱼᱟ।</string>
