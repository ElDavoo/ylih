    <string name="welcome_bluetooth_title">bluetooth ᱦᱩᱠᱩᱢ</string>
    <string name="welcome_bluetooth_why">android ᱫᱚ ᱟᱯ ᱠᱚ ᱮᱢᱟᱜ ᱠᱟᱱᱟ ᱡᱮ ᱚᱠᱟ bluetooth ᱡᱤᱱᱤᱥ ᱡᱩᱲᱟᱣ ᱮᱱᱟ ᱟᱨ ᱚᱱᱟᱜ ᱧᱩᱛᱩᱢ ᱪᱮᱫ, ᱡᱚᱠᱷᱚᱱ ᱟᱯ ᱨᱮ bluetooth ᱦᱩᱠᱩᱢ ᱢᱮᱱᱟᱜᱼᱟ। ᱚᱱᱟ ᱛᱮ ᱜᱮ ylih ᱦᱮᱰᱯᱷᱚᱱ ᱟᱨ ᱜᱟᱲᱤ ᱨᱮᱭᱟᱜ ᱥᱯᱤᱠᱟᱨ ᱵᱷᱮᱜᱟᱨ ᱮᱫᱟᱭ।</string>
    <string name="welcome_bluetooth_with">ᱱᱚᱶᱟ ᱥᱟᱶ: ᱡᱚᱛᱚ ᱡᱚᱲᱟ ᱡᱩᱲᱟᱣ ᱚᱠᱛᱚ ᱠᱷᱚᱱ ᱜᱮ ᱚᱞ ᱦᱩᱭᱩᱜᱼᱟ, ᱡᱟᱦᱟᱸᱱ ᱦᱚᱸ ᱪᱟᱹᱞᱩ ᱵᱟᱝ ᱛᱟᱦᱮᱸᱱᱟ।</string>
    <string name="welcome_bluetooth_without">ᱱᱚᱶᱟ ᱵᱟᱝ ᱛᱮ: ᱡᱟᱦᱟᱸᱱ bluetooth ᱦᱮᱰᱯᱷᱚᱱ ᱵᱟᱝ ᱚᱞᱚᱜᱼᱟ। ᱟᱯ ᱨᱮᱭᱟᱜ ᱮᱴᱟᱜ ᱠᱟᱹᱢᱤ ᱪᱟᱹᱞᱩᱜᱼᱟ, ᱟᱨ ᱛᱟᱭᱚᱢ android ᱥᱟᱡᱟᱣ ᱨᱮ ᱦᱩᱠᱩᱢ ᱮᱢ ᱫᱟᱲᱮᱭᱟᱜᱼᱟᱢ।</string>
    <string name="welcome_notifications_title">ᱠᱷᱚᱵᱚᱨ</string>
    <string name="welcome_notifications_why">ᱵᱤᱥᱛᱟᱨ ᱮᱴᱠᱮᱴᱚᱬ ᱢᱤᱫ ᱦᱩᱰᱤᱧ ᱠᱟᱹᱢᱤ ᱪᱟᱹᱞᱩ ᱫᱚᱦᱚᱭᱟ, ᱟᱨ android ᱚᱱᱟ ᱞᱮᱠᱟᱱ ᱟᱯ ᱠᱷᱚᱱ ᱢᱤᱫ ᱠᱷᱚᱵᱚᱨ ᱧᱮᱞᱚᱜ ᱞᱟᱹᱠᱛᱤᱭᱟ।</string>
    <string name="welcome_notifications_with">ᱱᱚᱶᱟ ᱥᱟᱶ: ᱠᱷᱚᱵᱚᱨ ᱩᱫᱩᱜᱼᱟ ᱡᱮ ᱱᱤᱛᱚᱜ ᱪᱮᱫ ᱚᱞ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ, ᱟᱨ ᱚᱱᱟ ᱜᱮ ᱩᱫᱩᱜᱼᱟ ᱡᱮ ᱮᱴᱠᱮᱴᱚᱬ ᱡᱤᱣᱤ ᱢᱮᱱᱟᱜᱼᱟ।</string>
    <string name="welcome_notifications_without">ᱱᱚᱶᱟ ᱵᱟᱝ ᱛᱮ: ᱮᱴᱠᱮᱴᱚᱬ ᱛᱟᱨᱟᱥ ᱪᱟᱹᱞᱩᱜᱼᱟ ᱟᱨ ᱚᱞᱟ। android ᱠᱷᱟᱹᱞᱤ ᱚᱱᱟᱜ ᱠᱷᱚᱵᱚᱨ ᱵᱟᱝ ᱩᱫᱩᱜᱼᱟ।</string>
    <string name="hibernation_title">ᱟᱢ ᱦᱤᱲᱤᱸᱡᱽ ᱚᱠᱛᱚ ᱦᱚᱸ ᱞᱮᱠᱷᱟ ᱛᱟᱦᱮᱸᱱ ᱞᱟᱹᱜᱤᱫ</string>
    <string name="hibernation_body">ᱛᱤᱱᱟᱜ ᱪᱟᱸᱫᱚ ᱫᱷᱟᱹᱨᱛᱤ ᱵᱟᱝ ᱡᱷᱤᱡ ᱟᱯ ᱠᱚ android ᱛᱷᱤᱨ ᱮᱫᱟᱭ ᱟᱨ ᱚᱱᱟᱜ ᱦᱩᱠᱩᱢ ᱨᱩᱣᱟᱹᱲ ᱤᱫᱤᱭᱟ, ᱚᱱᱟ ᱛᱮ ylih ᱚᱠᱛᱚ ᱦᱟᱹᱵᱤᱡ ᱡᱟᱦᱟᱸᱱ ᱵᱟᱝ ᱚᱞᱟ ᱡᱟᱦᱟᱸ ᱦᱟᱹᱵᱤᱡ ᱟᱢ ᱵᱟᱝ ᱡᱷᱤᱡᱮᱭᱟᱢ। ᱦᱤᱲᱤᱸᱡᱽ ᱜᱮ ᱱᱚᱶᱟ ᱟᱯ ᱨᱮᱭᱟᱜ ᱠᱟᱹᱢᱤ ᱠᱟᱱᱟ, ᱚᱱᱟ ᱛᱮ ᱱᱤᱛᱚᱜ ᱜᱮ ᱵᱟᱝ ᱛᱷᱤᱨ ᱞᱟᱹᱠᱛᱤ।</string>
