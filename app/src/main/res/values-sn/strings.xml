    <string name="settings_troubleshooting">kuitawo nokuzvitwika</string>
    <string name="settings_battery_body">kana mipikiso imisa kurangarira, tarisa kuti ylih hasisikiro kubvira battery optimization - app yakakurudzwa inogona kusiiwa kumatanho okurangarira kusvika ifukurwa.</string>
    <string name="settings_battery_button">zvitunzvi zvebattery</string>
    <string name="settings_battery_path">zvitunzvi → migadget → ylih → battery → musungu.</string>
    <string name="settings_hibernation_body">kana ylih igara isina kufukurwa kwemazuva, android inomisa uye inotora mvumo dzayo, uye hapana chinhu chinobhadharwa kusvika ufukure. kujamba kudai ndiko kunyanyanya kubvumidza sora kuenderera kubva pazuva regichana usina rangarira app.</string>
    <string name="settings_hibernation_on">android inogona kumiisa ylih.</string>
    <string name="settings_hibernation_off">ylih hasisikiro uye inoramba ichirangarira.</string>
    <string name="settings_hibernation_button">zvitunzvi zveapp zvisina kushandiswa</string>
    <string name="settings_about">kunokonzerwa</string>
    <string name="settings_about_body">ylih %1$s (%2$s) - mahora emasinete, anochengetedzwa zviraivanaka nokusvika rinhi.</string>
    <string name="settings_import_confirm_title">shanduro yose ruzivo?</string>
    <string name="settings_import_confirm_body">kuita backup iyi inodzura migadget iyoyi, sora neuye mipikiso inobhadharwa ikozvino.</string>

