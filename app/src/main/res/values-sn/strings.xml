    <string name="welcome_title">kamukamirai kuylic</string>
    <string name="welcome_intro">ylih inotsanangura kuti pairingana yemasinete inogara yakasangana nani, kuitira kuti muna mazuva acho unogona kutozvicarira chidimuro chisinei panyama pasi: mahora mangani akagara?</string>
    <string name="welcome_point_auto_title">sangana ubvunzuke</string>
    <string name="welcome_point_auto_body">bluetooth masinete anobhadharwa pachavo, kubvira panguva yamacangana. hapana chinhu chinofanira kusara kuchiitwa.</string>
    <string name="welcome_point_lifetime_title">sora imwe, upenyu umwe</string>
    <string name="welcome_point_lifetime_body">kana sora yarova, isundire: zvakakora zvayo zvinomirayira ipapo uye pairingana yomasinete imwechete ichamba zvinodzoka kubva zero.</string>
    <string name="welcome_point_detailed_title">nomwe nechikomborekedzo</string>
    <string name="welcome_point_detailed_body">kurangarira kwinzira, muzvitunzvi, kwinowedzera nomwe masinete uye inosumudzira mangani oupenyu ainyorwa kuchiita.</string>
    <string name="welcome_privacy">zvose zvinogara muphone iyi. hapana akawunti, uye app haina mvumo yeinterneti.</string>
    <string name="welcome_start">chiwedzero</string>
    <string name="welcome_next">rinotevera</string>
    <string name="welcome_allow">zyakenai</string>
    <string name="welcome_step">hundo %1$d ye %2$d</string>
    <string name="welcome_bluetooth_title">mvumo yebluetooth</string>
    <string name="welcome_bluetooth_why">android inoudzisa app chete yebluetooth gadget yakasangana, uye zvinoitwa, kana app ine mvumo yebluetooth. ndicho chinyarara ylih inotarisana sora yemasinete kubva mota stereo, uye inozviziva pairingana imwe kubva kumwe.</string>
    <string name="welcome_bluetooth_with">nemazviri: sora imwe iyoyi inobhadharwa kubvira panguva yamacangana, hamuna zvinogara kuchiitwa uye hamuna chavakanyarara kurangarira.</string>
    <string name="welcome_bluetooth_without">pasina: bluetooth masinete hasongazviiti kufa. zvimwe zvapp zvichiramba zvichishanda, uye unogona kuzvipiwa gare-gare muandroid app zvitunzvi.</string>
    <string name="welcome_notifications_title">mburongudzo</string>
    <string name="welcome_notifications_why">kurangarira kwinzira kunonzwa seavhi yakareruka, uye android inoda kana app ine zvakadai kunatsa mburongudzo inobvisikwa ndiko kwechii.</string>
    <string name="welcome_notifications_with">nemazviri: mburongudzo inoratidzira zvinobhadharwa ipapo, chigaro chimwe choga chinosangana kurangarira kwinzira kuraramba.</string>
    <string name="welcome_notifications_without">pasina: kurangarira kwinzira kunoramba kunoshanda uye kunobhadharwa. android chete haizviratidzi mburongudzo yayo.</string>
    <string name="hibernation_title">tongeredzera uri unorambidza zvino</string>
    <string name="hibernation_body">android inomisa app dzinogara dzisazviroorwa kwechimwe nguva uye inotora mvumo dzazo, izvo zvingadai ylih isave kufa kusvika unofukura ipapo. kushanduka iwe zviri chete zvinyorwa app iyi, saka inofanira kubvisa kune zvivhunga.</string>
