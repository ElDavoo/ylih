    <string name="settings_tracking">kurangarira</string>
    <string name="settings_detailed_title">kurangarira kwinzira</string>
    <string name="settings_detailed_body">kwinowedzera nomwe masinete uye mahora ekushanda. android inoudzisa nomwe plug zvingapinda chete kuapp inoshanda, saka iyi ichichengeta mburongudzo yakanyarara. bluetooth inorangarira zvose.</string>
    <string name="settings_detailed_unavailable">hasisikiro kusvika bluetooth mvumo ipiwe: build iyi inoratidzira chete connectedDevice seavhi yakaita, izvo android 14+ inosungira nebluetooth mvumo.</string>
    <string name="settings_playback_only_title">verengeza kunhemutsa chete</string>
    <string name="settings_playback_only_body">mihlelo inorangarira mahora ekushanda sezvakaiitwa zvinoshanda. mipikiso chete inobhadharwa nokurangarira kwinzira panguva yokusumudzirwa kunhemutsa; zvimwe zvingasiiwa.</string>
