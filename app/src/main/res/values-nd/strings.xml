    <string name="settings_language_system">ulimi lwe-system</string>
    <string name="settings_devices">izinkundla</string>
    <string name="settings_devices_body">susa okungamakwelo - stereo yofinyelela noma umsithi - ukuvimela inkumbulo yayo.</string>
    <string name="settings_device_subtitle">%1$s · okokuqala okubonakali %2$s</string>
