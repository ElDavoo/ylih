    <string name="welcome_title">amukela ku ylih</string>
    <string name="welcome_intro">ylih yaleqa isikhathi esininde okunomsulwa kwawo wamakwelo ashumayelana, kuze kwabo abantu abenakho kumbuze imibuzo elilodwa elibalulekile mayelana nomuntu: zingaphi iawu emfuleni?</string>
    <string name="welcome_point_auto_title">xhumeka uwusubaleni</string>
    <string name="welcome_point_auto_body">amakwelo e-bluetooth aleqwe ngokuzodwa kusukela ekushumekeni kwakho. akukho isatshala esisadelela.</string>
    <string name="welcome_point_lifetime_title">umuntu oyodwa, umuntu oyodwa</string>
    <string name="welcome_point_lifetime_body">nxa umuntu ufe, umdisize: ingcwele yafela kulapho unomsulwa omusha womuntu ofanayo usuqala futhi kusukela eziro.</string>
    <string name="welcome_point_detailed_title">enenthalathalathi nokusonsela</string>
    <string name="welcome_point_detailed_body">ukuqina okubalulekile ekunikezelweni kwezokuthuthukisa amakwelo abezinthalathalathi nokuthola kangakanani isikhathi abakusebenzisele kwakungo kwakungo.</string>
    <string name="welcome_privacy">konke kushiye ku foni yakho. azikho iakhawunti kuze ngosayiti akalinayo.</string>
    <string name="welcome_start">qalisa</string>
    <string name="welcome_next">okunxele</string>
    <string name="welcome_allow">vumela</string>
    <string name="welcome_step">inyathelo %1$d ye %2$d</string>
    <string name="welcome_bluetooth_title">inzinga le-bluetooth</string>
    <string name="welcome_bluetooth_why">android kulungile lapha owonke siphakamiselele i-bluetooth esebenzayo sifikela eyakho ofike lapha umuntu wamakwelo owodwa wangamathothele umuntu.</string>
    <string name="welcome_bluetooth_with">ngaphansi: konke umsulwa uleqwe kusukela ekushumekeni kwakho, akunikeze isatshala futhi angenzuza.</string>
    <string name="welcome_bluetooth_without">kungekhona: amakwelo e-bluetooth akukho okulalelwa. inkosikazi yodwa eyamkhona kwakungo futhi ungawonika kamuva ku-android izigebezo.</string>
    <string name="welcome_notifications_title">notifications</string>
    <string name="welcome_notifications_why">detailed tracking runs a small background service, and android requires any app doing that to keep a notification visible while it does.</string>
    <string name="welcome_notifications_with">with it: the notification shows what is being recorded right now, which is the only sign detailed tracking is alive.</string>
    <string name="welcome_notifications_without">without it: detailed tracking still runs and still records. android just will not show its notification.</string>
    <string name="hibernation_title">qhubeka ubala ngesikhathi oyewusubale</string>
    <string name="hibernation_body">android ihoxisa izinhlelo ezivulwe kwengezinsuku ezimbalwa ufake izintando zayo kamuva, okwenza ylih ingena lutho kufinyelile umdlalili wokonakala. wusugwebe ngalilokhu okusebenza ngaleli lize ngamanzi, ngakho nakuze kuvale.</string>
