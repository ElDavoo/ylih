    <string name="settings_import_warning">ukuingena kutshintsha konke okugcina okwamanje.</string>
    <string name="settings_troubleshooting">ukulutha okungenzeka</string>
    <string name="settings_battery_body">nxa umsebenzi ayasi libhalwe, hlola ukuthi ylih ivumelwe kumthamo we-battery - inkosikazi eyafakwa ngokukhigwa ayikaze ithathe izintando zokusingxumane kufinyelele umdlaluli wokonakala.</string>
    <string name="settings_battery_button">izigebezo ze-battery</string>
    <string name="settings_battery_path">izigebezo → inhlelo → ylih → ababesi → okungemukhele.</string>
    <string name="settings_hibernation_body">nxa ylih ivulwe izinyanga ezimbalwa, i-android iyalibala iyifunde izintando zayo, futhi lutho alikholo kufinyelele umdlaluli wokonakala. ukuvula lokhu yinyathelo eyenza umsulwa aqhubeke nokubala ngenkathi yakho ayikuqapheli inkosikazi.</string>
    <string name="settings_hibernation_on">i-android ingase ihleze i-ylih.</string>
    <string name="settings_hibernation_off">i-ylih ivumelwe niqhubeka nokubala.</string>
    <string name="settings_hibernation_button">izigebezo zeinhlelo elingasetshenzisiwe</string>
    <string name="settings_about">mayelana neyo</string>
    <string name="settings_about_body">ylih %1$s (%2$s) - iawu yomakwelo, ibalelwe endawo nethunjini.</string>
    <string name="settings_import_confirm_title">tshintsha konke imininingwane?</string>
    <string name="settings_import_confirm_body">ukuingena lezi bacup kususa konke idivayisi, umsulwa nokumsebenzi okugcinile.</string>

