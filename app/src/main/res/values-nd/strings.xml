    <string name="settings_tracking">ukubalela</string>
    <string name="settings_detailed_title">okuqina okubalulekile</string>
    <string name="settings_detailed_body">thatha amakwelo enenthalathalathi nokubala isikhathi sekulukhula. i-android kulungile amakwelo e-plug kuphela ku-app esebenzayo, ngakho lokhu kusiyele isikhasi esiphansi esinhlokweni. i-bluetooth ibalwa ngakho no.</string>
    <string name="settings_detailed_unavailable">ayatholakali kube i-bluetooth inike izintando: lokhu kukhanda kungetshengise kuphela inhlaka ye-connectedDevice, okwenza i-android 14+ uxhumeke emandleni e-bluetooth.</string>
    <string name="settings_playback_only_title">bala kuphela ukusosukelwa</string>
    <string name="settings_playback_only_body">amathathelo ethulela isikhathi esikukhuluma ngaso kunokuba isikhathi esishumelene. kuphela umsebenzi oqokululaziswe nokuqina okubalulekile kusosukelwa; okusele kususiwe.</string>
