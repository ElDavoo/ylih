    <string name="welcome_title">ylih তে স্বাগতম</string>
    <string name="welcome_intro">ylih প্রতিটি হেডফোনের জোড়া কতক্ষণ সংযুক্ত থাকে তা রেকর্ড করে, যাতে বছরের পর বছর পরে আপনি একটি জোড়ার বিষয়ে সবচেয়ে গুরুত্বপূর্ণ প্রশ্নের উত্তর দিতে পারেন: তারা কত ঘন্টা টিকেছিল?</string>
    <string name="welcome_point_auto_title">সংযোগ করুন এবং ভুলে যান</string>
    <string name="welcome_point_auto_body">bluetooth হেডফোন নিজেদের থেকে রেকর্ড হয়, সংযোগের মুহূর্ত থেকে। কিছু চলমান রাখার প্রয়োজন নেই।</string>
    <string name="welcome_point_lifetime_title">এক জোড়া, এক জীবনকাল</string>
    <string name="welcome_point_lifetime_body">যখন একটি জোড়া নষ্ট হয়, তখন এটি অবসর নিন: এর মোট সেখানে হিমায়িত হয় এবং একই হেডফোনের পরবর্তী জোড়া আবার শূন্য থেকে শুরু হয়।</string>
    <string name="welcome_point_detailed_title">তারযুক্ত এবং প্লেব্যাক</string>
    <string name="welcome_point_detailed_body">সেটিংসে বিস্তারিত ট্র্যাকিং তারযুক্ত হেডফোন যোগ করে এবং কতটা সময় প্রকৃতপক্ষে চলছিল তা পরিমাপ করে।</string>
    <string name="welcome_privacy">সবকিছু এই ফোনে থাকে। কোন অ্যাকাউন্ট নেই, এবং অ্যাপের কোন ইন্টারনেট অনুমতি নেই।</string>
    <string name="welcome_start">শুরু করুন</string>
