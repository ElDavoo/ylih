    <string name="settings_tracking">pracenje</string>
    <string name="settings_detailed_title">detaljno pracenje</string>
    <string name="settings_detailed_body">dodaje zicane slusalice i vreme reproduciranja. android samo prijavljuje zicane dogadjaje samo pokrenuto aplikaciji, tako da ovo cuva tiho obavestavanja u senci. bluetooth se prati ionako.</string>
    <string name="settings_detailed_unavailable">nedostupno dok se ne odobri pristup bluetooth-u: ova verzija deklarise samo vrstu connectedDevice usluge, koju android 14+ vezuje za bluetooth dozvolu.</string>
    <string name="settings_playback_only_title">brojite samo reproduciranje</string>
    <string name="settings_playback_only_body">statistika broji vreme kada se zvuk zaista reproducuje umesto vremena povezanosti. samo sesije zabeleske sa ukljucenim detaljnim pracenjem za reproduciranje; ostatak se ostavlja.</string>
