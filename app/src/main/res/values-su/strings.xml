    <string name="welcome_title">wilujeng sumping di ylih</string>
    <string name="welcome_intro">ylih ngarekam sabaraha lila unggal pasang headphone tetep nyambung, sangkan mangtaun-taun ka hareup anjeun tetep bisa ngajawab hiji-hijina patarosan anu penting ngeunaan sapasang: sabaraha jam maranéhna tahan?</string>
    <string name="welcome_point_auto_title">sambungkeun terus poho</string>
    <string name="welcome_point_auto_body">headphone bluetooth kacatet ku sorangan, ti mimiti nyambung. teu aya nu kudu diantep jalan.</string>
    <string name="welcome_point_lifetime_title">sapasang, sahirup</string>
    <string name="welcome_point_lifetime_body">lamun sapasang rusak, pangsiunkeun: totalna eureun di dinya jeung pasangan saterusna tina headphone anu sarua mimiti deui ti nol.</string>
    <string name="welcome_point_detailed_title">kabel jeung puteran</string>
    <string name="welcome_point_detailed_body">palacakan lengkep, dina setelan, nambahan headphone kabel jeung ngukur sabaraha lila waktu éta bener-bener disada.</string>
    <string name="welcome_privacy">sagalana tetep dina telepon ieu. teu aya akun, jeung aplikasi teu boga idin internét.</string>
    <string name="welcome_start">mimitian</string>
    <string name="welcome_next">saterusna</string>
    <string name="welcome_allow">idinan</string>
    <string name="welcome_step">léngkah %1$d ti %2$d</string>
    <string name="welcome_bluetooth_title">aksés bluetooth</string>
    <string name="welcome_bluetooth_why">android ngan ngabéjaan aplikasi alat bluetooth mana nu nyambung, jeung naon ngaranna, lamun aplikasi éta boga aksés bluetooth. kitu ylih ngabédakeun sapasang headphone jeung stéréo mobil, jeung nyaho hiji pasangan ti nu séjén.</string>
    <string name="welcome_bluetooth_with">ku éta: unggal pasangan kacatet ti mimiti nyambung, teu aya nu diantep jalan jeung teu aya nu kudu diinget pikeun dipencét.</string>
    <string name="welcome_bluetooth_without">tanpa éta: teu aya headphone bluetooth nu kacatet. bagian séjén tina aplikasi tetep jalan, jeung anjeun bisa masihanana engké dina setelan aplikasi android.</string>
    <string name="welcome_notifications_title">béwara</string>
    <string name="welcome_notifications_why">palacakan lengkep ngajalankeun layanan latar tukang leutik, jeung android merlukeun unggal aplikasi nu ngalakukeun kitu pikeun nahan béwara nu katingali salila éta.</string>
    <string name="welcome_notifications_with">ku éta: béwara némbongkeun naon nu keur dicatet ayeuna, éta hiji-hijina tanda yén palacakan lengkep hirup.</string>
    <string name="welcome_notifications_without">tanpa éta: palacakan lengkep tetep jalan jeung tetep nyatet. android ngan moal némbongkeun béwarana.</string>
    <string name="hibernation_title">tetep ngitung bari anjeun poho</string>
    <string name="hibernation_body">android ngeureunkeun aplikasi nu teu dibuka sababaraha bulan jeung nyokot deui idinna, nu bakal ngantep ylih teu nyatet naon-naon nepi ka anjeun muka deui. dipopohokeun téh persis alesan aplikasi ieu aya, jadi hadé pareuman éta ayeuna.</string>
