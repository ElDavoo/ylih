    <string name="welcome_title">dobrodosli u ylih</string>
    <string name="welcome_intro">ylih belezi koliko dugo svaki par slusalica ostaje povezan, tako da mozete odgovoriti na jedino bitno pitanje o paru: koliko sati su trajale?</string>
    <string name="welcome_point_auto_title">konekcija i zaboravljanje</string>
    <string name="welcome_point_auto_body">bluetooth slusalice se beleze automatski, od trenutka konekcije. nista ne treba da bude ukljuceno.</string>
    <string name="welcome_point_lifetime_title">jedan par, jedan zivot</string>
    <string name="welcome_point_lifetime_body">kada par umre, penzionisajte ga: njegov ukupan rezultat se zamrzava i sledeci par istih slusalica pocinje ispocetka sa nulom.</string>
    <string name="welcome_point_detailed_title">zicane i reproduciranje</string>
    <string name="welcome_point_detailed_body">detaljno pracenje, u postavkama, dodaje zicane slusalice i meri koliko je vremena zaista reproduciranje bilo ukljuceno.</string>
    <string name="welcome_privacy">sve ostaje na vasa telefonu. nema naloga i aplikacija nema dozvole za internet.</string>
    <string name="welcome_start">pocnite</string>
    <string name="welcome_next">dalje</string>
    <string name="welcome_allow">dozvoli</string>
    <string name="welcome_step">korak %1$d od %2$d</string>
    <string name="welcome_bluetooth_title">pristup bluetooth-u</string>
    <string name="welcome_bluetooth_why">android samo kaze aplikaciji koji je bluetooth uredaj povezan i kako se zove, ako aplikacija ima pristup bluetooth-u. na taj nacin ylih razlikuje par slusalica od avtomobilskog stereo sistema i kako zna jedan par od drugog.</string>
    <string name="welcome_bluetooth_with">sa njim: svaki par se belezi od trenutka konekcije, bez ikakvog pokretanja i bez potrebe da pamtite ista.</string>
    <string name="welcome_bluetooth_without">bez njega: bluetooth slusalice se ne beleze uopste. ostatak aplikacije funkcionise i mozete mu dodeliti dozvolu kasnije u android postavkama aplikacije.</string>
    <string name="welcome_notifications_title">obavestavanja</string>
    <string name="welcome_notifications_why">detaljno pracenje pokrece malu pozadinska servisa, i android zahteva da svaka aplikacija koja to radi bude vidljiva tokom rada.</string>
    <string name="welcome_notifications_with">sa njim: obavestavanja prikazuje sta se upravo sada belezi, sto je jedini znak da je detaljno pracenje zivo.</string>
    <string name="welcome_notifications_without">bez njega: detaljno pracenje se i dalje pokrece i belezi. android samo nece pokazati njegovu obavestavanja.</string>
    <string name="hibernation_title">nastavite brojanje dok zaboravljate na to</string>
    <string name="hibernation_body">android pauzira aplikacije koje nisu otvorene nekoliko meseci i uzima njihove dozvole, sto bi ostavilo ylih bez beleska dok je ne otvorite ponovo. biti zaboravljen je upravo ono za sta je ova aplikacija namenjena, tako da je vredno iskljuciti to sada.</string>
