    <string name="settings_troubleshooting">otklanjanje problema</string>
    <string name="settings_battery_body">ako sesije prestanu biti zabeleske, proverite da li je ylih izuzet od optimizacije baterije - aplikacija koja je forsiran zaustavljanje nikada ne prima emitovanja konekcije ponovo dok je ne otvorite.</string>
    <string name="settings_battery_button">postavke baterije</string>
    <string name="settings_battery_path">postavke → aplikacije → ylih → baterija → neograniceno.</string>
    <string name="settings_hibernation_body">ako ylih ostane neotvorenm nekoliko meseci, android ga pauzira i uzima njegove dozvole, i nista se ne belezi ponovo dok ga ne otvorite. iskljucivanje toga je ono sto dozvoljava paru da nastavlja brojanje kroz sezonu za koju nikada ne razmisljate o aplikaciji.</string>
    <string name="settings_hibernation_on">android moze pauzirati ylih.</string>
    <string name="settings_hibernation_off">ylih je izuzet i nastavlja beleski.</string>
    <string name="settings_hibernation_button">postavke nekoriscenih aplikacija</string>
