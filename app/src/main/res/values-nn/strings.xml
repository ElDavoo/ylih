    <string name="welcome_title">velkomen til ylih</string>
    <string name="welcome_intro">ylih registrerer kor lenge kvart par hovudtelefon held seg kopla til, slik at du framleis kan svara på det eine spørsmålet som betyr noko for eit par - kor mange timar heldt dei?</string>
    <string name="welcome_point_auto_title">kopla til og gløym</string>
    <string name="welcome_point_auto_body">bluetooth hovudtelefon blir registrert sjølv, frå det same augeblikket dei koplar til. ingenting treng å halda fram med å køyra.</string>
    <string name="welcome_point_lifetime_title">eitt par, eitt liv</string>
    <string name="welcome_point_lifetime_body">når eit par døyr, pensjoner det: summen frys der, og det neste paret av same hovudtelefon startar frå null igjen.</string>
    <string name="welcome_point_detailed_title">trådd og avspeling</string>
    <string name="welcome_point_detailed_body">nøyaktig registrering, i innstillingane, legg til trådd hovudtelefon og måler kor mykje av tida som faktisk var avspeling.</string>
    <string name="welcome_privacy">alt held seg på denne telefonen. det finst ikkje ein konto, og appen har ikkje internett-løyve.</string>
    <string name="welcome_start">kom i gang</string>
    <string name="welcome_next">neste</string>
    <string name="welcome_allow">tillat</string>
    <string name="welcome_step">steg %1$d av %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth-tilgang</string>
    <string name="welcome_bluetooth_why">android seier berre til ei app kva bluetooth-eining som kopla til, og kva han heiter, dersom appen held bluetooth-tilgang. det er korleis ylih kan skilja eit par hovudtelefon frå ein bilystereo, og korleis han veit det eine paret frå eit anna.</string>
    <string name="welcome_bluetooth_with">med det: kvart par blir registrert frå det same augeblikket det koplar til, utan noko som køyrer og utan noko å hugsa å trykkja.</string>
    <string name="welcome_bluetooth_without">utan det: bluetooth hovudtelefon blir ikkje registrert i det heile. resten av appen fungerer framleis, og du kan gje det seinare i android sine appinnstillingar.</string>
    <string name="welcome_notifications_title">merkingar</string>
    <string name="welcome_notifications_why">nøyaktig registrering køyrer ein liten bakgrunnsteneste, og android krev at alle appane som gjer det held ein merking synleg medan det gjer det.</string>
    <string name="welcome_notifications_with">med det: merkinga viser kva som blir registrert akkurat no, som er det eina teiknet på at nøyaktig registrering held fram.</string>
    <string name="welcome_notifications_without">utan det: nøyaktig registrering held framleis fram og registrerer framleis. android vil berre ikkje visa merkinga hans.</string>
    <string name="hibernation_title">halda telingen vidare medan du gløymer det</string>
    <string name="hibernation_body">android set i dvale appane som blir ikkje opna i fleire månader og tek lova deira attende, som ville la ylih registrera ingenting til du opna det att. å bli gløymd er eksakt det denne appen er til for, so det er verd å slå det av no.</string>
