    <string name="settings_tracking">registrering</string>
    <string name="settings_detailed_title">nøyaktig registrering</string>
    <string name="settings_detailed_body">legg til trådd hovudtelefon og avspeling tid. android seier berre trådd plugg hendingane til ein app som køyrer, so det held ein stille merking i skuggen. bluetooth blir registrert uansett.</string>
    <string name="settings_detailed_unavailable">utilgjengelig inntil bluetooth tilgang er gitt: denne versjonen deklarerer berre connectedDevice teneste typen, som android 14+ binder til ein bluetooth løyve.</string>
    <string name="settings_playback_only_title">telja berre avspeling</string>
    <string name="settings_playback_only_body">statistikken teljar tida lyden var faktisk avspeling i stedet for tida kopla. berre øktar registrert med nøyaktig registrering på målt avspeling; resten er laten ut.</string>
