    <string name="settings_troubleshooting">feilsøking</string>
    <string name="settings_battery_body">dersom øktar sluttar å bli registrert, kontroller at ylih er friteken for batteri optimering - ei app som er tvangsavslutta aldri mottar tilknyting kringkastingar att inntil ho er opna.</string>
    <string name="settings_battery_button">batteri innstillingar</string>
    <string name="settings_battery_path">innstillingar → appane → ylih → batteri → ubegrensa.</string>
    <string name="settings_hibernation_body">dersom ylih går uopna i fleire månader, android set henne i dvale og tek lova hans attende, og ingenting blir registrert att inntil du opnar ho. det å slå det av er det som let eit par halda telingen gjennom ein sesong du aldri tenker på appen.</string>
    <string name="settings_hibernation_on">android kan setja ylih i dvale.</string>
    <string name="settings_hibernation_off">ylih er fri og held registrering.</string>
