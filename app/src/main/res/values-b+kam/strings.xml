    <string name="settings_troubleshooting">kuwikanya mashida</string>
    <string name="settings_battery_body">kile mulunde aasyaa kuandulwa, angalia ila ylih isyaa mukunanya kwa kulilima kwa batiri — app ilile ilwamisiwe isyaa nayo kuminwa ilumbu kya kinyaa kila wikile tena.</string>
    <string name="settings_battery_button">iingiingi ya batiri</string>
    <string name="settings_battery_path">iingiingi → apps → ylih → batiri → isyaa.</string>
    <string name="settings_hibernation_body">kile ylih ayaa kwa miezi isyaa owikile, android akacika kila akwata ikilumbu kyakyo, no kiumo isyaa kithakanywa kila owikile tena. kukaacika ndi yoyo kiletela ikilongi kaamba kila muunakwe isilenge wakusahau app.</string>
    <string name="settings_hibernation_on">android anya akacika ylih.</string>
    <string name="settings_hibernation_off">ylih isyaa no ikaamba kithakanya.</string>
    <string name="settings_hibernation_button">iingiingi ya apps mumaasyaa</string>
    <string name="settings_about">kwa hili</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — misaani ya ikilongi, iikite mukilongi no kasale.</string>
    <string name="settings_import_confirm_title">ambika malilile kyonyu kyonyu?</string>
    <string name="settings_import_confirm_body">kunama ilinyo kiino syaula kidonge kimu kya idonge, ikilongi no mulunde kunthakaniwe sasa.</string>

