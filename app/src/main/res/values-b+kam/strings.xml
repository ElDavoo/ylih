    <string name="welcome_title">mwakabila kwa ylih</string>
    <string name="welcome_intro">ylih ithandika na wandula kwa kiasi ki kidonge cia ikilongi ki kuutwika kilisyaa kwa kimeme, ilo ise ila ino mukulu isu ina indila inkali kwa ikilongi: saani ngani mitesi iimile?</string>
    <string name="welcome_point_auto_title">kunama no kwilikila</string>
    <string name="welcome_point_auto_body">ikilongi ki kuutwika cia bluetooth iithakanywa kwa kuongelekana, kuuma kila iwike imenyaa. kiumo isyaa kiiswilila kwifwa na muchelo.</string>
    <string name="welcome_point_lifetime_title">ikilongi kimo, uufu umwe</string>
    <string name="welcome_point_lifetime_body">kila ikilongi kimo kiinilwa, kuthimu kiino: kisisye kyakyo kiyikala kule no ikilongi kimo kinema kya ikilongi kimo kyo kaanyu kiambika tena kuuma wa nyama.</string>
    <string name="welcome_point_detailed_title">kimeme no kwinjala</string>
    <string name="welcome_point_detailed_body">kwandula cia kina kisi, muiingiingi, kwongelekanya ikilongi ki kimeme no kuumanisa kwa kiasi ki munenyu waka alyonya na sika.</string>
    <string name="welcome_privacy">kiisya kyonyu kiooni mukilongi kiino kya simu. kukilumbu kwa akaunti, no ya application isyaa na ikilumbu cia intaneti.</string>
    <string name="welcome_start">ambika</string>
    <string name="welcome_next">kinema</string>
    <string name="welcome_allow">kakasya</string>
    <string name="welcome_step">nziko %1$d wa %2$d</string>
    <string name="welcome_bluetooth_title">ikilumbu kya bluetooth</string>
    <string name="welcome_bluetooth_why">android aasya na iyoni app kila ikilongi kya bluetooth kino kinyaa, no kila kiilwa, kile app ino kwa ikilumbu kya bluetooth. ndi yoyo ylih yandula ikilongi kya kuutwika kuuma kwa simu ya gadi, no kila yoyo inini ikilongi kimu kuuma kinema.</string>
    <string name="welcome_bluetooth_with">nayo: ikilongi kimu kimo ithakanywa kuuma kila iwike, nayo kiumo isyaa kiiswilila no kiumo isyaa kwa kulinga.</string>
    <string name="welcome_bluetooth_without">nayo isyaa: ikilongi ki kuutwika cia bluetooth isyaa ithakanywa kila ilo. kiisya kinema kya app kiooni kilisa, no wee weka kwiyaa mumuuna kwa iingiingi ya android.</string>
    <string name="welcome_notifications_title">ilumbu</string>
    <string name="welcome_notifications_why">kwandula cia kina kwa kuchela service ya kimuthele, no android aasya na ya ikilumbu ya ikilongi kimo kila isuulanisa ilumbu yoyo kila kwisa.</string>
    <string name="welcome_notifications_with">nayo: ilumbu yoyo isuulanisa kiisya kino kunthakanywa sasa, ndi yoyo ilumbu lyoyo lya kwandula kwa kina lya kwifwa.</string>
    <string name="welcome_notifications_without">nayo isyaa: kwandula kwa kina kiooni kilisa no kiooni kithakanywa. android kama aswi kusuulanisa ilumbu lyakyo.</string>
    <string name="hibernation_title">amba kwisya kila uu wakusahau</string>
    <string name="hibernation_body">android aacika apps mala maasyaa kwa miezi no akwata ikilumbu kyakyo, ndi yoyo aswiya ylih kithakanya kiumo kila owikile tena. kusilengwa ni ndi yoyo app iyo ingilile, ilo ino wau kumesa tena sasa.</string>
