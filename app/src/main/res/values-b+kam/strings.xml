    <string name="settings_tracking">kuandula</string>
    <string name="settings_detailed_title">kwandula kwa kina</string>
    <string name="settings_detailed_body">ongelekanya ikilongi kya kimeme no munenyu wa kwinjala. android asuulanisa ikilumbu kya kimeme kwa apps muno kwikilila, ilo isyaa kwa ilumbu isyaa mukilongi kya watu. bluetooth ithakanywa yoyo.</string>
    <string name="settings_detailed_unavailable">isyaa kila ikilumbu kya bluetooth isyaa ikyaa: muundwa iino asuula lindi lya connectedDevice, ndi yoyo android 14+ yisya kwa ikilumbu kya bluetooth.</string>
    <string name="settings_playback_only_title">amba kimu kya kwinjala</string>
    <string name="settings_playback_only_body">misalyo ambile munenyu wa kwinjala kwa sika kuuta munenyu wa kinyaa. mulunde weka wandululwe nayo kwandula kwa kina onsyaa kwinjala; kinema kyonyu kyasyaulwa.</string>
