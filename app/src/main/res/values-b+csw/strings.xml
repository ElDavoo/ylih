    <!-- Settings -->
    <string name="settings_tracking">akayasim</string>
    <string name="settings_detailed_title">akayasim mina atayakahwin</string>
    <string name="settings_detailed_body">sohkawin otisinahk mina mahkohkana atihcamok akayasim. android peyakohk ki-itahcikew sohkawin mawocihcikana, ki-itahcikew eko, kiya ka-akayak ki-ihtawisiw. bluetooth akayasim eso mihkohk.</string>
    <string name="settings_detailed_unavailable">nika ayisiyiniw iko ki-mawak bluetooth akayasim: eso ki-atayak peyakohk connectedDevice ka-atayakahwin, android 14+ ki-atayakahwikew bluetooth akayasim eti.</string>
    <string name="settings_playback_only_title">atihcamok piko akayasim</string>
    <string name="settings_playback_only_body">kiskinowatasiwina atihcamok tahto kesikaw akayasimohcikatewa, namoya nesowatisiwin kesikaw. akayasim mina atayakahwin ekwa ekosi masinahikatek piko atihcamok akayasimohkana; kotaka namoya.</string>
    <string name="settings_language">pîkiskwêwin</string>
    <string name="settings_language_system">wacistahkamikohk pîkiskwêwin</string>
    <string name="settings_devices">wacistahkamikohk</string>
    <string name="settings_devices_body">ki-macinakik ki ca-atayak nika otisinahk — wacistahkamikohk mina atihcamowin — ki-macinahew akayasim.</string>
    <string name="settings_device_subtitle">%1$s · peyakohk ki mayik %2$s</string>
    <string name="settings_data">akayasimohkana</string>
    <string name="settings_export">macinahew json</string>
    <string name="settings_import">mayik</string>
    <string name="settings_import_warning">mayik ki-macinakik kisisohk ka-atayasimohk eko.</string>
    <string name="settings_troubleshooting">pakamiowikana ka-atayak</string>
    <string name="settings_battery_body">atihcamohkana nika ki-akayasimohk, akayasim ylih nika ki-atayakahwew astewina — eso ki-macinahewik atihcamowin nika mahkohkana iko ki-mayikasow.</string>
    <string name="settings_battery_button">astewina atayakahwin</string>
    <string name="settings_battery_path">atayakahwin → eso ki-itahcikew → ylih → astewina → nika asteyik.</string>
    <string name="settings_hibernation_body">kispin ylih eso pisim namoya ki-yohtenamihk, android ki-nakatamawew miina ki-otinamawew akayasimowina, ekwa namoya kikway ka-nayahtahk ata ki-yohtenaman. ka-kipihtinamihk eyako ka-pakitinamihk otisinahikan ta-mawocih tahto pisim eka ka-kiskisitotawiht eyako app.</string>
    <string name="settings_hibernation_on">android ta-kipihtinam ylih.</string>
    <string name="settings_hibernation_off">ylih namoya kipihtinamihk ekwa kihci-nayahtahk.</string>
    <string name="settings_hibernation_button">namoya-atoskehk otisinahikana astewina</string>
    <string name="settings_about">ka-itahcikew</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — mahkohkana otisinahk, ki-atayakahwew kisisohk mina mahcihowin.</string>
    <string name="settings_import_confirm_title">macinakik kisisohk akayasimohkana?</string>
    <string name="settings_import_confirm_body">mayik eso atayakahwin ki-macinakik kisisohk wacistahkamikohk, otisinahk mina atihcamohkana eko ki-akayasimohk.</string>
