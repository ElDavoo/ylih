    <!-- First run -->
    <string name="welcome_title">takosiwin ki ylih</string>
    <string name="welcome_intro">ylih akayasim ka-itahcikew mina isko mahcihk otisinahk, ki-ihtawisiw ka-isko mihcet mahkon ci-atayak ka-ihtawasin ki otisinahk: mista awas mahkohkana ka-ihtawasin?</string>
    <string name="welcome_point_auto_title">mawocih mina piko</string>
    <string name="welcome_point_auto_body">bluetooth otisinahk akayasimwa ihtawisiw, ki-mawocihcik. ki-atayakahwewina nika.</string>
    <string name="welcome_point_lifetime_title">peyak otisinahk peyak mahcihowin</string>
    <string name="welcome_point_lifetime_body">takosin ki ca-ayinik otisinahk, ki-wakayik: macinohikana ki-atayak eko, mina ayis otisinahk wacistahkamikohk ay-itahcikek mahkohkana ki-ihtawisiw.</string>
    <string name="welcome_point_detailed_title">sohkawin mina atihcamok</string>
    <string name="welcome_point_detailed_body">akayasim mina atayakahwin, atayakahwina, ki-mamachotamokew sohkawin otisinahk mina ka-wayacak mahkonak atihcamok.</string>
    <string name="welcome_privacy">kisisohk ki mihkohk. nika apit mina nika mahciwin musik.</string>
    <string name="welcome_start">takosiwin</string>
    <string name="hibernation_title">ka-ki-kiskisitotawiht namoya ka-atayak</string>
    <string name="hibernation_body">android ki-nakatamawew otisinahikana eso pisim ka-mawaci namoya ki-yohtenamihk, kiiwe otayamna akayasimowina; eyako ylih namoya ka-nayahtahk kikway ata ki-yohtenaman miina. ka-kiskisitotawiht eyako tapiskoc ta-ohcitaw eyako app, mena kwayask ta-kipihtinamihk anohc.</string>
    <string name="action_not_now">namoya anohc</string>

