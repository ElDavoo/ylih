    <!-- First run -->
    <string name="welcome_title">ᑕᑯᓯᐏᐣ ᑭ ylih</string>
    <string name="welcome_intro">ylih ᐊᑲᔭᓯᒼ ᑲ-ᐃᑕᐦᒋᑫᐤ ᒥᓇ ᐃᐢᑯ ᒪᐦᒋᕽ ᐅᑎᓯᓇᕽ, ᑭ-ᐃᐦᑕᐏᓯᐤ ᑲ-ᐃᐢᑯ ᒥᐦᒉᑦ ᒪᕽᐅᐣ ᒋ-ᐊᑕᔭᒃ ᑲ-ᐃᐦᑕᐘᓯᐣ ᑭ ᐅᑎᓯᓇᕽ: ᒥᐢᑕ ᐊᐘᐢ ᒪᕽᐅᕽᐊᓇ ᑲ-ᐃᐦᑕᐘᓯᐣ?</string>
    <string name="welcome_point_auto_title">ᒪᐓᒋᐦ ᒥᓇ ᐱᑯ</string>
    <string name="welcome_point_auto_body">bluetooth ᐅᑎᓯᓇᕽ ᐊᑲᔭᓯᒷ ᐃᐦᑕᐏᓯᐤ, ᑭ-ᒪᐓᒋᐦᒋᒃ. ᑭ-ᐊᑕᔭᑲᐦᐍᐏᓇ ᓂᑲ.</string>
    <string name="welcome_point_lifetime_title">ᐯᔭᒃ ᐅᑎᓯᓇᕽ ᐯᔭᒃ ᒪᐦᒋᐦᐅᐏᐣ</string>
    <string name="welcome_point_lifetime_body">ᑕᑯᓯᐣ ᑭ ᒐ-ᐊᔨᓂᒃ ᐅᑎᓯᓇᕽ, ᑭ-ᐘᑲᔨᒃ: ᒪᒋᓄᐦᐃᑲᓇ ᑭ-ᐊᑕᔭᒃ ᐁᑯ, ᒥᓇ ᐊᔨᐢ ᐅᑎᓯᓇᕽ ᐘᒋᐢᑕᕽᐊᒥᑯᕽ ᐊᕀ-ᐃᑕᐦᒋᑫᒃ ᒪᕽᐅᕽᐊᓇ ᑭ-ᐃᐦᑕᐏᓯᐤ.</string>
    <string name="welcome_point_detailed_title">ᓱᕽᐊᐏᐣ ᒥᓇ ᐊᑎᐦᒐᒧᒃ</string>
    <string name="welcome_point_detailed_body">ᐊᑲᔭᓯᒼ ᒥᓇ ᐊᑕᔭᑲᐦᐏᐣ, ᐊᑕᔭᑲᐦᐏᓇ, ᑭ-ᒪᒪᐨᐦᐅᑕᒧᑫᐤ ᓱᕽᐊᐏᐣ ᐅᑎᓯᓇᕽ ᒥᓇ ᑲ-ᐘᔭᒐᒃ ᒪᕽᐅᓇᒃ ᐊᑎᐦᒐᒧᒃ.</string>
    <string name="welcome_privacy">ᑭᓯᓱᕽ ᑭ ᒥᕽᐅᕽ. ᓂᑲ ᐊᐱᑦ ᒥᓇ ᓂᑲ ᒪᐦᒋᐏᐣ ᒧᓯᒃ.</string>
    <string name="welcome_start">ᑕᑯᓯᐏᐣ</string>
    <string name="welcome_next">ᑯᑕᒃ</string>
    <string name="welcome_allow">ᐸᑭᑎᓇᒪᐤ</string>
    <string name="welcome_step">ᑕᕽᐅᐦᑌᐤ %1$d ᐃᑕ %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth ᐅᑎᓂᑫᐏᐣ</string>
    <string name="welcome_bluetooth_why">android ᐱᑯ ᐏᐦᑕᒪᐍᐤ ᐊᐱᓯᓯ ᐊᑐᐢᑫᐏᐣ ᑕᓂᒪ bluetooth ᐊᐸᒋᐦᒋᑲᐣ ᑲᐦ-ᐏᒋᐦᑕᓱᑦ, ᐁᑿ ᑕᓂᓯ ᐃᓯᔨᕽᐊᓱᑦ, ᑭᐢᐱᐣ ᐊᓇ ᐊᑐᐢᑫᐏᐣ ᐊᔭᐤ bluetooth ᐅᑎᓂᑫᐏᐣ. ᐁᑯᓯ ylih ᑭᐢᑫᔨᐦᑕᒼ ᐯᐦᑕᑯᓯᐏᐣ ᐁᑿ ᐅᑕᐸᓇᐢᒃ ᐱᑭᐢᑵᐏᐣ, ᐁᑿ ᐯᔭᒃ ᓂᓱᑿᐣ ᐁᑿ ᑯᑕᒃ.</string>
    <string name="welcome_bluetooth_with">ᐅᑎᓂᑫᐏᐣ ᐅᐦᒋ: ᑕᐦᑐ ᓂᓱᑿᐣ ᒪᓯᓇᐦᐃᑲᑌᐤ ᐃᐢᐱ ᑲ-ᐏᒋᐦᑕᓱᑦ, ᓇᒧᔭ ᑫᑿᕀ ᑲ-ᐊᑐᐢᑫᒪᑲᕽ ᐁᑿ ᓇᒧᔭ ᑲ-ᑭᐢᑭᓯᔭᐣ ᑲ-ᓴᑲᐢᑭᓇᐦᐊᒪᐣ.</string>
    <string name="welcome_bluetooth_without">ᓇᒧᔭ ᐅᑎᓂᑫᐏᐣ: ᓇᒧᔭ bluetooth ᐯᐦᑕᑯᓯᐏᐣ ᒪᓯᓇᐦᐃᑲᑌᐤ. ᑯᑕᑲ ᐊᑐᐢᑫᐏᐣ ᐊᑐᐢᑫᒪᑲᐣ, ᐁᑿ ᑲ-ᑭ-ᐸᑭᑎᓀᐣ ᒭᐢᑕᐢ android ᐊᑐᐢᑫᐏᐣ ᐃᓯᐦᒋᑫᐏᓇ.</string>
    <string name="welcome_notifications_title">ᐏᐦᑕᒪᑫᐏᓇ</string>
    <string name="welcome_notifications_why">ᒥᐢᑕᐦᐃ ᑲᓇᐍᔨᐦᒋᑫᐏᐣ ᐊᑐᐢᑫᒪᑲᐣ ᐊᐱᓯᓯ ᐅᑕᕽ ᐊᑐᐢᑫᐏᐣ, ᐁᑿ android ᓂᑕᐍᔨᐦᑕᒼ ᑕᐦᑐ ᐊᑐᐢᑫᐏᐣ ᐁᑯᓯ ᑲ-ᐃᑐᑕᕽ ᑲ-ᐘᐸᐦᑎᐦᐃᐍᑦ ᐏᐦᑕᒪᑫᐏᐣ.</string>
    <string name="welcome_notifications_with">ᐸᑭᑎᓇᒪᑫᐏᐣ ᐅᐦᒋ: ᐏᐦᑕᒪᑫᐏᐣ ᐘᐸᐦᑎᐦᐃᐍᐤ ᑫᑿᕀ ᐊᓄᐦᐨ ᑲ-ᒪᓯᓇᐦᐃᑲᑌᒃ, ᐁᑯᓂ ᐱᑯ ᑭᐢᑭᓄᐘᒋᐦᒋᑲᐣ ᒥᐢᑕᐦᐃ ᑲᓇᐍᔨᐦᒋᑫᐏᐣ ᐱᒪᑎᓯᐤ.</string>
    <string name="welcome_notifications_without">ᓇᒧᔭ ᐸᑭᑎᓇᒪᑫᐏᐣ: ᒥᐢᑕᐦᐃ ᑲᓇᐍᔨᐦᒋᑫᐏᐣ ᐊᑐᐢᑫᒪᑲᐣ ᐁᑿ ᒪᓯᓇᐦᐃᑫᐤ. android ᐱᑯ ᓇᒧᔭ ᐘᐸᐦᑎᐦᐃᐍᐤ ᐅᑎᓂᑫᐏᐣ.</string>
    <string name="hibernation_title">ᑲ-ᑭ-ᑭᐢᑭᓯᑐᑕᐏᐦᑦ ᓇᒧᔭ ᑲ-ᐊᑕᔭᒃ</string>
    <string name="hibernation_body">android ᑭ-ᓇᑲᑕᒪᐍᐤ ᐅᑎᓯᓇᐦᐃᑲᓇ ᐁᓱ ᐱᓯᒼ ᑲ-ᒪᐘᒋ ᓇᒧᔭ ᑭ-ᔪᐦᑌᓇᒥᕽ, ᑭᐃᐍ ᐅᑕᔭᒼᓇ ᐊᑲᔭᓯᒧᐏᓇ; ᐁᔭᑯ ylih ᓇᒧᔭ ᑲ-ᓇᔭᐦᑕᕽ ᑭᑿᕀ ᐊᑕ ᑭ-ᔪᐦᑌᓇᒪᐣ ᒥᐃᓇ. ᑲ-ᑭᐢᑭᓯᑐᑕᐏᐦᑦ ᐁᔭᑯ ᑕᐱᐢᑯᐨ ᑕ-ᐅᐦᒋᑕᐤ ᐁᔭᑯ ᐊᑉᑉ, ᒣᓇ ᑿᔭᐢᒃ ᑕ-ᑭᐱᐦᑎᓇᒥᕽ ᐊᓄᐦᐨ.</string>
