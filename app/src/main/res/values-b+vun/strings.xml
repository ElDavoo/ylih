    <string name="welcome_title">karibu sana ylih</string>
    <string name="welcome_intro">ylih inasomeka kwa muda gani kila jozi la asusu inabaki iliyounganishwa, ili kwa miaka ijayo bado uweze kujibu swali moja ambalo linastahili kuhusu jozi: kwa saa ngapi walikufa?</string>
    <string name="welcome_point_auto_title">unganisha nag unisahau</string>
    <string name="welcome_point_auto_body">asusu ya bluetooth inasomeka wenyewe, tangu wakati inayounganishwa. hakuna kinachohitaji kuwakaa kinachofanya kazi.</string>
    <string name="welcome_point_lifetime_title">jozi moja, maisha moja</string>
    <string name="welcome_point_lifetime_body">wakati jozi inakamatia, irudishe: jumla yake inategeuka mahali nchi na jozi ijayo ya asusu sawa huanza tena kutoka sifuri.</string>
    <string name="welcome_point_detailed_title">wa waya nag kuigiza</string>
    <string name="welcome_point_detailed_body">kusomeka kwa kina, katika taswilisho, kunaongeza asusu wa waya nag kupima ni kama muda ilikuwa kwa kweli inacheza.</string>
    <string name="welcome_privacy">kila kitu kinabaki kwenye simu yako. hakuna akawunti, nag programu haina ruhusa ya mtandao.</string>
    <string name="welcome_start">anza</string>
    <string name="welcome_next">ijayo</string>
    <string name="welcome_allow">ruhusu</string>
    <string name="welcome_step">hatua %1$d ya %2$d</string>
    <string name="welcome_bluetooth_title">ruhusa ya bluetooth</string>
    <string name="welcome_bluetooth_why">android inakataa kwenye programu tu ni dispositifu gani ya bluetooth iliyounganishwa, nag jina lake ni nini, kama programu ina ruhusa ya bluetooth. ni jinsi ylih inavyotenganisha jozi ya asusu kutoka kwenye stereo ya gari, nag jinsi inavyojua jozi moja kutoka nyingine.</string>
    <string name="welcome_bluetooth_with">pamoja nayo: kila jozi inasomeka tangu wakati inayounganishwa, bila kinachohitaji kuwakaa nag hakuna kinachohitaji kukumbuka kushinikiza.</string>
    <string name="welcome_bluetooth_without">bila hiyo: asusu yoyote ya bluetooth haisomeki kabisa. sehemu nyingine ya programu bado inafanya kazi, nag unaweza kuipa ruhusa baadaye katika taswilisho la programu ya android.</string>
    <string name="welcome_notifications_title">onyo</string>
    <string name="welcome_notifications_why">kusomeka kwa kina kunaendesha huduma ndogo ya nyuma, nag android inahitaji programu yoyote inayofanya hivyo kuweka onyo linaloonyesha wakati inafanya kazi.</string>
    <string name="welcome_notifications_with">pamoja nayo: onyo linaonyesha kile kinachosomeka sasa, ambalo ndilo tutupata la kusomeka kwa kina kinachofanya kazi.</string>
    <string name="welcome_notifications_without">bila hiyo: kusomeka kwa kina bado kunaendesha nag bado inasomeka. android tu haitakuwa inaonyesha onyo lilo.</string>
    <string name="hibernation_title">kuendelea kuhesabu wakati unasahau</string>
    <string name="hibernation_body">android inakoma programu ambazo hazizingii kwa miezi kadhaa nag inachukua ruhusa zao, ambayo ingelihaditha ylih hisomeki mahali mpaka unigeze tena. kusahauliwa ni hasa kile programu iyi inakusudia, kwa hiyo inastahili kuizima sasa.</string>
