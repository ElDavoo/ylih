    <string name="settings_tracking">kusomeka</string>
    <string name="settings_detailed_title">kusomeka kwa kina</string>
    <string name="settings_detailed_body">kunaongeza asusu wa waya nag muda wa kuigiza. android inakataa kwa programu zinazofanya kazi tu matukio ya waya, kwa hiyo hii inahifadhi onyo nyumba lenye sauti. bluetooth husomeka kwa njia yoyote.</string>
    <string name="settings_detailed_unavailable">haipatikani hadi ruhusa ya bluetooth ipewe: jenga hili linadeklarali aina ya huduma ya connectedDevice tu, ambayo android 14+ inaunganisha kwenye ruhusa ya bluetooth.</string>
    <string name="settings_playback_only_title">hesabu kuigiza tu</string>
    <string name="settings_playback_only_body">maoni huhesabu wakati sauti ilikuwa kwa kweli inacheza badala ya muda iliyounganishwa. kazi tu zilizosomeka na kusomeka kwa kina iliyoanzisha kupimwa kuigiza; nyingine zinaadhimishwa.</string>
    <string name="settings_language">lugha</string>
    <string name="settings_language_system">lugha ya mfumo</string>
    <string name="settings_devices">vifaa</string>
    <string name="settings_devices_body">ondoa kila kitu ambacho si asusu - stereo ya gari au spika - kusimama kuandika kile.</string>
    <string name="settings_device_subtitle">%1$s · liliwazo juu %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">kuandika json</string>
    <string name="settings_import">kuingiza</string>
    <string name="settings_import_warning">kuingiza inabadilisha kila kitu kilichohifadhiwa sasa.</string>
    <string name="settings_troubleshooting">kutatua matatizo</string>
    <string name="settings_battery_body">kama kazi zinasimama kusomekwa, angalia ylih haisomi kutoka kunabilisho la betri - programu ambayo imezuiliwa si wote mara kwa mara kulingana simu mpya hadi ingeyafungua.</string>
    <string name="settings_battery_button">taswilisho la betri</string>
    <string name="settings_battery_path">taswilisho - programu - ylih - betri - hakuna mapungufu.</string>
    <string name="settings_hibernation_body">kama ylih haizingii kwa miezi kadhaa, android inakoma nag inachukua ruhusa zake, nag hakuna kusomekwa tena hadi unigeze. kuizima ni kile kinachobadilisha jozi kusimama kuhesabu kupitia wakati hauna wazo kuhusu programu.</string>
    <string name="settings_hibernation_on">android inaweza kusimamisha ylih.</string>
    <string name="settings_hibernation_off">ylih haina mapungufu nag kuendelea kusomeka.</string>
    <string name="settings_hibernation_button">taswilisho la programu zisizotumika</string>
    <string name="settings_about">kuhusu</string>
    <string name="settings_about_body">ylih %1$s (%2$s) - saa za asusu, zinazohifadhiwa ndani nag milele.</string>
    <string name="settings_import_confirm_title">badilisha data yote?</string>
    <string name="settings_import_confirm_body">kuingiza hii hifadhi kufuta kila kifaa, jozi nag kazi iliyohifadhiwa sasa.</string>

