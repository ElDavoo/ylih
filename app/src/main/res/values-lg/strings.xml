    <string name="welcome_title">kakulukuta mu ylih</string>
    <string name="welcome_intro">ylih ekokoma ensawo zenjira z’okugomu buli paale y’entuufu, so nti mu miaka egyo mu maaso ojja kusobola okukibuza ekibuzo kyo kyokka ekibangirira: sente z’essaawa zonna enzijira?</string>
    <string name="welcome_point_auto_title">kwataganya n’okakasa</string>
    <string name="welcome_point_auto_body">ntuufu z’okubluutusi zikoomagana okwekka, okuva essaawa zeyesoose zigololo. tekonna nakyo kinasobola okudala.</string>
    <string name="welcome_point_lifetime_title">paale kimu, obulamu kimu</string>
    <string name="welcome_point_lifetime_body">paale bwe kifa, yikire: omuwendo gwo gufuluma wangu agenze waka paale mpya y’entuufu z’omu kyama etandika okuva kuzero.</string>
    <string name="welcome_point_detailed_title">okwesigidde n’okukubaganya</string>
    <string name="welcome_point_detailed_body">okukikumbila okuzigazi, mu settings, kwongera mu ntuufu z’okwesigidde n’okukubaganya sente ennene y’omusolo.</string>
    <string name="welcome_privacy">buli kimu kigigala ku mmobikwano eno. tekuna konti, n’app terina layini y’intaneti.</string>
    <string name="welcome_start">tandika</string>
    <string name="welcome_next">mulala</string>
    <string name="welcome_allow">kkiriza</string>
    <string name="welcome_step">suupo %1$d wa %2$d</string>
    <string name="welcome_bluetooth_title">layini y’okubluutusi</string>
    <string name="welcome_bluetooth_why">android kyokka ekigamba app ekka nti evayisi ki eyokyesoose, n’erandikirira ki, singa app eri mu layini y’okubluutusi. kye kikolela ylih okubala paale y’entuufu ku makandi mu kuggi, n’okumanya paale kimu okuva kuva.</string>
    <string name="welcome_bluetooth_with">n’eno: buli paale ekikoma okukikumbilwa okuva essaawa zeyesoose okyokwese, mu kifo ekitakira akatikiro n’ekitekitegeeza.</string>
    <string name="welcome_bluetooth_without">mu kifo ekikyo: paale z’okubluutusi tezikomagana namu. kifo kiggyiriza app kyetandika okukolaganya, n’ojja kusobola okukiwa mu maaso mu okukola okwa android.</string>
    <string name="welcome_notifications_title">okukubaganya</string>
    <string name="welcome_notifications_why">okukikumbila okuzigazi kwannyiga samidde y’okukola e bbanga likoma, n’android ekigamba buli app ekikola nkyo okukoma ne likunzo lya okukubaganya.</string>
    <string name="welcome_notifications_with">n’eno: likukubaganya likikubaganya nange ki ekikoma okukikumbilwa kati kati, kye kyokka ekikira okukikumbila okuzigazi kwali?</string>
    <string name="welcome_notifications_without">mu kifo ekikyo: okukikumbila okuzigazi kwekoma okukikolaganya. android kyokka tekigamba okukubaganya kwakyo.</string>
    <string name="hibernation_title">okukoma okukubaganya bwe wamala okukikubaganya</string>
    <string name="hibernation_body">android kwannyiga apps ezitakubika mu myaka amagazi n’ewala layini zazo, ekigira ylih terikikumbila kyonna okutuusa ewakati lwe wagida. okukamala okukubaganya kye kyokusobola kwa app eno, so kyandikwata okukiggyoleza kati kati.</string>
