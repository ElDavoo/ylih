    <string name="settings_troubleshooting">okukola okwebuuze</string>
    <string name="settings_battery_body">mutendera bwe migira okukikumbilwa, kebera okuba ylih ennyigira mu mabakali agapima - app ewedde okukoma tekikoma okutegeeza okukwataganya okutuusa kwe wagida.</string>
    <string name="settings_battery_button">okukola okwa bateri</string>
    <string name="settings_battery_path">okukola → apps → ylih → bateti → okutataama.</string>
    <string name="settings_hibernation_body">ylih bwe tagenda mu nkola okumala, android kwannyiga kyo n’ewala layini zazo, n’ekikoma okukikumbila okutuusa ewakati lwe wagida. okukiggyoleza kye kyokusobola kumala paale okukoma okukubaganya mu season gy’otakikubaganya app.</string>
    <string name="settings_hibernation_on">android ekyinza okukwannyiga ylih.</string>
    <string name="settings_hibernation_off">ylih ennyigira n’ekikoma okukikumbila.</string>
    <string name="settings_hibernation_button">okukola okwa app ewakati</string>
