    <string name="settings_detailed_title">okukikumbila okuzigazi</string>
    <string name="settings_detailed_body">kwongera mu ntuufu z’okwesigidde n’omusolo gwa okukubaganya. android kyokka ekigamba app ki okukubaganya okwa plugi y’okwesigidde ku app ekikola, so eno kwetaaga okukoma ne likukubaganya mu kifo. okubluutusi kikoma okukikumbilwa mu buli nkola.</string>
    <string name="settings_detailed_unavailable">tekikola okutuusa layini y’okubluutusi ekirizibwe: okukola oku kwokka ekikubaganya ekka eby’okukufa okwa connectedDevice, ekya android 14+ yeneeza ku layini y’okubluutusi.</string>
    <string name="settings_playback_only_title">kubaganya omusolo gwa okukubaganya gyokka</string>
    <string name="settings_playback_only_body">data ekubaganya omusolo gwa okukubaganya amakakasa mu kifo ky’omusolo gwa kwatanganyizibwa. mutendera gyokka ogwe nakikumbilwa okukikumbila okuzigazi okuweddwa okukubaganya omusolo; emizira gyegiriza.</string>
