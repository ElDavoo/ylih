    <string name="settings_troubleshooting">rješavanje problema</string>
    <string name="settings_battery_body">ako sesije prestanu biti zabilježene, provjeri je li ylih oslobođen od optimizacije baterije — aplikacija koja je prisilno zaustavljena više nikada ne prima veze dok je ne otvoriš.</string>
    <string name="settings_battery_button">postavke baterije</string>
    <string name="settings_battery_path">postavke → aplikacije → ylih → baterija → neograničeno.</string>
    <string name="settings_hibernation_body">ako ylih ostane neotvarana nekoliko mjeseci, android je pauzira i vraća dozvole, i ništa se ne bilježi dok je ne otvoriš. isključivanje toga je što omogućava paru da broji kroz sezonu koju nikad nisi razmišljao o aplikaciji.</string>
    <string name="settings_hibernation_on">android može pauzirati ylih.</string>
    <string name="settings_hibernation_off">ylih je oslobođena i nastavlja s bilježenjem.</string>
    <string name="settings_hibernation_button">postavke nekorištene aplikacije</string>
