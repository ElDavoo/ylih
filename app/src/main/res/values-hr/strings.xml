    <string name="welcome_title">dobrodošli u ylih</string>
    <string name="welcome_intro">ylih bilježi koliko dugo svaki par slušalica ostaje povezan, tako da godinama kasnije još uvijek možeš odgovoriti na jedino bitno pitanje: koliko sati su trajale?</string>
    <string name="welcome_point_auto_title">poveži i zaboravi</string>
    <string name="welcome_point_auto_body">bluetooth slušalice se beleže same od sebe, čim se povežu. ništa se ne mora ostaviti pokrenuto.</string>
    <string name="welcome_point_lifetime_title">jedan par, jedan životni vijek</string>
    <string name="welcome_point_lifetime_body">kada par umre, povuci ga: njegov zbroj se zamrzne ovdje, a sljedeći par istih slušalica počinje ponovno od nule.</string>
    <string name="welcome_point_detailed_title">žičane i reprodukcija</string>
    <string name="welcome_point_detailed_body">detaljno praćenje u postavkama dodaje žičane slušalice i mjeri koliko je vremena zapravo puštana glazba.</string>
    <string name="welcome_privacy">sve ostaje na ovom telefonu. nema računa, i aplikacija nema dozvolu za internet.</string>
    <string name="welcome_start">započni</string>
    <string name="welcome_next">sljedeće</string>
    <string name="welcome_allow">dopusti</string>
    <string name="welcome_step">korak %1$d od %2$d</string>
    <string name="welcome_bluetooth_title">pristup bluetooth-u</string>
    <string name="welcome_bluetooth_why">android samo kaže aplikaciji koju bluetooth uređaj je povezan i kako se zove ako aplikacija ima bluetooth pristup. to je kako ylih razlikuje slušalice od auto-stereo, i kako zna jedan par od drugoga.</string>
    <string name="welcome_bluetooth_with">s njim: svaki par se bilježi čim se poveže, bez ničega pokrenuto i ničega da se zapamti.</string>
    <string name="welcome_bluetooth_without">bez toga: bluetooth slušalice se uopće ne bilježe. ostatak aplikacije još uvijek radi, i možeš je dati dozvolu kasnije u android postavkama.</string>
    <string name="welcome_notifications_title">obavijesti</string>
    <string name="welcome_notifications_why">detaljno praćenje pokreće mali background servis, a android zahtijeva da bilo koja aplikacija koja to radi ima vidljivu obavijest dok to čini.</string>
    <string name="welcome_notifications_with">s njom: obavijest pokazuje što se trenutno bilježi, što je jedini znak da je detaljno praćenje aktivno.</string>
    <string name="welcome_notifications_without">bez nje: detaljno praćenje se i dalje pokreće i dalje bilježi. android jednostavno neće prikazati njegovu obavijest.</string>
    <string name="hibernation_title">nastavi brojati dok ne zaboraviš</string>
    <string name="hibernation_body">android pauzira aplikacije koje se ne otvaraju nekoliko mjeseci i vraća njihove dozvole, što bi ostavilo ylih da ne bilježi ništa dok je ne otvoriš ponovo. biti zaboravljen je upravo za što je ova aplikacija, pa je sada vrijedno isključiti.</string>
