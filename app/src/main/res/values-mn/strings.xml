    <string name="settings_troubleshooting">асуудал шийдвэрлэх</string>
    <string name="settings_battery_body">хуралдаан бүртгэгдэхээ болих юм бол ylih батарейн оновчлолоос чөлөөлөгдсөн эсэхийг шалга — хүчээр зогсоосон апп дахин нээгдэх хүртэл холболтын мэдэгдлийг дахин хэзээ ч хүлээж авахгүй.</string>
    <string name="settings_battery_button">батарейн тохиргоо</string>
    <string name="settings_battery_path">тохиргоо → аппууд → ylih → батарей → хязгаарлалтгүй.</string>
    <string name="settings_hibernation_body">ylih хэдэн сар нээгдэхгүй бол android түүнийг түр зогсоож, зөвшөөрлийг нь буцаан авна, чи нээх хүртэл юу ч дахин бүртгэгдэхгүй. үүнийг унтраасан нь л чи аппын талаар огт бодоогүй бүтэн улирлын турш хос тоолсоор байхыг боломжтой болгодог.</string>
    <string name="settings_hibernation_on">android ylih-г түр зогсоож болзошгүй.</string>
    <string name="settings_hibernation_off">ylih чөлөөлөгдсөн бөгөөд бүртгэсээр байна.</string>
    <string name="settings_hibernation_button">ашиглагдаагүй аппын тохиргоо</string>
