    <string name="welcome_title">ylih-д тавтай морил</string>
    <string name="welcome_intro">хос чихэвч бүр хэр удаан холбогдсон байхыг ylih бүртгэдэг, ингэснээр олон жилийн дараа ч чи нэг хосын талаарх хамгийн чухал ганц асуултад хариулж чадна: тэд хэдэн цаг тэссэн бэ?</string>
    <string name="welcome_point_auto_title">холбоод мартчих</string>
    <string name="welcome_point_auto_body">bluetooth чихэвч холбогдсон мөчөөс эхлэн өөрөө бүртгэгддэг. юу ч ажиллуулж орхих шаардлагагүй.</string>
    <string name="welcome_point_lifetime_title">нэг хос, нэг амьдрал</string>
    <string name="welcome_point_lifetime_body">хос эвдэрсэн үед түүнийг тэтгэвэрт гарга: нийт дүн нь тэндээ хөлдөж, ижил чихэвчний дараагийн хос тэгээс дахин эхэлнэ.</string>
    <string name="welcome_point_detailed_title">утас ба тоглуулалт</string>
    <string name="welcome_point_detailed_body">тохиргоо доторх дэлгэрэнгүй хяналт утастай чихэвчийг нэмж, тэр хугацааны хэдийг үнэхээр тоглуулж байсныг хэмждэг.</string>
    <string name="welcome_privacy">бүх зүйл энэ утсан дээр үлддэг. бүртгэл байхгүй, аппад интернэтийн зөвшөөрөл ч байхгүй.</string>
    <string name="welcome_start">эхлэх</string>
    <string name="welcome_next">дараах</string>
    <string name="welcome_allow">зөвшөөрөх</string>
    <string name="welcome_step">алхам %1$d / %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth хандалт</string>
    <string name="welcome_bluetooth_why">аль bluetooth төхөөрөмж холбогдсон, түүнийг юу гэдгийг android аппад зөвхөн тухайн апп bluetooth хандалттай үед л хэлдэг. ylih хос чихэвчийг машины радиогоос ялгаж, нэг хосыг нөгөөгөөс нь таньдаг арга нь энэ юм.</string>
    <string name="welcome_bluetooth_with">үүнтэй бол: хос бүр холбогдсон мөчөөс эхлэн бүртгэгдэнэ, юу ч ажиллуулж орхихгүй, юу ч дарахаа санах шаардлагагүй.</string>
    <string name="welcome_bluetooth_without">үүнгүй бол: ямар ч bluetooth чихэвч бүртгэгдэхгүй. аппын бусад хэсэг ажиллаад байна, чи үүнийг дараа android-ын апп тохиргооноос өгч болно.</string>
    <string name="welcome_notifications_title">мэдэгдэл</string>
    <string name="welcome_notifications_why">дэлгэрэнгүй хяналт жижиг арын үйлчилгээ ажиллуулдаг ба android ийм зүйл хийж буй аливаа аппаас тэр хугацаанд харагдах мэдэгдэл байлгахыг шаарддаг.</string>
    <string name="welcome_notifications_with">үүнтэй бол: мэдэгдэл яг одоо юу бүртгэгдэж байгааг харуулна, энэ бол дэлгэрэнгүй хяналт амьд байгаагийн цорын ганц шинж.</string>
    <string name="welcome_notifications_without">үүнгүй бол: дэлгэрэнгүй хяналт ажиллаад, бүртгээд байна. android зүгээр л түүний мэдэгдлийг харуулахгүй.</string>
    <string name="hibernation_title">чи мартсан ч тоолсоор байна</string>
    <string name="hibernation_body">хэдэн сар нээгдээгүй аппуудыг android түр зогсоож, зөвшөөрлийг нь буцаан авдаг, ингэснээр чи дахин нээх хүртэл ylih юу ч бүртгэхгүй. мартагдах нь яг энэ аппын оршин байгаа учир шалтгаан тул үүнийг одоо унтраах нь зүйтэй.</string>
    <string name="action_not_now">одоо биш</string>

