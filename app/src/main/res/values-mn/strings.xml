    <string name="settings_tracking">хяналт</string>
    <string name="settings_detailed_title">дэлгэрэнгүй хяналт</string>
    <string name="settings_detailed_body">утастай чихэвч болон тоглуулалтын хугацааг нэмнэ. утас залгах үйл явдлыг android зөвхөн ажиллаж буй аппад мэдэгддэг тул энэ нь мэдэгдлийн хэсэгт чимээгүй мэдэгдэл байлгана. bluetooth ямар ч тохиолдолд хянагдана.</string>
    <string name="settings_detailed_unavailable">bluetooth хандалт олгох хүртэл боломжгүй: энэ хувилбар зөвхөн connectedDevice үйлчилгээний төрлийг зарладаг ба android 14+ үүнийг bluetooth зөвшөөрөлтэй холбодог.</string>
    <string name="settings_playback_only_title">зөвхөн тоглуулалтыг тоолох</string>
    <string name="settings_playback_only_body">холбогдсон хугацааны оронд аудио үнэхээр тоглож байсан хугацааг статистик тоолно. зөвхөн дэлгэрэнгүй хяналт асаалттай үед бүртгэгдсэн хуралдаанууд тоглуулалтыг хэмжсэн; бусад нь орхигдоно.</string>
    <string name="settings_language">хэл</string>
    <string name="settings_language_system">системийн хэл</string>
    <string name="settings_devices">төхөөрөмж</string>
    <string name="settings_devices_body">чихэвч биш аливаа зүйлийн — машины радио эсвэл чанга яригч — тэмдгийг авч, бүртгэхийг зогсоо.</string>
