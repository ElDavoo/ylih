    <string name="settings_language_system">sistēmas valoda</string>
    <string name="settings_devices">ierīces</string>
    <string name="settings_devices_body">noņem atzīmi visam, kas nav austiņas — automašīnas radio vai skaļrunim — lai pārtrauktu to pierakstīt.</string>
    <string name="settings_device_subtitle">%1$s · pirmoreiz redzēts %2$s</string>
