    <string name="settings_export">eksportēt json</string>
    <string name="settings_import">importēt</string>
    <string name="settings_import_warning">importēšana aizstāj visu, kas pašlaik saglabāts.</string>
    <string name="settings_troubleshooting">problēmu novēršana</string>
    <string name="settings_battery_body">ja sesijas pārstāj tikt pierakstītas, pārbaudi, vai ylih ir atbrīvots no akumulatora optimizācijas — lietotne, kas ir piespiedu kārtā apturēta, vairs nesaņem savienojuma paziņojumus, līdz tā tiek atvērta.</string>
    <string name="settings_battery_button">akumulatora iestatījumi</string>
    <string name="settings_battery_path">iestatījumi → lietotnes → ylih → akumulators → neierobežots.</string>
    <string name="settings_hibernation_body">ja ylih netiek atvērts dažus mēnešus, android to aptur un atņem tam atļaujas, un nekas vairs netiek pierakstīts, līdz tu to atver. tieši tā izslēgšana ļauj pārim turpināt skaitīt cauri visai sezonai, kad tu par lietotni nemaz nedomā.</string>
    <string name="settings_hibernation_on">android var apturēt ylih.</string>
    <string name="settings_hibernation_off">ylih ir atbrīvots un turpina pierakstīt.</string>
    <string name="settings_hibernation_button">neizmantoto lietotņu iestatījumi</string>
    <string name="settings_about">par</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — austiņu stundas, glabātas šeit un mūžīgi.</string>
    <string name="settings_import_confirm_title">aizstāt visus datus?</string>
    <string name="settings_import_confirm_body">šīs rezerves kopijas importēšana dzēš katru pašlaik saglabāto ierīci, pāri un sesiju.</string>

