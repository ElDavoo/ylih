    <string name="welcome_title">byenveni dan ylih</string>
    <string name="welcome_intro">ylih anrezistre komye letan sak per lekoutèr res konekte, pou ki dan plizir lane to ankor kapav reponn sel kestion ki inportan lor enn per: komye ler zot inn dire?</string>
    <string name="welcome_point_auto_title">konekte apre bliye</string>
    <string name="welcome_point_auto_body">lekoutèr bluetooth anrezistre zot tousel, depi moman ki zot konekte. pena nanye ki bizin res marse.</string>
    <string name="welcome_point_lifetime_title">enn per, enn lavi</string>
    <string name="welcome_point_lifetime_body">kan enn per mor, met li dan retret: so total arete laba ek prosin per mem lekoutèr rekoumans depi zero.</string>
    <string name="welcome_point_detailed_title">fil ek lamizik</string>
    <string name="welcome_point_detailed_body">swivi detaye, dan paramet, azout lekoutèr ar fil ek mezir komye sa letan la ti pe zwe vremem.</string>
    <string name="welcome_privacy">tou res lor sa telefonn la. pena kont, ek aplikasion la pena permision internet.</string>
    <string name="welcome_start">koumanse</string>
    <string name="welcome_next">swivan</string>
    <string name="welcome_allow">permet</string>
    <string name="welcome_step">letap %1$d lor %2$d</string>
    <string name="welcome_bluetooth_title">akse bluetooth</string>
    <string name="welcome_bluetooth_why">android dir enn aplikasion ki aparey bluetooth inn konekte, ek kouma li apele, zis si aplikasion la ena akse bluetooth. se koumsa ki ylih fer diferans ant enn per lekoutèr ek radio loto, ek kone enn per ar enn lot.</string>
    <string name="welcome_bluetooth_with">avek li: sak per anrezistre depi moman ki li konekte, san nanye ki res marse ek san bizin rapel pou peze.</string>
    <string name="welcome_bluetooth_without">san li: okenn lekoutèr bluetooth pa anrezistre. res aplikasion la marse touzour, ek to kapav donn li plitar dan paramet aplikasion android.</string>
    <string name="welcome_notifications_title">notifikasion</string>
    <string name="welcome_notifications_why">swivi detaye fer marse enn ti servis anba, ek android demann tou aplikasion ki fer sa pou gard enn notifikasion vizib pandan sa letan la.</string>
    <string name="welcome_notifications_with">avek zot: notifikasion montre seki pe anrezistre lamem, se sel siny ki swivi detaye vivan.</string>
    <string name="welcome_notifications_without">san zot: swivi detaye touzour marse ek touzour anrezistre. android zis pa pou montre so notifikasion.</string>
    <string name="hibernation_title">kontign konte pandan ki to bliye li</string>
    <string name="hibernation_body">android arete bann aplikasion ki pa’nn ouver depi plizir mwa ek reprann zot permision, seki ti pou les ylih pa anrezistre nanye ziska to ouver li ankor. pou bliye se exakteman kifer sa aplikasion la existe, alor li vo lapenn tir sa aster.</string>
