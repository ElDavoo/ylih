    <string name="settings_import_warning">samavesha-dvayah sarva-idanIm sthita-suchana-dvayah parivartti karoti.</string>
    <string name="settings_troubleshooting">samasyah-nirakarana</string>
    <string name="settings_battery_body">adhyayana-gana sukhi-kartavya-avastha-prapta bhavat, ylih-asya shakti-samada-kartavya adhiratih iti smarati - karyakrama-vyavahara-viryam vinashta-bhavat, samyojana-suchana-dvayah punar-praptah na bhavati yavat-kale tat-dvarah avabudhya bhavati.</string>
    <string name="settings_battery_button">shakti-sthapana</string>
    <string name="settings_battery_path">sthapana - karyakrama-vah - ylih - shakti - asangarita.</string>
    <string name="settings_hibernation_body">ylih-asya katividhikalam apriyaya bhavat, android-asya tat-anantaram sthapana cha adhikara-dvayah punah triguha-bhavanti, suchana-gana punah-sukhikarta-bhavat yavat-kale tat-dvarah avabudhya bhavati. etad-bhava-kartavya, ylih-asya yugma-dvayah gatih calan-sthita rahu-adhyayane avasthapita bhavati.</string>
    <string name="settings_hibernation_on">android-asya ylih-asya sthapana karta shakta.</string>
    <string name="settings_hibernation_off">ylih-asya asangarita cha chalita-sthita rahu-adhyayane.</string>
    <string name="settings_hibernation_button">aprayojita-karyakrama-sthapana</string>
    <string name="settings_about">parichaya</string>
    <string name="settings_about_body">ylih %1$s (%2$s) - sravana-yantra-hora, sthita bhavana-gana-sthapita-sarvada.</string>
    <string name="settings_import_confirm_title">sarva-suchana-dvayah parivartti kartvi?</string>
    <string name="settings_import_confirm_body">etad-sthapana-dvayah samavesha-kale pratyek yantra-dvayah, yugma-dvayah cha adhyayana-gana sukhi-krita nasa-bhavanti.</string>

