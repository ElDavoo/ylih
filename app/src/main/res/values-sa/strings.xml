    <string name="settings_tracking">अनुसरणम्</string>
    <string name="settings_detailed_title">विस्तृतम् अनुसरणम्</string>
    <string name="settings_detailed_body">तन्तुयुक्तानि कर्णयन्त्राणि वादनकालं च योजयति। android तन्तुसंयोगघटनाः केवलं चलते अनुप्रयोगाय वदति, अतः इदं नीरवां सूचनां स्थापयति। bluetooth उभयथापि अनुसृतं भवति।</string>
    <string name="settings_detailed_unavailable">bluetooth प्रवेशं विना अनुपलब्धम् — इयं रचना केवलं connectedDevice सेवाप्रकारं घोषयति, यम् android 14+ bluetooth अनुमत्या सह बध्नाति।</string>
    <string name="settings_playback_only_title">केवलं वादनं गण्यताम्</string>
    <string name="settings_playback_only_body">साङ्ख्यिकी संयोगकालस्य स्थाने वस्तुतः ध्वनिवादनस्य कालं गणयति। केवलं विस्तृतेन अनुसरणेन लिखितानि सत्राणि वादनं मापितवन्ति; इतराणि त्यज्यन्ते।</string>
    <string name="settings_language">भाषा</string>
    <string name="settings_language_system">प्रणालीभाषा</string>
    <string name="settings_devices">उपकरणानि</string>
    <string name="settings_devices_body">यत् कर्णयन्त्रं नास्ति — यानध्वनियन्त्रं वा ध्वनिवर्धको वा — तत् अचिह्नितं करोतु, येन तत् न लिख्यते।</string>
    <string name="settings_device_subtitle">%1$s · प्रथमदर्शनम् %2$s</string>
