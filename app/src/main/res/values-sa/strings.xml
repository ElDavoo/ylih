    <string name="welcome_title">ylih-e svagata</string>
    <string name="welcome_intro">ylih pratyek sravana-yantra-yugma katividhikalam yojita rahu-adhyayane avadhih karoti. tatra paramvatsarebhyah samaye tvam eva prasnasya uttaram eva dasyasi - ye sravana-yantra-yugma katividhikalam sthita-abhavat?</string>
    <string name="welcome_point_auto_title">yogga kartvi cha vismartu</string>
    <string name="welcome_point_auto_body">bluetooth sravana-yantra-yugma sva-matra samyojana-kshane suchi-bhuta bhavanti. na kascit karyakrama chalita bhavitavya.</string>
    <string name="welcome_point_lifetime_title">eka yugma, eka jaivana-kala</string>
    <string name="welcome_point_lifetime_body">yada sravana-yantra-yugma vinashta bhavati, tade nivartti kartvi - tatra yogi-ankah tatah sthira bhavati cha puna-samyojane nava-yugma shunya-matra arambha bhavati.</string>
    <string name="welcome_point_detailed_title">sutra-yojita cha avadhih-gita</string>
    <string name="welcome_point_detailed_body">vistrita sthapana-goshthisu, sutra-yojita sravana-yantra-yugma cha yatah-madhye vastutah avadhih-gita-kala parimitir bhavati, tad adhyayane sangrahyate.</string>
    <string name="welcome_privacy">sarvam etad bhavananam eva sthita. na kascit sangha-gana, cha karyakrama-asya na kascit antarala-adhikara.</string>
    <string name="welcome_start">arambha kartvi</string>
    <string name="welcome_next">anusmarti</string>
    <string name="welcome_allow">anumate</string>
    <string name="welcome_step">padah %1$d tah %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth adhikara</string>
    <string name="welcome_bluetooth_why">android eva karyakrama-asya kevalam yat bluetooth-yantra samyojita-bhavat cha tat-nama yadi karyakrama-asya bluetooth adhikara asti, tad eva samjanam karoti. etad eva ylih-anam sravana-yantra-yugma-vah sva-yantra-vah pariccheda kartum cha dvayoh yugma-vah antaram parijnanat.</string>
    <string name="welcome_bluetooth_with">anena - pratyek yugma-dvayoh samyojana-kshane suchi-bhuta bhavati, nihil chalita cha nihil smrti-kartavyam.</string>
    <string name="welcome_bluetooth_without">anena-vina - na kascit bluetooth sravana-yantra-yugma suchi-bhuta bhavati. karyakrama-asya itara-amsah karyakrama eva karoti, cha tvam tat-anantaram android-asya karyakrama-goshthisu danam kartum shaknosha.</string>
    <string name="welcome_notifications_title">suchana</string>
    <string name="welcome_notifications_why">vistrita adhyayana-kshetram eka laghu-anya-karyakrama-sthapana chalita karoti, cha android-asya kasyacit eva tat-alpa-suchana-vidyamanam avasthapita kartavyam.</string>
    <string name="welcome_notifications_with">anena - suchana-dvayah yatah-madhye adhyayate tad vidyamanam darsayati, yatah eva vistrita adhyayana-kshetram jaivana-kalaparyapt.</string>
    <string name="welcome_notifications_without">anena-vina - vistrita adhyayana-kshetram ev chalita karoti cha sukhi-karana ev karoti. android eva tad-suchana-dvayah na darsayishyati.</string>
    <string name="hibernation_title">gana-krana-madhye smaranam karoti</string>
    <string name="hibernation_body">android-asya karyakrama-vah antah-puratarah katividhikalam apyukte sthita-bhavat, adhikara-dvayah punah triguha-bhavanti, ylih-asya ev karyakrama-adhyayana-gana-sthanam na karoti. etad ev ylih-asya karyakrama-asya gamya, tat-anantaram tat-adharnanam sthapana-svarupam.</string>
