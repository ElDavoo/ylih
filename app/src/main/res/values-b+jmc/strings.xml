    <string name="settings_tracking">ufuatiliaji</string>
    <string name="settings_detailed_title">ufuatiliaji wa kina</string>
    <string name="settings_detailed_body">inaongeza hedoniya za kamba na muda wa kuchumba. android inajuaje matukio ya kamba ya kamba tu kwa programu inayoendesha, kwa hivyo hii inabaki kuonyesha arifa ya kutisha kwenye kivuli. bluetooth inafuatiliwa kwa njia yoyote.</string>
    <string name="settings_detailed_unavailable">haipatikani hadi ufikiaji wa bluetooth utakapoidhinishwa: mtakatifu huu haujaahidi tu aina ya huduma ya simu ya kuunganisha, ambayo android 14+ inaambatisha kwa ruhusa ya bluetooth.</string>
    <string name="settings_playback_only_title">hesabu kucheza tu</string>
    <string name="settings_playback_only_body">takwimu zinahesabu muda sauti ilikuwa inaigiza kwa njia ya muda unaounganisha. vikao tu vya kurekodhi na ufuatiliaji wa kina juu ya kupimwa kwa kucheza; nyingine zote zinaacha nje.</string>
    <string name="settings_language">lugha</string>
    <string name="settings_language_system">lugha ya mfumo</string>
    <string name="settings_devices">simu</string>
    <string name="settings_devices_body">ondoa alama kila kitu ambacho si hedoniya — sterio ya gari au spika — ili kuacha kurekodi.</string>
    <string name="settings_device_subtitle">%1$s · kwanza kujifunza %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">kuhamisha json</string>
    <string name="settings_import">kuingiza</string>
    <string name="settings_import_warning">kuingiza kunabadilisha kila kitu kilichohifadhiwa sasa.</string>
    <string name="settings_troubleshooting">kusambaza matatizo</string>
    <string name="settings_battery_body">ikiwa vikao vinyekan kurekodhi, angalia kwamba ylih ilikuwa inakataa ubatilizo wa betri — programu iliyosimamishwa kwa nguvu haikati kukamatia mgharebuni wa unganizho tena hadi ikapata kufunguliwa.</string>
    <string name="settings_battery_button">mipango ya betri</string>
    <string name="settings_battery_path">mipango → programu → ylih → betri → kisanidi.</string>
    <string name="settings_hibernation_body">ikiwa ylih inabaki bila kufunguliwa kwa miezi kadhaa, android inakumia na kuzirejesha ruhusa zao, na hakuna kitu kinachorekodiwa tena hadi ufungue. kuizima ni kile kinachofanya jozi kuendelea kuhesabu kupitia kisimu unakosoma programu.</string>
    <string name="settings_hibernation_on">android inaweza kumia ylih.</string>
    <string name="settings_hibernation_off">ylih ilikuwa na njiani na inaendelea kurekodi.</string>
    <string name="settings_hibernation_button">mipango ya programu isiyotumiwa</string>
    <string name="settings_about">kuhusu</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — masaa ya hedoniya, yaliyofanikiwa ndani na milele.</string>
    <string name="settings_import_confirm_title">badilisha data zote?</string>
    <string name="settings_import_confirm_body">kuingiza chelezo hiki kunafuta kila simu, jozi na kikao kilicho hifadhiwa sasa.</string>

