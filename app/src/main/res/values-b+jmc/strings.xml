    <string name="welcome_title">karibu kwa ylih</string>
    <string name="welcome_intro">ylih inakumbuka ni muda gani kila jozi ya hedoniya ilibaki kuunganishwa, ili mwaka ujao unaweza bado kujibu swali moja tu linalohitaji kuzibu kuhusu jozi: saatislangisha ngapi zililipita?</string>
    <string name="welcome_point_auto_title">unganisha na sahau</string>
    <string name="welcome_point_auto_body">hedoniya za bluetooth zinarekodiwa pachenyewe, kuanzia wakati inapounganisha. hakuna kitu kinachohitajika kuachwa kikiendeshwa.</string>
    <string name="welcome_point_lifetime_title">jozi moja, maisha yote</string>
    <string name="welcome_point_lifetime_body">wakati jozi inafinika, iondoe: jumla yake inabakia huko na jozi inayofuata ya hedoniya sawa inaanza tena kutoka sifuri.</string>
    <string name="welcome_point_detailed_title">hedoniya za kamba na kuchumba</string>
    <string name="welcome_point_detailed_body">ufuatiliaji wa kina, katika mipango, unaongeza hedoniya za kamba na kupima ni sehemu gani ya muda ilikuwa inaigiza.</string>
    <string name="welcome_privacy">kila kitu kinabaki kwenye simu hii. hakuna akaunti, na programu haina ruhusa ya mtandao.</string>
    <string name="welcome_start">anza</string>
    <string name="welcome_next">inayofuata</string>
    <string name="welcome_allow">ruhusu</string>
    <string name="welcome_step">hatua %1$d ya %2$d</string>
    <string name="welcome_bluetooth_title">ufikiaji wa bluetooth</string>
    <string name="welcome_bluetooth_why">android inajuaje tu programu ipi kama ngazi ya bluetooth inaonganisha, na kile kinachoitwa, ikiwa programu inashikilia ufikiaji wa bluetooth. hii ndio jinsi ylih inavyobadilisha jozi ya hedoniya kutoka kwa sterio ya gari, na jinsi gani inajua jozi moja kutoka kwa nyingine.</string>
    <string name="welcome_bluetooth_with">nayo: kila jozi inaRekodiwa kuanzia wakati inapounganisha, bila kitu kinachobaki kuendeshwa na hakuna kitu cha kukariri kushinikiza.</string>
    <string name="welcome_bluetooth_without">bila hiyo: hedoniya za bluetooth hazirekodiwa kabisa. sehemu nyingine ya programu bado inafanya kazi, na unaweza kuipa ruhusa baadaye kwenye mipango ya programu ya android.</string>
    <string name="welcome_notifications_title">arifa</string>
    <string name="welcome_notifications_why">ufuatiliaji wa kina unaendesha huduma ndogo ya nyuma, na android inahitaji programu yoyote inayofanya hivyo ili kuendelea kuonyesha arifa inayoonekana wakati inafanya.</string>
    <string name="welcome_notifications_with">nayo: arifa inaonyesha kile kinachorekodiwa sasa sasa, ambayo ni alama tu kwamba ufuatiliaji wa kina ni hai.</string>
    <string name="welcome_notifications_without">bila hiyo: ufuatiliaji wa kina bado unaendesha na bado unarekodia. android tu haitaonyesha arifa yake.</string>
    <string name="hibernation_title">endelea kuhesabu wakati unakosahau</string>
    <string name="hibernation_body">android hukumia programu ambazo zimebaki bila kufunguliwa kwa miezi kadhaa na kuzirejesha ruhusa zao, ambayo ingeacha ylih ikirekebia hakuna kitu hadi ukaifungua tena. kusahauliwa ni kwa nini programu hii iko, kwa hivyo ni uzuri kuizima sasa.</string>
