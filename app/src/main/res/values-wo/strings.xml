    <string name="welcome_bluetooth_title">am jëm bluetooth</string>
    <string name="welcome_bluetooth_why">android nu joxe app ab sikasiit gu jëm, yendu gu lay, bu app mel bluetooth sa. ko ngir ylih amee sikasiit ci botis, yo amee sikasiit ci sikasiit.</string>
    <string name="welcome_bluetooth_with">mel sa: sikasiit gu yaa jot ngir ndax ñu jëm, buuji-buuji litaa, te aju dijit jaam.</string>
    <string name="welcome_bluetooth_without">buuji mel sa: sikasiit bluetooth buuji yaa. app yi rakk mel bu baax, te ko jëm su melokaan android ko.</string>
    <string name="welcome_notifications_title">xooliante</string>
    <string name="welcome_notifications_why">jot bu jarii mel jëm bu ndax, te android teet tëj app gu jotul xooliante ci waxtu bu gis.</string>
    <string name="welcome_notifications_with">mel sa: xooliante gi jotul ndax gu yaa, ki ñu xooliante bu mel bu jarii gu ci.</string>
    <string name="welcome_notifications_without">buuji mel sa: jot bu jarii mel te jotul su waxtu. android mu jotul xooliante.</string>
    <string name="hibernation_title">mel yi jut bu sa yaar</string>
    <string name="hibernation_body">android mel app yi dëkk ngir koo bisu ak yuur, te mel jëm na ci, kon ylih mu yaa yotul ko bi ndax ko so agale. yaar bu sa ko ko bu am ylih su seen, noo ko rekk fi ay yobee.</string>
