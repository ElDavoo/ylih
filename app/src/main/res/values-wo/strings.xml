    <string name="welcome_title">dalal ba ylih</string>
    <string name="welcome_intro">ylih dem jot na seet ci jëm sikasiit endi jëm gu meggul ci, noo na ko jáng suubaaga ko foofu sunu soobma mbeetu: jàngal seet am leegi?</string>
    <string name="welcome_point_auto_title">jëm te yaar</string>
    <string name="welcome_point_auto_body">sikasiit bluetooth gu yaa jot ngir ndax ñu jëm, buuji-buuji litaa. aju joom njëkk leen.</string>
    <string name="welcome_point_lifetime_title">sikasiit bu ben, jiggaleej bu ben</string>
    <string name="welcome_point_lifetime_body">sikasiit bu nag yemoo, gis-mi ba: jëm am jëm daal ñu, sikasiit bu ndëm ay sikasiit gu jëm kele.</string>
    <string name="welcome_point_detailed_title">joñ ak rekk</string>
    <string name="welcome_point_detailed_body">jot bu jarii, ci melokaan, daal joñ sikasiit te dal jàngal wi ñu jotal.</string>
