    <string name="settings_tracking">verfolgung</string>
    <string name="settings_detailed_title">jenaue verfolgung</string>
    <string name="settings_detailed_body">füjt kabelkopfhörer un musik-zick henzu. android saat nur en laufende app, wann kabel jer stöcker wääde, al al bleivet en stille benachrichtigunge sitstahn. bluetooth wid in jedem fall verfolgt.</string>
    <string name="settings_detailed_unavailable">is erst möglich, wenn bluetooth-zugriff jenährt wid: häm build saat nor der connectedDevice-täßjis-typ, wat android 14+ mit en bluetooth-erlaubnis verbindet.</string>
    <string name="settings_playback_only_title">nor musik-zick zelle</string>
    <string name="settings_playback_only_body">statistik zelle de zick, woh musik wirklich jespeeld woode, nit de verbundungszick. nor sizzunge, die mit jenaue verfolgung jespeichert wääde, messte musik; de andere komme nit vor.</string>
    <string name="settings_language">sproch</string>
    <string name="settings_language_system">system-sproch</string>
    <string name="settings_devices">jeerät</string>
    <string name="settings_devices_body">häk alles ov, wat keij kopfhörer es — en autoradio odder sprecher — öm et nit opzenämme.</string>
    <string name="settings_device_subtitle">%1$s · erscht jesähne %2$s</string>
