    <string name="settings_export">json exportere</string>
    <string name="settings_import">importere</string>
    <string name="settings_import_warning">importere ersätz alles, wat jrad jespeichert es.</string>
    <string name="settings_troubleshooting">problemen behebe</string>
    <string name="settings_battery_body">wenn sizzunge nit mehr op jenumme wääde, kuk, ob ylih vun batterie-optimiering befreid es — en app, die jeoppehaalde woode es, kriecht keij verbindings-meldunge meer, bes se widder jöffnet wid.</string>
    <string name="settings_battery_button">batterie-einstellunge</string>
    <string name="settings_battery_path">einstellunge → apps → ylih → batterie → unrestricted.</string>
    <string name="settings_hibernation_body">wenn ylih för en paar mönd nit jöffnet wid, pause android se un nimmt ehr erecht zorreck, un nix wid op jenumme, bes do se widder jöffniss. dat auszeschalen es wat de paar wigger zälle lässt, och wenn do e jahrtijd nit an de app denks.</string>
    <string name="settings_hibernation_on">android kann ylih pausere.</string>
    <string name="settings_hibernation_off">ylih es vun pausing befreid un zähle wigger.</string>
    <string name="settings_hibernation_button">einstellunge för ongebrukte apps</string>
    <string name="settings_about">över</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — kopfhörer-stunde, jejpeichert lookal un för alwäll.</string>
    <string name="settings_import_confirm_title">alle daten ersätzem?</string>
    <string name="settings_import_confirm_body">häm backup importere läscht jedes jeerät, paar un sizzung, die jrad jespeichert es.</string>

