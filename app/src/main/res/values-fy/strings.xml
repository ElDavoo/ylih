    <string name="settings_import_warning">ymport fersangje alles wat no op opslagene.</string>
    <string name="settings_troubleshooting">problemen oplosse</string>
    <string name="settings_battery_body">as sesjes ophâlde mei registrearjen, tsjinsjech dat ylih frij is fan batterij-optimisaasje - in app dy\'t dwong stopt ûntfangt gjin ferbining-broadcast nochris oant it iepene wurde.</string>
    <string name="settings_battery_button">batterij-ynstellingen</string>
    <string name="settings_battery_path">ynstellingen → apps → ylih → batterij → unbeheind.</string>
    <string name="settings_hibernation_body">as ylih moannen iepene net wurden, android pauseret it en nimt syn berjochting werom, en neat wurde registrearre oant do dy iepene. it út sette is wat in pear trochsette telle kin troch in seizoen dy\'t do noait oan it app tinkst.</string>
    <string name="settings_hibernation_on">android kin ylih paussearje.</string>
    <string name="settings_hibernation_off">ylih is frij en hâldt registrearjen.</string>
    <string name="settings_hibernation_button">unbrûkte app-ynstellingen</string>
