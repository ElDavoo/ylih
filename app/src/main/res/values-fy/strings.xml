    <string name="settings_language_system">systeem-taal</string>
    <string name="settings_devices">apparaten</string>
    <string name="settings_devices_body">uncheck alles dat net tskofhâlderskes is - in auto-stereo of in spreker - om it registrearjen te stopjen.</string>
