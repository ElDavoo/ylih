    <string name="welcome_title">karibu ylih</string>
    <string name="welcome_intro">ylih hurekodi muda ambao kila jozi ya vipokea sauti hukaa imeunganishwa, ili miaka mingi baadaye bado uweze kujibu swali pekee lenye maana kuhusu jozi: ilidumu kwa saa ngapi?</string>
    <string name="welcome_point_auto_title">unganisha kisha usahau</string>
    <string name="welcome_point_auto_body">vipokea sauti vya bluetooth hurekodiwa vyenyewe, tangu wakati vinapounganishwa. hakuna kinachohitaji kuachwa kikiendelea.</string>
    <string name="welcome_point_lifetime_title">jozi moja, maisha moja</string>
    <string name="welcome_point_lifetime_body">jozi inapoharibika, istaafishe: jumla yake husimama hapo na jozi inayofuata ya vipokea sauti vilevile huanza upya kutoka sifuri.</string>
    <string name="welcome_point_detailed_title">waya na uchezaji</string>
    <string name="welcome_point_detailed_body">ufuatiliaji wa kina, katika mipangilio, huongeza vipokea sauti vya waya na hupima ni kiasi gani cha muda huo sauti ilikuwa ikicheza kweli.</string>
    <string name="welcome_privacy">kila kitu hubaki kwenye simu hii. hakuna akaunti, na programu haina ruhusa ya intaneti.</string>
    <string name="welcome_start">anza</string>
    <string name="welcome_next">endelea</string>
    <string name="welcome_allow">ruhusu</string>
    <string name="welcome_step">hatua %1$d kati ya %2$d</string>
    <string name="welcome_bluetooth_title">ufikiaji wa bluetooth</string>
    <string name="welcome_bluetooth_why">android humwambia programu ni kifaa gani cha bluetooth kimeunganishwa, na kinaitwaje, ikiwa tu programu ina ufikiaji wa bluetooth. ndivyo ylih hutofautisha jozi ya vipokea sauti na redio ya gari, na jinsi inavyojua jozi moja na nyingine.</string>
    <string name="welcome_bluetooth_with">ukiwa nao: kila jozi hurekodiwa tangu wakati inapounganishwa, bila kitu chochote kuachwa kikiendelea na bila kukumbuka kubonyeza kitu.</string>
    <string name="welcome_bluetooth_without">bila huo: hakuna vipokea sauti vya bluetooth vinavyorekodiwa. sehemu nyingine ya programu bado hufanya kazi, na unaweza kuutoa baadaye katika mipangilio ya programu ya android.</string>
    <string name="welcome_notifications_title">arifa</string>
    <string name="welcome_notifications_why">ufuatiliaji wa kina huendesha huduma ndogo ya chinichini, na android huhitaji programu yoyote inayofanya hivyo kuweka arifa inayoonekana wakati wote.</string>
    <string name="welcome_notifications_with">ukiwa nazo: arifa huonyesha kinachorekodiwa sasa hivi, ndicho kiashiria pekee kwamba ufuatiliaji wa kina uko hai.</string>
    <string name="welcome_notifications_without">bila hizo: ufuatiliaji wa kina bado huendesha na bado hurekodi. android tu haitaonyesha arifa yake.</string>
    <string name="hibernation_title">huendelea kuhesabu unaposahau</string>
    <string name="hibernation_body">android husitisha programu ambazo hazijafunguliwa kwa miezi kadhaa na huchukua ruhusa zake, jambo ambalo lingeacha ylih bila kurekodi chochote hadi uifungue tena. kusahauliwa ndilo kusudi hasa la programu hii, kwa hivyo inafaa kuzima hilo sasa.</string>
