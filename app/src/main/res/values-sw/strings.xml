    <string name="settings_tracking">ufuatiliaji</string>
    <string name="settings_detailed_title">ufuatiliaji wa kina</string>
    <string name="settings_detailed_body">huongeza vipokea sauti vya waya na muda wa uchezaji. android huripoti matukio ya kuchomeka waya kwa programu inayoendesha pekee, kwa hivyo hili huweka arifa kimya kwenye kivuli. bluetooth hufuatiliwa vyovyote vile.</string>
    <string name="settings_detailed_unavailable">haipatikani hadi ufikiaji wa bluetooth utolewe: toleo hili hutangaza aina ya huduma ya connectedDevice pekee, ambayo android 14+ huifunga na ruhusa ya bluetooth.</string>
    <string name="settings_playback_only_title">hesabu uchezaji pekee</string>
    <string name="settings_playback_only_body">takwimu huhesabu muda ambao sauti ilikuwa ikicheza kweli badala ya muda wa kuunganishwa. vipindi vilivyorekodiwa na ufuatiliaji wa kina ukiwa umewashwa pekee ndivyo vilipima uchezaji; vingine huachwa nje.</string>
    <string name="settings_language">lugha</string>
    <string name="settings_language_system">lugha ya mfumo</string>
    <string name="settings_devices">vifaa</string>
    <string name="settings_devices_body">ondoa alama kwenye chochote kisicho vipokea sauti — redio ya gari au spika — ili kuacha kukirekodi.</string>
    <string name="settings_device_subtitle">%1$s · kilionekana kwa mara ya kwanza %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">hamisha json</string>
    <string name="settings_import">leta</string>
    <string name="settings_import_warning">kuleta hubadilisha kila kitu kilichohifadhiwa sasa.</string>
    <string name="settings_troubleshooting">kutatua matatizo</string>
    <string name="settings_battery_body">ikiwa vipindi vitaacha kurekodiwa, angalia kama ylih imeondolewa kwenye uboreshaji wa betri — programu iliyosimamishwa kwa nguvu haipokei tena matangazo ya muunganisho hadi ifunguliwe.</string>
    <string name="settings_battery_button">mipangilio ya betri</string>
    <string name="settings_battery_path">mipangilio → programu → ylih → betri → bila vikwazo.</string>
    <string name="settings_hibernation_body">ikiwa ylih haitafunguliwa kwa miezi kadhaa, android huisitisha na huchukua ruhusa zake, na hakuna kinachorekodiwa tena hadi uifungue. kuzima hilo ndiko kunakoruhusu jozi kuendelea kuhesabu kwa msimu mzima ambao hukufikiria programu hata kidogo.</string>
    <string name="settings_hibernation_on">android inaweza kusitisha ylih.</string>
    <string name="settings_hibernation_off">ylih imeondolewa na inaendelea kurekodi.</string>
    <string name="settings_hibernation_button">mipangilio ya programu zisizotumika</string>
    <string name="settings_about">kuhusu</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — saa za vipokea sauti, zilizohifadhiwa hapa na milele.</string>
    <string name="settings_import_confirm_title">badilisha data yote?</string>
    <string name="settings_import_confirm_body">kuleta nakala hii rudufu hufuta kila kifaa, jozi na kipindi kilichohifadhiwa sasa.</string>

