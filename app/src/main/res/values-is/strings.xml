    <string name="welcome_title">velkominn í ylih</string>
    <string name="welcome_intro">ylih skráir hversu lengi hvert par heyrnartóla er tengst, svo að nokkrum árum síðar getur þú enn svarað einu mikilvægustu spurningunni um par: hve margar stundir endurðu þau?</string>
    <string name="welcome_point_auto_title">tengstu og gleymdu</string>
    <string name="welcome_point_auto_body">bluetooth heyrnartólar eru skráðir sjálfkrafa, frá því þeir tengast. ekkert þarf að halda keyrandi.</string>
    <string name="welcome_point_lifetime_title">eitt par, ein ævi</string>
    <string name="welcome_point_lifetime_body">þegar par deyja, starfslok það: heildarfjöldi hans frýs þar og næsta par sömu heyrnartóla byrjar aftur frá núlli.</string>
    <string name="welcome_point_detailed_title">vírlaust og endurspilun</string>
    <string name="welcome_point_detailed_body">nákvæm rakning, í stillingum, bætir við vírlausum heyrnartólum og mælir hversu stór hluti tímans var raunverulega að spila.</string>
    <string name="welcome_privacy">allt dvalast á þessari símu. það er engin reikningur og appið hefur engar internetheimildir.</string>
    <string name="welcome_start">hafstu</string>
    <string name="welcome_next">næst</string>
    <string name="welcome_allow">leyfa</string>
    <string name="welcome_step">skref %1$d af %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth aðgangur</string>
    <string name="welcome_bluetooth_why">android segir appinu aðeins hvaða bluetooth tæki tengdust og hvað kallast það ef appið hefur bluetooth aðgang. það er hvernig ylih aðgreinir par heyrnartóla frá bíllestri og hvernig það þekkir eitt par frá öðru.</string>
    <string name="welcome_bluetooth_with">með því: hvert par er skráð frá því það tengist, án þess að neitt sé keyrandi og enginn þarf að muna að ýta.</string>
    <string name="welcome_bluetooth_without">án þess: engin bluetooth heyrnartól eru skráð yfirleitt. afgangurinn af appinu virkar enn og þú getur veitt það seinna í stillingum android.</string>
    <string name="welcome_notifications_title">tilkynningar</string>
    <string name="welcome_notifications_why">nákvæm rakning keyrir litla bakgrunnsþjónustu og android krefst þess að hver app sem gerir það haldi tilkynningu sýnilegri á meðan hún gerir það.</string>
    <string name="welcome_notifications_with">með því: tilkynningin sýnir hvað er verið að skrá rétt núna sem er eina merkin um að nákvæm rakning sé á lífi.</string>
    <string name="welcome_notifications_without">án þess: nákvæm rakning keyrir enn og skrár enn. android mun bara ekki sýna tilkynningu sína.</string>
    <string name="hibernation_title">haltu áfram talningunni meðan þú gleymir henni</string>
    <string name="hibernation_body">android stöðvar app sem eru ekki opnuð í nokkra mánuði og tekur heimildir þeirra til baka sem myndu skilja ylih án þess að skrá neitt þar til þú opnaðir hana næst. að gleymast er einmitt hvað þetta app er fyrir svo það borgar sig að slökkva á því núna.</string>
