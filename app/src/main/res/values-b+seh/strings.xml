    <string name="settings_detailed_title">kumva mwambiri</string>
    <string name="settings_detailed_body">kumapumiritsa matako onamuko wumadzi ndi nthawi ya kumdandalira. android imanyamalitsa zonetsa za plug ya wumadzi kutumbuwa yomwe ikudutsa, chifukwa chake ichi kumachitika zonetsa zosemphimpha m’chinjiro. bluetooth yadziwika.</string>
    <string name="settings_detailed_unavailable">silidikidwa mpaka bluetooth kulowerengedwa: izi kumbuyo kumanyalitsa kusanthula kwa connectedDevice, iyo android 14+ yalumikitsa ku bluetooth chiloleza.</string>
    <string name="settings_playback_only_title">werengetsa kumdandalira kawiri</string>
    <string name="settings_playback_only_body">mbalaka iwerengetsa nthawi iyo mawu akumdandalira moyo m’malo mwa nthawi yovankha. magawo anapakini ndi kumva mwambiri vuto kukayangʼanira kumdandalira; zina zisiyidwa.</string>
