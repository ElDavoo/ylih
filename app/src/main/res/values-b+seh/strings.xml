    <string name="welcome_title">uvuyeni mu ylih</string>
    <string name="welcome_intro">ylih imusava kambuzi ka nthawi yayethu pa makedzeni, ndipo chacha zimezi mudzakhoza kupindura puzo lokhalo lina chikani: maola angati anatengela?</string>
    <string name="welcome_point_auto_title">vankha ndi kusiyika</string>
    <string name="welcome_point_auto_body">matako a bluetooth amunyanyulidza mwachibvinjikiro, kuyambira nthawi iyo anavankha. palibe chomwe chikuyangʼanitsa kukhala kunyambulika.</string>
    <string name="welcome_point_lifetime_title">makedzeni amodzi, moyo umodzi</string>
    <string name="welcome_point_lifetime_body">makedzeni amodzi akufa, amusisire: kabuzi kake kakhala kumayimiliki ndipo makedzeni otsatira a matako omweomwe akhala kuyambira ziro.</string>
    <string name="welcome_point_detailed_title">wonamuko wumadzi ndi kumdandalira</string>
    <string name="welcome_point_detailed_body">kumva mwambiri, mu mapangidzo, kumapumiritsa matako onamuko wumadzi ndi kukayangʼanira ngati nthawi yawo inali yosambira.</string>
    <string name="welcome_privacy">zonse zimakhalira pa foni yino. palibe akaunti, ndi app ilibe chiloleza cha intanete.</string>
    <string name="welcome_start">thani</string>
    <string name="welcome_next">chulengedwe</string>
    <string name="welcome_allow">lani</string>
    <string name="welcome_step">gawo %1$d la %2$d</string>
    <string name="welcome_bluetooth_title">kuloweredwa kwa bluetooth</string>
    <string name="welcome_bluetooth_why">android imanyamalitsa app kuti kodi chipangizo cha bluetooth chivankha, ndi chamene chikuitanidwa, ngati app ili ndi kuloweredwa kwa bluetooth. ichi ndo njira iyo ylih imasiyanitsa makedzeni kuyambira chirikiti cha magalimoto, ndi njira iyo imadziwa makedzeni amodzi kuyambira ena.</string>
    <string name="welcome_bluetooth_with">ndi ichi: makedzeni aliwonse amunyanyulidza kuyambira nthawi iyo avankha, popanda chinachake kukhala kunyambulika ndi chinachake kusuza.</string>
    <string name="welcome_bluetooth_without">popanda ichi: matako a bluetooth sulinyanyulidza konse. kuchulukorera kwa app kukhalilobe kumagwira, ndi kuti mukhoza kuchikuloleza pambuyo mu mapangidzo a android.</string>
    <string name="welcome_notifications_title">zonetsa</string>
    <string name="welcome_notifications_why">kumva mwambiri kumagwira ntchito yachingʼamba, ndipo android ikudikira app iliyonse ikuchita ichi kusunga zonetsa zikuwoneka.</string>
    <string name="welcome_notifications_with">ndi ichi: zonetsa zikuonetsera zomwe zapakini pano, chimene chimodzi ndi chikumbukiro chakuti kumva mwambiri kuli moyo.</string>
    <string name="welcome_notifications_without">popanda ichi: kumva mwambiri kumagwira ndi kunapakini. android sudzakuwonetsera zonetsa zake.</string>
    <string name="hibernation_title">patulira kuwerengetsa pamene mukusiyika</string>
    <string name="hibernation_body">android imayimitsitsa mappu omwe sanasungulwe kwa miyezi ingapo ndipo imatola chiloleza chake kuno, zimene zingapangitse ylih sunapakini paliponse mukasungulira. kusuwa ndi chimene app iyi ili, chifukwa chake ndi chakusunga kuigona pano.</string>
