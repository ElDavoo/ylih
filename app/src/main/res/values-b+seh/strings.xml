    <string name="settings_battery_body">ngati magawo sangapakini, sankhani kuti ylih ili ndi kusankha kwa bettery - mappu okhomiridwa sikupeza ndi kunt’hauzili kwa nthawi yotsatira mpaka iyokwuke.</string>
    <string name="settings_battery_button">mapangidzo a bettery</string>
    <string name="settings_battery_path">mapangidzo → mappu → ylih → bettery → mosadandaula.</string>
    <string name="settings_hibernation_body">ngati ylih sanasungulwe kwa miyezi ingapo, android imayimitsitsa ndi imatola chiloleza, ndi palibe napakini mpaka mukasungulira. kuigona ndo njira iyo makedzeni amadutsa kuwerengetsa munthawi yomwe sindikuganiza za mappu.</string>
    <string name="settings_hibernation_on">android ikhoza kuyimitsitsa ylih.</string>
    <string name="settings_hibernation_off">ylih ili ndi kusankha ndi kunapakini.</string>
    <string name="settings_hibernation_button">mapangidzo a mappu osagwira ntchito</string>
    <string name="settings_about">pankhonipankhoni</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — maola a matako, kusumudzigwidwitsa ndi nthawi yonse.</string>
    <string name="settings_import_confirm_title">sinthani deta yonse?</string>
    <string name="settings_import_confirm_body">kutonya izi kulipira kulankhula chipangizo, makedzeni ndi gawo losomezedwa pano.</string>

