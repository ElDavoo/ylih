    <string name="settings_tracking">lekha iḍa</string>
    <string name="settings_detailed_title">puura lekha</string>
    <string name="settings_detailed_body">tar hedphon aane baja veḷa jorḍenu. android tar juḍa khabar kevala calu ap-ki inḍenu, aaṭene ii oṭe cup khabar toḍenu. bluetooth renḍu ṭeku lekha aanu.</string>
    <string name="settings_detailed_unavailable">bluetooth anumati sili kaam aa sili: ii bild kevala connectedDevice sevaa toḍenu, aane android 14+ aa-ki bluetooth anumati-ṭene juḍenu.</string>
    <string name="settings_playback_only_title">kevala baja ganḍu</string>
    <string name="settings_playback_only_body">lekha juḍa veḷa badale saccaka baja aate veḷa ganḍenu. baja kevala puura lekha manḍa sesan-ṭe maapa aate; baaki bahaara manḍenu.</string>
    <string name="settings_language">bhaasa</string>
    <string name="settings_language_system">sisṭam bhaasa</string>
    <string name="settings_devices">jinis</string>
    <string name="settings_devices_body">ie hedphon sili — gaaḍi spikar ba aara spikar — aa-na cinha veṭṭa iḍu, aaṭene aa lekha aa sili.</string>
    <string name="settings_device_subtitle">%1$s · modala %2$s</string>
    <string name="settings_data">ḍaṭa</string>
    <string name="settings_export">json bahaara</string>
    <string name="settings_import">bhitara</string>
    <string name="settings_import_warning">bhitara iḍa ippa manḍa sabu badalenu.</string>
    <string name="settings_troubleshooting">kaṣṭa ṭhika</string>
    <string name="settings_battery_body">sesan lekha nilite, toḍu ylih beṭri baccata-ṭene bahaara manḍenu ki sili — jora-ṭene nilupi aate ap uḍi paryanta juḍa khabar veṭṭa jaḍa sili.</string>
    <string name="settings_battery_button">beṭri sajaḍa</string>
    <string name="settings_battery_path">sajaḍa → ap → ylih → beṭri → banda sili.</string>
    <string name="settings_hibernation_body">ylih keteka lenju uḍi sili manḍite android aa-ki nilupenu aane anumati veṭṭa iḍenu, aane ni uḍi paryanta keteka lekha aa sili. aa-ki banda kite joḍi aa veḷa ku ganḍa manḍenu, jekaḍe ni ap-na kathaa ku uhinḍa sili.</string>
    <string name="settings_hibernation_on">android ylih-ki nilupa munḍenu.</string>
    <string name="settings_hibernation_off">ylih bahaara manḍenu aane lekha iḍenu.</string>
    <string name="settings_hibernation_button">kaam sili ap sajaḍa</string>
    <string name="settings_about">baare</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — hedphon ghanta, iṭṭene aane sadaa-ki manḍenu.</string>
    <string name="settings_import_confirm_title">sabu ḍaṭa badala munḍi?</string>
    <string name="settings_import_confirm_body">ii bekap bhitara iḍite ippa manḍa prati jinis, joḍi aane sesan mucha aanu.</string>

