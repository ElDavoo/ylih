    <string name="welcome_title">ylih-ta johar</string>
    <string name="welcome_intro">ylih lekha iḍinu, prati hedphon joḍi keteka veḷa juḍi manḍenu. eṭṭi barsa pacce ku ni oṭe prasna-ki jabab iḍa munḍenu — keteka ghanta kaam kiteru?</string>
    <string name="welcome_point_auto_title">juḍa kiḍu, pacce paasara</string>
    <string name="welcome_point_auto_body">bluetooth hedphon juḍi ai veḷa-ṭene tane lekha aanu. keteka jinis calu iḍa loḍa sili.</string>
    <string name="welcome_point_lifetime_title">oṭe joḍi, oṭe jivan</string>
    <string name="welcome_point_lifetime_body">joḍi sattaka pacce taane cheḍa kiḍu: taana lekha aaṭe niluḍenu, aa hedphon-na nava joḍi sunya-ṭene aarambha aanu.</string>
    <string name="welcome_point_detailed_title">tar aane baja</string>
    <string name="welcome_point_detailed_body">sajaḍa-ta puura lekha tar hedphon-ki jorḍenu aane keteka veḷa saccaka baja aate, aa-ki maapa kiḍenu.</string>
    <string name="welcome_privacy">sabu jinis ii phon-ṭene manḍenu. keteka khata sili, aane ap-ki internet anumati sili.</string>
    <string name="welcome_start">aarambha kiḍu</string>
    <string name="welcome_next">aage</string>
    <string name="welcome_allow">anumati iḍu</string>
    <string name="welcome_step">ḍege %1$d / %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth anumati</string>
    <string name="welcome_bluetooth_why">android ap-ki aaṭe inḍenu, ie bluetooth jinis juḍi aate aane taana nau kae, jekaḍe ap-ta bluetooth anumati manḍenu. iiṭene ylih hedphon aane gaaḍi-na spikar-ki alaga kiḍenu.</string>
    <string name="welcome_bluetooth_with">iiṭe: prati joḍi juḍi ai veḷa-ṭene lekha aanu, keteka jinis calu manḍa sili aane keteka ṭhika iḍa loḍa sili.</string>
    <string name="welcome_bluetooth_without">ii sili: keteka bluetooth hedphon lekha aa sili. ap-na baaki kaam calenu, aane pacce android sajaḍa-ta anumati iḍa munḍi.</string>
    <string name="welcome_notifications_title">khabar</string>
    <string name="welcome_notifications_why">puura lekha oṭe cinna sevaa calenu, aane android aaṭeka ap-ki oṭe khabar toḍa iḍa inḍenu.</string>
    <string name="welcome_notifications_with">iiṭe: khabar toḍenu, ippa ie lekha aanu, aane iiṭene puura lekha jivit manḍenu inḍi tela aanu.</string>
    <string name="welcome_notifications_without">ii sili: puura lekha calenu aane lekha iḍenu. android kevala taana khabar toḍa sili.</string>
    <string name="hibernation_title">ni paasari veḷa-ṭene ku ganḍa manḍa</string>
    <string name="hibernation_body">keteka lenju paryanta uḍi sili ap-ki android nilupenu aane taana anumati veṭṭa iḍenu, aaṭene ylih ni uḍi paryanta keteka lekha iḍa sili. paasara aayye ii ap-na mukhya kaam, aaṭene aa-ki ippaṭene banda kiḍa neeḷa.</string>
