    <!-- 設定 -->
    <string name="settings_tracking">追蹤</string>
    <string name="settings_detailed_title">詳細追蹤</string>
    <string name="settings_detailed_body">加入有線耳機與播放時間。android 只會在應用程式執行中時回報有線插拔事件，因此需要在通知欄保留一則無聲通知。無論如何都會追蹤藍牙。</string>
    <string name="settings_detailed_unavailable">需先授予藍牙存取權限才能使用：此版本只宣告 connectedDevice 服務類型，而 android 14 以上將此與藍牙權限綁定。</string>
    <string name="settings_devices">裝置</string>
    <string name="settings_devices_body">取消勾選不是耳機的項目——例如車用喇叭或藍牙音箱——即可停止記錄它。</string>
    <string name="settings_device_subtitle">%1$s · 首次出現於 %2$s</string>
    <string name="settings_data">資料</string>
    <string name="settings_export">匯出 json</string>
    <string name="settings_import">匯入</string>
    <string name="settings_import_warning">匯入會取代目前儲存的所有資料。</string>
    <string name="settings_troubleshooting">疑難排解</string>
    <string name="settings_battery_body">如果連線紀錄不再更新，請確認 ylih 已排除在電池最佳化之外——被強制停止的應用程式在再次開啟前，將不會收到任何連線廣播。</string>
    <string name="settings_battery_button">電池設定</string>
    <string name="settings_battery_path">設定 → 應用程式 → ylih → 電池 → 不受限制。</string>
    <string name="settings_about">關於</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — 耳機使用時數，永久保存於本機。</string>
    <string name="settings_import_confirm_title">要取代所有資料嗎？</string>
    <string name="settings_import_confirm_body">匯入此備份會刪除目前儲存的所有裝置、耳機與連線紀錄。</string>

    <!-- 共用操作 -->
    <string name="action_save">儲存</string>
    <string name="action_cancel">取消</string>
