    <string name="pair_retire_label">原因（壞掉、售出、遺失…）</string>
    <string name="pair_retire_confirm">退役</string>
    <string name="pair_retire_supporting">總時數將就此凍結。重新連接同一裝置會開始一副全新的耳機，從零計算。</string>
    <string name="pair_price_title">購買價格</string>
    <string name="pair_price_label">金額（整數單位）</string>
