    <string name="pair_delete_title">要刪除這副耳機嗎？</string>
    <string name="pair_delete_body">其所有連線紀錄也會一併刪除，且無法復原。</string>

    <!-- 連線紀錄項目 -->
    <string name="session_ongoing">進行中</string>
    <string name="session_until">直到 %1$s</string>
    <string name="session_playing">播放 %1$s</string>
