    <string name="settings_import">kuyingira</string>
    <string name="settings_import_warning">kuyingira kumbuyo kumasintha zonse zimene zasungirako pano.</string>
    <string name="settings_troubleshooting">kuthana ndi mavuto</string>
    <string name="settings_battery_body">ngati nthawi zoyambira zisiyikira kudzambira, sungani kuti ylih ili ndi chilolezo chokha chibatari - pulogalamu yomwe yasiyidwa sutha sizimadalira ntchito zolumikira mpaka inafuikiridwe.</string>
    <string name="settings_battery_button">misonkhano ya betri</string>
    <string name="settings_battery_path">misonkhano - mapulogalamu - ylih - betri - opanda malire.</string>
    <string name="settings_hibernation_body">ngati ylih siifuikiridwe kwa miyezi inayonse, android imaletsa ndi kuchira chilolezo, ndi chilichonse chisiyikira kudzambira mpaka inu munayifukira. kutohetsa ndi chomwe chimalola ayiriyo kuti ipitilizire kuwerengera m’maola omwe simukuganiza pulogalamu.</string>
    <string name="settings_hibernation_on">android ingathe kutsekanitsa ylih.</string>
    <string name="settings_hibernation_off">ylih ili ndi chilolezo ndi kupitilizira kudzambira.</string>
    <string name="settings_hibernation_button">misonkhano ya mapulogalamu osagwiritsidwe</string>
    <string name="settings_about">zokhudza</string>
    <string name="settings_about_body">ylih %1$s (%2$s) - maola a auriyo, asungidwe mkati ndi nyengo yoopsya.</string>
    <string name="settings_import_confirm_title">kusintha zambiri zonse?</string>
    <string name="settings_import_confirm_body">kuyingira mbiri iyi kumasuta chipangizo chonse, ayiriyo ndi nthawi zomwe zinasungidwe pano.</string>

