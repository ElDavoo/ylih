    <string name="settings_tracking">kudzambira</string>
    <string name="settings_detailed_title">kudzambira kolingalirangalirani</string>
    <string name="settings_detailed_body">wonjeza auriyo ine wailesi ndi nthawi ya kusakala. android akuma uzani events ya wailesi okha kwa mapulogalamu omwe akudze, motero izi zamakhalitsa chipemphero cha mu nyumba. bluetooth idzambira mwansi monse.</string>
    <string name="settings_detailed_unavailable">silingathe mpaka chilolezo cha bluetooth chipatsirire: kompila iyi ikulalika mtundu wa ntchito ya connectedDevice okha, omwe android 14+ amasinthira ku chilolezo cha bluetooth.</string>
    <string name="settings_playback_only_title">werengera kusakala okha</string>
    <string name="settings_playback_only_body">chiwerengero chikuwerengera nthawi yomwe saundi inali ikunyamula m’malo mwa nthawi yolumikira. nthawi zoonse zakulemba ndi kudzambira kolingalirangalirani kuchinyamulidwe kusakala; zina sizigwiritsidwa.</string>
    <string name="settings_language">chilankhulo</string>
    <string name="settings_language_system">chilankhulo cha siputala</string>
    <string name="settings_devices">zida</string>
    <string name="settings_devices_body">siyani checbox zabinthu zomwe sizingauriyo - pipila ya makala kapena msano - kuti musiyikire kudzambira izo.</string>
    <string name="settings_device_subtitle">%1$s · first seen %2$s</string>
