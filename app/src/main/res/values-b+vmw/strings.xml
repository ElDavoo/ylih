    <string name="welcome_title">karibuni ku ylih</string>
    <string name="welcome_intro">ylih ikulemba nthawi yomwe ayiriyo yooyipika iyakhalitsa, kutero kuti zaka zazikali mulankhulo inu mukadandaula funso lokha lomwe lili ndi chiyani: nthawi yomwe anatereka?</string>
    <string name="welcome_point_auto_title">lumpikira ndi kusiyana</string>
    <string name="welcome_point_auto_body">auriyo ya bluetooth ikulemba yekha, kuchokera nthawi yolumikira. paliyense chinachake chikuwotcha.</string>
    <string name="welcome_point_lifetime_title">ayiriyo imodzi, umoyo umodzi</string>
    <string name="welcome_point_lifetime_body">nthawi yomwe ayiriyo imutsika, ikupipitsa kumbuyo: ndalamo yake imaziletsa ndi ayiriyo yotsatira ya gawo lomwelo imayamba kachiwiri kuchokera pa zero.</string>
    <string name="welcome_point_detailed_title">ine wailesi ndi kusakala</string>
    <string name="welcome_point_detailed_body">kudzambira kolingalirangalirani, mu mpangano, kumawonjeza auriyo ine wailesi ndi kuyeza nthawi yomwe idalikhalitsidwa.</string>
    <string name="welcome_privacy">chilichonse chikhalitsa pa foni yako. paliyense akawunti, ndi pulogalamu yaku ilibe chilolezo cha intaneti.</string>
    <string name="welcome_start">tayambira</string>
    <string name="welcome_next">lotsatira</string>
    <string name="welcome_allow">lumikire</string>
    <string name="welcome_step">kapena %1$d kwa %2$d</string>
    <string name="welcome_bluetooth_title">kupatsira chilolezo cha bluetooth</string>
    <string name="welcome_bluetooth_why">android akuuzani pulogalamu yanu kuti chipangizo cha bluetooth chimene chidalumikira ndi chiyani, ngati pulogalamu yanu ili ndi chilolezo cha bluetooth. ndicho chimene ylih chikuyangʼanitsa ayiriyo kuchokera kupipila pa makala.</string>
    <string name="welcome_bluetooth_with">nalo: ayiriyo yooyipika iyakhaletsedwa kuchokera nthawi yolumikira, osakhala chilichonse chipikiche ndi kusiyikira kusankhanitsa.</string>
    <string name="welcome_bluetooth_without">pasinoona: auriyo ina pa bluetooth siilakhaletsedwa. gawo lina la pulogalamu likudze, ndi inu mudzatha kulipatsira chilolezo mutsogoleri wa android.</string>
    <string name="welcome_notifications_title">chipemphero</string>
    <string name="welcome_notifications_why">kudzambira kolingalirangalirani kumatha pulogalamu yayingʼanitso ya chuma, ndi android akudindimbitsa pulogalamu iliyonse yomwe ikuwonongeka kuti sangaganitsire chipemphero pomwe ikudze.</string>
    <string name="welcome_notifications_with">nalo: chipemphero chikasikiriza kungʼanitsa chiyani chikuyambira, chisanachike chomwe chipemphero cha kudzambira kolingalirangalirani chikuwotcha.</string>
    <string name="welcome_notifications_without">pasinoona: kudzambira kolingalirangalirani kumadze kupitilizira ndi kudzambira. android okha sukulalika chipemphero.</string>
    <string name="hibernation_title">pitiliza kuwerengera pomwe ukusiyana</string>
    <string name="hibernation_body">android amaletsa mapulogalamu omwe siamavulikirira kwa miyezi inayonse ndi kuchira chilolezo, komwe kumabweretsa ylih kusiyikira kudzambira mpaka inu munama otsatira. kusiyikira ndi chomwe pulogalamu iyi inzere, motero kuphaya ndi komaliza.</string>
