    <!-- Primera execució -->
    <string name="welcome_title">benvingut a ylih</string>
    <string name="welcome_intro">ylih enregistra quant temps queda connectat cada parell d’auriculars, de manera que anys més tard pugues contestar l’única pregunta que importa sobre un parell: quantes hores van durar?</string>
    <string name="welcome_point_auto_title">connecta i oblida’t</string>
    <string name="welcome_point_auto_body">els auriculars bluetooth s’enregistren sols, des del moment que es connecten. no cal deixar res en execució.</string>
    <string name="welcome_point_lifetime_title">un parell, una vida</string>
    <string name="welcome_point_lifetime_body">quan un parell es trenca, retira’l: el total es congela aquí i el següent parell dels mateixos auriculars comença de zero.</string>
    <string name="welcome_point_detailed_title">filats i reproducció</string>
    <string name="welcome_point_detailed_body">el seguiment detallat, a la configuració, afegeix auriculars filats i mesura quant de temps es va estar realment reproduint.</string>
    <string name="welcome_privacy">tot roman en aquest telèfon. no hi ha cap compte, ni l’app té permís per a internet.</string>
    <string name="welcome_start">comença</string>
    <string name="welcome_next">següent</string>
    <string name="welcome_allow">permet</string>
    <string name="welcome_step">pas %1$d de %2$d</string>
    <string name="welcome_bluetooth_title">accés al bluetooth</string>
    <string name="welcome_bluetooth_why">android només diu a una aplicació quin dispositiu bluetooth s’ha connectat, i com es diu, si l’aplicació té accés al bluetooth. així és com ylih distingeix uns auriculars de la ràdio del cotxe, i un parell d’un altre.</string>
    <string name="welcome_bluetooth_with">amb l’accés: cada parell es registra des del moment en què es connecta, sense deixar res funcionant i sense haver de recordar-se de prémer res.</string>
    <string name="welcome_bluetooth_without">sense l’accés: no es registra cap auricular bluetooth. la resta de l’aplicació continua funcionant, i el pots concedir més tard a la configuració d’aplicacions d’android.</string>
    <string name="welcome_notifications_title">notificacions</string>
    <string name="welcome_notifications_why">el seguiment detallat executa un petit servei en segon pla, i android obliga qualsevol aplicació que ho faci a mantenir una notificació visible.</string>
    <string name="welcome_notifications_with">amb el permís: la notificació mostra què s’està registrant ara mateix, l’únic senyal que el seguiment detallat és viu.</string>
    <string name="welcome_notifications_without">sense el permís: el seguiment detallat continua funcionant i registrant. android simplement no mostrarà la seva notificació.</string>
    <string name="hibernation_title">continua comptant mentre te n’oblides</string>
    <string name="hibernation_body">android atura les aplicacions que no s’obren durant uns mesos i els retira els permisos, cosa que deixaria ylih sense registrar res fins que la tornessis a obrir. que se n’oblidin és exactament per al que serveix aquesta aplicació, així que val la pena desactivar-ho ara.</string>
    <string name="action_not_now">ara no</string>

