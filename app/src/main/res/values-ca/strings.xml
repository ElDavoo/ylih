    <!-- Configuració -->
    <string name="settings_tracking">seguiment</string>
    <string name="settings_detailed_title">seguiment detallat</string>
    <string name="settings_detailed_body">afegeix auriculars filats i temps de reproducció. android només comunica els events de connexió filada a l’app si s’està executant, per tant aquí queda una notificació silenciosa a la barra. bluetooth es segueix de totes formes.</string>
    <string name="settings_detailed_unavailable">no disponible fins que es concedeixi accés bluetooth: aquesta versió només declara el tipus de servei connectedDevice, que android 14+ vincula a un permís bluetooth.</string>
    <string name="settings_playback_only_title">compta només la reproducció</string>
    <string name="settings_playback_only_body">les estadístiques compten el temps que l’àudio s’estava reproduint de debò en lloc del temps connectat. només les sessions enregistrades amb el seguiment detallat activat van mesurar la reproducció; la resta queden fora.</string>
    <string name="settings_language">idioma</string>
    <string name="settings_language_system">idioma del sistema</string>
    <string name="settings_devices">dispositius</string>
    <string name="settings_devices_body">desmarca tot el que no sigui auriculars — un sistema estèreo d’un cotxe o un altaveu — per deixar de gravar-lo.</string>
    <string name="settings_device_subtitle">%1$s · primer cop vist %2$s</string>
    <string name="settings_data">dades</string>
    <string name="settings_export">exportar json</string>
    <string name="settings_import">importar</string>
    <string name="settings_import_warning">importar reemplaça tot el que està guardat actualment.</string>
    <string name="settings_troubleshooting">resolució de problemes</string>
    <string name="settings_battery_body">si les sessions deixen de ser enregistrades, verifica que ylih està exempt de la optimització de bateria — una app que ha estat forçada a tancar-se mai no rep events de connexió fins que no es torni a obrir.</string>
    <string name="settings_battery_button">configuració de bateria</string>
    <string name="settings_battery_path">configuració → apps → ylih → bateria → sense restriccions.</string>
    <string name="settings_hibernation_body">si ylih no s’obre durant uns mesos, android l’atura i li retira els permisos, i no es torna a registrar res fins que l’obris. desactivar-ho és el que permet que uns auriculars continuïn comptant durant una temporada en què no penses mai en l’aplicació.</string>
    <string name="settings_hibernation_on">android pot aturar ylih.</string>
    <string name="settings_hibernation_off">ylih està exempta i continua registrant.</string>
    <string name="settings_hibernation_button">configuració d’aplicacions no utilitzades</string>
    <string name="settings_about">sobre</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — hores amb auriculars, guardades localment i per sempre.</string>
    <string name="settings_import_confirm_title">reemplaçar totes les dades?</string>
    <string name="settings_import_confirm_body">importar aquesta còpia de seguretat elimina cada dispositiu, parell i sessió guardada actualment.</string>
    <string name="widget_lifetime_label">ylih · vida</string>
    <string name="widget_lifetime_description">hores per parell, amb un cronòmetre en directe del que està connectat</string>
    <string name="widget_activity_label">ylih · activitat</string>
    <string name="widget_activity_description">les hores de tots els parells juntes, més avui, 7 dies i 30 dies</string>
