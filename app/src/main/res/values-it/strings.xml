    <string name="pair_average">media</string>
    <string name="pair_longest">più lunga</string>
    <string name="pair_first_seen">prima volta</string>
    <string name="pair_of_measured">del misurato</string>
    <string name="pair_measured">misurato</string>
    <string name="pair_paid">pagate</string>
    <string name="pair_per_hour">all\'ora</string>
    <string name="pair_bought">acquistate</string>
    <string name="pair_daily_hours_14">ore al giorno (14 giorni)</string>
    <string name="pair_rename_title">rinomina paio</string>
    <string name="pair_rename_label">nome</string>
    <string name="pair_retire_title">ritira questo paio</string>
    <string name="pair_retire_label">motivo (rotte, vendute, perse…)</string>
    <string name="pair_retire_confirm">ritira</string>
    <string name="pair_retire_supporting">i totali si fermano qui. ricollegando lo stesso dispositivo parte un paio nuovo da zero.</string>
    <string name="pair_price_title">prezzo pagato</string>
    <string name="pair_price_label">importo (unità intere)</string>
    <string name="pair_price_supporting">serve per il costo orario.</string>
    <string name="pair_delete_title">eliminare questo paio?</string>
    <string name="pair_delete_body">verranno eliminate anche tutte le sessioni registrate. l\'operazione non è reversibile.</string>

    <!-- Righe sessione -->
    <string name="session_ongoing">in corso</string>
    <string name="session_until">fino a %1$s</string>
    <string name="session_playing">%1$s in riproduzione</string>
    <string name="session_recovered">recuperata</string>

    <!-- Impostazioni -->
    <string name="settings_tracking">tracciamento</string>
    <string name="settings_detailed_title">tracciamento dettagliato</string>
    <string name="settings_detailed_body">aggiunge le cuffie via cavo e il tempo di riproduzione. android segnala gli eventi del jack solo a un\'app già in esecuzione, quindi resta una notifica silenziosa nel pannello. il bluetooth è tracciato in ogni caso.</string>
    <string name="settings_detailed_unavailable">non disponibile finché non concedi l\'accesso al bluetooth: questa build dichiara solo il tipo di servizio connectedDevice, che android 14+ lega a un permesso bluetooth.</string>
    <string name="settings_devices">dispositivi</string>
    <string name="settings_devices_body">togli la spunta a ciò che non sono cuffie — l\'impianto dell\'auto, una cassa — per smettere di registrarlo.</string>
    <string name="settings_device_subtitle">%1$s · prima volta %2$s</string>
    <string name="settings_data">dati</string>
    <string name="settings_export">esporta json</string>
    <string name="settings_import">importa</string>
    <string name="settings_import_warning">l\'importazione sostituisce tutto quello che c\'è ora.</string>
    <string name="settings_troubleshooting">problemi</string>
    <string name="settings_battery_body">se le sessioni smettono di essere registrate, controlla che ylih sia esente dall\'ottimizzazione della batteria — un\'app arrestata forzatamente non riceve più alcun evento di connessione finché non la riapri.</string>
    <string name="settings_battery_button">impostazioni batteria</string>
    <string name="settings_battery_path">impostazioni → app → ylih → batteria → senza restrizioni.</string>
    <string name="settings_about">informazioni</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — le ore delle tue cuffie, in locale e per sempre.</string>
    <string name="settings_import_confirm_title">sostituire tutti i dati?</string>
    <string name="settings_import_confirm_body">importare questo backup elimina ogni dispositivo, paio e sessione registrati finora.</string>

    <!-- Azioni comuni -->
    <string name="action_save">salva</string>
    <string name="action_cancel">annulla</string>
    <string name="action_delete">elimina</string>
    <string name="action_import">importa</string>

    <!-- Notifica -->
    <string name="channel_tracking">tracciamento cuffie</string>
    <string name="channel_tracking_description">visibile mentre ylih sorveglia le cuffie via cavo e la riproduzione. android non segnala gli eventi del jack alle app che non sono in esecuzione.</string>
    <string name="notification_title">registrazione ore in cuffia</string>
    <string name="notification_starting">avvio…</string>
    <string name="notification_idle">in attesa di cuffie</string>
    <!-- Italian's CLDR set is one/many/other; "many" covers compound figures like "3 milioni". -->
    <plurals name="notification_active">
        <item quantity="one">%1$d connesso · %2$s</item>
        <item quantity="many">%1$d connessi · %2$s</item>
        <item quantity="other">%1$d connessi · %2$s</item>
    </plurals>
    <plurals name="notification_active_playing">
        <item quantity="one">%1$d connesso · %2$s · in riproduzione</item>
        <item quantity="many">%1$d connessi · %2$s · in riproduzione</item>
        <item quantity="other">%1$d connessi · %2$s · in riproduzione</item>
    </plurals>

    <!-- Messaggi -->
    <string name="detailed_needs_bluetooth">questa build ha bisogno dell\'accesso al bluetooth per tracciare le cuffie via cavo</string>
    <string name="export_done">backup esportato</string>
    <string name="export_failed">esportazione non riuscita</string>
    <string name="import_failed">importazione non riuscita</string>
    <string name="error_could_not_open">impossibile aprire %1$s</string>
    <plurals name="import_done">
        <item quantity="one">importata %d sessione</item>
        <item quantity="many">importate %d sessioni</item>
        <item quantity="other">importate %d sessioni</item>
    </plurals>

    <plurals name="session_count">
        <item quantity="one">%d sessione</item>
        <item quantity="many">%d sessioni</item>
        <item quantity="other">%d sessioni</item>
    </plurals>
</resources>
