<?xml version="1.0" encoding="utf-8"?>
<!--
  Italian. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources>
    <string name="app_title">ylih - la tua vita in cuffia</string>

    <!-- Navigazione -->
    <string name="nav_headphones">cuffie</string>
    <string name="nav_stats">statistiche</string>
    <string name="nav_settings">impostazioni</string>

    <!-- Tipi di dispositivo -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">via cavo</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">sconosciuto</string>

    <!-- Primo avvio -->
    <string name="welcome_title">benvenuto in ylih</string>
    <string name="welcome_intro">ylih registra per quanto tempo ogni paio di cuffie resta connesso, così fra anni potrai ancora rispondere all\'unica domanda che conta su un paio di cuffie: quante ore sono durate?</string>
    <string name="welcome_point_auto_title">collega e dimentica</string>
    <string name="welcome_point_auto_body">le cuffie bluetooth vengono registrate da sole, dal momento in cui si connettono. non serve lasciare in esecuzione nulla.</string>
    <string name="welcome_point_lifetime_title">un paio, una vita</string>
    <string name="welcome_point_lifetime_body">quando un paio muore, ritiralo: il suo totale si ferma lì e il paio successivo delle stesse cuffie riparte da zero.</string>
    <string name="welcome_point_detailed_title">cavo e riproduzione</string>
    <string name="welcome_point_detailed_body">il tracciamento dettagliato, nelle impostazioni, aggiunge le cuffie via cavo e misura quanta parte del tempo stavi davvero ascoltando.</string>
    <string name="welcome_privacy">tutto resta su questo telefono. non c\'è nessun account e l\'app non ha il permesso di accedere a internet.</string>
    <string name="welcome_start">iniziamo</string>

    <!-- Elenco cuffie -->
    <string name="devices_in_use">in uso</string>
    <string name="devices_retired">ritirate</string>
    <string name="devices_empty_title">ancora nessuna cuffia</string>
    <string name="devices_empty_body">collega un paio di cuffie bluetooth e compariranno qui. per le cuffie via cavo serve il tracciamento dettagliato, nelle impostazioni.</string>
    <string name="devices_generation">paio n. %1$d</string>
    <string name="devices_retired_on">ritirate il %1$s</string>
    <string name="devices_connected_for">connesse da %1$s</string>
    <string name="devices_recent">%1$s / 7g</string>

