    <string name="welcome_title">witej we ylih</string>
    <string name="welcome_intro">ylih zapisuje, jak dugo kożde pora suchawek ostowo połōnczōne, coby za wiela lot dało sie jeszcze ôdpowiedzieć na jedyne ważne pytanie ô pora: wiela godzin wytrzimały?</string>
    <string name="welcome_point_auto_title">połōncz i zapōmnij</string>
    <string name="welcome_point_auto_body">suchawki bluetooth zapisujōm sie same, ôd chwile jak sie połōnczōm. nic niy musi ôstać włōnczōne.</string>
    <string name="welcome_point_lifetime_title">jedno pora, jedno życie</string>
    <string name="welcome_point_lifetime_body">jak pora sie zepsuje, dej mu pynzyjo: jego suma staje w tym miejscu, a nastympne pora tych samych suchawek zaczyno ôd zera.</string>
    <string name="welcome_point_detailed_title">kabel i granie</string>
    <string name="welcome_point_detailed_body">dokładne śledzynie, we sztelowaniu, dodowo suchawki na kablu i mierzi, wiela z tego czasu naprowdy grało.</string>
    <string name="welcome_privacy">wszysko ôstowo na tym telefōnie. niy ma kōnta, a aplikacyjo niy mo zwolynio na internet.</string>
    <string name="welcome_start">zacznij</string>
    <string name="welcome_next">dalij</string>
    <string name="welcome_allow">zwōl</string>
    <string name="welcome_step">krok %1$d z %2$d</string>
    <string name="welcome_bluetooth_title">dostymp do bluetooth</string>
    <string name="welcome_bluetooth_why">android pado aplikacyji, kere urzōndzynie bluetooth sie połōnczyło i jak sie nazywo, ino jak aplikacyjo mo dostymp do bluetooth. tak ylih poznowo pora suchawek ôd radia we aucie i jedne pora ôd drugigo.</string>
    <string name="welcome_bluetooth_with">z nim: kożde pora je zapisowane ôd chwile połōnczynio, nic niy ôstowo włōnczōne i niy trza pamiyntać ô żodnym knefliku.</string>
    <string name="welcome_bluetooth_without">bez niego: żodne suchawki bluetooth niy sōm zapisowane. reszta aplikacyje dalij robi, a dostymp możesz dać niyskorzij we sztelowaniu aplikacyji android.</string>
    <string name="welcome_notifications_title">powiadōmiynia</string>
    <string name="welcome_notifications_why">dokładne śledzynie puszczo mały serwis we tle, a android wymogo, coby kożdo aplikacyjo, kero to robi, trzimała widzialne powiadōmiynie bez tyn czas.</string>
    <string name="welcome_notifications_with">z nimi: powiadōmiynie pokazuje, co je terozki zapisowane, a to jedyny znak, że dokładne śledzynie żyje.</string>
    <string name="welcome_notifications_without">bez nich: dokładne śledzynie dalij robi i dalij zapisuje. android ino niy pokoże jego powiadōmiynio.</string>
    <string name="hibernation_title">liczy dalij, jak ty ô nij zapōminosz</string>
    <string name="hibernation_body">android zatrzimuje aplikacyje, kere niy były ôtwarte bez pora miesiyncy, i ôdbiyro im zwolynia, co ôstawiyłoby ylih bez zapisowanio, aż byś jōm zaś ôtworzōł. zapōmniynie to je akurat to, po co ta aplikacyjo je, tōż warto to terozki wyłōnczyć.</string>
