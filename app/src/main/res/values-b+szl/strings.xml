    <string name="settings_troubleshooting">rozwiōnzowanie problymōw</string>
    <string name="settings_battery_body">jak sesyje przestanōm być zapisowane, wejzdrzij, czy ylih je zwolniōno z ôptymalizacyje bateryje — aplikacyjo zatrzimano na siła już niy dostowo powiadōmiyń ô połōnczyniu, aż jōm ôtworzysz.</string>
    <string name="settings_battery_button">sztelowanie bateryje</string>
    <string name="settings_battery_path">sztelowanie → aplikacyje → ylih → bateryjo → bez ôgraniczyń.</string>
    <string name="settings_hibernation_body">jak ylih niy bydzie ôtwarto bez pora miesiyncy, android jōm zatrzimie i ôdbiere jij zwolynia, a nic już niy bydzie zapisowane, aż jōm ôtworzysz. wyłōnczynie tego pozwolo pora liczyć bez cołko pora, kej ô aplikacyji ani niy myślisz.</string>
    <string name="settings_hibernation_on">android może zatrzimać ylih.</string>
    <string name="settings_hibernation_off">ylih je zwolniōno i dalij zapisuje.</string>
    <string name="settings_hibernation_button">sztelowanie niyużywanych aplikacyji</string>
