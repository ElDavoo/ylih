    <string name="welcome_title">bem-vindo ao ylih</string>
    <string name="welcome_intro">ylih registra quanto tempo cada par de fones fica conectado, para que anos depois você ainda possa responder à única pergunta que importa sobre um par: quantas horas duraram?</string>
    <string name="welcome_point_auto_title">conecte e esqueça</string>
    <string name="welcome_point_auto_body">fones bluetooth são gravados automaticamente, desde o momento em que se conectam. nada precisa ficar funcionando.</string>
    <string name="welcome_point_lifetime_title">um par, uma vida</string>
    <string name="welcome_point_lifetime_body">quando um par morre, aposente-o: seu total congela ali e o próximo par dos mesmos fones começa do zero.</string>
    <string name="welcome_point_detailed_title">fones com fio e reprodução</string>
    <string name="welcome_point_detailed_body">rastreamento detalhado, nas configurações, adiciona fones com fio e mede quanto tempo foi realmente em reprodução.</string>
    <string name="welcome_privacy">tudo fica neste telefone. não há conta, e o app não tem permissão de internet.</string>
    <string name="welcome_start">comece</string>
    <string name="welcome_next">próximo</string>
    <string name="welcome_allow">permitir</string>
    <string name="welcome_step">passo %1$d de %2$d</string>
    <string name="welcome_bluetooth_title">acesso bluetooth</string>
    <string name="welcome_bluetooth_why">android só diz a um app qual dispositivo bluetooth se conectou e qual é seu nome se o app tiver acesso bluetooth. é como ylih diferencia um par de fones de um som de carro, e como sabe um par do outro.</string>
    <string name="welcome_bluetooth_with">com isso: cada par é gravado desde o momento em que se conecta, sem nada deixado funcionando e sem nada para lembrar de pressionar.</string>
    <string name="welcome_bluetooth_without">sem isso: nenhum fone bluetooth é gravado. o resto do app ainda funciona, e você pode conceder depois nas configurações do app android.</string>
    <string name="welcome_notifications_title">notificações</string>
    <string name="welcome_notifications_why">rastreamento detalhado executa um pequeno serviço em segundo plano, e android requer que qualquer app fazendo isso mantenha uma notificação visível enquanto faz.</string>
    <string name="welcome_notifications_with">com isso: a notificação mostra o que está sendo gravado agora, que é o único sinal de que o rastreamento detalhado está vivo.</string>
    <string name="welcome_notifications_without">sem isso: rastreamento detalhado ainda funciona e ainda grava. android apenas não mostrará sua notificação.</string>
    <string name="hibernation_title">continue contando enquanto você esquece</string>
    <string name="hibernation_body">android pausa apps que ficam sem abertura por alguns meses e retira suas permissões, o que deixaria ylih gravando nada até que você o abrisse novamente. ser esquecido é exatamente para o que este app existe, então vale a pena desligar isso agora.</string>
