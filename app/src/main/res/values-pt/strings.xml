    <string name="settings_import">importar</string>
    <string name="settings_import_warning">importar substitui tudo o que esta atualmente armazenado.</string>
    <string name="settings_troubleshooting">solucao de problemas</string>
    <string name="settings_battery_body">se as sessoes pararem de ser gravadas, verifique se ylih esta isento de otimizacao de bateria - um app que foi forcado a parar nunca recebe transmissoes de conexao novamente ate que seja aberto.</string>
    <string name="settings_battery_button">configuracoes de bateria</string>
    <string name="settings_battery_path">configuracoes → aplicativos → ylih → bateria → ilimitado.</string>
    <string name="settings_hibernation_body">se ylih ficar sem abertura por alguns meses, android o pausa e retira suas permissoes, e nada e gravado novamente ate que voce o abra. desativar isso e o que permite que um par continue contando durante uma estacao em que voce nunca pensa no app.</string>
    <string name="settings_hibernation_on">android pode pausar ylih.</string>
    <string name="settings_hibernation_off">ylih e isento e continua gravando.</string>
    <string name="settings_hibernation_button">configuracoes de app nao utilizado</string>
