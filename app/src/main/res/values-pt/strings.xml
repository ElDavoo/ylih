    <string name="welcome_title">bem-vindo ao ylih</string>
    <string name="welcome_intro">ylih registra quanto tempo cada par de fones fica conectado, para que anos depois voce ainda possa responder a unica pergunta que importa sobre um par: quantas horas duraram?</string>
    <string name="welcome_point_auto_title">conecte e esqueca</string>
    <string name="welcome_point_auto_body">fones bluetooth sao gravados automaticamente, desde o momento em que se conectam. nada precisa ficar funcionando.</string>
    <string name="welcome_point_lifetime_title">um par, uma vida</string>
    <string name="welcome_point_lifetime_body">quando um par morre, aposente-o: seu total congela alí e o proximo par dos mesmos fones comeca do zero.</string>
    <string name="welcome_point_detailed_title">fones com fio e reproducao</string>
    <string name="welcome_point_detailed_body">rastreamento detalhado, nas configuracoes, adiciona fones com fio e mede quanto tempo foi realmente em reproducao.</string>
    <string name="welcome_privacy">tudo fica neste telefone. nao ha conta, e o app nao tem permissao de internet.</string>
    <string name="welcome_start">comece</string>
    <string name="welcome_next">proximo</string>
    <string name="welcome_allow">permitir</string>
    <string name="welcome_step">passo %1$d de %2$d</string>
    <string name="welcome_bluetooth_title">acesso bluetooth</string>
    <string name="welcome_bluetooth_why">android so diz a um app qual dispositivo bluetooth se conectou e qual e seu nome se o app tiver acesso bluetooth. e como ylih diferencia um par de fones de um som de carro, e como sabe um par do outro.</string>
    <string name="welcome_bluetooth_with">com isso: cada par e gravado desde o momento em que se conecta, sem nada deixado funcionando e sem nada para lembrar de pressionar.</string>
    <string name="welcome_bluetooth_without">sem isso: nenhum fone bluetooth e gravado. o resto do app ainda funciona, e voce pode conceder depois nas configuracoes do app android.</string>
    <string name="welcome_notifications_title">notificacoes</string>
    <string name="welcome_notifications_why">rastreamento detalhado executa um pequeno servico em segundo plano, e android requer que qualquer app fazendo isso mantenha uma notificacao visivel enquanto faz.</string>
    <string name="welcome_notifications_with">com isso: a notificacao mostra o que esta sendo gravado agora, que e o unico sinal de que o rastreamento detalhado esta vivo.</string>
    <string name="welcome_notifications_without">sem isso: rastreamento detalhado ainda funciona e ainda grava. android apenas nao mostrara sua notificacao.</string>
    <string name="hibernation_title">continue contando enquanto voce esquece</string>
    <string name="hibernation_body">android pausa apps que ficam sem abertura por alguns meses e retira suas permissoes, o que deixaria ylih gravando nada ate que voce o abrisse novamente. ser esquecido e exatamente para o que este app existe, entao vale a pena desligar isso agora.</string>
