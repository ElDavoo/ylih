    <string name="settings_import_warning">importar substitui tudo o que está atualmente armazenado.</string>
    <string name="settings_troubleshooting">solução de problemas</string>
    <string name="settings_battery_body">se as sessões pararem de ser gravadas, verifique se ylih está isento de otimização de bateria - um app que foi forçado a parar nunca recebe transmissões de conexão novamente até que seja aberto.</string>
    <string name="settings_battery_button">configurações de bateria</string>
    <string name="settings_battery_path">configurações → aplicativos → ylih → bateria → ilimitado.</string>
    <string name="settings_hibernation_body">se ylih ficar sem abertura por alguns meses, android o pausa e retira suas permissões, e nada é gravado novamente até que você o abra. desativar isso é o que permite que um par continue contando durante uma estação em que você nunca pensa no app.</string>
    <string name="settings_hibernation_on">android pode pausar ylih.</string>
    <string name="settings_hibernation_off">ylih é isento e continua gravando.</string>
    <string name="settings_hibernation_button">configurações de app não utilizado</string>
