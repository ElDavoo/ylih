<?xml version="1.0" encoding="utf-8"?>
<!--
  Duala. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources>
    <string name="app_title">ylih — iso ia moto wa moto wa likúmu</string>

    <!-- Bottom navigation -->
    <string name="nav_headphones">ndúmu ndúmu</string>
    <string name="nav_stats">mbidí</string>
    <string name="nav_settings">mbandja</string>

    <!-- Device kinds -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">ndúmu ya bilonga</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">ilinga</string>

    <!-- First run -->
    <string name="welcome_title">welcome ku ylih</string>
    <string name="welcome_intro">ylih isela mfane mwa ndúmu ndúmu, moni mbi wondo imoto, njiba i ka sosala njiba iso ia ndúmu ndúmu: mabe mbe ke likúmu nkwa?</string>
    <string name="welcome_point_auto_title">koka nsele nsele</string>
    <string name="welcome_point_auto_body">ndúmu ya bluetooth inyengi ye ndígiti, sike ma ekoká. ilinga ilinga njiba i ka liedi muambé.</string>
    <string name="welcome_point_lifetime_title">ndúmu mota, likúmu mota</string>
    <string name="welcome_point_lifetime_body">sike ndúmu iye kú mafú, kona ye: iso iye basataka wá, ndúmu iyela a nkwa isala mota mbákela.</string>
    <string name="welcome_point_detailed_title">bilonga nsele mfane</string>
    <string name="welcome_point_detailed_body">isela isoki, mu mbandja, ekoká bilonga nsele mfane mwa mani mwe mbe isela.</string>
    <string name="welcome_privacy">elongo elonga moto moto. ilinga konto, ilinga internet permission.</string>
    <string name="welcome_start">busala</string>

