    <!-- Settings -->
    <string name="settings_tracking">isela isoki</string>
    <string name="settings_detailed_title">isela isoki mayale</string>
    <string name="settings_detailed_body">ekoká bilonga nsele mfane wa mani. android enene bilonga nsele mbuá moto ilon muula moto, njiba ilinga mbuá ilinga nsele. bluetooth isele mu elongo.</string>
    <string name="settings_detailed_unavailable">ilinga ilambe ngaka bluetooth masolo osambé: likolo mota isela connectedDevice emoto moto, njiba android 14+ iya mbakara mi bluetooth masolo.</string>
