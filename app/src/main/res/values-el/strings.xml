    <!-- Πρώτη εκκίνηση -->
    <string name="welcome_title">καλώς ήρθες στο ylih</string>
    <string name="welcome_intro">το ylih καταγράφει πόση ώρα μένει συνδεδεμένο κάθε ζευγάρι ακουστικών, ώστε ακόμα και μετά από χρόνια να μπορείς να απαντήσεις στο μόνο ερώτημα που μετράει για ένα ζευγάρι: πόσες ώρες άντεξε;</string>
    <string name="welcome_point_auto_title">σύνδεσε και ξέχνα</string>
    <string name="welcome_point_auto_body">τα ακουστικά bluetooth καταγράφονται μόνα τους, από τη στιγμή που συνδέονται. δεν χρειάζεται να αφήσεις τίποτα να τρέχει.</string>
    <string name="welcome_point_lifetime_title">ένα ζευγάρι, μια διάρκεια ζωής</string>
    <string name="welcome_point_lifetime_body">όταν ένα ζευγάρι χαλάει, απόσυρέ το: το σύνολό του παγώνει εκεί και το επόμενο ζευγάρι των ίδιων ακουστικών ξεκινά ξανά από το μηδέν.</string>
    <string name="welcome_point_detailed_title">ενσύρματα και αναπαραγωγή</string>
    <string name="welcome_point_detailed_body">η λεπτομερής καταγραφή, στις ρυθμίσεις, προσθέτει τα ενσύρματα ακουστικά και μετρά πόσο από αυτόν τον χρόνο ήταν πραγματικά αναπαραγωγή.</string>
    <string name="welcome_privacy">όλα μένουν σε αυτό το τηλέφωνο. δεν υπάρχει λογαριασμός και η εφαρμογή δεν έχει άδεια πρόσβασης στο internet.</string>
    <string name="welcome_start">ξεκίνα</string>
    <string name="hibernation_title">συνεχίζει να μετράει όσο την ξεχνάς</string>
    <string name="hibernation_body">το android βάζει σε παύση τις εφαρμογές που δεν ανοίγουν για μερικούς μήνες και τους αφαιρεί τις άδειες, οπότε το ylih δεν θα κατέγραφε τίποτα μέχρι να το ξανανοίξεις. το να ξεχαστεί είναι ακριβώς ο λόγος ύπαρξης αυτής της εφαρμογής, γι\' αυτό αξίζει να το απενεργοποιήσεις τώρα.</string>
    <string name="action_not_now">όχι τώρα</string>

