    <!-- Ρυθμίσεις -->
    <string name="settings_tracking">καταγραφή</string>
    <string name="settings_detailed_title">λεπτομερής καταγραφή</string>
    <string name="settings_detailed_body">προσθέτει τα ενσύρματα ακουστικά και τον χρόνο αναπαραγωγής. το android αναφέρει τα συμβάντα σύνδεσης καλωδίου μόνο σε μια εφαρμογή που ήδη εκτελείται, γι\' αυτό διατηρείται μια σιωπηλή ειδοποίηση στο συρτάρι. το bluetooth καταγράφεται σε κάθε περίπτωση.</string>
    <string name="settings_detailed_unavailable">μη διαθέσιμο μέχρι να δοθεί πρόσβαση στο bluetooth: αυτή η έκδοση δηλώνει μόνο τον τύπο υπηρεσίας connectedDevice, τον οποίο το android 14+ συνδέει με άδεια bluetooth.</string>
    <string name="settings_playback_only_title">μέτρα μόνο την αναπαραγωγή</string>
    <string name="settings_playback_only_body">τα στατιστικά μετρούν τον χρόνο που ο ήχος έπαιζε πραγματικά αντί για τον χρόνο σύνδεσης. μόνο οι συνεδρίες που καταγράφηκαν με τη λεπτομερή καταγραφή ενεργή μέτρησαν την αναπαραγωγή· οι υπόλοιπες παραλείπονται.</string>
    <string name="settings_language">γλώσσα</string>
    <string name="settings_language_system">γλώσσα συστήματος</string>
    <string name="settings_devices">συσκευές</string>
    <string name="settings_devices_body">αποεπίλεξε ό,τι δεν είναι ακουστικά — ένα ηχοσύστημα αυτοκινήτου ή ένα ηχείο — για να σταματήσει η καταγραφή του.</string>
    <string name="settings_device_subtitle">%1$s · πρώτη εμφάνιση %2$s</string>
    <string name="settings_data">δεδομένα</string>
    <string name="settings_export">εξαγωγή json</string>
    <string name="settings_import">εισαγωγή</string>
    <string name="settings_import_warning">η εισαγωγή αντικαθιστά όλα όσα είναι αποθηκευμένα αυτή τη στιγμή.</string>
    <string name="settings_troubleshooting">επίλυση προβλημάτων</string>
    <string name="settings_battery_body">αν οι συνεδρίες σταματήσουν να καταγράφονται, έλεγξε αν το ylih εξαιρείται από τη βελτιστοποίηση μπαταρίας — μια εφαρμογή που έχει τερματιστεί βίαια δεν λαμβάνει ποτέ ξανά μεταδόσεις σύνδεσης μέχρι να ανοίξει.</string>
    <string name="settings_battery_button">ρυθμίσεις μπαταρίας</string>
    <string name="settings_battery_path">ρυθμίσεις → εφαρμογές → ylih → μπαταρία → χωρίς περιορισμούς.</string>
    <string name="settings_hibernation_body">αν το ylih δεν ανοίξει για μερικούς μήνες, το android το βάζει σε παύση και του αφαιρεί τις άδειες, και δεν καταγράφεται τίποτα ξανά μέχρι να το ανοίξεις. η απενεργοποίηση αυτού είναι που αφήνει ένα ζευγάρι να συνεχίσει να μετράει σε μια περίοδο που δεν σκέφτεσαι καθόλου την εφαρμογή.</string>
    <string name="settings_hibernation_on">το android μπορεί να βάλει το ylih σε παύση.</string>
    <string name="settings_hibernation_off">το ylih εξαιρείται και συνεχίζει να καταγράφει.</string>
    <string name="settings_hibernation_button">ρυθμίσεις αχρησιμοποίητων εφαρμογών</string>
    <string name="settings_about">σχετικά</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — ώρες ακουστικών, αποθηκευμένες τοπικά και για πάντα.</string>
    <string name="settings_import_confirm_title">αντικατάσταση όλων των δεδομένων;</string>
    <string name="settings_import_confirm_body">η εισαγωγή αυτού του αντιγράφου ασφαλείας διαγράφει κάθε συσκευή, ζευγάρι και συνεδρία που είναι αποθηκευμένα τώρα.</string>

