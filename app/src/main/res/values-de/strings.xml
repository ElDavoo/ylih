    <!-- Einstellungen -->
    <string name="settings_tracking">Tracking</string>
    <string name="settings_detailed_title">detailliertes Tracking</string>
    <string name="settings_detailed_body">erfasst zusätzlich kabelgebundene Kopfhörer und die Wiedergabezeit. android meldet Kabel-Steckerereignisse nur an eine laufende App, deshalb bleibt dafür eine stille Benachrichtigung in der Leiste. bluetooth wird so oder so erfasst.</string>
    <string name="settings_detailed_unavailable">nicht verfügbar, solange kein bluetooth-Zugriff erteilt ist: diese Version meldet nur den Diensttyp connectedDevice, den android 14+ an eine bluetooth-Berechtigung knüpft.</string>
    <string name="settings_playback_only_title">nur Wiedergabe zählen</string>
    <string name="settings_playback_only_body">die Statistik zählt die Zeit, in der wirklich Audio lief, statt der verbundenen Zeit. nur Sitzungen, die mit eingeschaltetem detailliertem Tracking aufgezeichnet wurden, haben die Wiedergabe gemessen; der Rest bleibt außen vor.</string>
    <string name="settings_language">Sprache</string>
    <string name="settings_language_system">Systemsprache</string>
    <string name="settings_devices">Geräte</string>
    <string name="settings_devices_body">entferne das Häkchen bei allem, was keine Kopfhörer sind — eine Autoanlage oder ein Lautsprecher —, damit es nicht mehr erfasst wird.</string>
    <string name="settings_device_subtitle">%1$s · erstmals gesehen %2$s</string>
    <string name="settings_data">Daten</string>
    <string name="settings_export">json exportieren</string>
    <string name="settings_import">importieren</string>
    <string name="settings_import_warning">beim Importieren wird alles ersetzt, was derzeit gespeichert ist.</string>
    <string name="settings_troubleshooting">Problembehebung</string>
    <string name="settings_battery_body">wenn Sitzungen nicht mehr aufgezeichnet werden, prüfe, ob ylih von der Akku-Optimierung ausgenommen ist — eine erzwungen beendete App erhält keine Verbindungs-Broadcasts mehr, bis sie erneut geöffnet wird.</string>
    <string name="settings_battery_button">Akku-Einstellungen</string>
    <string name="settings_battery_path">Einstellungen → Apps → ylih → Akku → uneingeschränkt.</string>
    <string name="settings_hibernation_body">wenn ylih ein paar monate nicht geöffnet wird, pausiert android sie und nimmt ihr die berechtigungen weg, und es wird nichts mehr aufgezeichnet, bis du sie öffnest. das abzuschalten ist es, was einen kopfhörer über eine ganze zeit weiterzählen lässt, in der du nie an die app denkst.</string>
    <string name="settings_hibernation_on">android darf ylih pausieren.</string>
    <string name="settings_hibernation_off">ylih ist ausgenommen und zeichnet weiter auf.</string>
    <string name="settings_hibernation_button">einstellungen für ungenutzte apps</string>
    <string name="settings_about">Info</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — Kopfhörerstunden, lokal gespeichert und für immer.</string>
    <string name="settings_import_confirm_title">alle Daten ersetzen?</string>
    <string name="settings_import_confirm_body">das Importieren dieses Backups löscht jedes Gerät, Paar und jede Sitzung, die derzeit gespeichert sind.</string>

