    <!-- الإعدادات -->
    <string name="settings_tracking">التتبع</string>
    <string name="settings_detailed_title">التتبع التفصيلي</string>
    <string name="settings_detailed_body">يضيف السماعات السلكية ووقت التشغيل. لا يُبلّغ android عن أحداث توصيل السماعة السلكية إلا لتطبيق قيد التشغيل، لذا يبقي هذا إشعارًا صامتًا في لوحة الإشعارات. يُتتبَّع bluetooth في الحالتين.</string>
    <string name="settings_detailed_unavailable">غير متاح حتى يُمنح الوصول إلى bluetooth: يعلن هذا الإصدار فقط عن نوع الخدمة connectedDevice، الذي يربطه android 14 وما بعده بإذن bluetooth.</string>
    <string name="settings_playback_only_title">احتساب التشغيل فقط</string>
    <string name="settings_playback_only_body">تحتسب الإحصاءات الوقت الذي كان الصوت يعمل فيه فعلاً بدلاً من وقت الاتصال. الجلسات المسجّلة أثناء تفعيل التتبع التفصيلي وحدها قاست التشغيل، أما البقية فتُستبعد.</string>
    <string name="settings_language">اللغة</string>
    <string name="settings_language_system">لغة النظام</string>
    <string name="settings_devices">الأجهزة</string>
    <string name="settings_devices_body">ألغِ تحديد أي شيء ليس سماعات — مثل نظام صوت السيارة أو مكبر صوت — لإيقاف تسجيله.</string>
    <string name="settings_device_subtitle">%1$s · أول ظهور %2$s</string>
    <string name="settings_data">البيانات</string>
    <string name="settings_export">تصدير json</string>
    <string name="settings_import">استيراد</string>
    <string name="settings_import_warning">الاستيراد يستبدل كل ما هو مخزَّن حاليًا.</string>
    <string name="settings_troubleshooting">استكشاف الأخطاء وإصلاحها</string>
    <string name="settings_battery_body">إذا توقف تسجيل الجلسات، تحقق من أن ylih مستثنى من تحسين البطارية — التطبيق الذي أُوقف قسرًا لا يتلقى بعدها أي إشعارات اتصال إلى أن يُفتح مجددًا.</string>
    <string name="settings_battery_button">إعدادات البطارية</string>
    <string name="settings_battery_path">الإعدادات ← التطبيقات ← ylih ← البطارية ← غير مقيّد.</string>
    <string name="settings_hibernation_body">إذا بقي ylih بدون فتح لعدة أشهر، يوقفه android ويسحب أذوناته، ولا يُسجَّل شيء بعد ذلك حتى تفتحه. إيقاف هذا الخيار هو ما يجعل الزوج يستمر في العد طوال موسم لا تفكر فيه بالتطبيق أصلًا.</string>
    <string name="settings_hibernation_on">قد يوقف android تطبيق ylih.</string>
    <string name="settings_hibernation_off">ylih مستثنى ويستمر في التسجيل.</string>
    <string name="settings_hibernation_button">إعدادات التطبيقات غير المستخدمة</string>
    <string name="settings_about">حول</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — ساعات السماعات، محفوظة محليًا وإلى الأبد.</string>
    <string name="settings_import_confirm_title">استبدال كل البيانات؟</string>
    <string name="settings_import_confirm_body">استيراد هذه النسخة الاحتياطية يحذف كل جهاز وزوج وجلسة مخزَّنة الآن.</string>
