    <string name="settings_import_warning">uvoz zamenjuje sve što je trenutno sačuvano.</string>
    <string name="settings_troubleshooting">rešavanje problema</string>
    <string name="settings_battery_body">ako sesije prestanu da se beleže, proveri da li je ylih izuzeta iz optimizacije baterije — aplikacija koja je nasilno zaustavljena više nikada ne prima emitovanja o povezivanju dok se ne otvori.</string>
    <string name="settings_battery_button">podešavanja baterije</string>
    <string name="settings_battery_path">podešavanja → aplikacije → ylih → baterija → neograničeno.</string>
    <string name="settings_hibernation_body">ako ylih stoji neotvorena nekoliko meseci, android je pauzira i oduzima joj dozvole, i ništa se više ne beleži dok je ne otvoriš. isključivanje toga je ono što omogućava paru da nastavi da broji kroz celu sezonu u kojoj uopšte ne misliš na aplikaciju.</string>
    <string name="settings_hibernation_on">android može da pauzira ylih.</string>
    <string name="settings_hibernation_off">ylih je izuzeta i nastavlja da beleži.</string>
    <string name="settings_hibernation_button">podešavanja nekorišćenih aplikacija</string>
    <string name="settings_about">o aplikaciji</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — sati sa slušalicama, čuvani lokalno i zauvek.</string>
    <string name="settings_import_confirm_title">zameniti sve podatke?</string>
    <string name="settings_import_confirm_body">uvoz ove rezervne kopije briše svaki uređaj, par i sesiju koji su sada sačuvani.</string>

