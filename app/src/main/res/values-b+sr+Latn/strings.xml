    <string name="settings_tracking">praćenje</string>
    <string name="settings_detailed_title">detaljno praćenje</string>
    <string name="settings_detailed_body">dodaje žičane slušalice i vreme reprodukcije. android prijavljuje događaje žičanog priključka samo aplikaciji koja radi, pa ovo drži tiho obaveštenje u traci. bluetooth se prati u svakom slučaju.</string>
    <string name="settings_detailed_unavailable">nedostupno dok se ne odobri pristup bluetooth-u: ova verzija objavljuje samo tip usluge connectedDevice, koji android 14+ vezuje za bluetooth dozvolu.</string>
    <string name="settings_playback_only_title">broj samo reprodukciju</string>
    <string name="settings_playback_only_body">statistika broji vreme kada je audio zaista svirao umesto vremena povezanosti. samo sesije zabeležene sa uključenim detaljnim praćenjem su merile reprodukciju; ostale se izostavljaju.</string>
