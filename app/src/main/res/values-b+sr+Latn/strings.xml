    <string name="welcome_title">dobrodošao u ylih</string>
    <string name="welcome_intro">ylih beleži koliko dugo svaki par slušalica ostaje povezan, da bi i za nekoliko godina i dalje mogao da odgovoriš na jedino pitanje koje je važno za jedan par: koliko sati su izdržale?</string>
    <string name="welcome_point_auto_title">poveži i zaboravi</string>
    <string name="welcome_point_auto_body">bluetooth slušalice se beleže same, od trenutka kada se povežu. ništa ne mora da ostane pokrenuto.</string>
    <string name="welcome_point_lifetime_title">jedan par, jedan vek</string>
    <string name="welcome_point_lifetime_body">kada par crkne, penzioniši ga: njegov zbir se zamrzava tu, a sledeći par istih slušalica kreće ponovo od nule.</string>
    <string name="welcome_point_detailed_title">žičane i reprodukcija</string>
    <string name="welcome_point_detailed_body">detaljno praćenje, u podešavanjima, dodaje žičane slušalice i meri koliko je vremena zaista sviralo.</string>
    <string name="welcome_privacy">sve ostaje na ovom telefonu. nema naloga, a aplikacija nema dozvolu za internet.</string>
    <string name="welcome_start">počni</string>
    <string name="welcome_next">dalje</string>
    <string name="welcome_allow">dozvoli</string>
    <string name="welcome_step">korak %1$d od %2$d</string>
    <string name="welcome_bluetooth_title">pristup bluetooth-u</string>
    <string name="welcome_bluetooth_why">android aplikaciji kaže koji se bluetooth uređaj povezao, i kako se zove, samo ako aplikacija ima pristup bluetooth-u. tako ylih razlikuje par slušalica od auto-radija, i tako zna jedan par od drugog.</string>
    <string name="welcome_bluetooth_with">sa njim: svaki par se beleži od trenutka kada se poveže, bez ičega što ostaje pokrenuto i bez potrebe da se setiš da nešto pritisneš.</string>
    <string name="welcome_bluetooth_without">bez njega: nijedan par bluetooth slušalica se ne beleži. ostatak aplikacije i dalje radi, a možeš ga dati kasnije u android podešavanjima aplikacija.</string>
    <string name="welcome_notifications_title">obaveštenja</string>
    <string name="welcome_notifications_why">detaljno praćenje pokreće malu pozadinsku uslugu, a android zahteva da svaka aplikacija koja to radi drži vidljivo obaveštenje dok traje.</string>
    <string name="welcome_notifications_with">sa njima: obaveštenje prikazuje šta se upravo beleži, što je jedini znak da je detaljno praćenje živo.</string>
    <string name="welcome_notifications_without">bez njih: detaljno praćenje i dalje radi i dalje beleži. android jednostavno neće prikazati njegovo obaveštenje.</string>
    <string name="hibernation_title">nastavlja da broji dok ti zaboravljaš na nju</string>
    <string name="hibernation_body">android pauzira aplikacije koje stoje neotvorene nekoliko meseci i oduzima im dozvole, što bi ostavilo ylih da ne beleži ništa dok je ponovo ne otvoriš. upravo to da bude zaboravljena jeste ono zbog čega ova aplikacija postoji, pa se isplati isključiti to sada.</string>
