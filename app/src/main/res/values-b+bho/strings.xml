    <!-- पहिली बार चलावल -->
    <string name="welcome_title">ylih मा स्वागत छै</string>
    <string name="welcome_intro">ylih रिकॉर्ड करेला कि हर जोड़ी के ईयरफोन कतना समे तक जुड़ल रहेला, ताहि कि साल भर बाद तुम अहिँ एकोए सवाल का जवाब दे सकब — कतना घंटा चलल?</string>
    <string name="welcome_point_auto_title">जोड़ दे अउर भुला दे</string>
    <string name="welcome_point_auto_body">bluetooth ईयरफोन खुद ही रिकॉर्ड होलन, जोड़ते ही। कुछु नइखे चलावे के।</string>
    <string name="welcome_point_lifetime_title">एक जोड़ी, एक जिंदगी</string>
    <string name="welcome_point_lifetime_body">जब जोड़ी टूट जाय, तो उदा खतम कर दे: कुल वहीँ रुक जाय अउर अगल जोड़ी नया शुरु हो शून्य से।</string>
    <string name="welcome_point_detailed_title">तार अउर बजावल</string>
    <string name="welcome_point_detailed_body">विस्तृत ट्रैकिंग, सेटिंग्स मा, तार वाल ईयरफोन जोड़ेला अउर मपेला कि कतना समे सच मा बजावल होल।</string>
    <string name="welcome_privacy">सब कुछु एही फोन पर रहेला। कोई अकाउंट नइखे, अउर ऐप के इंटरनेट अनुमति नइखे।</string>
    <string name="welcome_start">शुरु कर</string>

