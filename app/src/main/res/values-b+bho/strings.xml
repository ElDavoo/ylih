    <string name="settings_troubleshooting">समस्या समाधान</string>
    <string name="settings_battery_body">अगर सत्र रिकॉर्ड न हो रहल होय, तो देख कि ylih बैटरी अनुकूलन से छुट्टा छै — जबरन बंद कइल ऐप फिर से खोले तक कोई जुड़ी घटना न पाय।</string>
    <string name="settings_battery_button">बैटरी सेटिंग्स</string>
    <string name="settings_battery_path">सेटिंग्स → ऐप्स → ylih → बैटरी → अप्रतिबंधित।</string>
    <string name="settings_hibernation_body">अगर ylih कई महीना ले ना खोलल जाव, त android एकरा रोक देला आ एकर अनुमति वापस ले लेला, आ जब ले रउआ एकरा ना खोलब तब ले कुछो फेर से रिकॉर्ड ना होई। एकरा बंद करब ओहि से जोड़ी ओह मौसम में भी गिनत रह सकेला जब रउआ ऐप के बारे में सोचबे ना करीं।</string>
    <string name="settings_hibernation_on">android ylih के रोक सकेला।</string>
    <string name="settings_hibernation_off">ylih छूट में बा आ रिकॉर्ड करत रहेला।</string>
    <string name="settings_hibernation_button">बिना इस्तेमाल ऐप के सेटिंग</string>
