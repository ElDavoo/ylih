    <string name="settings_tracking">ट्रैकिंग</string>
    <string name="settings_detailed_title">विस्तृत ट्रैकिंग</string>
    <string name="settings_detailed_body">तार वाल ईयरफोन जोड़ेला अउर बजावल के समे मपेला। android सिर्फ चलत ऐप के तार वाल घटना भेजेला, तो ऊ छाया मा चुप सूचना रहेला। bluetooth कहिए ट्रैक होय।</string>
    <string name="settings_detailed_unavailable">तब तक उपलब्ध नइखे जब तक bluetooth अनुमति न दिहल जाय: ई संस्करण सिर्फ connectedDevice सेवा प्रकार घोषित करेला, जे android 14+ bluetooth अनुमति से जोड़ेला।</string>
    <string name="settings_playback_only_title">खाली प्लेबैक गिनीं</string>
    <string name="settings_playback_only_body">आँकड़ा जुड़ल रहे के समय के जगह ऑडियो सचमुच बजे के समय गिनेला। खाली ऊ सेशन जे विस्तृत ट्रैकिंग चालू रहते रिकॉर्ड भइल, ऊहे प्लेबैक नापले; बाकी छोड़ दिहल जाला।</string>
    <string name="settings_language">भाषा</string>
    <string name="settings_language_system">सिस्टम के भाषा</string>
    <string name="settings_devices">उपकरण</string>
    <string name="settings_devices_body">जे कुछु ईयरफोन न होय — कार स्टीरियो या स्पीकर — उदा बंद कर दे रिकॉर्डिंग बंद करे के लिये।</string>
    <string name="settings_device_subtitle">%1$s · पहिले देखल %2$s</string>
    <string name="settings_data">डेटा</string>
    <string name="settings_export">json निर्यात कर</string>
    <string name="settings_import">आयात कर</string>
    <string name="settings_import_warning">आयात से अभे सब कुछु बदल जाब।</string>
    <string name="settings_troubleshooting">समस्या समाधान</string>
    <string name="settings_battery_body">अगर सत्र रिकॉर्ड न हो रहल होय, तो देख कि ylih बैटरी अनुकूलन से छुट्टा छै — जबरन बंद कइल ऐप फिर से खोले तक कोई जुड़ी घटना न पाय।</string>
    <string name="settings_battery_button">बैटरी सेटिंग्स</string>
    <string name="settings_battery_path">सेटिंग्स → ऐप्स → ylih → बैटरी → अप्रतिबंधित।</string>
    <string name="settings_about">बारे मा</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — ईयरफोन घंटा, स्थानीय अउर हमेसा के लिये रखल गइल।</string>
    <string name="settings_import_confirm_title">सब डेटा बदल दे?</string>
    <string name="settings_import_confirm_body">एही बैकअप के आयात करब तो हर उपकरण, जोड़ी अउर सत्र जे अभे बचल होय, मिट जाब।</string>

