    <string name="welcome_title">benvenite a ylih</string>
    <string name="welcome_intro">ylih registra quanto tempore singula parea de cuffias resta connexa, pro que tu posse responder post annos al unic question que importa: quantos horas duraba ille parea?</string>
    <string name="welcome_point_auto_title">connexe e oblivie</string>
    <string name="welcome_point_auto_body">cuffias bluetooth es registrate automaticamente desde que illos se connexe. nihil debe restar functionante</string>
    <string name="welcome_point_lifetime_title">un parea, un vita</string>
    <string name="welcome_point_lifetime_body">quando un parea muore, retira la: su total se fixa ibi e le proxim parea del mesme cuffias recommencia ab zero</string>
    <string name="welcome_point_detailed_title">connexa e playback</string>
    <string name="welcome_point_detailed_body">traccia detalliat in configurationes adde cuffias connexa e mesura quanto del tempore se audiva realmente</string>
    <string name="welcome_privacy">toto resta in tu telefone. non ha conto, e le application non ha permission de internet</string>
    <string name="welcome_start">comenciar</string>
    <string name="welcome_next">sequente</string>
    <string name="welcome_allow">permitter</string>
    <string name="welcome_step">paso %1$d de %2$d</string>
    <string name="welcome_bluetooth_title">accesso bluetooth</string>
    <string name="welcome_bluetooth_why">android solmente dice a un application qual apparato bluetooth es connexo e como se nomina, si le application ha accesso bluetooth. isto es como ylih distingue cuffias de un stereo de auto, e como sape distinguer un parea ab altere</string>
    <string name="welcome_bluetooth_with">con illo: qualibet parea es registrate desde que se connexe, sin nihil que debe restar functionante e sin nihil que remembrar de premer</string>
    <string name="welcome_bluetooth_without">sin illo: nulle cuffias bluetooth es registrate. le resto del application ancora functiona, e tu pote conceder illo plus tarde in le configurationes android</string>
    <string name="welcome_notifications_title">notificationes</string>
    <string name="welcome_notifications_why">traccia detalliat executa un servicto de fundo parve, e android require que omni application faciente isto mantenera un notification visibile durante</string>
    <string name="welcome_notifications_with">con illo: le notification monstra que se registra nunc, que es le unic signo que traccia detalliat es vive</string>
    <string name="welcome_notifications_without">sin illo: traccia detalliat ancora executa e ancora registra. android simplemente non monstra su notification</string>
    <string name="hibernation_title">continua contar mentre tu obliviar</string>
    <string name="hibernation_body">android pausa applicationes que resta non aperte per alcun menses e revoca lor permissiones, que causarea ylih de registrar nihil usque tu proxim apertura. esser obliviato es exactemente pro que iste application existe, tunc vale la pena de disactivar isto nunc</string>
