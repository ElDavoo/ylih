    <string name="settings_tracking">taifeadadh</string>
    <string name="settings_detailed_title">taifeadadh mion</string>
    <string name="settings_detailed_body">cuir fhuaimeanna ceangailte agus ama imirt. riail android tuairisciú ach ar imeall nasc fhuaimeanna rith app, agus seo a choimeádann fógra ciúin sa scáth. bluetooth tracked ach ar an dóigh ar aon nós.</string>
    <string name="settings_detailed_unavailable">nach bhfuil ar fáil go dtí go dtabharfar rochtain bluetooth: ní fhógraíonn an thógáil seo ach an cineál seirbhíse connectedDevice, atá nasc android 14+ go cead bluetooth.</string>
    <string name="settings_playback_only_title">comhaireamh imirt amháin</string>
    <string name="settings_playback_only_body">staitisticí comhaireamh am fuaim a bhí á imirt i ndáiríribh in ionad an ama ceangailte. seisiúin amháin taifeadadh le taifeadadh mionsonraithe ar thomhaiste imirt; an chuid eile fágtha amach.</string>
    <string name="settings_language">teanga</string>
    <string name="settings_language_system">teanga an chórais</string>
    <string name="settings_devices">gléasanna</string>
    <string name="settings_devices_body">unchecked a bith nach bhfuil fhuaimeanna — stereo carr nó spréachaire — a stad taifeadadh.</string>
