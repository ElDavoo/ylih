    <string name="settings_troubleshooting">socrú fadhbanna</string>
    <string name="settings_battery_body">má stop seisiúin a bheith taifeadadh, seiceáil go bhfuil ylih díolmhaithe ó bharr cadhnra — aip a bhí stad fórsa riamh fhaigheann craoladh nasc arís go dtí go raibh sé oscailte.</string>
    <string name="settings_battery_button">socruithe cadhnra</string>
    <string name="settings_battery_path">socruithe → aip → ylih → cadhnra → gan dhéanamh stric.</string>
    <string name="settings_hibernation_body">má imíonn ylih gan fhosgailt ar feadh roinnt míonna, pause android agus a thógann a gcead ar ais, agus níl aon rud taifeadadh arís go dtí go raibh tú oscailte. a bhaint as sin nach bhfuil cad a ligeann péire fanainn ag comhaireamh trí ráithe nach smaoineamh tú an aip.</string>
    <string name="settings_hibernation_on">féadfaidh android pause ylih.</string>
    <string name="settings_hibernation_off">ylih díolmhaithe agus fanainn taifeadadh.</string>
    <string name="settings_hibernation_button">socruithe app neamhúsáidte</string>
    <string name="settings_about">faoi thaobh</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — uaireanta fhuaimeanna, coinnithe go go domhain agus go brách.</string>
    <string name="settings_import_confirm_title">ionadú gach sonraí?</string>
    <string name="settings_import_confirm_body">iompórtáil an chúltaca seo scrios gach gléas, péire agus seisiún stóráilte anois.</string>

