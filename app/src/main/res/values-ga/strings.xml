    <string name="welcome_title">fáilte go ylih</string>
    <string name="welcome_intro">taifeadadh ylih fad a fhanann gach péire de fhuaimeanna ceangailte, chun go bhféadfaidh tú blianta ó shin freisín an aon cheist atá tábhachtach a fhreagairt: cé mhéad uair a mhair siad?</string>
    <string name="welcome_point_auto_title">ceangail agus dearmad</string>
    <string name="welcome_point_auto_body">taifeadadh na bhfuaimeanna bluetooth ar a gcuid féin, ó thosach an nasc. ní gá fágáil ar bith a rith.</string>
    <string name="welcome_point_lifetime_title">péire amháin, saol amháin</string>
    <string name="welcome_point_lifetime_body">nuair a bhásaíonn péire, cuir i scoir é: gealadh a iomlán ann agus tosú an chéad péire eile den teideal céanna arís ó nialas.</string>
    <string name="welcome_point_detailed_title">ceangailte agus imirt</string>
    <string name="welcome_point_detailed_body">taifeadadh mionsonraithe, i socruithe, cuir fhuaimeanna ceangailte agus tomhas cé mhéad den am a bhí ag imirt go fírinneach.</string>
    <string name="welcome_privacy">fanann gach rud ar an fhón seo. níl cuntas ann, agus níl cead idirlín ag an aip.</string>
    <string name="welcome_start">tosú ar ais</string>
    <string name="welcome_next">ar aghaidh</string>
    <string name="welcome_allow">ceadaigh</string>
    <string name="welcome_step">céim %1$d de %2$d</string>
    <string name="welcome_bluetooth_title">rochtain bluetooth</string>
    <string name="welcome_bluetooth_why">ní inneoin d’android aip a insint do app cén gléas bluetooth atá ceangailte, agus cad atá air, mura bhfuil rochtain bluetooth ag an app. seo a fhios ag ylih péire de fhuaimeanna ó stereo carr, agus conas a fhios aige péire amháin ó cheann eile.</string>
    <string name="welcome_bluetooth_with">leis an bhfír: taifeadadh gach péire ó thosach an nasc, gan fágáil ar bith agus gan aon rud le cuimhneamh a bhrú.</string>
    <string name="welcome_bluetooth_without">gan a bheith: níl aon fhuaimeanna bluetooth taifeadadh ar chor ar bith. oibríonn an chuid eile den aip i gcónaí, agus is féidir leat é a dheonú níos déanaí i socruithe aip android.</string>
    <string name="welcome_notifications_title">fógraí</string>
    <string name="welcome_notifications_why">reatha taifeadadh mionsonraithe seirbhís bheag chúlra, agus ceangal android aip ar bith a dhéanamh sin a choimeád fógra infheicthe agus a dhéanann.</string>
    <string name="welcome_notifications_with">leis an bhfír: taispeánann an fógra cad atá á thaifeadadh i láthair an ama, agus seo an aon chomhartha go bhfuil taifeadadh mionsonraithe beo.</string>
    <string name="welcome_notifications_without">gan a bheith: fós reatha taifeadadh mionsonraithe agus fós a dhéanann taifead. níl android a thaispeáint a fógra.</string>
    <string name="hibernation_title">coimeádtar ag comhaireamh agus tú i ndearmad</string>
    <string name="hibernation_body">pause android aip atá gan fhosgailt ar feadh roinnt míonna agus a thógann a gcead ar ais, a d’fhágfadh ylih taifeadadh ar dhada go dtí go raibh tú oscailte arís. a bheith dearmadaithe mar gheall ar go beacht cad atá an aip seo ann, agus is fiú a bhaint as anois.</string>
