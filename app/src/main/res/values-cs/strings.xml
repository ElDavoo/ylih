    <!-- Nastavení -->
    <string name="settings_tracking">sledování</string>
    <string name="settings_detailed_title">podrobné sledování</string>
    <string name="settings_detailed_body">přidává kabelová sluchátka a čas přehrávání. android hlásí připojení kabelu jen běžící aplikaci, proto tohle udržuje tichou notifikaci v liště. bluetooth se sleduje v obou případech.</string>
    <string name="settings_detailed_unavailable">nedostupné, dokud nepovolíš přístup k bluetooth: tato verze deklaruje jen typ služby connectedDevice, který android 14+ váže na oprávnění bluetooth.</string>
    <string name="settings_devices">zařízení</string>
    <string name="settings_devices_body">odškrtni cokoli, co nejsou sluchátka — autorádio nebo reproduktor — aby se to přestalo zaznamenávat.</string>
    <string name="settings_device_subtitle">%1$s · poprvé viděno %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">exportovat json</string>
    <string name="settings_import">import</string>
    <string name="settings_import_warning">import nahradí vše, co je teď uložené.</string>
    <string name="settings_troubleshooting">řešení potíží</string>
    <string name="settings_battery_body">pokud se relace přestanou zaznamenávat, zkontroluj, že je ylih vyňat z optimalizace baterie — aplikace, která byla vynuceně zastavena, už nedostává žádná oznámení o připojení, dokud se znovu neotevře.</string>
    <string name="settings_battery_button">nastavení baterie</string>
    <string name="settings_battery_path">nastavení → aplikace → ylih → baterie → bez omezení.</string>
    <string name="settings_about">o aplikaci</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — hodiny ve sluchátkách, uložené lokálně a navždy.</string>
