    <!-- První spuštění -->
    <string name="welcome_title">vítej v ylih</string>
    <string name="welcome_intro">ylih zaznamenává, jak dlouho zůstává každý pár sluchátek připojený, abys i za pár let dokázal zodpovědět jedinou otázku, na které u páru sluchátek záleží: kolik hodin vydržel?</string>
    <string name="welcome_point_auto_title">připoj a zapomeň</string>
    <string name="welcome_point_auto_body">bluetooth sluchátka se zaznamenávají sama, od chvíle, kdy se připojí. nic nemusí zůstat spuštěné.</string>
    <string name="welcome_point_lifetime_title">jeden pár, jedna životnost</string>
    <string name="welcome_point_lifetime_body">když pár dosluhuje, vyřaď ho: jeho součet se tam zastaví a další pár stejných sluchátek začíná znovu od nuly.</string>
    <string name="welcome_point_detailed_title">kabel a přehrávání</string>
    <string name="welcome_point_detailed_body">podrobné sledování, v nastavení, přidává kabelová sluchátka a měří, kolik z toho času se opravdu přehrávalo.</string>
    <string name="welcome_privacy">všechno zůstává v tomto telefonu. neexistuje žádný účet a aplikace nemá oprávnění k internetu.</string>
    <string name="welcome_start">začít</string>

