    <string name="welcome_title">felág vũ ylih</string>
    <string name="welcome_intro">ylih tẽ tukré kãgó ũ jĩ kutulunan kimẽ tã tymĩ tĩ, pa ke anũ mu nũ ta té vũ pẽpég ki ta jõ tĩ jag kutulunan: upe rẽ sé kimẽ tã ku?</string>
    <string name="welcome_point_auto_title">vũ no ség</string>
    <string name="welcome_point_auto_body">kutulunan bluetooth tẽ ukré prũ se, dedu se vũ. nũ ga ty kré rĩ.</string>
    <string name="welcome_point_lifetime_title">kimẽ nũ, ty kimẽ</string>
    <string name="welcome_point_lifetime_body">kãgó kutulunan té, kórta se: kré se ty rê lũ. kutulunan jĩ kutulunan se ty ambĩ fỹ fõ.</string>
    <string name="welcome_point_detailed_title">tig no kí rĩ</string>
    <string name="welcome_point_detailed_body">tukré gĩ, na rég, ty ũ kutulunan tig no ty ũ kãgó kí ta kõ.</string>
    <string name="welcome_privacy">tud ty rê lũ nũ telefon. ty akẽ, no app ty ty rẽnpéjó interneti.</string>
