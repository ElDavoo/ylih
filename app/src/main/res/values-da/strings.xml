    <!-- Indstillinger -->
    <string name="settings_tracking">sporing</string>
    <string name="settings_detailed_title">detaljeret sporing</string>
    <string name="settings_detailed_body">tilføjer høretelefoner med kabel og afspilningstid. android rapporterer kun kabelbegivenheder til en kørende app, så dette bevarer en lydløs notifikation i meddelelsespanelet. bluetooth spores under alle omstændigheder.</string>
    <string name="settings_detailed_unavailable">ikke tilgængelig, før bluetooth-adgang er givet: denne build angiver kun tjenestetypen connectedDevice, som android 14+ knytter til en bluetooth-tilladelse.</string>
    <string name="settings_playback_only_title">tæl kun afspilning</string>
    <string name="settings_playback_only_body">statistikken tæller den tid, lyden faktisk spillede, i stedet for tiden tilsluttet. kun sessioner optaget med detaljeret sporing slået til har målt afspilning; resten udelades.</string>
    <string name="settings_language">sprog</string>
    <string name="settings_language_system">systemsprog</string>
    <string name="settings_devices">enheder</string>
    <string name="settings_devices_body">fjern fluebenet ved alt, der ikke er høretelefoner — et bilstereoanlæg eller en højttaler — for at holde op med at registrere det.</string>
    <string name="settings_device_subtitle">%1$s · først set %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">eksportér json</string>
    <string name="settings_import">importér</string>
    <string name="settings_import_warning">import erstatter alt, der er gemt nu.</string>
    <string name="settings_troubleshooting">fejlfinding</string>
    <string name="settings_battery_body">hvis sessioner holder op med at blive registreret, så tjek at ylih er undtaget fra batterioptimering — en app, der er blevet tvangsstoppet, modtager aldrig forbindelsesbegivenheder igen, før den åbnes.</string>
    <string name="settings_battery_button">batteriindstillinger</string>
    <string name="settings_battery_path">indstillinger → apps → ylih → batteri → ubegrænset.</string>
    <string name="settings_hibernation_body">hvis ylih ikke åbnes i et par måneder, sætter android den på pause og tager dens tilladelser tilbage, og der optages ikke noget igen, før du åbner den. at slå det fra er det, der lader et sæt blive ved med at tælle gennem en sæson, hvor du aldrig tænker på appen.</string>
    <string name="settings_hibernation_on">android kan sætte ylih på pause.</string>
    <string name="settings_hibernation_off">ylih er undtaget og bliver ved med at optage.</string>
    <string name="settings_hibernation_button">indstillinger for ubrugte apps</string>
    <string name="settings_about">om</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — høretelefontimer, gemt lokalt og for altid.</string>
    <string name="settings_import_confirm_title">erstat alle data?</string>
    <string name="settings_import_confirm_body">import af denne sikkerhedskopi sletter hver enhed, hvert par og hver session, der er gemt nu.</string>
