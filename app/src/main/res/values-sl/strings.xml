    <string name="settings_tracking">sledenje</string>
    <string name="settings_detailed_title">podrobno sledenje</string>
    <string name="settings_detailed_body">dodaja žične slušalke in čas predvajanja. android prejave žičnih priključkov pove le tekajoči aplikaciji, zato to ohranja tiho obvestilo. bluetooth se spremlja v vsakem primeru.</string>
    <string name="settings_detailed_unavailable">dostopno, dokler ni odobren dostop bluetooth: ta gradnja samo izjavlja tip storitve connectedDevice, ki ga android 14+ veže na dovolenje bluetooth.</string>
    <string name="settings_playback_only_title">računa samo predvajanje</string>
    <string name="settings_playback_only_body">statistika računajo čas, ko je bil zvok dejansko predvajan, namesto časa priključka. samo seje beležene z omenjenim podrobnim slejenjem so merile predvajanje; ostalo je izpuščeno.</string>
    <string name="settings_language">jezik</string>
    <string name="settings_language_system">jezik sistema</string>
    <string name="settings_devices">naprave</string>
    <string name="settings_devices_body">odznačite vse, kar niso slušalke - avtomobilski stereo ali zvočniki - preneha jih beležiti.</string>
    <string name="settings_device_subtitle">%1$s · prvič videno %2$s</string>
    <string name="settings_data">podatki</string>
    <string name="settings_export">izvezi json</string>
    <string name="settings_import">uvozi</string>
    <string name="settings_import_warning">uvoz nadomesti vse trenutno shranjeno.</string>
    <string name="settings_troubleshooting">odpravljanje težav</string>
    <string name="settings_battery_body">če se seje prenehajo beležiti, preverite, da je ylih oproščena optimizacije baterije — aplikacija, ki je bila prisilno ustavljena, nikoli ne prejme spet oddaje priključka, dokler je ne odprete.</string>
    <string name="settings_battery_button">nastavitve baterije</string>
    <string name="settings_battery_path">nastavitve → aplikacije → ylih → baterija → neomejeno.</string>
    <string name="settings_hibernation_body">če ylih dolgo časa ne odprete, ga android premrzne in odvzame dovoljenja, in nič se spet ne beleži, dokler ga ne odprete. izklapljanje je tisto, kar omogoči paru, da šteje čez sezono, na katero niste mislili na aplikacijo.</string>
    <string name="settings_hibernation_on">android lahko premrzne ylih.</string>
    <string name="settings_hibernation_off">ylih je oproščena in še naprej beleži.</string>
    <string name="settings_hibernation_button">nerabljene nastavitve aplikacije</string>
    <string name="settings_about">o nas</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — ure slušalk, shranjene lokalno in za vedno.</string>
    <string name="settings_import_confirm_title">nadomesti vse podatke?</string>
    <string name="settings_import_confirm_body">uvoz te varnostne kopije izbriše vsako napravo, par in sejo, ki je trenutno shranjena.</string>

