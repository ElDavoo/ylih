    <!-- Imilikilo -->
    <string name="settings_tracking">inshumu</string>
    <string name="settings_detailed_title">inshumu ifingilila</string>
    <string name="settings_detailed_body">isamitikilila imipala apo inshuba ya kusekesa. android ikakunika amakamu ya imipala pakati pa foni ifwaile kukulipila, ululasa foniyo ifuna ukwifuna kwakwa. bluetooth inikiliwa ici ne ici.</string>
    <string name="settings_detailed_unavailable">palefwe pakali bluetooth ifuminile: nkola yino yatika ikulika connectedDevice shani walobo, ulo android 14+ ulitilakila bluetooth lumino.</string>
    <string name="settings_devices">amalendo</string>
    <string name="settings_devices_body">kwezepo ifyonse ifisena ifu — akanji akwa, amipale — ili kusiya inshumu yonse.</string>
    <string name="settings_device_subtitle">%1$s · inatonwilwe pakali %2$s</string>
    <string name="settings_data">amakamu</string>
    <string name="settings_export">kutumbulula json</string>
    <string name="settings_import">kufitika</string>
    <string name="settings_import_warning">kufitika kulimina fyonse icakala pakali.</string>
    <string name="settings_troubleshooting">kusosa amakamu</string>
    <string name="settings_battery_body">ifikapililo ifinu kusiyilila kunikiliwa, tontonela ylih isinfilwe mu kulipila ka batadi — foni ifwaile ilefinya palefwe kukunika amakamu, pakali ifwaile kufukilula.</string>
    <string name="settings_battery_button">imilikilo ya batadi</string>
    <string name="settings_battery_path">imilikilo → fifile → ylih → batadi → alipumuikiliwe.</string>
    <string name="settings_about">pa ylih</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — amahola mu ifu, akabilibililwa pakali alina ulubuka.</string>
    <string name="settings_import_confirm_title">kulimina fyonse amakamu?</string>
    <string name="settings_import_confirm_body">kufitika isameki ino kulimina amalendo, ifipela apo ifikapililo ifyonse icakala pakali.</string>

