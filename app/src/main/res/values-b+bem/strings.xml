    <!-- Ukwali wambuka -->
    <string name="welcome_title">kamukalile ku ylih</string>
    <string name="welcome_intro">ylih inikilila ifipela fya lwe ya ifu ifyonse, ili kuti imyaka imine namuyandwanya, makwefukila ifyonse abantu bakuupoka ifipela: ifipela fya lwe na ifu nshaba chikali?</string>
    <string name="welcome_point_auto_title">kufika apo ukwisa</string>
    <string name="welcome_point_auto_body">ifu ya bluetooth inikiliwa yenyene, pakati pa kufika kwayo. icakushele kalimina kwakwa.</string>
    <string name="welcome_point_lifetime_title">ifipela imwe, ubwino umwe</string>
    <string name="welcome_point_lifetime_body">pakali ifipela ifumilila, ilefuze: amakamu amitikilila pankokolo lino, apo ifipela ifilinga lya ifu iliyonse ifumuka ifyupela pakali ni wapili.</string>
    <string name="welcome_point_detailed_title">imipala apo kusekesa</string>
    <string name="welcome_point_detailed_body">inshumu ifingilila, mu imilikilo, isamitikilila imipala apo kukalakala ni inshuba iyofi ya pa kusekesa.</string>
    <string name="welcome_privacy">ifyonse fifumilila pano mu foni yinu. palefwe umuntu, apo na foni yinu palefwe lumino lwa intaneti.</string>
    <string name="welcome_start">kolankela</string>

