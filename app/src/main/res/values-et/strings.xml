<?xml version="1.0" encoding="utf-8"?>
<!--
  Estonian. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources>
    <string name="app_title">ylih - sinu elu kõrvaklappides</string>

    <!-- Alumine navigatsioon -->
    <string name="nav_headphones">kõrvaklapid</string>
    <string name="nav_stats">statistika</string>
