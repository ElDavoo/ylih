    <!-- Seadistused -->
    <string name="settings_tracking">jälgimine</string>
    <string name="settings_detailed_title">detailne jälgimine</string>
    <string name="settings_detailed_body">lisab juhtmega kõrvaklapid ja taasesituse aja. android teatab juhtmega ühenduse sündmustest ainult töötavale rakendusele, seega see hoiab vaikset teatist varjus. bluetooth jälgitakse igal juhul.</string>
    <string name="settings_detailed_unavailable">saadaval alles pärast bluetooth juurdepääsu andmist: see versioon kuulutab ainult connectedDevice teenuse tüüpi, mille android 14+ seob bluetooth loaga.</string>
    <string name="settings_playback_only_title">loe ainult taasesitust</string>
    <string name="settings_playback_only_body">statistika loeb aega, mil heli tegelikult mängis, ühendatud aja asemel. taasesitust mõõtsid ainult seansid, mis salvestati sisselülitatud detailse jälgimisega; ülejäänud jäetakse välja.</string>
    <string name="settings_language">keel</string>
    <string name="settings_language_system">süsteemi keel</string>
    <string name="settings_devices">seadmed</string>
    <string name="settings_devices_body">märgi välja kõik, mis ei ole kõrvaklapid - automagnitofon või kõlari - et lõpetada selle salvestamine.</string>
    <string name="settings_device_subtitle">%1$s · esimest korda nähtud %2$s</string>
    <string name="settings_data">andmed</string>
    <string name="settings_export">ekspordi json</string>
    <string name="settings_import">import</string>
    <string name="settings_import_warning">importimine asendab kõik praegu salvestatud.</string>
    <string name="settings_troubleshooting">tõrkeotsing</string>
    <string name="settings_battery_body">kui seansid ei salvestu enam, kontrollige, kas ylih on välistatud aku optimeerimisest - sunniviisiliselt peatatud rakendus ei saa kuni selle avamiseni uuesti ühenduse teadaandeid.</string>
    <string name="settings_battery_button">akuseadistused</string>
    <string name="settings_battery_path">seadistused → rakendused → ylih → aku → piiramata.</string>
    <string name="settings_hibernation_body">kui ylihi paar kuud ei avata, peatab android selle ja võtab load tagasi ning midagi ei salvestata enne, kui sa selle avad. selle väljalülitamine on see, mis laseb kõrvaklappidel edasi lugeda terve hooaja, mil sa rakendusele üldse ei mõtle.</string>
    <string name="settings_hibernation_on">android võib ylihi peatada.</string>
    <string name="settings_hibernation_off">ylih on vabastatud ja salvestab edasi.</string>
    <string name="settings_hibernation_button">kasutamata rakenduste seaded</string>
    <string name="settings_about">ylihst</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — kõrvaklappide tunnid, salvestatud kohalikult ja igaveselt.</string>
    <string name="settings_import_confirm_title">asenda kõik andmed?</string>
    <string name="settings_import_confirm_body">selle varunduse importimine kustutab iga praegu salvestatud seadme, paari ja seansi.</string>
