    <!-- Első indítás -->
    <string name="welcome_title">üdv a ylih-ben</string>
    <string name="welcome_intro">a ylih rögzíti, hogy egy-egy fejhallgatópár mennyi ideig marad csatlakoztatva, hogy évekkel később is meg tudd válaszolni az egyetlen kérdést, ami egy pár esetében valóban számít: hány órát bírtak ki?</string>
    <string name="welcome_point_auto_title">csatlakoztasd, és felejtsd el</string>
    <string name="welcome_point_auto_body">a bluetooth-os fejhallgatók automatikusan, önmaguktól rögzülnek, a csatlakozás pillanatától kezdve. semmit sem kell futva hagyni.</string>
    <string name="welcome_point_lifetime_title">egy pár, egy élettartam</string>
    <string name="welcome_point_lifetime_body">amikor egy pár tönkremegy, vond ki: az összideje ott lezárul, és ugyanannak a fejhallgatónak a következő párja újra nulláról indul.</string>
    <string name="welcome_point_detailed_title">vezetékes és lejátszás</string>
    <string name="welcome_point_detailed_body">a beállításokban bekapcsolható részletes követés hozzáadja a vezetékes fejhallgatókat, és méri, hogy az idő mekkora részében szólt ténylegesen zene.</string>
    <string name="welcome_privacy">minden ezen a telefonon marad. nincs fiók, és az alkalmazásnak nincs internet-hozzáférési engedélye.</string>
    <string name="welcome_start">kezdjük</string>

