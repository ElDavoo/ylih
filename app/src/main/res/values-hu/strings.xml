    <!-- Beállítások -->
    <string name="settings_tracking">követés</string>
    <string name="settings_detailed_title">részletes követés</string>
    <string name="settings_detailed_body">hozzáadja a vezetékes fejhallgatókat és a lejátszási időt. az android a vezetékes csatlakozási eseményeket csak egy futó alkalmazásnak jelzi, ezért ez egy néma értesítést tart a lehúzható panelen. a bluetooth mindkét esetben követve van.</string>
    <string name="settings_detailed_unavailable">nem érhető el, amíg nincs engedélyezve a bluetooth-hozzáférés: ez a build csak a connectedDevice szolgáltatástípust deklarálja, amelyet az android 14+ egy bluetooth-engedélyhez köt.</string>
    <string name="settings_playback_only_title">csak a lejátszás számítson</string>
    <string name="settings_playback_only_body">a statisztika a csatlakoztatott idő helyett azt az időt számolja, amíg tényleg szólt a hang. a lejátszást csak a bekapcsolt részletes követéssel rögzített munkamenetek mérték; a többi kimarad.</string>
    <string name="settings_language">nyelv</string>
    <string name="settings_language_system">rendszernyelv</string>
    <string name="settings_devices">eszközök</string>
    <string name="settings_devices_body">vedd ki a pipát mindenből, ami nem fejhallgató — például egy autórádióból vagy egy hangszóróból —, hogy leállítsd a rögzítését.</string>
    <string name="settings_device_subtitle">%1$s · először látva: %2$s</string>
    <string name="settings_data">adatok</string>
    <string name="settings_export">json exportálása</string>
    <string name="settings_import">importálás</string>
    <string name="settings_import_warning">az importálás lecseréli az összes jelenleg tárolt adatot.</string>
    <string name="settings_troubleshooting">hibaelhárítás</string>
    <string name="settings_battery_body">ha a munkamenetek rögzítése leáll, ellenőrizd, hogy a ylih mentesítve van-e az akkumulátor-optimalizálás alól — egy kényszerítve leállított alkalmazás soha többé nem kap kapcsolódási eseményeket, amíg meg nem nyitod újra.</string>
    <string name="settings_battery_button">akkumulátor-beállítások</string>
    <string name="settings_battery_path">beállítások → alkalmazások → ylih → akkumulátor → korlátozás nélkül.</string>
    <string name="settings_about">névjegy</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — a fejhallgatóid órái, helyben tárolva, örökre.</string>
    <string name="settings_import_confirm_title">lecseréled az összes adatot?</string>
    <string name="settings_import_confirm_body">ennek a mentésnek az importálása törli az összes jelenleg tárolt eszközt, párt és munkamenetet.</string>

