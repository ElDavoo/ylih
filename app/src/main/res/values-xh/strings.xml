    <string name="welcome_title">wamkelekile ku ylih</string>
    <string name="welcome_intro">ylih ibhala ingokufa kubukhulu bemilambo, ukuze emva kweminyaka ingabuya unaphendula umbuzo obalulekile kumqala: zingaphi iiyure azazikhonze?</string>
    <string name="welcome_point_auto_title">qhagamshela u yilahle</string>
    <string name="welcome_point_auto_body">imilambo ye-bluetooth iqala ukufakwa ngoobusuku bethu, kwangoko xa ixhuma. akukho kufumana ekusindeni.</string>
    <string name="welcome_point_lifetime_title">imilambo enye, ubomi obunye</string>
    <string name="welcome_point_lifetime_body">xa imilambo iyafa, phakamisela: inani layo leziziba apho kwaye imilambo entsha yefariwaringu ifumane ekulaleni.</string>
    <string name="welcome_point_detailed_title">izinzimu kunye nokudlala</string>
    <string name="welcome_point_detailed_body">ukufikelela inkcazo, kumisethi, kudibanisa izinzimu kunye nokulinganisa ingxowethu yokuqhubeka.</string>
    <string name="welcome_privacy">yonke into iyabusiswa kwisfowuneli sakho. akukho i-akhawunti, kunye napp ayinayo ithuba le-intanethi.</string>
    <string name="welcome_start">qalani</string>
    <string name="welcome_next">okulandelayo</string>
    <string name="welcome_allow">vumela</string>
    <string name="welcome_step">intsinga %1$d ye %2$d</string>
    <string name="welcome_bluetooth_title">ukufinyelela i-bluetooth</string>
    <string name="welcome_bluetooth_why">i-android yitsho kwisicelo nje ukuba isixhobo se-bluetooth sixhume, kunye nokuba libizwa njani, xa isicelo sinotumelo lwe-bluetooth. ke kanjikelele ylih yamkela imilambo kumotori, kunye nokwazi imilambo enye kwenye.</string>
    <string name="welcome_bluetooth_with">konke oku: imilambo ngilinye iqalwa kwi-record kwangoko xa ixhuma, kunye akukho into esindayo kunye akukho into eninimemthe ukucinezela.</string>
    <string name="welcome_bluetooth_without">ngaphandle kwesicelo: awekho imilambo ye-bluetooth iqaliwe. inxalenye enye yeapp isebenza, kunye ningakunika imvume kamva kumisethi yeapp yakho.</string>
    <string name="welcome_notifications_title">isaziso</string>
    <string name="welcome_notifications_why">inkcazo-enkcazo ibusisa isixhobo esincinane, kwaye i-android isithi nawuphi na isicelo esenza njalo kufuneka sigcine isaziso esibonakala." </string>
    <string name="welcome_notifications_with">ngale nto: isaziso sibonisa ukuba sithini esibhalwayo okwangoku, eyona nkolo kuba inkcazo-enkcazo iphila.</string>
    <string name="welcome_notifications_without">ngaphandle koko: inkcazo-enkcazo ibusisa iphinda ibhalwa. i-android nje ayibonisi isaziso sayo.</string>
    <string name="hibernation_title">qhubeka ukubala ngelixa ukulibali</string>
    <string name="hibernation_body">i-android iphumeza iisicelo ezingavulwanga kumakhulu amashumi eminyaka, kunye nokuthatha imvume yayo, leyo inokuyikhungela yi-ylih ayithandi ukuqala ukusebenza kwakhona uninzi wonke. ukubaleka ngumkhosi oweyani iyanda appiliyisheni, ke akukho njalo ulwanele ukuyisomkela ngoku.</string>
