    <string name="settings_troubleshooting">ukulungisa iinkinga</string>
    <string name="settings_battery_body">iisession aziqalwa ukuqala, butha ylih iindlela zokugcina amandla — isicelo esacinywe akwazi ukuwamkela amavumba kuze kube sifunyanwe.</string>
    <string name="settings_battery_button">imisethi yamandla</string>
    <string name="settings_battery_path">imisethi → iisicelo → ylih → amandla → unrestricted.</string>
    <string name="settings_hibernation_body">ylih ayivulelwanga okuncinane iinyanga, i-android iyiphumza kunye nokuthatha imvume yayo, akukho into eyaqaliwe ukuqala kuze kube uvule. ukuthi off ayinto eyayinqabilisayo imilambo ekulungele ikhuloni lonke unikholelele.</string>
    <string name="settings_hibernation_on">i-android inokuyiphumza i-ylih.</string>
    <string name="settings_hibernation_off">i-ylih ikhululekile kunye nokuqhubeka nokukhubula.</string>
    <string name="settings_hibernation_button">imisethi yesicelo esingasetyenziswayo</string>
    <string name="settings_about">ngomfundi</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — iiyure nemilambo, ezigciniwe ngaphakamngeni kunye kaninzi.</string>
