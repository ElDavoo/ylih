    <string name="settings_tracking">tracking</string>
    <string name="settings_detailed_title">tapshelvar tracking</string>
    <string name="settings_detailed_body">tar valem headphon ani playback velh jodte. android fukt challu appla tar valem plug events report karte, tymmulle he shadmadhe ek muk suchna thevet. bluetooth kointyahi prakare track kelem jate.</string>
    <string name="settings_detailed_unavailable">bluetooth pravesh dilyas paryat uplabdh nahi: he build fukt connectedDevice sev prakhar ghodshit karte, je android 14+ bluetooth parvangi sodte.</string>
    <string name="settings_playback_only_title">fukt playback moj</string>
    <string name="settings_playback_only_body">ankde julem velh aitvj audio kharkhur vajt aslelem velh mojte. fukt tapshelvar tracking sah record kelem seshan molem playback; baaki vgleem jatam.</string>
