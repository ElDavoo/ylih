    <string name="welcome_title">ylih maddhe aplem svagat</string>
    <string name="welcome_intro">ylih record korta ki prattyek headphon jodi kitne kalh julem rahte, tymmulle varshanntar tum ank punn ek prashnache uttar dest shakt: te kitni taas tiklem?</string>
    <string name="welcome_point_auto_title">joda ani visar</string>
    <string name="welcome_point_auto_body">bluetooth headphon svat record kelem jatam, te jultat sam. kaheebhee challu thakvnyanchi garej nahi.</string>
    <string name="welcome_point_lifetime_title">ek jodi, ek ajiwan</string>
    <string name="welcome_point_lifetime_body">jev ek jodi marte, tev ti nivrut kra: tchi ekkul thethan gothni kra ani samaan headphonchi puddhel jodi shunny pasun punn suru hote.</string>
    <string name="welcome_point_detailed_title">tar valem ani playback</string>
    <string name="welcome_point_detailed_body">setting maddhel tapshelvar tracking tar valem headphon jodte ani audio kitni velh kharkhur vajt hota he moste.</string>
    <string name="welcome_privacy">sarvkaheebhee hya phonvar raahte. konathem khate nahi, ani appla internet parvangi nahi.</string>
    <string name="welcome_start">surukvat kra</string>
    <string name="welcome_next">puddhel</string>
    <string name="welcome_allow">parvangi de</string>
    <string name="welcome_step">charn %1$d cha %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth pravesh</string>
    <string name="welcome_bluetooth_why">android fukt appla sangt ki konate bluetooth device julem ani tyala kay mhntat, jar appla bluetooth pravesh assel tar. yehi karun ylih headphonchi jodi kar stereo pasun veglem karte, ani he kase janate ki ek jodi dusryanpasun veglem ahe.</string>
    <string name="welcome_bluetooth_with">tyachy sah: prattyek jodi tyachy jultat record kelem jate, kaheebhee challu n thakvta ani dabhnyachi kaheebhee garej nahi.</string>
    <string name="welcome_bluetooth_without">tyache vina: konathem bluetooth headphon ajibhat record kelem jat nahet. appcha urverit bhag ajun kary karte, ani tum nanttar android ya app setting maddhel parvangi dilyas te dillem jauu shaktem.</string>
    <string name="welcome_notifications_title">suchna</string>
    <string name="welcome_notifications_why">tapshelvar tracking ek lahaan parshvbhumi sev chlaute, ani android konatyahi appla he karth astana suchna drishmnan thevnyachi avashyakta aset.</string>
    <string name="welcome_notifications_with">tyachy sah: suchna darshvte ki kay record kelem jat ahe abhi, je tapshelvar tracking sajeev ahe he ekmev sanket ahe.</string>
    <string name="welcome_notifications_without">tyache vina: tapshelvar tracking ajun chalte ani ajun record karte. android fukt tchi suchna dakshvnar nahi.</string>
    <string name="hibernation_title">tum visrlyas mojni challu thev</string>
    <string name="hibernation_body">android appz janchya kahi mahine upyog kelem jat nahi te thambvte ani tyanchi parvangi parat ghet, je ylih la kaheebhee record n karta sodtel johpryant tum te punn ughadtat nahi. visrun janem yeech hya appche uddisht ahe, tymmulle te band karnnem ajja layak ahe.</string>
