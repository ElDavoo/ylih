    <string name="settings_battery_button">battery setting</string>
    <string name="settings_battery_path">setting → app → ylih → battery → pratibandhit.</string>
    <string name="settings_hibernation_body">jar ylih kahi mahine ughadtat nahi tar android te thambvte ani tyanchi parvangi parat ghet, ani johpryant tum te ughadtat nahi tohpryant kaheebhee punn record kelem jat nahi. he band karnem he ahe je jodihe appbaddhal kadheebhee vichar n karta ek ritutu mojni jaari thevet.</string>
    <string name="settings_hibernation_on">android ylih he thambvu shaknate.</string>
    <string name="settings_hibernation_off">ylih mukt ahe ani record kart thevet.</string>
