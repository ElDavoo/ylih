    <string name="welcome_title">ylihʼга хуш келибсиз</string>
    <string name="welcome_intro">ylih ҳар бир аудиотосма нечадан туя қўлилганлигини ҳисобловчи дастур. бир нечаёл кейин, сизнинг аудиотосмалари қанча соат давом этганлигини сўрашингиз мумкин болади.</string>
    <string name="welcome_point_auto_title">улаш ва унутиш</string>
    <string name="welcome_point_auto_body">bluetooth аудиотосмалари ўзи қайд этилади. ҳеч нарса ишлаб турсин.</string>
    <string name="welcome_point_lifetime_title">бир жуфт, бир умр</string>
    <string name="welcome_point_lifetime_body">аудиотосма иштирок қилар эди, унга яхши айтинг: унинг жамисі шўнда ўз турадилан кейинги жуфт нол дан бошланади.</string>
    <string name="welcome_point_detailed_title">симли ва чоён ўйин</string>
    <string name="welcome_point_detailed_body">батафсил қўнун, созламаларда, симли аудиотосмалар ва нечадан воқтингнинг жунини колимасинг.</string>
    <string name="welcome_privacy">ҳар нарса телефоннингда қўлилади. ҳисобинок йўқ ва дастур интернетга уланмайди.</string>
    <string name="welcome_start">бошлаш</string>
    <string name="welcome_next">кейинги</string>
    <string name="welcome_allow">рухсат беринг</string>
    <string name="welcome_step">%1$d / %2$d қадамда</string>
    <string name="welcome_bluetooth_title">bluetooth уланиш</string>
    <string name="welcome_bluetooth_why">android фақат дастур bluetooth уланишнинг рухсатига эга болса, қайси bluetooth қурилма уланганлигини аёлатади. ушбу ylih аудиотосмаларни машина мўзикасидан ажратади.</string>
    <string name="welcome_bluetooth_with">рухсат берилса: ҳар бир аудиотосма уланиш дан сўнг қайд этилади.</string>
    <string name="welcome_bluetooth_without">рухсат берилмаса: bluetooth аудиотосмалари қайд этилмайди. қолган дастур ишлайди.</string>
    <string name="welcome_notifications_title">билдирги</string>
    <string name="welcome_notifications_why">батафсил қўнун суст фон хизматини ишлатади ва android уни индирмаси лозим.</string>
    <string name="welcome_notifications_with">рухсат берилса: билдирги қайси аудиотосма қайд этилаётганлигини кўрсатади.</string>
    <string name="welcome_notifications_without">рухсат берилмаса: батафсил қўнун ишлайди лекин android билдирги кўрсатмайди.</string>
    <string name="hibernation_title">унутингиз булса ҳам хисоблаб туринг</string>
    <string name="hibernation_body">android бир нечаёл ичида ўзи фасли дастурларни тўхтатади ва уларнинг рухсатларини олади. androidʼнинг ушбу хусусиятини ўчиринг.</string>
