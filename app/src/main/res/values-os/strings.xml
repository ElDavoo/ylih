    <string name="settings_about_body">ylih %1$s (%2$s) — наушникты сахӕттӕ, ам ӕмӕ ӕнустӕм ӕвӕрд.</string>
    <string name="settings_import_confirm_title">ӕппӕт бӕрӕггӕнӕнтӕ ивӕм?</string>
    <string name="settings_import_confirm_body">ацы фӕливд импорт кӕнгӕйӕ ныр ӕвӕрд алы аппарат, парӕ ӕмӕ сесси дӕр аппӕрст ӕрцӕудзӕн.</string>

