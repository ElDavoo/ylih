    <string name="settings_tracking">цӕстдард</string>
    <string name="settings_detailed_title">арфдӕр цӕстдард</string>
    <string name="settings_detailed_body">проводон наушниктӕ ӕмӕ хъусыны рӕстӕг бафтауы. android проводы хабӕрттӕ ӕрмӕст кусгӕ программӕйӕн зӕгъы, уымӕ гӕсгӕ ай ӕнӕуынгӕ хъусынгӕнинаг дары. bluetooth дыууӕ хуызы дӕр цӕстдарды бахауы.</string>
    <string name="settings_detailed_unavailable">bluetooth-ы барӕй дарддӕр нӕ кусы: ацы амал ӕрмӕст connectedDevice хуызы кусӕг ӕвдисы, ӕмӕ android 14+ уый bluetooth-ы бариме сбӕтты.</string>
    <string name="settings_playback_only_title">ӕрмӕст хъусын нымай</string>
    <string name="settings_playback_only_body">статистикӕ баст уӕвыны рӕстӕджы бӕсты ӕцӕгӕй хъуысгӕ рӕстӕг нымайдзӕн. хъусын ӕрмӕст арфдӕр цӕстдардимӕ фыст сесситы барст ӕрцыд; иннӕтӕ ныууадзгӕ цӕуынц.</string>
