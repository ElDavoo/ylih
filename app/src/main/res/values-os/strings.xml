    <string name="welcome_title">ylih-мӕ ӕрбацу</string>
    <string name="welcome_intro">ylih фыссы, наушникты алы парӕ дӕр цас рӕстӕг баст у, цӕмӕй азты фӕстӕ дӕр иу фарстӕн дзуапп раттай — цал сахаты фӕцардысты?</string>
    <string name="welcome_point_auto_title">сбаст кӕн ӕмӕ дӕ рох уӕд</string>
    <string name="welcome_point_auto_body">bluetooth наушниктӕ сӕхӕдӕг фыст цӕуынц, сбаст уӕвыны минутӕй фӕстӕмӕ. ницы хъӕуы куысты уадзын.</string>
    <string name="welcome_point_lifetime_title">иу парӕ — иу цард</string>
    <string name="welcome_point_lifetime_body">парӕ куы амӕла, уӕд ӕй ныууадз: йӕ нымӕц уым ныллӕууы, ӕмӕ уыцы наушникты дыккаг парӕ ногӕй нулӕй райдайы.</string>
    <string name="welcome_point_detailed_title">проводон ӕмӕ хъусын</string>
    <string name="welcome_point_detailed_body">уагӕвӕрдты арфдӕр цӕстдард проводон наушниктӕ бафтауы ӕмӕ барста кӕны, цас рӕстӕг ӕцӕгӕй хъуыст.</string>
    <string name="welcome_privacy">алцыдӕр ацы телефоны баззайы. аккаунт нӕй, ӕмӕ программӕйӕн интернеты бар дӕр нӕй.</string>
    <string name="welcome_start">райдай</string>
    <string name="welcome_next">дарддӕр</string>
    <string name="welcome_allow">бар ратт</string>
    <string name="welcome_step">къахдзӕф %1$d / %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth-ы бар</string>
    <string name="welcome_bluetooth_why">android программӕйӕн ӕрмӕст уӕд зӕгъы, кӕцы bluetooth аппарат сбаст ӕмӕ йӕ ном цы у, куы йын уа bluetooth-ы бар. уымӕй ylih наушниктӕ машинӕйы динамикӕй иртасы ӕмӕ иу парӕ иннӕйӕ базоны.</string>
    <string name="welcome_bluetooth_with">уыимӕ: алы парӕ дӕр сбаст уӕвыны минутӕй фыст цӕуы, ницы куысты лӕууы ӕмӕ ницы хъӕуы дӕ зӕрдыл дарын.</string>
    <string name="welcome_bluetooth_without">ӕнӕ уымӕй: иу bluetooth наушник дӕр нӕ фыссы. программӕйы иннӕ хай кусы, ӕмӕ фӕстӕдӕр android-ы уагӕвӕрдты бар раттӕн ис.</string>
    <string name="welcome_notifications_title">хъусынгӕнинӕгтӕ</string>
    <string name="welcome_notifications_why">арфдӕр цӕстдард гыццыл фӕстейы куыст ӕвзары, ӕмӕ android афтӕ чи кӕны, уыцы программӕйӕ домы, цӕмӕй хъусынгӕнинаг зыниниаг уа.</string>
    <string name="welcome_notifications_with">уыимӕ: хъусынгӕнинаг ӕвдисы, ныр цы фыст цӕуы, ӕмӕ уый у ӕрмӕстдӕр нысан, арфдӕр цӕстдард удӕгас кӕй у.</string>
    <string name="welcome_notifications_without">ӕнӕ уымӕй: арфдӕр цӕстдард уӕддӕр кусы ӕмӕ фыссы. android ӕрмӕст йӕ хъусынгӕнинаг нӕ равдисы.</string>
    <string name="hibernation_title">дӕ рох куы уа, уӕддӕр нымайӕд</string>
    <string name="hibernation_body">цалдӕр мӕйы ӕнӕгом программӕтӕ android ӕрлӕууын кӕны ӕмӕ сын сӕ бартӕ айсы, ӕмӕ уӕд ylih ницы фыссы, цалынмӕ йӕ нӕ бакӕнай. рох уӕвын та у ацы программӕйы сӕйраг хъуыддаг, уымӕ гӕсгӕ уый ныртӕккӕ баурӕдын хуыздӕр у.</string>
