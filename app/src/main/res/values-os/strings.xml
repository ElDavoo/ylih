    <string name="settings_language_system">системӕйы ӕвзаг</string>
    <string name="settings_devices">аппарӕттӕ</string>
    <string name="settings_devices_body">наушниктӕ чи нӕу — машинӕйы динамик кӕнӕ колонкӕ — уый нысанӕй раппар, цӕмӕй ӕй ма фысса.</string>
