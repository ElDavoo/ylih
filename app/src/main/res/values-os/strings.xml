    <string name="settings_import_warning">импорт ныр ӕвӕрд алцыдӕр ивы.</string>
    <string name="settings_troubleshooting">зындзинӕдтӕ аиуварс кӕнын</string>
    <string name="settings_battery_body">сесситӕ фыссын куы банцайой, уӕд бакӕс, ylih батарейы ӕфсармӕй ирвӕзгӕ у ӕви нӕ — тыхӕй ӕрлӕууын кӕнд программӕ баст уӕвыны хабӕрттӕ нал исы, цалынмӕ йӕ нӕ бакӕнай.</string>
    <string name="settings_battery_button">батарейы уагӕвӕрдтӕ</string>
    <string name="settings_battery_path">уагӕвӕрдтӕ → программӕтӕ → ylih → батарея → ӕнӕбарӕн.</string>
    <string name="settings_hibernation_body">ylih цалдӕр мӕйы ӕнӕгом куы уа, уӕд ӕй android ӕрлӕууын кӕны ӕмӕ йын йӕ бартӕ айсы, ӕмӕ ницы фыст цӕуы, цалынмӕ йӕ бакӕнай. уый баурӕдын та у, парӕ уыцы афӕдзы дӕр нымайгӕ кӕй уыдзӕн, кӕд ыл дӕ зӕрдӕ нӕ хӕцы, уӕддӕр.</string>
    <string name="settings_hibernation_on">android ylih ӕрлӕууын кӕнын йӕ бон у.</string>
    <string name="settings_hibernation_off">ylih ирвӕзгӕ у ӕмӕ фыссы.</string>
    <string name="settings_hibernation_button">ӕнӕспайда программӕты уагӕвӕрдтӕ</string>
