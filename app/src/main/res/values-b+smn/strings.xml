    <string name="welcome_title">tervismerkkam ylihii</string>
    <string name="welcome_intro">ylih pándooš kuá maná hearas čulhkan siimdá, mainna veari majeehist vahtta klahtestađ dan ieleš káskkáa: mánne jahkaj ojis väldiduustoj?</string>
