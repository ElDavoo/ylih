    <string name="welcome_point_auto_body">bluetooth hearas pándooštaš ittáá, ja čulhkan siimdá. midá ejä tahta jáhtta siirvun.</string>
    <string name="welcome_point_lifetime_title">okta pair, okta elo</string>
    <string name="welcome_point_lifetime_body">jos pair nuabbat, maahtat: sen sumpá ásttu čeakcu já seakke pair mainna samá hearas aalgá jällen nolla siimdá.</string>
    <string name="welcome_point_detailed_title">sáhppat já kuullamievvi</string>
