    <string name="settings_playback_only_title">ƙidaya wasa kaɗai</string>
    <string name="settings_playback_only_body">lissafin ƙidaya lokaci sauti a wasa da gaske a maimakon lokaci haɗe. sai zaman da aka riƙa tare binciken zuriya wasa; sauran ake ajiye.</string>
