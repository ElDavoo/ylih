<?xml version="1.0" encoding="utf-8"?>
<!--
  Finnish. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources>
    <string name="app_title">ylih - elämäsi kuulokkeissa</string>

    <!-- Alanavigointi -->
    <string name="nav_headphones">kuulokkeet</string>
    <string name="nav_stats">tilastot</string>
    <string name="nav_settings">asetukset</string>

    <!-- Laitetyypit -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">langallinen</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">tuntematon</string>

    <!-- Ensimmäinen käynnistys -->
    <string name="welcome_title">tervetuloa sovellukseen ylih</string>
    <string name="welcome_intro">ylih tallentaa, kuinka kauan jokainen kuulokepari pysyy yhteydessä, joten vuosien päästä voit yhä vastata ainoaan kysymykseen, joka kuulokkeista oikeasti merkitsee: kuinka monta tuntia ne kestivät?</string>
    <string name="welcome_point_auto_title">yhdistä ja unohda</string>
    <string name="welcome_point_auto_body">bluetooth-kuulokkeet tallentuvat itsestään heti, kun ne yhdistetään. mitään ei tarvitse jättää käyntiin.</string>
    <string name="welcome_point_lifetime_title">yksi pari, yksi elinikä</string>
    <string name="welcome_point_lifetime_body">kun pari kuolee, poista se käytöstä: sen kokonaisaika jäätyy siihen, ja seuraava saman kuulokemallin pari aloittaa taas nollasta.</string>
    <string name="welcome_point_detailed_title">langalliset ja toisto</string>
    <string name="welcome_point_detailed_body">asetuksista löytyvä tarkka seuranta lisää langalliset kuulokkeet ja mittaa, kuinka suuri osa ajasta meni oikeasti toistoon.</string>
    <string name="welcome_privacy">kaikki pysyy tässä puhelimessa. tiliä ei ole, eikä sovelluksella ole internet-oikeutta.</string>
    <string name="welcome_start">aloita</string>

    <!-- Kuulokeluettelo -->
    <string name="devices_in_use">käytössä</string>
    <string name="devices_retired">käytöstä poistetut</string>
    <string name="devices_empty_title">ei vielä kuulokkeita</string>
    <string name="devices_empty_body">yhdistä bluetooth-kuulokkeet, niin ne ilmestyvät tänne. langalliset kuulokkeet vaativat tarkan seurannan asetuksista.</string>
