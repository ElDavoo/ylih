    <!-- Asetukset -->
    <string name="settings_tracking">seuranta</string>
    <string name="settings_detailed_title">tarkka seuranta</string>
    <string name="settings_detailed_body">lisää langalliset kuulokkeet ja toistoajan. android ilmoittaa langallisen liittämisen vain käynnissä olevalle sovellukselle, joten tämä pitää ilmoitusalueella hiljaisen ilmoituksen. bluetooth seurataan joka tapauksessa.</string>
    <string name="settings_detailed_unavailable">ei käytettävissä ennen kuin bluetooth-oikeus on myönnetty: tämä versio ilmoittaa vain connectedDevice-palvelutyypin, jonka android 14+ sitoo bluetooth-oikeuteen.</string>
    <string name="settings_playback_only_title">laske vain toisto</string>
    <string name="settings_playback_only_body">tilastot laskevat ajan, jolloin ääntä todella toistettiin, yhdistettynä olon sijaan. vain istunnot, jotka tallennettiin tarkan seurannan ollessa päällä, mittasivat toiston; loput jätetään pois.</string>
    <string name="settings_language">kieli</string>
    <string name="settings_language_system">järjestelmän kieli</string>
    <string name="settings_devices">laitteet</string>
    <string name="settings_devices_body">poista valinta kaikesta, mikä ei ole kuulokkeita — auton stereot tai kaiutin — jotta niitä ei enää tallenneta.</string>
    <string name="settings_device_subtitle">%1$s · ensi kerta havaittu %2$s</string>
    <string name="settings_data">tiedot</string>
    <string name="settings_export">vie json</string>
    <string name="settings_import">tuo</string>
    <string name="settings_import_warning">tuonti korvaa kaiken tällä hetkellä tallennetun.</string>
    <string name="settings_troubleshooting">vianmääritys</string>
    <string name="settings_battery_body">jos sessioiden tallennus lakkaa, tarkista, että ylih on vapautettu akun optimoinnista — pakkosuljettu sovellus ei vastaanota yhteysilmoituksia enää ennen kuin se avataan uudelleen.</string>
    <string name="settings_battery_button">akkuasetukset</string>
    <string name="settings_battery_path">asetukset → sovellukset → ylih → akku → ei rajoituksia.</string>
    <string name="settings_hibernation_body">jos ylihiä ei avata pariin kuukauteen, android pysäyttää sen ja ottaa luvat pois, eikä mitään tallenneta uudelleen ennen kuin avaat sen. tämän kytkeminen pois on se, mikä antaa kuulokkeiden laskea läpi kauden, jolloin et ajattele sovellusta lainkaan.</string>
    <string name="settings_hibernation_on">android voi pysäyttää ylihin.</string>
    <string name="settings_hibernation_off">ylih on vapautettu ja tallentaa edelleen.</string>
    <string name="settings_hibernation_button">käyttämättömien sovellusten asetukset</string>
    <string name="settings_about">tietoja</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — kuulokeaikaa, säilytettynä paikallisesti ja ikuisesti.</string>
    <string name="settings_import_confirm_title">korvataanko kaikki tiedot?</string>
    <string name="settings_import_confirm_body">tämän varmuuskopion tuominen poistaa kaikki nyt tallennetut laitteet, parit ja sessiot.</string>
    <string name="widget_lifetime_label">ylih · elinikä</string>
