        <item quantity="one">%1$d yhdistetty · %2$s</item>
        <item quantity="other">%1$d yhdistetty · %2$s</item>
    </plurals>
    <plurals name="notification_active_playing">
        <item quantity="one">%1$d yhdistetty · %2$s · toistaa</item>
        <item quantity="other">%1$d yhdistetty · %2$s · toistaa</item>
    </plurals>

    <!-- Ilmoitusviestit -->
    <string name="detailed_needs_bluetooth">tämä versio tarvitsee bluetooth-oikeuden ennen kuin se voi seurata langallisia kuulokkeita</string>
