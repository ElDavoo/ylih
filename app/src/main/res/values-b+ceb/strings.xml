    <!-- Unang pagbubukas -->
    <string name="welcome_title">maligayang pagdating sa ylih</string>
    <string name="welcome_intro">ang ylih ay nagtitala kung gaano katagal ang bawat pares ng headphones ay nananatiling konektado, upang sa mga taon sa hinaharap ay maaari mo pa ring sagutin ang iisang tanong na tunay na mahalaga tungkol sa isang pares: ilang oras ang tumagal?</string>
    <string name="welcome_point_auto_title">kumonekta at kalimutan</string>
    <string name="welcome_point_auto_body">ang bluetooth headphones ay awtomatikong naitutala, simula sa sandaling kumonekta sila. walang kailangang manatiling tumatakbo.</string>
    <string name="welcome_point_lifetime_title">isang pares, isang habambuhay</string>
    <string name="welcome_point_lifetime_body">kapag ang isang pares ay nasira, iwan ito: ang kabuuang oras ay humihinto doon at ang susunod na pares ng parehong headphones ay magsisimula muli mula sa zero.</string>
    <string name="welcome_point_detailed_title">may kable at pagtugtog</string>
    <string name="welcome_point_detailed_body">ang detalyadong subaybay, sa mga setting, ay nagdadagdag ng mga headphones na may kable at sinusukat kung gaano karaming oras ang aktwal na pagtugtog.</string>
    <string name="welcome_privacy">lahat ay nananatili sa telepono na ito. walang account, at ang app ay walang pahintulot sa internet.</string>
    <string name="welcome_start">magsimula</string>

