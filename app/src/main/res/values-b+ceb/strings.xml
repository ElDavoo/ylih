    <!-- Mga setting -->
    <string name="settings_tracking">subaybay</string>
    <string name="settings_detailed_title">detalyadong subaybay</string>
    <string name="settings_detailed_body">nagdadagdag ng mga headphones na may kable at oras ng pagtugtog. ang android ay sumusulong lamang sa mga kaganapang plug ng kable sa tumatakbong app, kaya nagpanatili ito ng tahimik na notification. ang bluetooth ay sinusubaybayan sa lahat ng paraan.</string>
    <string name="settings_detailed_unavailable">hindi available hanggang hindi ipagkaloob ang access sa bluetooth: ang build na ito ay nag-declare lamang ng connectedDevice service type, na ang android 14+ ay natatali sa isang bluetooth permission.</string>
    <string name="settings_playback_only_title">ihapa ang pagpatugtog lang</string>
    <string name="settings_playback_only_body">ang estadistika mag-ihap sa oras nga nagpatugtog gyud ang audio imbis sa oras nga konektado. ang mga sesyon lang nga narekord samtang naka-on ang detalyadong subaybay ang nakasukod sa pagpatugtog; ang uban dili apilon.</string>
    <string name="settings_language">pinulongan</string>
    <string name="settings_language_system">pinulongan sa sistema</string>
    <string name="settings_devices">mga device</string>
    <string name="settings_devices_body">aalis-alisan ang mga hindi ito headphones — isang car stereo o isang speaker — upang tumigil sa pag-record nito.</string>
    <string name="settings_device_subtitle">%1$s · una nakita %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">i-export ang json</string>
    <string name="settings_import">mag-import</string>
    <string name="settings_import_warning">ang pag-import ay papalit ng lahat ng kasalukuyang nakatala.</string>
    <string name="settings_troubleshooting">paglutas ng mga problema</string>
    <string name="settings_battery_body">kung hindi na nakatala ang mga session, tingnan kung ang ylih ay exempt mula sa battery optimization — isang app na na-force stop ay hindi na makakatanggap ng connection broadcasts hanggang sa muling buksan ito.</string>
    <string name="settings_battery_button">battery settings</string>
    <string name="settings_battery_path">settings → apps → ylih → battery → unrestricted.</string>
    <string name="settings_about">tungkol sa</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — oras sa mga headphones, napanatili nang lokal at magpakailanman.</string>
    <string name="settings_import_confirm_title">palit ang lahat ng data?</string>
    <string name="settings_import_confirm_body">ang pag-import ng backup na ito ay magbabura ng bawat device, pares at session na kasalukuyang nakalagay.</string>

