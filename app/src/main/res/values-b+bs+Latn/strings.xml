    <!-- Prvo pokretanje -->
    <string name="welcome_title">dobrodošli u ylih</string>
    <string name="welcome_intro">ylih beleži koliko dugo ostaje povezana svaka para slušalica, tako da možeš, godinama kasnije, odgovoriti na jedino važno pitanje o pari: koliko sati su izdržale?</string>
    <string name="welcome_point_auto_title">poveži i zaboravi</string>
    <string name="welcome_point_auto_body">bluetooth slušalice se beleže same, od trenutka kada se povežu. ništa ne mora biti pokrenuto.</string>
    <string name="welcome_point_lifetime_title">jedna para, jedan vek</string>
    <string name="welcome_point_lifetime_body">kada para prestane da radi, povuci je u penziju: njena suma se zaleđuje tamo, a sledeća para istih slušalica počinje ponovo od nule.</string>
    <string name="welcome_point_detailed_title">žičane i reprodukcija</string>
    <string name="welcome_point_detailed_body">detaljno praćenje, u postavkama, dodaje žičane slušalice i meri koliko vremena je bilo stvarno puštanja muzike.</string>
    <string name="welcome_privacy">sve ostaje na ovom telefonu. nema naloga, niti aplikacija ima dozvolu za internet.</string>
    <string name="welcome_start">počni</string>
    <string name="hibernation_title">nastavi brojati i dok je zaboravljaš</string>
    <string name="hibernation_body">android zaustavlja aplikacije koje nisu otvarane nekoliko mjeseci i oduzima im dozvole, zbog čega ylih ne bi ništa bilježio dok je ponovo ne otvoriš. upravo to da bude zaboravljena je svrha ove aplikacije, zato vrijedi to isključiti odmah.</string>
