    <string name="settings_detailed_title">detaljno praćenje</string>
    <string name="settings_detailed_body">dodaje žičane slušalice i vreme puštanja. android samo prijavljuje događaje žičane veze pokrenuto aplikaciji, tako da ovo čuva tiho obaveštenje u senci. bluetooth se prati svakako.</string>
