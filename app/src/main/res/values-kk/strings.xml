    <string name="settings_language_system">жүйелік тіл</string>
    <string name="settings_devices">құрылғылар</string>
    <string name="settings_devices_body">құлақ аспалары емес ештеңе белгісін өшіріңіз — автомобиль стереосы немесе спикер — оны жазбай тәтеуді тоқтатсын.</string>
