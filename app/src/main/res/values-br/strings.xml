    <!-- Arventennoù -->
    <string name="settings_tracking">heuliadur</string>
    <string name="settings_detailed_title">heuliadur en diwantet</string>
    <string name="settings_detailed_body">ouzhpennañ tonelloù gwiriek hag amzer kanañ. android ne roue kendaol gwele-kennaskañ nemet d\'ur prog a zo lanv, evit-se e tistro kuñviñ amañ en droed. bluetooth a heulier a-boa ur c\'hentañ.</string>
    <string name="settings_detailed_unavailable">c\'hortoz bi-se bluetooth da vezout graet kuzh: ar stajenn-mañ neus nemet sorzhioù connectedDevice, ar pezh a zo stag android 14+ d\'ur retlaij bluetooth.</string>
    <string name="settings_playback_only_title">kontañ ar seniñ hepken</string>
    <string name="settings_playback_only_body">ar stadegoù a gont an amzer ma oa ar son o seniñ e gwirionez e-lec\'h an amzer kevreet. n\'eus nemet ar prantadoù enrollet gant an heuliadur en diwantet gweredekaet o deus muzuliet ar seniñ; ar re all a vez lezet er-maez.</string>
    <string name="settings_language">yezh</string>
    <string name="settings_language_system">yezh ar reizhiad</string>
    <string name="settings_devices">tachenn</string>
    <string name="settings_devices_body">nullañ nemet tra n\'eo ket tonelloù — ur garantell pe ur ganer — da staoañ e enrollañ.</string>
    <string name="settings_device_subtitle">%1$s · gwelet evit ar wechañ %2$s</string>
