    <string name="settings_import">enderzhañ</string>
    <string name="settings_import_warning">enderzhañ a c\'hellac\'h holl tra zo bet gwarchañ bremañ.</string>
    <string name="settings_troubleshooting">diskar a valoù</string>
    <string name="settings_battery_body">ma ne vo ket enrollet daolenn, gwiriañ ylih n\'eo ket digarget eus sturmañ baterienn — ur prog harzet n\'hall ket kaout kemennadenn kennaskañ, betek ma vez digeriñ anezhi c\'hoazh.</string>
    <string name="settings_battery_button">arventennoù baterienn</string>
    <string name="settings_battery_path">arventennoù → progidi → ylih → baterienn → distelleget.</string>
    <string name="settings_hibernation_body">ma ne vez ket digoret ylih e-pad un nebeud mizioù, android al laka en ehan hag a zistro e aotreoù, ha netra ne vez enrollet ken betek ma tigorot anezhañ. lazhañ an dra-se eo ar pezh a laka ur re selaouerezhioù da genderc\'hel da gontañ e-pad ur mare ma ne soñjit james en arload.</string>
    <string name="settings_hibernation_on">gallout a ra android lakaat ylih en ehan.</string>
    <string name="settings_hibernation_off">ylih zo dieubet ha kenderc\'hel a ra d\'enrollañ.</string>
    <string name="settings_hibernation_button">arventennoù an arloadoù dizimplij</string>
    <string name="settings_about">diwar-benn</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — eurvezhioù en tonelloù, gwarchañ e-lec\'h hag bepred.</string>
    <string name="settings_import_confirm_title">c\'hellac\'h holl roadennoù?</string>
    <string name="settings_import_confirm_body">enderzhañ ar savegezh-mañ a c\'hellac\'h bep tachenn, parol hag daolenn gwarchañ bremañ.</string>
