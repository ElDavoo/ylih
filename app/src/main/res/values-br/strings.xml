    <!-- Kentañ ober -->
    <string name="welcome_title">degemer mat e ylih</string>
    <string name="welcome_intro">ylih a noa an hañsoñj a-se e-pad ma vo stag ur parol a doneloù, evit ma c\'halloc\'h digañ ar muiañ a vloazvezhioù a-raok da respont an hevelep er-maez a-zegouezh a zo gwir a-zivout ur parol: pegen a eurvezhioù hag a servijas anezhañ?</string>
    <string name="welcome_point_auto_title">stagañ hag ankouañ</string>
    <string name="welcome_point_auto_body">tonelloù bluetooth a vo enrollet e-unan, adalek an amzer ma int staget. nemet tra ebet hag a c\'helle chom lanv.</string>
    <string name="welcome_point_lifetime_title">ur parol, unn buhez</string>
    <string name="welcome_point_lifetime_body">pa c\'h ez ur parol da ziorzh, digemer a c\'helloc\'h anezhi: he zivout a stoñk da-heul hag ur parol nevez eus an hevelep tonelloù a ya adalek zero.</string>
    <string name="welcome_point_detailed_title">gwiriek hag kanañ</string>
    <string name="welcome_point_detailed_body">heuliadur kuzh, en arventennoù, a ouzhpennañ tonelloù gwiriek hag a mejur pezh eus an amzer a oa war-lerc\'h.</string>
    <string name="welcome_privacy">a-bezh a chom war ar bellgomz-mañ. nemet kont ebet, hag an arload neus nemet gwele-kennaskañ.</string>
    <string name="welcome_start">da-geñver</string>

