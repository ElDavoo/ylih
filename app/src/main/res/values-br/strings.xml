    <string name="settings_troubleshooting">diskar a valoù</string>
    <string name="settings_battery_body">ma ne vo ket enrollet daolenn, gwiriañ ylih n\'eo ket digarget eus sturmañ baterienn — ur prog harzet n\'hall ket kaout kemennadenn kennaskañ, betek ma vez digeriñ anezhi c\'hoazh.</string>
    <string name="settings_battery_button">arventennoù baterienn</string>
    <string name="settings_battery_path">arventennoù → progidi → ylih → baterienn → distelleget.</string>
