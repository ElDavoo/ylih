    <string name="welcome_intro">ylih প্ৰতিটি শিৰোফোনৰ যোৰ কিমান সময় সংযুক্ত থাকে তা লিপিবদ্ধ কৰে, যাতে বছৰৰ পিছত আপুনি সেই একমাত্ৰ গুৰুত্বপূৰ্ণ প্ৰশ্নটোৰ উত্তৰ দিব পাৰে: তেওঁলোক কিমান ঘণ্টা চলিল?</string>
    <string name="welcome_point_auto_title">সংযোগ কৰি পাহৰি যান</string>
    <string name="welcome_point_auto_body">bluetooth শিৰোফোন নিজেই লিপিবদ্ধ হয়, সংযোগৰ মুহূৰ্ত পৰা। কোনো কিছু চলি থাকিব নালাগে।</string>
    <string name="welcome_point_lifetime_title">এটা যোৰ, এটা জীৱনকাল</string>
    <string name="welcome_point_lifetime_body">যেতিয়া এটা যোৰ বিফল হয়, এটা অবসৰ দিন: ইয়াৰ মুঠো তাত হিমাঙ্কিত হয় আৰু একে শিৰোফোনৰ পৰৱৰ্তী যোৰ শূন্যৰ পৰা নতুন সূচনা কৰে।</string>
    <string name="welcome_point_detailed_title">তাৰযুক্ত আৰু প্লেবেক</string>
    <string name="welcome_point_detailed_body">বিস্তৃত ট্ৰেকিং, সেটিংসত, তাৰযুক্ত শিৰোফোন যোগ কৰে আৰু কিমান সময় বাস্তৱত প্লেবেক হৈছিল তা পৰিমাপ কৰে।</string>
    <string name="welcome_privacy">সবকিছু এই ফোনত থাকে। কোনো অ্যাকাউন্ট নাই, আৰু এপটোৰ ইন্টাৰনেট অনুমতি নাই।</string>
    <string name="welcome_start">আৰম্ভ কৰক</string>
    <string name="hibernation_title">পাহৰি থাকিলেও গণনা অব্যাহত ৰাখক</string>
    <string name="hibernation_body">android এ কেইমাহমান নোখোলা এপবোৰ বিৰতি দিয়ে আৰু সিহঁতৰ অনুমতিবোৰ ঘূৰাই লয়, যাৰ ফলত আপুনি পুনৰ নোখোলালৈকে ylih এ একো লিপিবদ্ধ নকৰিব। পাহৰি যোৱাই এই এপটোৰ প্ৰকৃত উদ্দেশ্য, সেয়েহে এতিয়াই সেইটো বন্ধ কৰি থোৱা ভাল।</string>
