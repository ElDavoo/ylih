    <string name="settings_detailed_title">বিস্তৃত ট্ৰেকিং</string>
    <string name="settings_detailed_body">তাৰযুক্ত শিৰোফোন আৰু প্লেবেক সময় যোগ কৰে। android কেৱল চলি থকা এপটোলৈ তাৰযুক্ত প্লাগ ইভেন্ট জানায়, তাই এটি ছাঁয়াত এটা নীৰৱ বিজ্ঞপ্তি ৰাখে। bluetooth যিকোনো ক্ষেত্রে ট্র্যাক কৰা হয়।</string>
    <string name="settings_detailed_unavailable">bluetooth অ্যাক্সেস প্রদান না হোৱা পৰ্যন্ত উপলব্ধ নহয়: এই বিল্ড কেৱল connectedDevice সেবা প্ৰকাৰ ঘোষণা কৰে, যি android 14+ bluetooth অনুমতিত বান্ধে।</string>
    <string name="settings_playback_only_title">কেৱল প্লেবেক গণনা কৰক</string>
    <string name="settings_playback_only_body">পৰিসংখ্যাই সংযোগ থকা সময়ৰ সলনি অডিঅ\' প্ৰকৃততে বাজি থকা সময় গণনা কৰে। কেৱল বিস্তৃত ট্ৰেকিং অন থকা অৱস্থাত ৰেকৰ্ড হোৱা ছেছনেহে প্লেবেক জুখিছিল; বাকীবোৰ বাদ দিয়া হয়।</string>
