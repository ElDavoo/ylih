    <string name="welcome_title">salam maa aylih</string>
    <string name="welcome_intro">aylih jannginaa jinde kaalangal maa seŋal, haa ko ɓalɓe kaɗa, aɗa waawi deŋel gilla golle ɗum ko jogooɗi e kaalangal: saaji maa ɗum njiyaa?</string>
    <string name="welcome_point_auto_title">seŋal e jillin</string>
    <string name="welcome_point_auto_body">kaalangal bluetooth jannginaaɗo ɗiɗe, haa seŋal, baakol to uum fuɗɗugol.</string>
    <string name="welcome_point_lifetime_title">jeeɓe goɗɗe, kaal goɗɗe</string>
    <string name="welcome_point_lifetime_body">yiɓɓe jeeɓe hoti, deftugol: jannginol ɗum naati ndee, kaalangal kaɓɓe nde taruuji oo fuɗɗugol haa jemaaku.</string>
    <string name="welcome_point_detailed_title">jeeɗgal e huulnde</string>
    <string name="welcome_point_detailed_body">jannginol carminore, e teelirminol, baynu kaalangal jeeɗgal e jannginaa jinde huulnde maa.</string>
    <string name="welcome_privacy">juulem foti e telefon maa. alal baakɗo, kala aylih heewu internet.</string>
