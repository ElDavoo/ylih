    <string name="settings_detailed_body">𞤦𞤢𞤴𞤲𞤵 𞤳𞤢𞥄𞤤𞤢𞤲𞤺𞤢𞤤 𞤶𞤫𞥅𞤯𞤺𞤢𞤤 𞤫 𞤶𞤭𞤲𞤣𞤫 𞤸𞤵𞥅𞤤𞤲𞤣𞤫. 𞤢𞤲𞤣𞤪𞤮𞤭𞤣 𞤺𞤢𞤯𞤢 𞤧𞤫𞥅𞤯 𞤶𞤫𞥅𞤯𞤺𞤢𞤤 𞤲𞤶𞤵𞤽𞥆𞤵 𞤯𞤭𞤯𞤭 𞤲𞤶𞤵𞤽𞥆𞤭𞤼𞤫𞤪𞤫, 𞤸𞤢𞥄 𞤳𞤮 𞤲𞤣𞤫𞥅 𞤼𞤫𞤤𞤭 𞤦𞤢𞤩 𞤫 𞤼𞤫𞤻. bluetooth 𞤶𞤢𞤲𞤺𞤭𞤲𞤢𞥄𞤯𞤮 𞤶𞤵𞥅𞤤𞤫𞤥.</string>
