    <string name="welcome_bluetooth_title">𞤶𞤫𞤼𞤼𞤵𞤺𞤮𞤤 𞤦𞤤𞤵𞤼𞤵𞥅𞤧</string>
    <string name="welcome_bluetooth_why">𞤢𞤲𞤣𞤪𞤮𞥅𞤣 𞤱𞤭𞤴𞤢𞤼 𞤶𞤢𞥄𞤩𞤲𞤭𞤪𞤺𞤢𞤤 𞤳𞤮 𞤸𞤮𞤲𞥆𞤣𞤫 𞤳𞤢𞥄𞤩𞤭𞤪𞤺𞤢𞤤 𞤦𞤤𞤵𞤼𞤵𞥅𞤧 𞤧𞤫𞤺𞤭𞥅, 𞤫 𞤳𞤮 𞤦𞤫 𞤭𞤲𞤲𞤫𞤼𞤫𞥅, 𞤧𞤮 𞤼𞤢𞤲 𞤶𞤢𞥄𞤩𞤲𞤭𞤪𞤺𞤢𞤤 𞤲𞤺𞤢𞤤 𞤶𞤮𞤺𞤭𞥅 𞤶𞤫𞤼𞤼𞤵𞤺𞤮𞤤 𞤦𞤤𞤵𞤼𞤵𞥅𞤧.</string>
    <string name="welcome_bluetooth_with">𞤫 𞤶𞤫𞤼𞤼𞤵𞤺𞤮𞤤: 𞤳𞤢𞤤𞤢 𞤶𞤮𞤱𞤪𞤫 𞤱𞤭𞤲𞥆𞤣𞤫𞤼𞤫𞥅 𞤺𞤭𞤤𞤢 𞤫 𞤧𞤢𞥄𞤲𞤺𞤢 𞤥𞤮 𞤲𞤣𞤫 𞤧𞤫𞤺𞤭𞥅, 𞤸𞤢𞤴 𞤸𞤵𞥅𞤲𞤣𞤫 𞤱𞤢𞥄𞤧𞤢 𞤸𞤫𞤯𞥆𞤢𞥄𞤣𞤫 𞤫 𞤺𞤮𞤤𞥆𞤫.</string>
    <string name="welcome_bluetooth_without">𞤳𞤮 𞤢𞤤𞤣𞤢𞥄 𞤫 𞤶𞤫𞤼𞤼𞤵𞤺𞤮𞤤: 𞤲𞤢𞤲𞤭𞤪𞤯𞤫 𞤦𞤤𞤵𞤼𞤵𞥅𞤧 𞤱𞤮𞥅𞤣𞤢𞥄 𞤱𞤭𞤲𞥆𞤣𞤫𞤼𞤫𞥅𞤯𞤫. 𞤳𞤫𞤣𞥆𞤭𞥅𞤯𞤭 𞤶𞤢𞥄𞤩𞤲𞤭𞤪𞤺𞤢𞤤 𞤲𞤺𞤢𞤤 𞤭𞤲𞤢 𞤺𞤮𞤤𞥆𞤮𞥅, 𞤳𞤢𞤣𞤭 𞤢 𞤱𞤢𞤱𞤭 𞤴𞤢𞤥𞤭𞤪𞤣𞤫 𞤯𞤵𞤥 𞤩𞤢𞥄𞤱𞤮 𞤫 𞤼𞤫𞥅𞤤𞤼𞤫 𞤶𞤢𞥄𞤩𞤲𞤭𞤪𞤯𞤫 𞤢𞤲𞤣𞤪𞤮𞥅𞤣.</string>
    <string name="welcome_notifications_title">𞤼𞤭𞤲𞤼𞤭𞤲𞤫</string>
    <string name="welcome_notifications_why">𞤲𞤣𞤢𞥄𞤪𞤯𞤫 𞤩𞤵𞤳𞥆𞤵𞤯𞤫 𞤭𞤲𞤢 𞤣𞤮𞤺𞤲𞤢 𞤺𞤮𞤤𞤤𞤫 𞤨𞤢𞤥𞤢𞤪𞤫 𞤪𞤫𞤩𞤢, 𞤳𞤢𞤣𞤭 𞤢𞤲𞤣𞤪𞤮𞥅𞤣 𞤭𞤲𞤢 𞤲𞤢𞥄𞤥𞤲𞤮𞥅 𞤳𞤢𞤤𞤢 𞤶𞤢𞥄𞤩𞤲𞤭𞤪𞤺𞤢𞤤 𞤱𞤢𞤯𞤢𞤴𞤲𞤺𞤢𞤤 𞤯𞤵𞤥 𞤴𞤮 𞤱𞤢𞤯 𞤼𞤭𞤲𞤼𞤭𞤲𞤢𞤤 𞤴𞤭𞤴𞤮𞤴𞤼𞤫𞥅.</string>
    <string name="welcome_notifications_with">𞤫 𞤴𞤢𞤥𞤭𞤪𞤮𞥅𞤶𞤫: 𞤼𞤭𞤲𞤼𞤭𞤲𞤢𞤤 𞤲𞤺𞤢𞤤 𞤸𞤮𞤤𞥆𞤢𞤼 𞤳𞤮 𞤱𞤭𞤲𞥆𞤣𞤫𞤼𞤫𞥅 𞤶𞤮𞥅𞤲𞤭, 𞤳𞤮 𞤯𞤵𞤥 𞤼𞤢𞤲 𞤱𞤮𞤲𞤭 𞤥𞤢𞥄𞤲𞤣𞤫 𞤱𞤮𞤲𞤣𞤫 𞤲𞤣𞤢𞥄𞤪𞤯𞤫 𞤩𞤵𞤳𞥆𞤵𞤯𞤫 𞤭𞤲𞤢 𞤱𞤵𞥅𞤪𞤭.</string>
    <string name="welcome_notifications_without">𞤳𞤮 𞤢𞤤𞤣𞤢𞥄 𞤫 𞤴𞤢𞤥𞤭𞤪𞤮𞥅𞤶𞤫: 𞤲𞤣𞤢𞥄𞤪𞤯𞤫 𞤩𞤵𞤳𞥆𞤵𞤯𞤫 𞤭𞤲𞤢 𞤣𞤮𞤺𞥆𞤢 𞤳𞤢𞤣𞤭 𞤭𞤲𞤢 𞤱𞤭𞤲𞤣𞤢. 𞤢𞤲𞤣𞤪𞤮𞥅𞤣 𞤼𞤢𞤲 𞤸𞤮𞤤𞥆𞤢𞤼𞤢𞥄 𞤼𞤭𞤲𞤼𞤭𞤲𞤢𞤤 𞤥𞤢𞤺𞥆𞤢𞤤.</string>
    <string name="hibernation_title">𞤶𞤮𞤳𞥆𞤵 𞤤𞤭𞤥𞤮𞤵𞤺𞤮𞤤 𞤸𞤢𞤴 𞤧𞤮 𞤴𞤫𞤶𞥆𞤭𞤼𞤢𞥄</string>
    <string name="hibernation_body">𞤢𞤲𞤣𞤪𞤮𞤭𞤣 𞤸𞤭𞤨𞥆𞤢𞤴 𞤢𞤨𞤤𞤭𞤷𞤢𞤼𞤭𞤮𞤲 𞤯𞤫 𞤧𞤫𞥅𞤯𞤼𞤢𞥄𞤳𞤭 𞤴𞤮𞤺𞤢 𞤤𞤫𞤱𞤦𞤭, 𞤲𞤢𞤲𞤺𞤭𞤪𞤢 𞤶𞤢𞤥𞤭𞤪𞤮𞥅𞤶𞤫 𞤥𞤵𞤥 𞤫𞤲, 𞤯𞤵𞤥 𞤱𞤢𞥄𞤱𞤭 𞤱𞤮𞤲𞤼𞤵𞤣𞤫 ylih 𞤸𞤭𞤧𞤢𞤼𞤢𞥄 𞤸𞤢𞤴 𞤸𞤵𞥅𞤲𞤣𞤫 𞤸𞤢𞥄 𞤢𞥄𞤲 𞤵𞤣𞥆𞤭𞤼𞤵 𞤯𞤵𞤥 𞤳𞤢𞤣𞤭. 𞤴𞤫𞤶𞥆𞤭𞤼𞤫𞤺𞤮𞤤 𞤳𞤮 𞤯𞤵𞤥 𞤼𞤭𞤺𞤭 𞤱𞤮𞤲𞤭 𞤬𞤢𞥄𞤲𞤣𞤢𞥄𞤪𞤫 𞤢𞤨𞤤𞤭𞤷𞤢𞤼𞤭𞤮𞤲 𞤯𞤭𞥅, 𞤯𞤵𞤥 𞤱𞤢𞤯𞤭 𞤶𞤮𞤺𞤢𞤺𞤮𞤤 𞤸𞤭𞤨𞥆𞤵𞤣𞤫 𞤯𞤵𞤥 𞤶𞤮𞥅𞤲𞤭 𞤭𞤲𞤢 𞤸𞤭𞤥𞥆𞤭.</string>
