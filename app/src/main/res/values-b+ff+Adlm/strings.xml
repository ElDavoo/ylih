    <string name="welcome_title">𞤧𞤢𞤤𞤢𞤥 𞤥𞤢𞥄 ylih</string>
    <string name="welcome_intro">ylih 𞤶𞤢𞤲𞤺𞤭𞤲𞤢𞥄 𞤶𞤭𞤲𞤣𞤫 𞤳𞤢𞥄𞤤𞤢𞤲𞤺𞤢𞤤 𞤥𞤢𞥄 𞤧𞤫𞤽𞤢𞤤, 𞤸𞤢𞥄 𞤳𞤮 𞤩𞤢𞤤𞤩𞤫 𞤳𞤢𞤯𞤢, 𞤢𞤯𞤢 𞤱𞤢𞥄𞤱𞤭 𞤣𞤫𞤽𞤫𞤤 𞤺𞤭𞤤𞥆𞤢 𞤺𞤮𞤤𞥆𞤫 𞤯𞤵𞤥 𞤳𞤮 𞤶𞤮𞤺𞤮𞥅𞤯𞤭 𞤫 𞤳𞤢𞥄𞤤𞤢𞤲𞤺𞤢𞤤: 𞤧𞤢𞥄𞤶𞤭 𞤥𞤢𞥄 𞤯𞤵𞤥 𞤲𞤶𞤭𞤴𞤢𞥄?</string>
    <string name="welcome_point_auto_title">𞤧𞤫𞤽𞤢𞤤 𞤫 𞤶𞤭𞤤𞥆𞤭𞤲</string>
    <string name="welcome_point_auto_body">𞤳𞤢𞥄𞤤𞤢𞤲𞤺𞤢𞤤 bluetooth 𞤶𞤢𞤲𞤺𞤭𞤲𞤢𞥄𞤯𞤮 𞤯𞤭𞤯𞤫, 𞤸𞤢𞥄 𞤧𞤫𞤽𞤢𞤤, 𞤦𞤢𞥄𞤳𞤮𞤤 𞤼𞤮 𞤵𞥅𞤥 𞤬𞤵𞤯𞥆𞤵𞤺𞤮𞤤.</string>
    <string name="welcome_point_lifetime_title">𞤶𞤫𞥅𞤩𞤫 𞤺𞤮𞤯𞥆𞤫, 𞤳𞤢𞥄𞤤 𞤺𞤮𞤯𞥆𞤫</string>
    <string name="welcome_point_lifetime_body">𞤴𞤭𞤩𞥆𞤫 𞤶𞤫𞥅𞤩𞤫 𞤸𞤮𞤼𞤭, 𞤣𞤫𞤬𞤼𞤵𞤺𞤮𞤤: 𞤶𞤢𞤲𞤺𞤭𞤲𞤮𞤤 𞤯𞤵𞤥 𞤲𞤢𞥄𞤼𞤭 𞤲𞤣𞤫𞥅, 𞤳𞤢𞥄𞤤𞤢𞤲𞤺𞤢𞤤 𞤳𞤢𞤩𞥆𞤫 𞤲𞤣𞤫 𞤼𞤢𞤪𞤵𞥅𞤶𞤭 𞤮𞥅 𞤬𞤵𞤯𞥆𞤵𞤺𞤮𞤤 𞤸𞤢𞥄 𞤶𞤫𞤥𞤢𞥄𞤳𞤵.</string>
    <string name="welcome_point_detailed_title">𞤶𞤫𞥅𞤯𞤺𞤢𞤤 𞤫 𞤸𞤵𞥅𞤤𞤲𞤣𞤫</string>
    <string name="welcome_point_detailed_body">𞤶𞤢𞤲𞤺𞤭𞤲𞤮𞤤 𞤷𞤢𞤪𞤥𞤭𞤲𞤮𞤪𞤫, 𞤫 𞤼𞤫𞥅𞤤𞤭𞤪𞤥𞤭𞤲𞤮𞤤, 𞤦𞤢𞤴𞤲𞤵 𞤳𞤢𞥄𞤤𞤢𞤲𞤺𞤢𞤤 𞤶𞤫𞥅𞤯𞤺𞤢𞤤 𞤫 𞤶𞤢𞤲𞤺𞤭𞤲𞤢𞥄 𞤶𞤭𞤲𞤣𞤫 𞤸𞤵𞥅𞤤𞤲𞤣𞤫 𞤥𞤢𞥄.</string>
    <string name="welcome_privacy">𞤶𞤵𞥅𞤤𞤫𞤥 𞤬𞤮𞤼𞤭 𞤫 𞤼𞤫𞤤𞤫𞤬𞤮𞤲 𞤥𞤢𞥄. 𞤢𞤤𞤢𞤤 𞤦𞤢𞥄𞤳𞤯𞤮, 𞤳𞤢𞤤𞤢 ylih 𞤸𞤫𞥅𞤱𞤵 𞤭𞤲𞤼𞤫𞤪𞤲𞤫𞤼.</string>
