    <string name="settings_tracking">jannginol</string>
    <string name="settings_detailed_title">jannginol carminore</string>
    <string name="settings_detailed_body">baynu kaalangal jeeɗgal e jinnde huulnde. android gaɗa seeɗ jeeɗgal njuŋŋu ɗiɗi njuŋŋitere, haa ko ndee teli baɓɓ e teñ. bluetooth jannginaaɗo juulem.</string>
    <string name="settings_detailed_unavailable">ndilta redu bluetooth heewɗo: taruuji maa seelitoo nde connectedDevice duman, android 14+ gootoo e bluetooth jumnitoore.</string>
    <string name="settings_playback_only_title">limtu tan huulnde</string>
    <string name="settings_playback_only_body">limlimte ɗe limta sahaa mo hito ngo huuli goonga, wanaa sahaa jokkondiral. kojolli ɗi winndaa e jannginol carminore uddaa tan ɗi betii huulnde; keddiiɗi ina acce.</string>
