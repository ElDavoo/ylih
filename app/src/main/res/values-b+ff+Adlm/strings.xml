    <string name="settings_playback_only_body">𞤤𞤭𞤥𞤤𞤭𞤥𞤼𞤫 𞤯𞤫 𞤤𞤭𞤥𞤼𞤢 𞤧𞤢𞤸𞤢𞥄 𞤥𞤮 𞤸𞤭𞤼𞤮 𞤲𞤺𞤮 𞤸𞤵𞥅𞤤𞤭 𞤺𞤮𞥅𞤲𞤺𞤢, 𞤱𞤢𞤲𞤢𞥄 𞤧𞤢𞤸𞤢𞥄 𞤶𞤮𞤳𞥆𞤮𞤲𞤣𞤭𞤪𞤢𞤤. 𞤳𞤮𞤶𞤮𞤤𞥆𞤭 𞤯𞤭 𞤱𞤭𞤲𞤣𞤢𞥄 𞤫 𞤶𞤢𞤲𞤺𞤭𞤲𞤮𞤤 𞤷𞤢𞤪𞤥𞤭𞤲𞤮𞤪𞤫 𞤵𞤣𞥆𞤢𞥄 𞤼𞤢𞤲 𞤯𞤭 𞤦𞤫𞤼𞤭𞥅 𞤸𞤵𞥅𞤤𞤲𞤣𞤫; 𞤳𞤫𞤣𞥆𞤭𞥅𞤯𞤭 𞤭𞤲𞤢 𞤢𞤷𞥆𞤫.</string>
