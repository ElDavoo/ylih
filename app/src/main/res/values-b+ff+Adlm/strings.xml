    <string name="settings_hibernation_body">𞤧𞤮 ylih 𞤧𞤫𞥅𞤯𞤼𞤢𞥄𞤳𞤭 𞤴𞤮𞤺𞤢 𞤤𞤫𞤱𞤦𞤭, 𞤢𞤲𞤣𞤪𞤮𞤭𞤣 𞤸𞤭𞤨𞥆𞤢𞤴 𞤯𞤵𞤥, 𞤲𞤢𞤲𞤺𞤭𞤪𞤢 𞤶𞤢𞤥𞤭𞤪𞤮𞥅𞤶𞤫 𞤥𞤵𞤥, 𞤸𞤢𞤴 𞤸𞤵𞥅𞤲𞤣𞤫 𞤸𞤭𞤧𞤢𞤼𞤢𞥄 𞤳𞤢𞤣𞤭 𞤸𞤢𞥄 𞤢𞥄𞤲 𞤵𞤣𞥆𞤭𞤼𞤵 𞤯𞤵𞤥. 𞤸𞤭𞤨𞥆𞤵𞤣𞤫 𞤯𞤵𞤥 𞤳𞤮 𞤯𞤵𞤥 𞤱𞤢𞥄𞤱𞤲𞤢𞤼𞤢 𞤺𞤮𞥅𞤼𞤫𞤤 𞤶𞤮𞤳𞥆𞤵 𞤤𞤭𞤥𞤮𞤵𞤺𞤮𞤤 𞤫 𞤲𞤣𞤫𞤪 𞤴𞤮𞤲𞤼𞤫𞤪𞤫 𞤢𞥄𞤲 𞤥𞤭𞥅𞤶𞤭𞤼𞤢𞥄𞤳𞤭 𞤢𞤨𞤤𞤭𞤷𞤢𞤼𞤭𞤮𞤲 𞤲𞤣𞤫𞤲 𞤬𞤫𞤧.</string>
