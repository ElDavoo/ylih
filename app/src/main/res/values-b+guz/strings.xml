    <string name="welcome_title">wikare ko ylih</string>
    <string name="welcome_intro">ylih e-igara ombe omurango oyo momarua oragomire guikonyire, mara mbirango ino mweri ni omwerire kuhumula ebibuze bimo byo: rooba nigi omurango o-o?</string>
    <string name="welcome_point_auto_title">igomeka agire</string>
    <string name="welcome_point_auto_body">bisuma bya bluetooth bi-igara kemererire, kumbi igomeka. taine isomeka ritoigwire.</string>
    <string name="welcome_point_lifetime_title">omurango omu, omworo omu</string>
    <string name="welcome_point_lifetime_body">mwari omurango oreru, mitigira: echungechunge chace chikanyanyere korinike echunge echi omurango ogeo chikanyanya kuuma gatabere.</string>
    <string name="welcome_point_detailed_title">obwanya nabosigo na magaketi</string>
    <string name="welcome_point_detailed_body">iguratire rikararibiryire mumbo, ichungechunge chichare bisuma bya bosigo akarubare ombe chungechunge chikochongire komu.</string>
    <string name="welcome_privacy">isomeka yose ikire mumagasi meya. aitaiji ari, akatindire atagire ruhanga rwa intaneti.</string>
    <string name="welcome_start">igaka</string>
    <string name="welcome_next">echi resi</string>
    <string name="welcome_allow">yoreka</string>
    <string name="welcome_step">icheche %1$d gia %2$d</string>
    <string name="welcome_bluetooth_title">rutegezo rwa bluetooth</string>
    <string name="welcome_bluetooth_why">android aroreka rogata ribire chindi cha bluetooth chikonyire, na chakiyitwe, singa rogata ire na rutegezo rwa bluetooth. ni ge ylih arogombeire omurango ogeo wa bisuma gutangania radio ya kare, na ni ge arogombire omurango omu gutagana omu.</string>
    <string name="welcome_bluetooth_with">nacho: omurango oyo oyo o-igara kumbi ikombeka, kera taine isomeka ritoigwire na taine isomeka rikochokire.</string>
    <string name="welcome_bluetooth_without">kera: bisuma bya bluetooth bitari bi-igara gatagato. isomeka rikabiryire yose itoigwire, na urogira kusubu mumbo ga rogata.</string>
    <string name="welcome_notifications_title">ibiki byogombire</string>
    <string name="welcome_notifications_why">iguratire rikararibiryire e-igara rogata rikotwe, na android e-igara rogata rikoigara ibiki riremerere ngubu.</string>
    <string name="welcome_notifications_with">nacho: ibiki rikarugombeire se nire igara chikochongire komu, ni ge gatagato ga iguratire rikararibiryire ire.</string>
    <string name="welcome_notifications_without">kera: iguratire rikararibiryire itoigwire na itoigara. android marake itarugombire ibiki.</string>
    <string name="hibernation_title">totoigara mwari toganagana</string>
    <string name="hibernation_body">android e-igara rogata ria toigwire omon ochuma agato agato, agarigira rutegezo rwacho, ni ge ylih itagigara gatagato kumbi togwire. kuganagana ni ge rogata rogogobanega ko se, ni ge togoiba ni ngoto kumbi kumama icho komu.</string>
