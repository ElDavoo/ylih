    <string name="settings_detailed_title">iguratire rikararibiryire</string>
    <string name="settings_detailed_body">ichage bisuma bya bosigo na echunge cha magaketi. android aroreka rugata rutambira rwe na mugintagati, ni ge kogintagati rwe igara ibiki riremerere. bluetooth e-igara rutambira kwa karata.</string>
    <string name="settings_detailed_unavailable">marake komu kumbi rutegezo rwa bluetooth rigarigire: rigata rogogobanega kaka connectedDevice ire yowokoragurira, ni ge android 14+ igarigira rutegezo rwa bluetooth.</string>
    <string name="settings_playback_only_title">igara magaketi gatagato</string>
    <string name="settings_playback_only_body">istati igara echunge chikochongire komu marake echunge chigomeke. ichambire kiga iguratire rikararibiryire ichongia magaketi; ekembe igoriyeke.</string>
