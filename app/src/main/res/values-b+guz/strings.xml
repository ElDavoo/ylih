    <string name="settings_battery_body">mwari ichambire itagigara, rora se ylih marake betire yokorogera — rogata rogusigire rigumire marake ikarigira rutigari kumbi toigwire.</string>
    <string name="settings_battery_button">osarua bya betire</string>
    <string name="settings_battery_path">osarua → rogata → ylih → betire → marake igwire.</string>
    <string name="settings_hibernation_body">mwari ylih marake toigwire omon ochuma agato agato, android e-igara igogumare agarigira rutegezo rwacho, na taine risomeka rigarigire kumbi togwire. kugurama niko ni ge togarire kogarigira gutambira kumbi icheri toganagana icho.</string>
    <string name="settings_hibernation_on">android ingira gugumare ylih.</string>
    <string name="settings_hibernation_off">ylih marake igwire na itogarigira gutambira.</string>
    <string name="settings_hibernation_button">osarua bya rogata marake tokorogera</string>
    <string name="settings_about">kubera</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — amasaa bya bisuma, igabire kabi akaabire.</string>
