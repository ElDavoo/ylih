    <string name="settings_export">json sira</string>
    <string name="settings_import">kɛ jigɛn</string>
    <string name="settings_import_warning">kɛ jigɛn bi ma kuma bɛ bɛ jɔli jɔ sisan.</string>
    <string name="settings_troubleshooting">gɛrɛya taɲini</string>
    <string name="settings_battery_body">jiginna sutu bi wɛrɛ, ylih apparatigi bi batiri dɔrɔ jɔ tɛ - aparatigi jɛ damɛ jɛ ka jiginna kuma se se ka wɛrɛ dɔrɔn.</string>
    <string name="settings_battery_button">batiri soriyasoo</string>
    <string name="settings_battery_path">soriyasoo → aparatigi → ylih → batiri → a sigida tɛ.</string>
    <string name="settings_hibernation_body">ni ylih ma dabɔ kalo caaman kɔnɔ, android b’a dɔn ka a ka sigida bɔ, a tɛna foyi sɛbɛn fɔ i k’a dabɔ tugun. o dɔn walasa aparatigi ka to ka jate hali waati min i tɛ miiri aparatigi nin na.</string>
    <string name="settings_hibernation_on">android bɛ se ka ylih dɔn.</string>
    <string name="settings_hibernation_off">ylih ma dɔn — a bɛ to ka sɛbɛn.</string>
    <string name="settings_hibernation_button">aparatigi minnu ma baara kɛ soriyasoo</string>
    <string name="settings_about">ylih kuma</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — kopila kɔrɔ duumi, telefɔne yen ma gara ni ka sigida sira jɛ.</string>
    <string name="settings_import_confirm_title">kuma bɛ jɔli jɔ?</string>
    <string name="settings_import_confirm_body">kɛ jigɛn yen bi aparatigi, kopila ni jiginna sutu bɛ kɔsa sisan.</string>
