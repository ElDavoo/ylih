    <string name="welcome_title">azul g ylih</string>
    <string name="welcome_intro">ylih ittnef amud n weggur n usekcal, akka ilaq yiwen wass i d amuq: weggur aqelmayen kra n yiseggasen?</string>
    <string name="welcome_point_auto_title">sekcal ibeɛden</string>
    <string name="welcome_point_auto_body">weggur bluetooth ttnofen s yafus, seg yessusem. ulac asiwel n usekcal alelli.</string>
    <string name="welcome_point_lifetime_title">weggur yiwen, tudert yiwet</string>
    <string name="welcome_point_lifetime_body">melmi weggur yeɛmud, ader s akken yeffe: tizmilin yis tuggemt dagi, segment ibeddew weggur amaynu seg 0.</string>
    <string name="welcome_point_detailed_title">idugen d useggas</string>
    <string name="welcome_point_detailed_body">s izenzaren, rmed idugen d useggas n uzeit n useggas tigezzifin.</string>
    <string name="welcome_privacy">akk tizmilin yal azrar s ufus-inek. ulac amiḍan, d usekcal ulac tarubaɛt n internet.</string>
    <string name="welcome_start">beggu</string>
    <string name="welcome_next">azwel</string>
    <string name="welcome_allow">ssireg</string>
    <string name="welcome_step">asqel %1$d, gis %2$d</string>
    <string name="welcome_bluetooth_title">tbaɛutin bluetooth</string>
    <string name="welcome_bluetooth_why">android ittnef n usekcal yesɛan tbaɛutin bluetooth achal anasen bluetooth sekcelin d wacu yestimen. d ayen yakin ylih akken ad izzin weggur ibeɛden n assugem, d wacu akken ad izzin weggur d weggur.</string>
    <string name="welcome_bluetooth_with">s snat-a: weggur amuk ttnofen seg yessusem, ulac asiwel n usekcal.</string>
    <string name="welcome_bluetooth_without">bedda snat-a: weggur bluetooth ulac ttnofen o. yisaɣ n usekcal yella, tzemred ad d-aseggaɛ laḥcen s izenzaren n usekcal.</string>
    <string name="welcome_notifications_title">asnubgin</string>
    <string name="welcome_notifications_why">tuttra tafziranit yettnef n service meqqren, android yettnef n usekcal akken ad ttnofen asnubgin mi ttamdal.</string>
    <string name="welcome_notifications_with">s snat-a: asnubgin yay d ad ten-sken akken tuttra, d ayen akken ad ẓran tuttra tafziranit tettnef.</string>
    <string name="welcome_notifications_without">bedda snat-a: tuttra tafziranit yella tettnef akka tuttnef. android glas ur ten-sken ara asnubgin-nsen.</string>
    <string name="hibernation_title">kemmek teɛcud tettumeggru kceṛɛ ur tesɛid ara ara</string>
    <string name="hibernation_body">android izzar usekcal i yeggan tarwa d kra seg yiseggasen, akka ylih ulac tettumeggru alamma tesnewliḍ application-nni. d ayen yuɣal n weḥed n ylih, kesed azzar-it akka tura.</string>
