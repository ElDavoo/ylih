    <string name="welcome_title">welcome to ylih</string>
    <string name="welcome_intro">ylih na keep track how long each pair of headphones stay connect, so after years you still go fit answer the only question wey matter about one pair: how many hours dem last?</string>
    <string name="welcome_point_auto_title">connect am make you forget</string>
    <string name="welcome_point_auto_body">bluetooth headphones na record themselves, from the moment dem connect. nothing needs to stay running.</string>
    <string name="welcome_point_lifetime_title">one pair, one life</string>
    <string name="welcome_point_lifetime_body">when one pair die, retire am: the total go freeze there and the next pair of the same headphones go start again from zero.</string>
    <string name="welcome_point_detailed_title">wire and playback</string>
    <string name="welcome_point_detailed_body">detailed tracking, for settings, add wired headphones and measure how much time wey actually play.</string>
    <string name="welcome_privacy">everything stay for this phone. no account, and the app no get internet permission.</string>
    <string name="welcome_start">make we start</string>
    <string name="welcome_next">next</string>
