    <string name="settings_import">importovať</string>
    <string name="settings_import_warning">import nahradí všetko, čo je v súčasnosti uložené.</string>
    <string name="settings_troubleshooting">riešenie problémov</string>
    <string name="settings_battery_body">ak sa relácie prestanú zaznamenávať, skontrolujte, že ylih je oslobodená z optimalizácie batérie — aplikácia, ktorá bola nútene zastavená, nikdy dostane znova spojovací vysielací signál, kým sa neotvorí.</string>
    <string name="settings_battery_button">nastavenia batérie</string>
    <string name="settings_battery_path">nastavenia → aplikácie → ylih → batéria → bez obmedzení.</string>
    <string name="settings_hibernation_body">ak ylih nie je otvorený niekoľko mesiacov, android ho pozastaví a odoberie mu oprávnenia a nič sa opäť nezaznamenáva, kým ho neotvoríte. vypnutie je to, čo umožňuje páru držať počet cez sezónu, na ktorú ste si aplikáciu nespomenuli.</string>
    <string name="settings_hibernation_on">android môže pozastaviť ylih.</string>
    <string name="settings_hibernation_off">ylih je oslobodená a naďalej zaznamenáva.</string>
    <string name="settings_hibernation_button">nepoužívané nastavenia aplikácie</string>
    <string name="settings_about">o aplikácii</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — hodiny slúchadiel, uchovávané lokálne a navždy.</string>
    <string name="settings_import_confirm_title">nahradiť všetky údaje?</string>
    <string name="settings_import_confirm_body">import tejto zálohy vymaže každé zariadenie, pár a reláciu v súčasnosti uloženú.</string>

