    <string name="settings_tracking">sledovanie</string>
    <string name="settings_detailed_title">podrobné sledovanie</string>
    <string name="settings_detailed_body">pridáva drôtené slúchadlá a čas prehrávania. android oznamuje prípojné udalosti drôtov iba spustenej aplikácii, takže to udržuje tichý oznam. bluetooth sa sleduje v každom prípade.</string>
    <string name="settings_detailed_unavailable">dostupné až po udelení bluetooth prístupu: tento build iba vyhlasuje typ služby connectedDevice, ktorý android 14+ viazal na povolenie bluetooth.</string>
    <string name="settings_playback_only_title">počítaj iba prehrávanie</string>
    <string name="settings_playback_only_body">štatistika počítajú čas, kedy sa audio skutočne prehrávalo namiesto času pripojeného. iba relácie zaznamenané s podrobným sledovaním zmeral prehrávanie; zvyšok je vynechaný.</string>
