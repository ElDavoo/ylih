    <string name="welcome_title">vitajte v ylih</string>
    <string name="welcome_intro">ylih zaznamenáva, ako dlho zostáva každý pár slúchadiel pripojený, aby ste o roky neskôr stále mohli odpovedať na jedinú dôležitú otázku: koľko hodín vydržali?</string>
    <string name="welcome_point_auto_title">pripoj a zabudni</string>
    <string name="welcome_point_auto_body">bluetooth slúchadlá sú zaznamenávané automaticky, od chvíle ich pripojenia. nič nemusí zostať spustené.</string>
    <string name="welcome_point_lifetime_title">jeden pár, jeden život</string>
    <string name="welcome_point_lifetime_body">keď sa pár pokazí, vyberte ho: jeho celkový čas sa tu zmrazí a ďalší pár rovnakých slúchadiel sa opäť spustí od nuly.</string>
    <string name="welcome_point_detailed_title">drôtové a prehrávanie</string>
    <string name="welcome_point_detailed_body">podrobné sledovanie v nastaveniach pridáva drôtené slúchadlá a meria, koľko času sa skutočne hralo.</string>
    <string name="welcome_privacy">všetko zostáva na tomto telefóne. nie je žiadny účet a aplikácia nemá povolenie na internet.</string>
    <string name="welcome_start">začať</string>
    <string name="welcome_next">ďalej</string>
    <string name="welcome_allow">povoliť</string>
    <string name="welcome_step">krok %1$d z %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth prístup</string>
    <string name="welcome_bluetooth_why">android povie aplikácii iba o tom, ktoré zariadenie sa pripojilo a ako sa nazýva, ak má aplikácia bluetooth prístup. takto ylih rozlíši pár slúchadiel od autorádia a ako pozná jeden pár od druhého.</string>
    <string name="welcome_bluetooth_with">s ním: každý pár je zaznamenávaný od okamihu pripojenia bez nič, čo by muselo zostať spustené, a bez čoho sa treba pamätať.</string>
    <string name="welcome_bluetooth_without">bez neho: bluetooth slúchadlá vôbec nie sú zaznamenávané. zvyšok aplikácie stále funguje a môžete mu dať povolenie neskôr v android nastaveniach.</string>
    <string name="welcome_notifications_title">oznámenia</string>
    <string name="welcome_notifications_why">podrobné sledovanie spúšťa malú službu na pozadí a android vyžaduje, aby každá aplikácia to robiaca, udržiavala viditeľné oznámenie.</string>
    <string name="welcome_notifications_with">s ním: oznámenie ukazuje, čo sa práve zaznamenáva, čo je jediný znak, že podrobné sledovanie je aktívne.</string>
    <string name="welcome_notifications_without">bez neho: podrobné sledovanie stále beží a stále zaznamenáva. android jednoducho neukazuje jeho oznámenie.</string>
    <string name="hibernation_title">keep counting while you forget about it</string>
    <string name="hibernation_body">android pozastavuje aplikácie, ktoré nie sú otvorené niekoľko mesiacov a odoberie im oprávnenia, čo by nechálo ylih bez zaznamenávania, kým ho opäť neotvoríte. byť zabudnutý je presne to, na čo je táto aplikácia, takže je to stojí vypnúť teraz.</string>
