    <string name="welcome_title">witajće k ylihu</string>
    <string name="welcome_intro">ylih nachwliva, kak dołho je so kóžda para słuchawkow zwězkana, aby wy w lětach móhli na pytanje wotmołwić: kolko hodźin su durjeli?</string>
    <string name="welcome_point_auto_title">zwězkej a zabydź</string>
    <string name="welcome_point_auto_body">bluetooth słuchawki so notuja samy, hdy se zwězkaju. ničcy njemamy běžeć</string>
    <string name="welcome_point_lifetime_title">jedna para, jedno žiwjenje</string>
    <string name="welcome_point_lifetime_body">hdyž para skońči, ju zažywej: jeje suma so tu zaměrnja a přida para tych samych słuchawkow znochwali nula</string>
    <string name="welcome_point_detailed_title">přewodne a wotehranje</string>
    <string name="welcome_point_detailed_body">detaljna nachwila w nastajenjach dodawa přewodne słuchawki a měri, kolyko časa je prawje so wotehrało</string>
    <string name="welcome_privacy">wšitko staja na tutym telefonje. nima konta a aplikacija nima internetneho prawa</string>
    <string name="welcome_start">započmi</string>
    <string name="welcome_next">přichodne</string>
    <string name="welcome_allow">dowolić</string>
    <string name="welcome_step">krok %1$d z %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth přistup</string>
    <string name="welcome_bluetooth_why">android jenož powěda aplikaciji, kiž bluetooth přistrojenja su zwězkana a kich mjeno maju, hdyž aplikacija ma bluetooth přistup. tak ylih pozna paru słuchawkow wot awtoradija a jednu paru wot druhe</string>
    <string name="welcome_bluetooth_with">z tym: kóžda para so notuje, hdy se zwězkuje, a ničcy njemaja běžeć a na ničco njemaja čekać</string>
    <string name="welcome_bluetooth_without">bjez toho: žane bluetooth słuchawki so njenotuja. ostatk aplikacije hišće dělajo, a móžeš to pozdźišće w nastajenjach dowolić</string>
    <string name="welcome_notifications_title">powědomjenja</string>
    <string name="welcome_notifications_why">detaljna nachwila wuwjeduje mały službu na pozadku, a android žada, zo aplikacija to zworhuje zwobraznjeće powědomjenje</string>
    <string name="welcome_notifications_with">z tym: powědomjenje pokazuje, što so prawje nachwluje, što je jedyny znak, zo je detaljna nachwila aktiwna</string>
    <string name="welcome_notifications_without">bjez toho: detaljna nachwila hišće běži a hišće notuje. android jenož jeje powědomjenje njezwobraznuje</string>
    <string name="hibernation_title">počítaj hišće, dokelž zabyjaš</string>
    <string name="hibernation_body">android stawy aplikacije, kiž dołho njestanu wotworjene, a wzamě jich prawa. to by njechodiło, zo ylih ničcy notuje. aplikacija je za to, zo so na ju zabudy, tak je warto to nětka wupinać</string>
