    <string name="settings_tracking">ट्रैकिंग</string>
    <string name="settings_detailed_title">विस्तृत ट्रैकिंग</string>
    <string name="settings_detailed_body">तारयुक्त हेडफोन और प्लेबैक समय जोड़ता है। android केवल एक चल रही ऐप को तारयुक्त प्लग ईवेंट की रिपोर्ट करता है, इसलिए यह शेड में एक शांत सूचना रखता है। bluetooth किसी भी तरह से ट्रैक किया जाता है।</string>
    <string name="settings_detailed_unavailable">जब तक bluetooth अनुमति दी नहीं जाती तब तक उपलब्ध नहीं है: यह बिल्ड केवल connectedDevice सेवा प्रकार घोषित करता है, जिसे android 14+ एक bluetooth अनुमति से जोड़ता है।</string>
    <string name="settings_playback_only_title">खालि प्लेबैक हिसाब खालाम</string>
    <string name="settings_playback_only_body">जोनोम खालामनाय सम नि सोलायथाव अडियो थार थारै जायो नाय समखौ आंखिदुंगारि हिसाब खालामो। खालि विस्तृत ट्रैकिंग ओन थानाय समाव रेकर्ड जानाय सेसनआव प्लेबैक मापित जादों; गुबुनखौ नागारो।</string>
    <string name="settings_language">राव</string>
    <string name="settings_language_system">सिस्टेमनि राव</string>
    <string name="settings_devices">डिवाइस</string>
    <string name="settings_devices_body">हेडफोन नहीं होने वाली किसी भी चीज को अनचेक करें — कार स्टीरियो या स्पीकर — इसे रिकॉर्ड करना बंद करने के लिए।</string>
    <string name="settings_device_subtitle">%1$s · पहली बार देखा गया %2$s</string>
    <string name="settings_data">डेटा</string>
    <string name="settings_export">json निर्यात करें</string>
    <string name="settings_import">आयात करें</string>
    <string name="settings_import_warning">आयात करने से वर्तमान में संग्रहीत सब कुछ बदल जाता है।</string>
    <string name="settings_troubleshooting">समस्या निवारण</string>
    <string name="settings_battery_body">यदि सत्र रिकॉर्ड किए जाना बंद हो जाते हैं, तो जांचें कि ylih बैटरी अनुकूलन से मुक्त है — एक बलपूर्वक बंद की गई ऐप को जब तक खोला नहीं जाता तब तक कनेक्शन प्रसारण नहीं मिलते।</string>
    <string name="settings_battery_button">बैटरी सेटिंग्स</string>
    <string name="settings_battery_path">सेटिंग्स → ऐप्स → ylih → बैटरी → अप्रतिबंधित।</string>
    <string name="settings_about">के बारे में</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — हेडफोन घंटे, स्थानीय रूप से और हमेशा के लिए रखे गए।</string>
    <string name="settings_import_confirm_title">सभी डेटा बदलें?</string>
    <string name="settings_import_confirm_body">इस बैकअप को आयात करने से अभी संग्रहीत हर डिवाइस, जोड़ी और सत्र हटा दिया जाता है।</string>

