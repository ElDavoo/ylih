    <string name="welcome_title">ylih मे आपनो स्वागत</string>
    <string name="welcome_intro">ylih हर हेडफोन जोडी दो कने वक्त रिकॉर्ड करे, ताकि साल बाद आप यह जान सको कि यह जोडी कने घंटे चली?</string>
    <string name="welcome_point_auto_title">जोडो अर भूलो</string>
    <string name="welcome_point_auto_body">ब्लूटूथ हेडफोन अपने आप रिकॉर्ड होत हे जब से वे जुडे। कुछ भी चलाना नहीं पडे।</string>
    <string name="welcome_point_lifetime_title">एक जोडी, एक जीवन</string>
    <string name="welcome_point_lifetime_body">जब जोडी खराब हो जाए, तो रिटायर करो: उसको कुल फ्रीज हो जाएगा अर नई जोडी जीरो से शुरू होगी।</string>
    <string name="welcome_point_detailed_title">तार अर प्लेबैक</string>
    <string name="welcome_point_detailed_body">विस्तृत ट्रैकिंग, सेटिंग मे, तार हेडफोन जोडे अर कितने समय प्लेबैक हुई मापे।</string>
    <string name="welcome_privacy">सब कुछ इस फोन मे रहे। कोई खाता नहीं है अर ऐप को इंटरनेट की अनुमति नहीं है।</string>
    <string name="welcome_start">शुरू करो</string>
    <string name="welcome_next">अगलो</string>
    <string name="welcome_allow">मंजूर करो</string>
    <string name="welcome_step">कदम %1$d का %2$d</string>
    <string name="welcome_bluetooth_title">ब्लूटूथ पहुंच</string>
    <string name="welcome_bluetooth_why">एंड्रॉयड केवल तभी बताता है कि कौन सी ब्लूटूथ डिवाइस कनेक्ट हुई है, अगर ऐप को ब्लूटूथ एक्सेस है। यही ylih को हेडफोन को कार स्पीकर से अलग करने का तरीका है।</string>
    <string name="welcome_bluetooth_with">इसके साथ: हर जोडी कनेक्ट होने से ही रिकॉर्ड हो जाती है, कुछ चलाना नहीं पडे।</string>
    <string name="welcome_bluetooth_without">इसके बिना: कोई भी ब्लूटूथ हेडफोन रिकॉर्ड नहीं होते। बाकी ऐप काम करता है, अर आप बाद मे एंड्रॉयड सेटिंग से दे सकते हो।</string>
    <string name="welcome_notifications_title">सूचनाएं</string>
    <string name="welcome_notifications_why">विस्तृत ट्रैकिंग एक छोटी पृष्ठभूमि सेवा चलाती है, अर एंड्रॉयड को एक सूचना दिखानी पडती है।</string>
    <string name="welcome_notifications_with">इसके साथ: सूचना बताती है कि अभी क्या रिकॉर्ड हो रहा है, जो विस्तृत ट्रैकिंग के चलने का संकेत है।</string>
    <string name="welcome_notifications_without">इसके बिना: विस्तृत ट्रैकिंग फिर भी चलती है अर रिकॉर्ड करती है। एंड्रॉयड सूचना नहीं दिखाएगा।</string>
    <string name="hibernation_title">भूलते रहते हुए गिनती जारी रखो</string>
    <string name="hibernation_body">एंड्रॉयड महीनों तक खोले ना जाने वाली ऐप को रोक देता है अर अनुमतियां छीन लेता है, जिससे ylih रिकॉर्ड नहीं कर पाता। ऐप को भुला दिया जाना ही यहां का मतलब है, इसलिए इसे अभी बंद करना सार्थक है।</string>
    <string name="action_not_now">अभी नहीं</string>

