    <string name="settings_language_system">sistem dili</string>
    <string name="settings_devices">cihazlar</string>
    <string name="settings_devices_body">qulaqlıq olmayan heç nə — avtomobil stereosistemi və ya akustik — qeyd etməyi dayandırmaq üçün işarəsini çıxarın.</string>
