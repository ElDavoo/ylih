    <!-- Tənzimləmələr -->
    <string name="settings_tracking">izləmə</string>
    <string name="settings_detailed_title">ətraflı izləmə</string>
    <string name="settings_detailed_body">simlə qulaqlıqlar və oynatma vaxtını əlavə edir. android simlə qoşulma hadisələrini yalnız işləyən bir tətbiqə bildirər, buna görə də bildirişlər şkalatosu sakit qalır. bluetooth hər halda izlənir.</string>
    <string name="settings_detailed_unavailable">bluetooth icazəsi verilənə qədər mövcud deyil: bu qurğu yalnız connectedDevice xidmət tipini elan edir, android 14+ bunu bluetooth icazəsinə bağlayır.</string>
