    <string name="settings_export">json-ə ixrac et</string>
    <string name="settings_import">idxal et</string>
    <string name="settings_import_warning">idxal hazırda saxlanılan hər şeyi əvəz edir.</string>
    <string name="settings_troubleshooting">problemin aradan qaldırılması</string>
    <string name="settings_battery_body">seanslar qeyd olunmağı dayandırsa, ylih-in batareya optimallaşdırmasından istisna edildiyinə əmin olun — məcburi olaraq dayandırılmış tətbiq açılana qədər qoşulma hadisələrini almır.</string>
    <string name="settings_battery_button">batareya tənzimləmələri</string>
    <string name="settings_battery_path">tənzimləmələr → tətbiqlər → ylih → batareya → sınırlamadan azad.</string>
    <string name="settings_about">haqqında</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — qulaqlıqda saatlar, mərkəzi şəkildə və əbədi saxlanılır.</string>
    <string name="settings_import_confirm_title">bütün məlumatları əvəz etmək istəyirsiniz?</string>
    <string name="settings_import_confirm_body">bu ehtiyat nüsxəsini idxal etmək hazırda saxlanılan hər bir cihazı, cütlüyü və seansu silir.</string>

