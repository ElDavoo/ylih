    <string name="settings_battery_body">அமர்வுகள் பதிவாவது நின்றுவிட்டால், ylih பேட்டரி மேம்படுத்தலிலிருந்து விலக்கப்பட்டுள்ளதா எனப் பாருங்கள் — வலுக்கட்டாயமாக நிறுத்தப்பட்ட ஆப், மீண்டும் திறக்கும் வரை இணைப்பு ஒளிபரப்புகளைப் பெறாது.</string>
    <string name="settings_battery_button">பேட்டரி அமைப்புகள்</string>
    <string name="settings_battery_path">அமைப்புகள் → ஆப்கள் → ylih → பேட்டரி → கட்டுப்பாடற்றது.</string>
    <string name="settings_hibernation_body">ylih சில மாதங்கள் திறக்கப்படாவிட்டால், android அதை இடைநிறுத்தி அதன் அனுமதிகளைத் திரும்பப் பெறும், நீங்கள் திறக்கும் வரை எதுவும் பதிவாகாது. அதை அணைப்பதுதான், ஆப்-ஐப் பற்றி நீங்கள் நினைக்காத ஒரு பருவம் முழுவதும் ஒரு ஜோடி தொடர்ந்து எண்ண அனுமதிக்கிறது.</string>
    <string name="settings_hibernation_on">android ylih-ஐ இடைநிறுத்தலாம்.</string>
    <string name="settings_hibernation_off">ylih விலக்கப்பட்டுள்ளது, பதிவு தொடர்கிறது.</string>
    <string name="settings_hibernation_button">பயன்படுத்தாத ஆப் அமைப்புகள்</string>
    <string name="settings_about">பற்றி</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — ஹெட்ஃபோன் மணிநேரங்கள், இங்கேயே என்றென்றும் வைக்கப்படுகின்றன.</string>
    <string name="settings_import_confirm_title">எல்லா தரவையும் மாற்றவா?</string>
    <string name="settings_import_confirm_body">இந்த காப்புப்பிரதியை இறக்குமதி செய்தால் இப்போது சேமித்துள்ள ஒவ்வொரு சாதனம், ஜோடி, அமர்வும் நீக்கப்படும்.</string>

    <string name="widget_lifetime_label">ylih · ஆயுள்</string>
    <string name="widget_lifetime_description">ஒவ்வொரு ஜோடிக்கும் மணிநேரம், இணைந்திருப்பதில் நேரலை டைமருடன்</string>
    <string name="widget_activity_label">ylih · செயல்பாடு</string>
    <string name="widget_activity_description">எல்லா ஜோடிகளின் மணிநேரமும் சேர்ந்து, இன்று, 7 நாட்கள், 30 நாட்கள்</string>
    <string name="widget_chart_label">ylih · 30 நாட்கள்</string>
    <string name="widget_chart_description">கடந்த 30 நாட்களின் தினசரி கேட்ட மணிநேரம்</string>

