    <string name="welcome_title">salaam gal u yimaado ylih</string>
    <string name="welcome_intro">ylih waxay soo shuruqdaa sida gaarka oo dhegga ah iska hadhay iska xiran, si aad mararka hadii kulul oo dhawr sanno ay kaa dambeeyo aad wali jawaab ku siiso su\'aasha keliya oo macashay nololka: dhegga xanuun baxda ay joog dhacdeen?</string>
    <string name="welcome_point_auto_title">xidhka oo ilaalinka</string>
    <string name="welcome_point_auto_body">dhegga bluetooth waxaa lagula sameeyay naftooda, marka ay xidhaan. waxba lumay inaga lagula joogsiyo.</string>
    <string name="welcome_point_lifetime_title">gaarka mid, nololka mid</string>
    <string name="welcome_point_lifetime_body">marka gaarka ay dhinto, isagoo haday naga halis; tirada beddelka ay qabatay waxyar halista inta dhegga kalay xidhaan dhegga cusub ee laga shuruqday zero.</string>
    <string name="welcome_point_detailed_title">xadka iyo ciyaarta</string>
    <string name="welcome_point_detailed_body">shaaca qoray kheyr, xawaaraha, dhegga xadka iyo imika ay joogtay. gayraan yixidhu.</string>
    <string name="welcome_privacy">wixii jira waxaa ku kul tihiin siiddan. waxba akun ama akun, appka oo aan internet oggolaanshahan.</string>
    <string name="welcome_start">bilaab</string>
