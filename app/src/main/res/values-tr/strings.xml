    <!-- İlk açılış -->
    <string name="welcome_title">ylih\'e hoş geldin</string>
    <string name="welcome_intro">ylih her kulaklığın ne kadar süre bağlı kaldığını kaydeder, böylece yıllar sonra bile bir kulaklık çifti hakkında önemli olan tek soruyu yanıtlayabilirsin: kaç saat dayandı?</string>
    <string name="welcome_point_auto_title">tak ve unut</string>
    <string name="welcome_point_auto_body">bluetooth kulaklıklar bağlandığı andan itibaren kendiliğinden kaydedilir. hiçbir şeyin açık kalması gerekmez.</string>
    <string name="welcome_point_lifetime_title">bir çift, bir ömür</string>
    <string name="welcome_point_lifetime_body">bir çift bozulduğunda emekliye ayır: toplamı orada donar ve aynı modelin bir sonraki çifti sıfırdan başlar.</string>
    <string name="welcome_point_detailed_title">kablolu ve çalma süresi</string>
    <string name="welcome_point_detailed_body">ayarlardaki ayrıntılı takip, kablolu kulaklıkları ekler ve sürenin ne kadarında gerçekten ses çaldığını ölçer.</string>
    <string name="welcome_privacy">her şey bu telefonda kalır. hesap yoktur ve uygulamanın internet izni yoktur.</string>
    <string name="welcome_start">başla</string>

