    <string name="settings_tracking">ufuataji</string>
    <string name="settings_detailed_title">ufuataji wa kina</string>
    <string name="settings_detailed_body">unaongeza makinanzi ya waya na wakati wa kumsikiliza. android tu inakamatia matukio ya waya kwa programu inayofanya kazi, kwa hiyo hii inahifadhi onyo silie katika mng\'ole. bluetooth inafuatiliwa kila jinsi.</string>
    <string name="settings_detailed_unavailable">haipatikani hadi ruhusa ya bluetooth itakapokubali: hii huzalisha tu aina ya huduma ya connectedDevice, ambayo android 14+ inakamatia kwa ruhusa ya bluetooth.</string>
    <string name="settings_playback_only_title">hesabu tu kumsikiliza</string>
    <string name="settings_playback_only_body">takwimu huhesabu wakati udio ulikuwa kinakimbia halisi badala ya wakati uliokamatia. kila mara iliyorekodiwa na ufuataji wa kina juu ilipimwa kumsikiliza; nyingine zimekosa.</string>
    <string name="settings_language">lugha</string>
    <string name="settings_language_system">lugha ya mfumo</string>
    <string name="settings_devices">simu</string>
    <string name="settings_devices_body">tofautiana chochote kisicho makinanzi — simu ya gari au chezeana — kusimamisha kurekodi.</string>
    <string name="settings_device_subtitle">%1$s · kwanza kuona %2$s</string>
