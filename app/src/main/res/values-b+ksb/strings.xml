    <string name="welcome_title">karibu ylih-ni</string>
    <string name="welcome_intro">ylih inataka kumbuka saa ngapi kila jozi ya makinanzi ina kuchunga bila kutenganisha, ili baada ya miaka mingi unaweza kujibu swali moja muhimu: saa ngapi zilisimama?</string>
    <string name="welcome_point_auto_title">unganisha na sahau</string>
    <string name="welcome_point_auto_body">makinanzi ya bluetooth yanarekodiwa yenyewe, tangu wakati ya kuunganisha. hakuna kitu kinachohitaji kuendelea kufanya kazi.</string>
    <string name="welcome_point_lifetime_title">jozi moja, maisha moja</string>
    <string name="welcome_point_lifetime_body">wakati jozi inapokufa, fusha: jumla yake inasimama hapo na jozi inayofuata ya makinanzi sawa inaanza tena kutoka sifuri.</string>
    <string name="welcome_point_detailed_title">waya na kumsikiliza</string>
    <string name="welcome_point_detailed_body">ufuataji wa kina, katika mipango, unaongeza makinanzi ya waya na kupima sehemu gani ya wakati ulikuwa unakimbia.</string>
    <string name="welcome_privacy">kila kitu kinasalia simu hii. hakuna akaunti, na programu haina ruhusa ya mitandao.</string>
    <string name="welcome_start">kuanza</string>
    <string name="welcome_next">inayofuata</string>
    <string name="welcome_allow">ruhusu</string>
    <string name="welcome_step">hatua %1$d ya %2$d</string>
    <string name="welcome_bluetooth_title">ruhusa ya bluetooth</string>
    <string name="welcome_bluetooth_why">android inajumbuza programu tu ipi simu ya bluetooth imeunganisha, na jina lake, ikiwa programu ina bluetooth. ndio inayosaidia ylih kutofautiana na waya wa simu, na kumjua jozi moja kutoka nyingine.</string>
    <string name="welcome_bluetooth_with">kwa hiyo: kila jozi inarekodiwa tangu wakati ya kuunganisha, bila kitu kinachoendelea na bila kitu kumbuka kubofya.</string>
    <string name="welcome_bluetooth_without">bila hiyo: hakuna makinanzi ya bluetooth yanarekodiwa. sehemu nyingine ya programu bado inafanya kazi, na unaweza kuiruhusa baadaye katika mipango ya simu ya android.</string>
    <string name="welcome_notifications_title">onyo</string>
    <string name="welcome_notifications_why">ufuataji wa kina unaendesha huduma ndogo ya nyuma, na android inahitaji programu yoyote inayofanya hiyo kuhifadhi onyo linaloona wakati inafanya.</string>
    <string name="welcome_notifications_with">kwa hiyo: onyo linaonyesha nini kinarekodiwa sasa sasa, ni ishara tu ya ufuataji wa kina unaofanya kazi.</string>
    <string name="welcome_notifications_without">bila hiyo: ufuataji wa kina bado unaendesha na bado inaandika. android tu haitaonyesha onyo lake.</string>
    <string name="hibernation_title">endelea kuhesabu ilipojaliwa</string>
    <string name="hibernation_body">android inasimamisha programu ambazo zimefunguliwa kwa miezi michache na kunyima ruhusa zake, ambayo ingeacha ylih haijarekodia chochote hadi ujifungulie upya. kusahauliwa ndicho programu hii inafanya, kwa hiyo inastahili kuwa off sasa.</string>
