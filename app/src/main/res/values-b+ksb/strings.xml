    <string name="settings_export">uchapaji json</string>
    <string name="settings_import">kuingiza</string>
    <string name="settings_import_warning">kuingiza kunabadilisha kila kitu ambacho kumesimu kwa sasa.</string>
    <string name="settings_troubleshooting">kutatua matatizo</string>
    <string name="settings_battery_body">ikiwa kila mara huacha kurekodi, angalia kwamba ylih hako ndani ya kuokoa betri — programu ambayo imesimamishwa kwa nguvu haipati ujumbe wa kuunganisha tena hadi itafunguliwa.</string>
    <string name="settings_battery_button">mipango ya betri</string>
    <string name="settings_battery_path">mipango → programu → ylih → betri → haizuiliwe.</string>
    <string name="settings_hibernation_body">ikiwa ylih haifungui kwa miezi michache, android inaisimamisha na kunyima ruhusa zake, na chochote haikirekodi tena hadi ujifungulie. kuizima ndio inasaidia jozi kuhesabu kwa msimu usiwezi kufikiri programu.</string>
    <string name="settings_hibernation_on">android inaweza kusimamisha ylih.</string>
    <string name="settings_hibernation_off">ylih hako ndani na inaendelea kurekodi.</string>
    <string name="settings_hibernation_button">mipango ya programu isiyotumika</string>
    <string name="settings_about">kuhusu</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — saa za makinanzi, zinasimiwa hapo na milele.</string>
    <string name="settings_import_confirm_title">badilisha data yote?</string>
    <string name="settings_import_confirm_body">kuingiza hii nyumba ifuta kila simu, jozi na kila mara inataka sasa.</string>

