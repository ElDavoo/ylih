    <!-- Powiadomienie -->
    <string name="channel_tracking">śledzenie słuchawek</string>
    <string name="channel_tracking_description">widoczne, gdy ylih obserwuje słuchawki przewodowe i odtwarzanie. android nie dostarcza zdarzeń podłączenia jacka aplikacjom, które nie działają.</string>
    <string name="notification_title">śledzenie czasu w słuchawkach</string>
    <string name="notification_starting">uruchamianie…</string>
    <string name="notification_idle">oczekiwanie na słuchawki</string>
    <!-- "połączone" is the same neuter-singular / non-masculine-personal-plural adjective form for
         every count, so all four Polish categories carry identical text on purpose. -->
    <plurals name="notification_active">
        <item quantity="one">%1$d połączone · %2$s</item>
        <item quantity="few">%1$d połączone · %2$s</item>
        <item quantity="many">%1$d połączone · %2$s</item>
        <item quantity="other">%1$d połączone · %2$s</item>
    </plurals>
