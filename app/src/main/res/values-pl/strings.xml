    <string name="pair_retire_title">wycofaj tę parę</string>
    <string name="pair_retire_label">powód (zepsuta, sprzedana, zgubiona…)</string>
    <string name="pair_retire_confirm">wycofaj</string>
    <string name="pair_retire_supporting">suma zostaje tu zamrożona. ponowne połączenie tego samego urządzenia rozpoczyna nową parę od zera.</string>
    <string name="pair_price_title">zapłacona cena</string>
    <string name="pair_price_label">kwota (pełne jednostki)</string>
    <string name="pair_price_supporting">używane do wyliczenia kosztu za godzinę.</string>
    <string name="pair_delete_title">usunąć tę parę?</string>
    <string name="pair_delete_body">wszystkie zarejestrowane dla niej sesje też zostaną usunięte. tej operacji nie można cofnąć.</string>

