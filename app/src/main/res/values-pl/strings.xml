<?xml version="1.0" encoding="utf-8"?>
<!--
  Polish. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources>
    <string name="app_title">ylih - twoje życie w słuchawkach</string>

    <!-- Nawigacja -->
    <string name="nav_headphones">słuchawki</string>
    <string name="nav_stats">statystyki</string>
    <string name="nav_settings">ustawienia</string>

    <!-- Typy urządzeń -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">przewodowe</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">nieznane</string>

    <!-- Pierwsze uruchomienie -->
    <string name="welcome_title">witaj w ylih</string>
    <string name="welcome_intro">ylih zapisuje, jak długo każda para słuchawek pozostaje połączona, żeby za lata można było odpowiedzieć na jedyne pytanie, które naprawdę liczy się w przypadku pary słuchawek: ile godzin wytrzymała?</string>
    <string name="welcome_point_auto_title">połącz i zapomnij</string>
    <string name="welcome_point_auto_body">słuchawki bluetooth są rejestrowane same, od chwili połączenia. nic nie musi działać w tle.</string>
    <string name="welcome_point_lifetime_title">jedna para, jedno życie</string>
    <string name="welcome_point_lifetime_body">kiedy para umiera, wycofaj ją: jej suma zostaje tam zamrożona, a kolejna para tych samych słuchawek zaczyna znów od zera.</string>
    <string name="welcome_point_detailed_title">przewodowe i odtwarzanie</string>
    <string name="welcome_point_detailed_body">szczegółowe śledzenie, w ustawieniach, dodaje słuchawki przewodowe i mierzy, ile z tego czasu faktycznie trwało odtwarzanie.</string>
    <string name="welcome_privacy">wszystko zostaje na tym telefonie. nie ma żadnego konta, a aplikacja nie ma uprawnienia dostępu do internetu.</string>
    <string name="welcome_start">zaczynajmy</string>

    <!-- Lista słuchawek -->
    <string name="devices_in_use">w użyciu</string>
    <string name="devices_retired">wycofane</string>
    <string name="devices_empty_title">jeszcze brak słuchawek</string>
    <string name="devices_empty_body">połącz parę słuchawek bluetooth, a pojawią się tutaj. słuchawki przewodowe wymagają szczegółowego śledzenia, w ustawieniach.</string>
    <string name="devices_generation">para nr %1$d</string>
