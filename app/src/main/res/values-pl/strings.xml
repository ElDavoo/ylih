    <!-- Ustawienia -->
    <string name="settings_tracking">śledzenie</string>
    <string name="settings_detailed_title">szczegółowe śledzenie</string>
    <string name="settings_detailed_body">dodaje słuchawki przewodowe i czas odtwarzania. android zgłasza zdarzenia podłączenia jacka tylko działającej aplikacji, dlatego utrzymuje to cichą notyfikację na pasku. bluetooth jest śledzony tak czy inaczej.</string>
    <string name="settings_detailed_unavailable">niedostępne, dopóki nie przyznasz dostępu do bluetooth: ta wersja deklaruje tylko typ usługi connectedDevice, który android 14+ wiąże z uprawnieniem bluetooth.</string>
    <string name="settings_devices">urządzenia</string>
    <string name="settings_devices_body">odznacz wszystko, co nie jest słuchawkami — np. radio samochodowe lub głośnik — aby przestać to rejestrować.</string>
    <string name="settings_device_subtitle">%1$s · pierwszy raz %2$s</string>
    <string name="settings_data">dane</string>
    <string name="settings_export">eksportuj json</string>
    <string name="settings_import">importuj</string>
    <string name="settings_import_warning">import zastępuje wszystko, co jest obecnie zapisane.</string>
    <string name="settings_troubleshooting">rozwiązywanie problemów</string>
    <string name="settings_battery_body">jeśli sesje przestaną być rejestrowane, sprawdź, czy ylih jest wyłączony z optymalizacji baterii — aplikacja wymuszenie zatrzymana nigdy więcej nie otrzyma powiadomień o połączeniu, dopóki nie zostanie otwarta.</string>
    <string name="settings_battery_button">ustawienia baterii</string>
    <string name="settings_battery_path">ustawienia → aplikacje → ylih → bateria → brak ograniczeń.</string>
    <string name="settings_about">o aplikacji</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — godziny w słuchawkach, przechowywane lokalnie i na zawsze.</string>
    <string name="settings_import_confirm_title">zastąpić wszystkie dane?</string>
    <string name="settings_import_confirm_body">import tej kopii zapasowej usuwa każde urządzenie, parę i sesję zapisane obecnie.</string>

