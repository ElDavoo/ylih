    <string name="settings_detailed_title">ವಿವರವಾದ ಟ್ರ್ಯಾಕಿಂಗ್</string>
    <string name="settings_detailed_body">ತಂತ್ರದ ಹೆಡ್ಫೋನ್ ಮತ್ತು ಪ್ಲೇಬ್ಯಾಕ್ ಸಮಯ ಸೇರಿಸುತ್ತದೆ. android ಕೆಲಸ ಅಪ್ಲಿಕೇಶನ ಮಾತ್ರ ತಂತ್ರದ ಪ್ಲಗ್ ಇವೆಂಟ್ ರೆಪೋರ್ಟ ಸಿ ಅದು ಮಌನ ಸೂಚನೆ ಛಾಯೆ ಇದು ಇಡುತ್ತದೆ. ಬ್ಲೂಟೂತ್ ಯಾವುದೇ ವಿಧಾನ ಟ್ರ್ಯಾಕ ಪ್ರಭಾವಿತ.</string>
    <string name="settings_detailed_unavailable">ಬ್ಲೂಟೂತ್ ಪ್ರವೇಶ ಅನುಮತಿ ತನಕ ಲಭ್ಯವಿಲ್ಲ: ಈ ಬಿಲ್ಡ್ connectedDevice ಸೇವೆ ಪ್ರಕಾರ ಘೋಷಿತ ಮಾತ್ರ ಏಕೆಂದರೆ android 14+ ಬ್ಲೂಟೂತ್ ಪ್ರವೇಶ ರಾಯಲಟಿ.</string>
    <string name="settings_playback_only_title">ಪ್ಲೇಬ್ಯಾಕ್ ಮಾತ್ರ ಎಣಿಸಿ</string>
