    <string name="settings_language_system">系统语言</string>
    <string name="settings_devices">设备</string>
    <string name="settings_devices_body">取消选中不是耳机的任何东西 — 汽车音响或扬声器 — 以停止记录它。</string>
    <string name="settings_device_subtitle">%1$s · 首次看到 %2$s</string>
