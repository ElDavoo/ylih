    <string name="welcome_title">kipajoq ylih</string>
    <string name="welcome_intro">ylih pingasutaq allagua nukappiaaq malilisui, tamarmilugo uugujoq takunngassaaq allattoq misigissuni: kigutaa sapaappoq?</string>
    <string name="welcome_point_auto_title">tapatik ippumuk</string>
    <string name="welcome_point_auto_body">bluetooth nukappiaaq ilortariaqartuq asillalerniq, tamarmik angijorniq. pium akutukkunnissutaqaaq.</string>
    <string name="welcome_point_lifetime_title">allagua ataaq, inugujoq ataaq</string>
    <string name="welcome_point_lifetime_body">allagua nukappiaaq nutaa marluk ilunnersuu, ikinnik allajorpoq: tamassumalu malilisui pinngortamarsaraq, allagua pisaraq nukappiaaq malilisui sapparilira nuliani.</string>
    <string name="welcome_point_detailed_title">misile tamanittuq</string>
    <string name="welcome_point_detailed_body">ilortariassutaq annertuugujoq, pinngutat-imi, misile nukappiaaq malmik ilaruguleq asarpa tamanittuq.</string>
    <string name="welcome_privacy">tamassumalu tamati pium inugujoq-imi allattarpoq. alakkaartuq pijariaqtunngillaq, ylih-imi internet-ataaseq pijariaqtunngillaq.</string>
    <string name="welcome_start">ajoqiliq</string>
    <string name="welcome_next">ajoqinn</string>
    <string name="welcome_allow">ajaanngineq</string>
    <string name="welcome_step">ulloq %1$d / %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth ikkinnguttaq</string>
    <string name="welcome_bluetooth_why">android qitirneq app-imut anersaasut bluetooth-inut immikkut, ikinnik ataanilinnut, app-am bluetooth ikkinnguttaq ataanilugujoq. siullerni ylih nukappiaaq qallaligunilaq qanuja-stereotunik, ikinnik allagua nukappiaaq misigissuni.</string>
    <string name="welcome_bluetooth_with">tamannalu: allagua nukappiaaq immiksut atorta, tamassumalu angijorniq, pium akutukkunnissutaqaaq.</string>
    <string name="welcome_bluetooth_without">tamannaalaq: bluetooth nukappiaaq ilortariaqartuq ataallaq. ylih-imi ataatsimut atorpoq, ikinnik android-imi app-imi pinngutat-imi ajaanngineq.</string>
    <string name="welcome_notifications_title">notifications</string>
    <string name="welcome_notifications_why">detailed tracking runs a small background service, and android requires any app doing that to keep a notification visible while it does.</string>
    <string name="welcome_notifications_with">with it: the notification shows what is being recorded right now, which is the only sign detailed tracking is alive.</string>
    <string name="welcome_notifications_without">without it: detailed tracking still runs and still records. android just will not show its notification.</string>
    <string name="hibernation_title">kigut ippumuk aqviliorsugut</string>
    <string name="hibernation_body">android app-ik tunngasugut qessutsimut tupikkasoq sappaaq taassumagit ikkinnguttat, ylih ilortariaqarpoq pium ajoqilinnilaq. taassumagit aqviliorsunngillat taannalu ilaa app-ima, tamannalu unangasilinnaleq.</string>
