    <string name="settings_language_system">系统语言</string>
    <string name="settings_devices">设备</string>
    <string name="settings_devices_body">取消勾选不是耳机的设备——比如车载音响或音箱——即可停止记录它。</string>
    <string name="settings_device_subtitle">%1$s · 首次出现于 %2$s</string>
