    <string name="welcome_title">tukamusyani ku ylih</string>
    <string name="welcome_intro">ylih ewandiika emiserikale gya ekigazi, awo amakanya eri mbu nogyendereze ekigazi kyokka: saawa zi li wankati?</string>
    <string name="welcome_point_auto_title">kwata ne okukora</string>
    <string name="welcome_point_auto_body">bluetooth ekigazi kyokyokakyokyo na okukora awo gitumine, awatali kyona ekigazi ekyo.</string>
    <string name="welcome_point_lifetime_title">ekigazi kimu, obwire bumu</string>
    <string name="welcome_point_lifetime_body">ekigazi kyokunama, kitooke: omweri gwako gugyesigira awo ekigazi kyo nexinkosi n’okugyara ku ziro.</string>
    <string name="welcome_point_detailed_title">wired ne playback</string>
    <string name="welcome_point_detailed_body">okukora okwo okweminsi, mu emizira, kwongera ekigazi ekya wired ne okukubala kabiri ey’omweri.</string>
    <string name="welcome_privacy">kyona kiryamu mu kifuuni. awatali account, ne app etasobeza internet.</string>
    <string name="welcome_start">tangira</string>
    <string name="welcome_next">kyokya</string>
    <string name="welcome_allow">yinyange</string>
    <string name="welcome_step">ekyawandika %1$d eri %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth access</string>
    <string name="welcome_bluetooth_why">android yonaakubala app nti bluetooth device eri yikwata, ne nge bala rye, aba app eweteekeddwa bluetooth access. kino kye ylih eyigatta ekigazi eri stereo ya gadi, ne nge igamba ekigazi ki kimu.</string>
    <string name="welcome_bluetooth_with">ne kino: ekigazi kyokyokakyokyo nakukwata, awatali kyona ekigazi ekyo.</string>
    <string name="welcome_bluetooth_without">mpakira kino: bluetooth ekigazi takyonakubaalwa. app yonna etambya, ne okuwera akakira mu android app settings.</string>
    <string name="welcome_notifications_title">notifications</string>
    <string name="welcome_notifications_why">okukora okwo okweminsi kubika service entono, android eyetaaga app yonna okukubika notification wansi.</string>
    <string name="welcome_notifications_with">ne kino: notification yonakira nti kyona ekyo kyakubaalwa, kye kyo kyekyo ekigazi kyokuniikiriza.</string>
    <string name="welcome_notifications_without">mpakira kino: okukora okwo okweminsi kubika ne gisobya, android taginaakubika notification.</string>
    <string name="hibernation_title">ku kubala akamwe okukora</string>
    <string name="hibernation_body">android yoomusonyeza app emezi amakumi, yogera emitwe, awo yoyewedde emitwe gyayo, awo akakira takyabaalwa kabiri. okusonyezibwa kino ndikino app, kye kyo kyeetaaga okwetookyako.</string>
