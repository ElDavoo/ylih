    <string name="settings_tracking">tracking</string>
    <string name="settings_detailed_title">detailed tracking</string>
    <string name="settings_detailed_body">nikwongyera amatu g’ewaya n’obwire bw’okucurika. android neetegyeza app erikukora yonka aha kuta waya, n’ahabw’ekyo eki nikibiika ekimanyiso ekitarikugamba. bluetooth nikuratirwa buzima.</string>
    <string name="settings_detailed_unavailable">tikirikubaasa okuhitsya obu bluetooth erikuheebwa: obwombeki obu nibworeka connectedDevice yonka, ei android 14+ arikuhikiriza n’obushoboorozi bwa bluetooth.</string>
    <string name="settings_playback_only_title">bara okucurika kwonka</string>
    <string name="settings_playback_only_body">emibaro neebara obwire obu amaziina gaabaire nigacurika buzima omu mwanya gw’obwire bw’okuhikiriza. obwire bwonka obuhandiikirwe n’okukuratira okwijwire nikwo bwapimire okucurika; obundi nibwikirizibwa aheeru.</string>
    <string name="settings_language">language</string>
    <string name="settings_language_system">system language</string>
    <string name="settings_devices">devices</string>
    <string name="settings_devices_body">ihaho akamanyiso aha kintu kyona ekitari amatu — redio y’emotoka nari spiika — kubaasa kurekyera okugihandiika.</string>
    <string name="settings_device_subtitle">%1$s · ekyareebwa okubanza %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">export json</string>
    <string name="settings_import">import</string>
    <string name="settings_import_warning">okutaahamu nikuhindura byona ebiribiikirwe hati.</string>
    <string name="settings_troubleshooting">troubleshooting</string>
    <string name="settings_battery_body">ku obwire bwarekyera kuhandiikwa, reeba ku ylih arikwetegyerezibwa kuruga omu kuhwenkyereza batteri — app erikwemerezibwa n’amaani terikugaruka kutunga amakuru g’okuhikiriza okuhitsya obu erikwiguurwa.</string>
    <string name="settings_battery_button">entebeekanisa ya batteri</string>
    <string name="settings_battery_path">entebeekanisa → app → ylih → batteri → hatariho kikomo.</string>
    <string name="settings_hibernation_body">ku ylih atarikwiguurwa emyezi mikye, android naamwemereza kandi naamwiha obushoboorozi bwe, kandi tihariho ekirikuhandiikwa okuhitsya obu orikumwiguura. okuzimya ekyo nikyo kirikuhikiriza obubiri kuguma nibubara omu bwire bwona obu otarikuteekateeka aha app.</string>
    <string name="settings_hibernation_on">android naabaasa kwemereza ylih.</string>
    <string name="settings_hibernation_off">ylih ayetegyerezibwe kandi nagumizamu kuhandiika.</string>
    <string name="settings_hibernation_button">entebeekanisa y’app ezitarikukoresibwa</string>
    <string name="settings_about">about</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — eshaaha z’amatu, nizibiikwa hanu n’ebiro byona.</string>
    <string name="settings_import_confirm_title">hindura amakuru goona?</string>
    <string name="settings_import_confirm_body">okutaahamu bakapu egi nikushazya buri kintu, obubiri n’akaanya ebiribiikirwe hati.</string>

