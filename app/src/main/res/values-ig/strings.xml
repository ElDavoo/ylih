    <string name="welcome_title">nnọọ na ylih</string>
    <string name="welcome_intro">ylih na-edekọ oge ndị isi obia ka ọ dị, ka mgbe ọtụtụ afọ gasịrị, ị nwee ike ịza ihe naanị a dị mkpa maka otu: tupu ole ka ha rụrụ?</string>
    <string name="welcome_point_auto_title">jikọ wee chefụ</string>
    <string name="welcome_point_auto_body">a na-edekọ isi obia bluetooth n’ụzọ ha nwere, site n’oge ha jikọchara. ọ dịghị ihe ọ bụ na a gaara ikwàmkwa.</string>
    <string name="welcome_point_lifetime_title">otu peeà, otu oge ịnụ ndụ</string>
    <string name="welcome_point_lifetime_body">mgbe peeà ndị a nwụrụ, kwado ya: mkpọkọ ya ka a gbụchiri ebe ahụ ma peeà ọzọ nke igu isi ọzọ na-amalite ọzọ site na mkpọkọ ụfọdụ.</string>
    <string name="welcome_point_detailed_title">ụsọ na ụda omume</string>
    <string name="welcome_point_detailed_body">nhazi ihe omume anya, na ntọ ụlọ, na-agbakwu ụsọ isi obia ma na-atụ anya oge ole kara mma ụda na-eme.</string>
    <string name="welcome_privacy">ihe niile ka dị na fọn a. ọ dịghị akaụntụ ọbụla, app a enweghịkwa ikike ntanetị.</string>
    <string name="welcome_start">bido</string>
    <string name="welcome_next">ọzọ</string>
    <string name="welcome_allow">kwere</string>
    <string name="welcome_step">usoro %1$d nke %2$d</string>
    <string name="welcome_bluetooth_title">ịnụ maka bluetooth</string>
    <string name="welcome_bluetooth_why">android naanị na-agwa app ihe ngosi bluetooth jikọchara, na aha ya, ma app nwere ịnụ bluetooth. ọ bụ otu ylih si na-esikarị otu isi obia na stereo ụgbọ, na otu o si maara otu peeà n’ihu nke ibe ya.</string>
    <string name="welcome_bluetooth_with">na ya: a na-edekọ peeà ọ bụla site n’oge ọ jikọchara, na ọ dịghị ọ bụ ihe ka a ikwàmkwa na ọ dịghị etu ọ bụ na a gaara ibupu.</string>
    <string name="welcome_bluetooth_without">na-enweghị ya: a naghị edekọ isi obia bluetooth ọbụla. ike ndị ọzọ nke app ka na-arụ ọrụ, ma ị nwere ike ịkwanye ya mgbe emechaa na nhazi app nke android.</string>
    <string name="welcome_notifications_title">ọkwa ama</string>
    <string name="welcome_notifications_why">nhazi ihe omume anya na-agba ọrụ nkịtị mbutụ, na android na-achọ ka app ọ bụla na-eme nke a jide ọkwa ama nke kpachapụ mgbe ọ na-eme.</string>
    <string name="welcome_notifications_with">na ya: ọkwa ama na-egosi ihe a na-edekọ ugbu a, na ọ bụ naanị ihe ngosi nhazi ihe omume anya dị ndụ.</string>
    <string name="welcome_notifications_without">na-enweghị ya: nhazi ihe omume anya ka na-agba ọrụ ma ka na-edekọ. android naanị na-agaghị egosi ọkwa ama ya.</string>
    <string name="hibernation_title">gụọ na ọ tụrụ gị afụ</string>
    <string name="hibernation_body">android na-akwụsị app ndị na-adịghị meghe ọtụtụ ọnwa ma na-ewere ngwugwu ha azụ, nke ga-echa ylih edekọ ihe ọbụla ruo n’oge ị meghere ya ọzọ. ichefụ bụ ihe naanị a app a bụ maka, yabụ ọ dị mkpa ịtụghachi ya ugbu a.</string>
    <string name="action_not_now">ọbụ taa mba</string>

