    <string name="settings_hibernation_body">ma ylih adịghị emeghe ọtụtụ ọnwa, android na-akwụsị ya ma na-ewere ngwugwu ya azụ, ma ihe ọbụla a na-edekọ ọzọ ruo mgbe ị meghere ya. ịtụghachi ya bụ ihe na-eme ka peeà nọgide na-agụ n’oge gị na-echefụ ngwa.</string>
