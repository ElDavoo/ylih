    <string name="settings_detailed_title">nhazi ihe omume anya akaụkwụ</string>
    <string name="settings_detailed_body">na-agbakwu ụsọ isi obia ma oge omume. android naanị na-agwa app ihe omume ụsọ pụtụ na ọrụ nke na-agba, yabụ nke a na-ejide ọkwa ama nke nwere ike ime ihe na-agbagojiri. bluetooth ka a nhazi ma o ziri ezi.</string>
    <string name="settings_detailed_unavailable">o nweghị mma ruo ịnụ bluetooth a kwere: isigwe a na-akọ naanị ụdị ọrụ jikọchara ngosi, nke android 14+ na-ejikọ n’ịnụ bluetooth.</string>
