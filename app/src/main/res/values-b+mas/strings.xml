    <string name="welcome_title">keipot te ylih</string>
    <string name="welcome_intro">ylih egilu enkata natii nkiyiaa are neirurunye, amu peesai ilarin kumok imeeta ainepu enkiteng nabo naishoo: kaji isaai naaramat?</string>
    <string name="welcome_point_auto_title">irurunye neiyiolou</string>
    <string name="welcome_point_auto_body">nkiyiaa e bluetooth negilu ninche oshi, te nkata naairurunye. metii entoki naimu neishakinoto.</string>
    <string name="welcome_point_lifetime_title">nkiyiaa nabo, enkishui nabo</string>
    <string name="welcome_point_lifetime_body">peeitu nkiyiaa netua, itoroshi: enkiropiyian enye keitoroshi te nena, nenkiyiaa naipirta e nkiyiaa neitu keitayu te nkidong.</string>
    <string name="welcome_point_detailed_title">waya o enkiyioo</string>
    <string name="welcome_point_detailed_body">enkilepata sapuk, te isirmet, keitayu nkiyiaa e waya neitobira enkata natii keiyioo te sii.</string>
    <string name="welcome_privacy">kulie ntokitin keitoroshi te simu ena. metii akaunt, neitu app eata enkirroret e intaneti.</string>
    <string name="welcome_start">itayu</string>
    <string name="welcome_next">naipirta</string>
    <string name="welcome_allow">iyiolou</string>
    <string name="welcome_step">enkitejo %1$d te %2$d</string>
    <string name="welcome_bluetooth_title">enkirroret e bluetooth</string>
    <string name="welcome_bluetooth_why">android keitejo app entoki e bluetooth naairurunye, o enkarna enye, peeitu app eata enkirroret e bluetooth. ena niji ylih keiyiolou nkiyiaa te redio e motoka, neiyiolou nkiyiaa nabo te naipirta.</string>
    <string name="welcome_bluetooth_with">te ninye: nkiyiaa pooki negilu te nkata naairurunye, metii entoki naishakinoto neitu entoki naitayu.</string>
    <string name="welcome_bluetooth_without">metii ninye: metii nkiyiaa e bluetooth naagilu. kulie ntokitin e app keishakino, neitodolu inkitejo te isirmet e app e android.</string>
    <string name="welcome_notifications_title">inkitejo</string>
    <string name="welcome_notifications_why">enkilepata sapuk keishakino enkishakino sidai te nkop, nenandroid keiyiolou app pooki naashakino ena keitoroshi enkitejo naadolu te nkata ena.</string>
    <string name="welcome_notifications_with">te ninche: enkitejo keitodolu entoki naagilu tenkata ena, ena niji enkitejo nabo naitejo enkilepata sapuk keishui.</string>
    <string name="welcome_notifications_without">metii ninche: enkilepata sapuk keishakino neigilu. android meitodolu enkitejo enye ake.</string>
    <string name="hibernation_title">keitoropiyian peeitu iyiolou</string>
    <string name="hibernation_body">android keitoroshi app naitu keirrag te lapaitin kumok neitayu inkirroret enye, ena naitoroshi ylih meigilu entoki te peeitu irrag aare. enkiyiolou niji enkiteng e app ena, amu keitodolu itoroshi ena tenkata ena.</string>
