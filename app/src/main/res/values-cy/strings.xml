    <string name="settings_import">mewnforio</string>
    <string name="settings_import_warning">mae mewnforio yn disodli popeth sy’n cael ei storio ar hyn o bryd.</string>
    <string name="settings_troubleshooting">datrys problemau</string>
    <string name="settings_battery_body">os bydd sesiynau yn rhoi’r gorau i gael eu cofnodi, gwiriwch fod ylih yn eithriad o optimeiddio batri — app sydd wedi’i orfodi i stopio byth yn derbyn darllediadau cysylltiad eto nes ei agor.</string>
    <string name="settings_battery_button">gosodiadau batri</string>
    <string name="settings_battery_path">gosodiadau → apiau → ylih → batri → heb gyfyngiad.</string>
    <string name="settings_hibernation_body">os na chaiff ylih ei hagor am ychydig fisoedd, mae android yn ei hoedi ac yn cymryd ei chaniatâd yn ôl, ac ni chofnodir dim eto nes i chi ei hagor. diffodd hynny sy’n gadael i bâr ddal i gyfrif drwy dymor pan nad ydych byth yn meddwl am yr ap.</string>
    <string name="settings_hibernation_on">gall android oedi ylih.</string>
    <string name="settings_hibernation_off">mae ylih wedi’i heithrio ac yn dal i gofnodi.</string>
    <string name="settings_hibernation_button">gosodiadau apiau nas defnyddir</string>
    <string name="settings_about">ynghylch</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — oriau clustffonau, wedi’u cadw’n lleol ac am byth.</string>
    <string name="settings_import_confirm_title">disodli’r holl ddata?</string>
    <string name="settings_import_confirm_body">mae mewnforio’r cefnwp hwn yn dileu pob dyfais, pâr a sesiwn wedi’u storio nawr.</string>
