    <string name="welcome_title">tuwe iyókhiyah ylih ekta</string>
    <string name="welcome_intro">ylih he naptewictakpe wahpáya owáshi takú kikhúwate hécha, hecél waná omákahe makóche kiksúyapi kin hé wachíŋ itanwichʻáyapi kiŋ: opáwhte oyáshi he kená tahináphe kin?</string>
    <string name="welcome_point_auto_title">ozuya qa amniyeya</string>
    <string name="welcome_point_auto_body">naptewictakpe bluetooth kin iyokhíyapi kiŋ ozúyapi kin hecekhán, iš etáŋhan ozúyapi kiŋ. tóksa wachíŋ napʻi yešte kiŋ héc wachʻítʻeya.</string>
    <string name="welcome_point_lifetime_title">napé kiŋ wachʻítʻe, wosátami kiŋ wachʻítʻe</string>
    <string name="welcome_point_lifetime_body">napé kiŋ he takhísni kiŋ, kasálde: tawóhta kiŋ he yélo écʼa qa napé kiŋ ékta napé waŋ pʻítʻe ozúyapi kin sunka kiŋ hecekhán.</string>
    <string name="welcome_point_detailed_title">psín oyuspéya qa niyowápi</string>
    <string name="welcome_point_detailed_body">owótakhta óspeya kiŋ oyúza kin ekta, psín oyuspéya qa niyowápi owáshi owaŋkó hiyúyapi kiŋ oyúzi oyuŋkpé kin.</string>
    <string name="welcome_privacy">niš ówaŋkʻu kin oháŋkʻa kiŋ aŋke. oyáte kiŋ waŋ wachʻítʻe, qa okodákidata kiŋ itanwichʻáyapi waŋ yeshte wachʻítʻe.</string>
    <string name="welcome_start">ozúya</string>
    <string name="welcome_next">hokšína waŋ</string>
    <string name="welcome_allow">iyówahi</string>
    <string name="welcome_step">%1$d kiŋ %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth iyówahi kiŋ</string>
    <string name="welcome_bluetooth_why">android ghe túwa kiŋ oyáte kiŋ waŋ wóta bluetooth ozúyapi kiŋ qa tí kin sétaksi he, oyáte kiŋ heŋ bluetooth iyówahi kiŋ yuhá wachʻítʻe. he ylih wopʻitʻé wáŋ naptewictakpe kiŋ wachʻítʻe qa wachʻítʻe napé kiŋ naglekcéda.</string>
    <string name="welcome_bluetooth_with">he yukhá: napé oyáŋste wahóŋpi kiŋ ozúyapi kiŋ hecekhán, tóksa wachʻíŋ napʻi yešte kiŋ héc wachʻítʻe.</string>
    <string name="welcome_bluetooth_without">he yušte: bluetooth naptewictakpe waŋ oyáŋste wahóŋpi kiŋ wachʻítʻe. oyáte kiŋ hecʼón waná waɣá, qa oyáte waŋ naglekcéda.</string>
    <string name="welcome_notifications_title">owáhonye kiŋ</string>
    <string name="welcome_notifications_why">owótakhta óspeya kiŋ oyáte kiŋ waŋ okhódukta hin kiŋ kiksúye, qa android túwa kiŋ oyáte kiŋ he kʻóhaŋ owaŋkʻu itanwichʻáyapi kiŋ itamčʻihpaye ehʻeya.</string>
    <string name="welcome_notifications_with">he yukhá: owáhonye kiŋ oyáŋste kʻóta táwa tunʻékta, he túwa wopʻitʻé owótakhta óspeya kiŋ napʻi.</string>
    <string name="welcome_notifications_without">he yušte: owótakhta óspeya kiŋ waná waɣá qa oyáŋste tunʻékta. android ghe owáhonye kiŋ itamčʻihpaye wachʻítʻe.</string>
    <string name="hibernation_title">owótakhta éyaš amniyeya ekhó</string>
    <string name="hibernation_body">android oyáte kiŋ wósápe tokhíhna wazúya eyáku kta qa iyówahi kiŋ hduhe kta, oyáte ylih oyáŋste tunʻékta ekhó wazúya wapʻí kiŋ. amniyeya oyáte kiŋ he wópʼe wáŋ ylih oyáte, he ghe takúni iyoksiža etáŋhan iyehákhpaye.</string>
