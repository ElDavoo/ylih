    <string name="settings_import">import</string>
    <string name="settings_import_warning">importing replaces everything currently stored.</string>
    <string name="settings_troubleshooting">troubleshooting</string>
    <string name="settings_battery_body">if sessions stop being recorded, check that ylih is exempt from battery optimisation — an app that has been force-stopped never receives connection broadcasts again until it is opened.</string>
    <string name="settings_battery_button">battery settings</string>
    <string name="settings_battery_path">settings → apps → ylih → battery → unrestricted.</string>
    <string name="settings_hibernation_body">if ylih goes unopened for a few months, android pauses it and takes its permissions back, and nothing is recorded again until you open it. turning that off is what lets a pair keep counting through a season you never think about the app.</string>
    <string name="settings_hibernation_on">android may pause ylih.</string>
    <string name="settings_hibernation_off">ylih is exempt and keeps recording.</string>
    <string name="settings_hibernation_button">unused app settings</string>
