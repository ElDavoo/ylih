    <string name="settings_troubleshooting">समस्या समाधान</string>
    <string name="settings_battery_body">जँ सत्र अभिलेखित होएब बन्न भऽ जाए तँ देखू जे ylih बैटरी अनुकूलनसँ मुक्त अछि की नहि — जबरदस्ती रोकल ऐपकेँ फेर खोलबा धरि जुड़बाक सूचना कहियो नहि भेटैत अछि।</string>
    <string name="settings_battery_button">बैटरी सेटिंग</string>
    <string name="settings_battery_path">सेटिंग → ऐप → ylih → बैटरी → बिना रोक-टोक।</string>
    <string name="settings_hibernation_body">जँ ylih किछु मास धरि नहि खुजल तँ android ओकरा रोकि दैत अछि आ ओकर अनुमति वापस लऽ लैत अछि, आ अहाँक खोलबा धरि किछु अभिलेखित नहि होइत। ओकरा बन्न कऽ देनाइ यैह अछि जे कोनो जोड़ीकेँ ओहि पूरा मौसमभरि गनैत रहऽ दैत अछि जाहिमे अहाँ ऐपक बारेमे सोचबो नहि करैत छी।</string>
    <string name="settings_hibernation_on">android ylih केँ रोकि सकैत अछि।</string>
