    <string name="settings_devices">यंत्र</string>
    <string name="settings_devices_body">जे किछु हेडफोन नहि अछि — गाड़ीक रेडियो वा स्पीकर — ओकर निशान हटा दिअ जाहिसँ ओ अभिलेखित नहि हो।</string>
