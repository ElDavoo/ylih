    <string name="settings_language_system">rũthiomi rwa sistimu</string>
    <string name="settings_devices">indo</string>
    <string name="settings_devices_body">eheria rũũri kuuma kĩndũ o gĩothe gĩtarĩ iria bia gũthikĩria — redio ya ngari kana kĩgambia — nĩgetha gĩtige kwandĩkwo.</string>
