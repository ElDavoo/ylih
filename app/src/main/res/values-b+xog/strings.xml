    <string name="settings_hibernation_body">ylih eye ekowumbulire omwezi oguggufu, android ekoma era eguwa layisensi, okukola tekukolebwako okukutuuka bw’oyigala. okukoma kuno ekigendererwamu ensawo okubala mu nyinza enzikirira okugigala.</string>
