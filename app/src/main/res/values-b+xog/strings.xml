    <string name="welcome_title">karibu ku ylih</string>
    <string name="welcome_intro">ylih ebalirira okamala gw’ensawo minwa gye nkwata, awo emakumi g’emyaka ogiyinza okuba wansi okunoza okukola: minwa egyi osinga okubeekawo ssente?</string>
    <string name="welcome_point_auto_title">kwataganya okukoma</string>
    <string name="welcome_point_auto_body">minwa gy’ebluutusi gikoma okulembedde, buli kiseera gy’ensobya. tewali kintu kyeyambisaamu.</string>
    <string name="welcome_point_lifetime_title">ensewo emu, bulamu bumu</string>
    <string name="welcome_point_lifetime_body">ensawo gy’okufa, gyigire: ssente yaayo ez’omalako awo, n’ensawo empya y’omuntu omu etandika okuva zeero.</string>
    <string name="welcome_point_detailed_title">enkwali n’okukubaganya</string>
    <string name="welcome_point_detailed_body">okuteekawo okw’omulala, mu okuteekawo, kuweke enkwali n’okukalkulaatimu okukaakatifu.</string>
    <string name="welcome_privacy">buli kintu kigigira wamu mu simu yo. tewali akawunti, era app etakozesa intaaneti.</string>
    <string name="welcome_start">tandika</string>
    <string name="welcome_next">ekigendererwamu</string>
