    <string name="welcome_step">entikko %1$d ya %2$d</string>
    <string name="welcome_bluetooth_title">okukoma ku bluetooth</string>
    <string name="welcome_bluetooth_why">android ettegeeza pulogiramu se nti bluetooth device ya nkwata, n’erinnya lyo, singa pulogiramu erina okukoma ku bluetooth. gwe ylih eyigwawo minwa okuva ku simu y’omulimu, n’eyigwawo ensewo emu okuva ku nzira ennya.</string>
    <string name="welcome_bluetooth_with">ne eno: ensewo ey’omuntu yomu ecoweka okulembedde buli kiseera gy’ensobya, tewali kintu kyeyambisaamu, n’akawayamba kuziwamu.</string>
    <string name="welcome_bluetooth_without">nga tewali eno: minwa gy’ebluutusi tekulembeddeko. pulogiramu emirala mirungi, era oyinza okuwa layisensi mu maaso mu okuteekawo kw’android.</string>
    <string name="welcome_notifications_title">xooliante</string>
    <string name="welcome_notifications_why">okuteekawo okw’omulala ebusisa service enzibu, era android etegeka xooliante okukama. </string>
    <string name="welcome_notifications_with">ne eno: xooliante ejja kulabika ndax gu yaa, eyona ttegeeza okuteekawo okw’omulala gu mabanga.</string>
    <string name="welcome_notifications_without">nga tewali eno: okuteekawo okw’omulala ebusisa n’ekuba namu. android yalitegeka xooliante.</string>
    <string name="hibernation_title">koma okubala bw’oyigala</string>
    <string name="hibernation_body">android ekoma pulogiramu ezigigala omwezi omusanvu, n’eguwa layisensi zaayo, ylih etayinza kubala okutuuka bw’oyigala. okugigala ye mulimu gw’ylih, kale kale kaleyo ngabye mu bukodyo bwokukoma.</string>
