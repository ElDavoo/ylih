<!--
  Headphones with a clock dial between the earcups.

  The shape is built from six constants around one anchor P = (54, 58.35), the shared centre of
  the headband arc and the dial:

    headband  radius 21.5, stroke 5.5
    earcups   at 54 +- 21.5, length 8, stroke 9 (round cap)
    dial      radius 11, stroke 4
    hands     stroke 3.6

  Painted bounds come out at x 28..80 and y 34.1..71.4, so the drawing is 52dp wide inside the
  72dp a round mask leaves — filling it without crowding the edge. The farthest painted point
  from the centre is an earcup cap, sqrt(21.5^2 + 12.35^2) + 4.5 = 29.3, comfortably inside the
  33dp safe radius.

  P is NOT placed to centre the bounding box. This drawing is bottom-heavy — the band is a thin
  arc while the dial and cups are solid — so a box-centred version reads as sitting low. P is
  instead solved so the centroid of the painted pixels lands on (54, 54); measured, that puts
  the box centre at y 52.75 and the mass dead centre. Move any constant above and the anchor
  has to be re-solved, not nudged: render the artwork on black and read back
  `identify -verbose -moments`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Headband -->
    <path
        android:pathData="M32.5,58.35 A21.5,21.5 0 0 1 75.5,58.35"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- Earcups -->
    <path
        android:pathData="M32.5,58.35 L32.5,66.35"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M75.5,58.35 L75.5,66.35"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <!-- Dial -->
    <path
        android:pathData="M43,58.35 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4" />

    <!-- Hands: one straight up, one to the lower right, so the dial reads as a clock at a glance -->
    <path
        android:pathData="M54,50.85 L54,58.35 L59,61.85"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
