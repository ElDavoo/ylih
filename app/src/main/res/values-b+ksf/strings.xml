    <string name="welcome_bluetooth_title">bu bluetooth</string>
    <string name="welcome_bluetooth_why">android i-gbin app chi device ya-bluetooth a-zu, ni chi a-koli, mzambi app i-ba bu bluetooth. nda i-gbin ylih i-pwo bu-makinanzi ba-simu, ni chi i-jen moo ba-zek.</string>
    <string name="welcome_bluetooth_with">ku-ba: bu-makinanzi ba-yak i-kanam kilo bu-zu, ku-ndap chi i-ba kolo ni kap ku-bu.</string>
    <string name="welcome_bluetooth_without">ku-ba-nka: bu-makinanzi ba-bluetooth ndap chi i-kanam. mfamba chi app i-ba ka-gwo, ni u-dung i-bu ka-minfutu ya-app.</string>
    <string name="welcome_notifications_title">matonsi</string>
    <string name="welcome_notifications_why">ka-tracking ka-nkpoong i-ta huduma chi nkpoong, ni android i-gwob app chi chi-ba ka-ta i-ba notification i-nje mzambi i-ta.</string>
    <string name="welcome_notifications_with">ku-ba: notification i-gbin chi chi-kanam a-ba saa, nde a-bu chu cha-tracking chi-ta.</string>
    <string name="welcome_notifications_without">ku-ba-nka: ka-tracking ka-nkpoong i-ta ni i-kanam. android yak ndap i-gbin notification.</string>
    <string name="hibernation_title">kont kilo mzambi u-puga</string>
    <string name="hibernation_body">android i-to app chi u-ta ko miezi, ni ku-ku bu-chi, nde ylih ndap chi i-kanam kilo u-bu app ye. puga yi ndde app yi i-ba, kwa nda i-ba chu i-ka u-gwo a-ba ye.</string>
