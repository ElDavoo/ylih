    <string name="welcome_point_auto_body">bu-makinanzi ba-bluetooth bi-kanam sila, mzambi i-zu. ndap chi i-ba ka-kolo.</string>
    <string name="welcome_point_lifetime_title">moo na mzambi</string>
    <string name="welcome_point_lifetime_body">mzambi bu fa, i-puga je: nba-bu i-ba fa nde ba-makinanzi ba-semli i-gwo tsi.</string>
    <string name="welcome_point_detailed_title">waya ni ma-playing</string>
    <string name="welcome_point_detailed_body">ka-tracking ka-nkpoong, mfamba chi mipango, i-zu bu-waya ni gba chi ma-time a-ba ka-nje.</string>
