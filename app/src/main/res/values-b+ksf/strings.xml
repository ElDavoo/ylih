    <string name="welcome_title">welkom ylih</string>
    <string name="welcome_intro">ylih i-kanema kilo nde bu-makinanzi bi-pita moo, su kilo-kilo i-bu fa, u-du tsib na mbuang na nyame i-ba: otu njul a-ba?</string>
