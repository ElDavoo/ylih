    <string name="welcome_title">willkumen zua ylih</string>
    <string name="welcome_intro">ylih registriert, wie lang iidè paar chopfhörer vrbunde pliibt, äso dass du jorn speter nuch chönnisch antworte: wie vil stunda hend si ghödet?</string>
    <string name="welcome_point_auto_title">verbinde u vergäss</string>
    <string name="welcome_point_auto_body">bluetooth chopfhörer wernd automaatisch registriert, sobald si verbunde sind. nünt muss laaufe plibe.</string>
    <string name="welcome_point_lifetime_title">i paar, i ganz läbe</string>
    <string name="welcome_point_lifetime_body">wen i paar starbt, kannsch sii i rüschtig nee: d’total friert dort u d’nächst paar vum sälle chopfhörer fangt wieder bi nu oo.</string>
    <string name="welcome_point_detailed_title">dradtet u playback</string>
    <string name="welcome_point_detailed_body">d’detailliert verfolgig, i d’istellunga, addiärt dradtet chopfhörer u misst, wie lang tatsächli audio glauft hät.</string>
    <string name="welcome_privacy">alles bliibt uf dinem telefon. es git kiin konto u d’app hät kii internet erlaubniss.</string>
