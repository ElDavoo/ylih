    <string name="pair_rename_label">namn</string>
    <string name="pair_retire_title">pensionera detta par</string>
    <string name="pair_retire_label">anledning (gick sönder, sålt, tappat bort…)</string>
    <string name="pair_retire_confirm">pensionera</string>
    <string name="pair_retire_supporting">totalsumman fryses här. att återansluta samma enhet startar ett nytt par från noll.</string>
    <string name="pair_price_title">betalat pris</string>
    <string name="pair_price_label">belopp (hela enheter)</string>
    <string name="pair_price_supporting">används för kostnad per timme.</string>
    <string name="pair_delete_title">ta bort detta par?</string>
    <string name="pair_delete_body">varje registrerad session för det tas också bort. det går inte att ångra.</string>

    <!-- Sessionsrader -->
    <string name="session_ongoing">pågående</string>
    <string name="session_until">till %1$s</string>
    <string name="session_playing">%1$s uppspelning</string>
    <string name="session_recovered">återställd</string>

    <!-- Inställningar -->
    <string name="settings_tracking">spårning</string>
    <string name="settings_detailed_title">detaljerad spårning</string>
    <string name="settings_detailed_body">lägger till kabelanslutna hörlurar och uppspelningstid. android rapporterar kabelhändelser bara till en app som redan körs, så detta innebär en tyst avisering i aviseringsfältet. bluetooth spåras ändå.</string>
    <string name="settings_detailed_unavailable">otillgängligt tills bluetoothåtkomst har beviljats: den här versionen deklarerar bara tjänsttypen connectedDevice, som android 14+ kopplar till en bluetoothbehörighet.</string>
    <string name="settings_playback_only_title">räkna bara uppspelning</string>
    <string name="settings_playback_only_body">statistiken räknar tiden då ljudet faktiskt spelade i stället för tiden ansluten. bara sessioner som spelades in med detaljerad spårning påslagen har mätt uppspelning; resten lämnas utanför.</string>
    <string name="settings_language">språk</string>
    <string name="settings_language_system">systemspråk</string>
    <string name="settings_devices">enheter</string>
    <string name="settings_devices_body">avmarkera allt som inte är hörlurar — en bilstereo eller en högtalare — för att sluta registrera det.</string>
    <string name="settings_device_subtitle">%1$s · sågs först %2$s</string>
    <string name="settings_data">data</string>
    <string name="settings_export">exportera json</string>
    <string name="settings_import">importera</string>
    <string name="settings_import_warning">import ersätter allt som lagras just nu.</string>
    <string name="settings_troubleshooting">felsökning</string>
    <string name="settings_battery_body">om sessioner slutar registreras, kontrollera att ylih är undantagen från batterioptimering — en app som har tvångsstoppats får inga fler anslutningshändelser förrän den öppnas igen.</string>
    <string name="settings_battery_button">batteriinställningar</string>
    <string name="settings_battery_path">inställningar → appar → ylih → batteri → obegränsad.</string>
    <string name="settings_about">om</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — hörlurstimmar, sparade lokalt och för alltid.</string>
    <string name="settings_import_confirm_title">ersätta all data?</string>
    <string name="settings_import_confirm_body">att importera denna säkerhetskopia tar bort varje enhet, par och session som lagras just nu.</string>

    <!-- Delade åtgärder -->
    <string name="action_save">spara</string>
    <string name="action_cancel">avbryt</string>
    <string name="action_delete">ta bort</string>
    <string name="action_import">importera</string>

    <!-- Avisering -->
    <string name="channel_tracking">hörlursspårning</string>
    <string name="channel_tracking_description">visas medan ylih bevakar kabelanslutna hörlurar och uppspelning. android levererar inte kabelhändelser till appar som inte körs.</string>
    <string name="notification_title">spårar hörlurstid</string>
    <string name="notification_starting">startar…</string>
    <string name="notification_idle">väntar på hörlurar</string>
    <plurals name="notification_active">
        <item quantity="one">%1$d ansluten · %2$s</item>
        <item quantity="other">%1$d anslutna · %2$s</item>
    </plurals>
    <plurals name="notification_active_playing">
        <item quantity="one">%1$d ansluten · %2$s · uppspelning</item>
        <item quantity="other">%1$d anslutna · %2$s · uppspelning</item>
    </plurals>

    <!-- Snackbar-meddelanden -->
    <string name="detailed_needs_bluetooth">den här versionen behöver bluetoothåtkomst innan den kan spåra kabelanslutna hörlurar</string>
    <string name="export_done">säkerhetskopia exporterad</string>
    <string name="export_failed">export misslyckades</string>
    <string name="import_failed">import misslyckades</string>
    <string name="error_could_not_open">det gick inte att öppna %1$s</string>
    <plurals name="import_done">
        <item quantity="one">importerade %d session</item>
        <item quantity="other">importerade %d sessioner</item>
    </plurals>

    <plurals name="session_count">
        <item quantity="one">%d session</item>
        <item quantity="other">%d sessioner</item>
    </plurals>
</resources>
