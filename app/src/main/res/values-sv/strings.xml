<?xml version="1.0" encoding="utf-8"?>
<!--
  Swedish. Same house style as the default locale: lowercase throughout, on purpose.

  `app_name` is deliberately absent — the launcher label is a name, not a word, and does not
  translate. So is `value_none`, which is an em dash.
-->
<resources>
    <string name="app_title">ylih - ditt liv i hörlurar</string>

    <!-- Navigering -->
    <string name="nav_headphones">hörlurar</string>
    <string name="nav_stats">statistik</string>
    <string name="nav_settings">inställningar</string>

    <!-- Enhetstyper -->
    <string name="kind_bluetooth">bluetooth</string>
    <string name="kind_ble">le audio</string>
    <string name="kind_wired">kabel</string>
    <string name="kind_usb">usb</string>
    <string name="kind_unknown">okänd</string>

    <!-- Första starten -->
    <string name="welcome_title">välkommen till ylih</string>
    <string name="welcome_intro">ylih registrerar hur länge varje par hörlurar är anslutet, så att du om flera år fortfarande kan svara på den enda frågan som spelar roll för ett par hörlurar: hur många timmar höll de?</string>
    <string name="welcome_point_auto_title">anslut och glöm</string>
    <string name="welcome_point_auto_body">bluetooth-hörlurar registreras av sig själva, från det ögonblick de ansluts. inget behöver köras i bakgrunden.</string>
    <string name="welcome_point_lifetime_title">ett par, ett liv</string>
    <string name="welcome_point_lifetime_body">när ett par dör, pensionera det: dess totalsumma fryses där och nästa par av samma hörlurar börjar om från noll.</string>
    <string name="welcome_point_detailed_title">kabel och uppspelning</string>
    <string name="welcome_point_detailed_body">detaljerad spårning, i inställningar, lägger till kabelanslutna hörlurar och mäter hur stor del av tiden som faktiskt spelades upp.</string>
    <string name="welcome_privacy">allt stannar på den här telefonen. det finns inget konto, och appen har ingen internetbehörighet.</string>
    <string name="welcome_start">kom igång</string>

    <!-- Hörlurslista -->
    <string name="devices_in_use">i bruk</string>
    <string name="devices_retired">pensionerade</string>
    <string name="devices_empty_title">inga hörlurar än</string>
    <string name="devices_empty_body">anslut ett par bluetooth-hörlurar så dyker de upp här. kabelanslutna hörlurar kräver detaljerad spårning, i inställningar.</string>
    <string name="devices_generation">par nr %1$d</string>
    <string name="devices_retired_on">pensionerad %1$s</string>
    <string name="devices_connected_for">ansluten %1$s</string>
    <string name="devices_recent">%1$s / 7d</string>

    <!-- Statistik -->
    <string name="stats_title">alla hörlurar</string>
