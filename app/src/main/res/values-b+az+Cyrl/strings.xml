    <!-- Бастапқы іс-әрекет -->
    <string name="welcome_title">ylih-ә хош ҝәлдиниз</string>
    <string name="welcome_intro">ylih һәр бир гулаглыг ҹүтлүјүнүн гошулу галдығы мүддәти гејд едир ки, илләрдән сонра сиз ҹүтлүк һаггында јеҝанә мүһүм суала ҹаваб верә биләрсиниз: нечә саат хидмәт етдиләр?</string>
    <string name="welcome_point_auto_title">гошун вә унут</string>
    <string name="welcome_point_auto_body">bluetooth гулаглыглары автоматик гејд олунур, гошулма анындан башлајараг. һеч нәси ишләмәјә бәһс сахламаға еһтијаҹ јохдур.</string>
    <string name="welcome_point_lifetime_title">бир ҹүтлүк, бир өмүр</string>
    <string name="welcome_point_lifetime_body">ҹүтлүк гопмаса, ону арадан галдырын: онун ҹәми орада дондурулур вә ејни гулаглығын сонракы ҹүтлүјү сыфырдан башлајыр.</string>
    <string name="welcome_point_detailed_title">симлә вә ојнатма</string>
    <string name="welcome_point_detailed_body">тәнзимләмәләрдә әтрафлы изләмә симлә гулаглыглар әлавә едир вә вахтын нә гәдәринин һәгигәтән ојнатылдығыны өлчүр.</string>
    <string name="welcome_privacy">һәр шеј бу телефонда галыр. һеч бир һесаб јохдур вә тәтбигин интернет иҹазәси јохдур.</string>
    <string name="welcome_start">башлајын</string>
    <string name="welcome_next">нөвбәти</string>
    <string name="welcome_allow">иҹазә вер</string>
    <string name="welcome_step">аддым %1$d / %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth ҝириши</string>
    <string name="welcome_bluetooth_why">андроид тәтбигә һансы bluetooth ҹиһазынын гошулдуғуну вә адынын нә олдуғуну јалныз тәтбигин bluetooth ҝириши варса билдирир. ylih гулаглығы автомобил магнитофонундан, бир ҹүтү диҝәриндән белә ајырыр.</string>
    <string name="welcome_bluetooth_with">ҝириш варса: һәр ҹүт гошулдуғу андан гејд олунур, һеч нәји ишләк сахламаға вә нәјисә басмағы јадда сахламаға еһтијаҹ јохдур.</string>
    <string name="welcome_bluetooth_without">ҝириш јохдурса: һеч бир bluetooth гулаглығы гејд олунмур. тәтбигин галан һиссәси ишләјир вә иҹазәни сонра андроид-ин тәтбиг ајарларындан верә биләрсиниз.</string>
    <string name="welcome_notifications_title">билдиришләр</string>
    <string name="welcome_notifications_why">әтрафлы изләмә кичик бир арха фон хидмәти ишләдир вә андроид буну едән һәр тәтбигдән билдириши ҝөрүнән сахламағы тәләб едир.</string>
    <string name="welcome_notifications_with">иҹазә варса: билдириш инди нәјин гејд олундуғуну ҝөстәрир, әтрафлы изләмәнин ишләдијинин јеҝанә әламәти будур.</string>
    <string name="welcome_notifications_without">иҹазә јохдурса: әтрафлы изләмә јенә ишләјир вә јенә гејд едир. садәҹә андроид онун билдиришини ҝөстәрмәјәҹәк.</string>
    <string name="hibernation_title">унутсан да сајмаға давам ет</string>
    <string name="hibernation_body">андроид бир нечә ај ачылмајан тәтбигләри дајандырыр вә иҹазәләрини ҝери алыр ки, бу да ylih-и сән ону јенидән ачана гәдәр һеч нә гејд етмәјән вәзијјәтә салар. унудулмаг бу тәтбигин вар олмаг сәбәбидир, она ҝөрә дә инди буну деактив етмәјә дәјәр.</string>
