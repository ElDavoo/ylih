    <!-- Бастапқы іс-әрекет -->
    <string name="welcome_title">ylih-ә хош келдіңіз</string>
    <string name="welcome_intro">ylih әр дәстә наўсыбырлыныњ қанше уақыт қосылғалы тұрғанын есептейді, сондықтан келесі жылдардан сіз бір дәстә тура осындай ғана маңызды сұраққа жауап бере аласыз: олар қанше сағат іскерлік істеген?</string>
    <string name="welcome_point_auto_title">қосы қойға мен ұмыт</string>
    <string name="welcome_point_auto_body">bluetooth наўсыбырлысы өз-өзінен есептеледі, қосылыс сәттінің өзінен. ешнәрсе жүргіксіз істеу қажет емес.</string>
    <string name="welcome_point_lifetime_title">бір дәстә, бір өмір</string>
    <string name="welcome_point_lifetime_body">дәстә ісслі болса, оны зақрытия: оның жиынты бұл жерде тоқталады және сол наўсыбырлыныњ келесі дәстәсі нөлден сәтіліке барлай бастайды.</string>
    <string name="welcome_point_detailed_title">сызыңлы және ойнау</string>
    <string name="welcome_point_detailed_body">толық іс-әрекет, әйланмәләрде, сызыңлы наўсыбырлысын қосады және оның қанше уақыты хақылап ойналғанын өлшейді.</string>
    <string name="welcome_privacy">барлығы осы телефонда қалды. ешқандай есептік емес, және қосынша интернет рұқсаты жоқ.</string>
    <string name="welcome_start">бастау</string>

