    <string name="settings_detailed_title">әтрафлы изләмә</string>
    <string name="settings_detailed_body">симлә гулаглыглар вә ојнатма вахтыны әлавә едир. андроид симлә гошулма һадисәләрини јалныз ишләјән бир тәтбигә билдирәр, буна ҝөрә дә билдиришләр шкалатосу сакит галыр. bluetooth һәр һалда изләнир.</string>
    <string name="settings_detailed_unavailable">bluetooth иҹазәси вериләнә гәдәр мөвҹуд дејил: бу гурғу јалныз ҹоннеҹтедДевиҹе хидмәт типини елан едир, андроид 14+ буну bluetooth иҹазәсинә бағлајыр.</string>
    <string name="settings_playback_only_title">јалныз охутманы сај</string>
