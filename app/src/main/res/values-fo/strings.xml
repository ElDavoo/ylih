    <!-- Stillingar -->
    <string name="settings_tracking">fylgja</string>
    <string name="settings_detailed_title">útbroytað fylgja</string>
    <string name="settings_detailed_body">leggur til táðað heyrnirtól og spælutíð. android fræðir um táðað tengibreytingar bara til app, sum er keypandi, so hetta helst þógil skyggja. bluetooth er fylgt í øllum høpum.</string>
    <string name="settings_detailed_unavailable">ótiliglig til bluetooth lov er givið: henda bygning segir bara connectedDevice tænastunáð, sum android 14+ bundnast til bluetooth lov.</string>
    <string name="settings_playback_only_title">tel bert spæling</string>
    <string name="settings_playback_only_body">hagtøl telja tíðina, tá ið ljóðið veruliga spældi, í staðin fyri tíðina sambundin. bert setur, sum vórðu skrásett við útbroytt fylgja tendrað, mátaðu spælingina; hini verða latin úti.</string>
    <string name="settings_language">mál</string>
    <string name="settings_language_system">mál kervisins</string>
    <string name="settings_devices">tækjir</string>
    <string name="settings_devices_body">avhaka hvat, ið ikki er heyrnirtól — bilvágd ella talari — til at standa av at skráseta hani.</string>
    <string name="settings_device_subtitle">%1$s · fyrst sæt %2$s</string>
    <string name="settings_data">dátir</string>
    <string name="settings_export">útflyt json</string>
    <string name="settings_import">innflyt</string>
    <string name="settings_import_warning">innflyt ynskar alt, sum nú er goymt.</string>
    <string name="settings_troubleshooting">útrøðing vandamála</string>
    <string name="settings_battery_body">um setir standa av at verða skrásattar, kanna, at ylih er útilokin frá batteríbótandi — ein app, sum er tvang-stopp, fær aldri tengibreytingar aftur, til hani er opnað.</string>
    <string name="settings_battery_button">batterísillingar</string>
    <string name="settings_battery_path">stillingar → apps → ylih → batteri → óbundið.</string>
    <string name="settings_hibernation_body">verður ylih ikki opnaður í nakrar mánaðir, steðgar android honum og tekur loyvini aftur, og einki verður upptikið aftur, fyrr enn tú opnar hann. at sláa tað frá er tað, sum letur eitt sett halda fram at telja gjøgnum eina tíð, tá tú ongantíð hugsar um appin.</string>
    <string name="settings_hibernation_on">android kann steðga ylih.</string>
    <string name="settings_hibernation_off">ylih er undantikin og heldur fram at taka upp.</string>
    <string name="settings_hibernation_button">stillingar fyri óbrúkt app</string>
    <string name="settings_about">um</string>
    <string name="settings_about_body">ylih %1$s (%2$s) — heyrnirtóla tímar, haldir lokal og til eilivíl.</string>
    <string name="settings_import_confirm_title">ynskra allar dátir?</string>
    <string name="settings_import_confirm_body">innflyt av hesi búðarskrá strikar hvørt tækji, pair og setu, sum nú er goymt.</string>
    <string name="widget_lifetime_label">ylih · lívskaar</string>
    <string name="widget_lifetime_description">tímar á hvørt par, við livandi tíðartakara á tí sum er tengt</string>
