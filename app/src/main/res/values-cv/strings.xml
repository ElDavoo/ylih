    <string name="welcome_title">ylih-a karivasya</string>
    <string name="welcome_intro">ylih nalme-na shyvarintsene ka pahnava, ma suri yilti virente tantal i yilme putara vit: sara shava nalme-ne tutri?</string>
    <string name="welcome_point_auto_title">khavari heri tapkala</string>
    <string name="welcome_point_auto_body">bluetooth nalme-ne tuna tapkalannu khavari yere, tapkalannu kalte tal. pu yok viyya tavan pahnane peles.</string>
    <string name="welcome_point_lifetime_title">pir nalme - pir vitta</string>
    <string name="welcome_point_lifetime_body">nalme khavari shayna putarre, pahnava: tapkalannu vit tutri tal, tal antan nalme-na khavari yanatma yilte kayter nulla tal.</string>
    <string name="welcome_point_detailed_title">sarniy i yashcha</string>
    <string name="welcome_point_detailed_body">tanniya tapkala, paramtry-a tal, sarniy nalme-ne huri, ma yashcha virenta ka pahnava.</string>
    <string name="welcome_privacy">pu yok ava yurnite kana. akkaunt peles, ylih-a internet privetnaya peles.</string>
    <string name="welcome_start">puste katsiteme</string>
    <string name="welcome_next">puskal</string>
    <string name="welcome_allow">puste</string>
    <string name="welcome_step">sharsh %1$d %2$d tal</string>
    <string name="welcome_bluetooth_title">bluetooth privetnaya</string>
    <string name="welcome_bluetooth_why">android app-a khavari bluetooth ayta tapkalanna harsam, ma yashcha yere, takka app-a bluetooth privetnaya yakart. ava ylih-a nalme-ne stereo-ra tapkaltara, ma pir nalme pi-ta tapkalara.</string>
    <string name="welcome_bluetooth_with">ava: nalme-na pir tapkaltarra harsam, peles raste pavan i peles tavan tuptartse.</string>
    <string name="welcome_bluetooth_without">ava peles: bluetooth nalme-ne piles tunne peles. ylih tal raste yere, i tul android-a paramtry-a tal tutte putarre.</string>
    <string name="welcome_notifications_title">privetleve</string>
    <string name="welcome_notifications_why">tanniya tapkala fon sere servis yashcha, ma android app-a privetleve karsi tutterne mal.</string>
    <string name="welcome_notifications_with">ava: privetleve ylih-a tu yere kayter, ma ava tanniya tapkala-na yasalt.</string>
    <string name="welcome_notifications_without">ava peles: tanniya tapkala raste tunne i pavan. android privetleve karsi peles.</string>
    <string name="hibernation_title">tapkale tavan hupshe kal tupe</string>
    <string name="hibernation_body">android app-ne vitta tun sharsh aytalsa pavan, ma privatnya kayterra, ylih peles tunne putarre. ava app-a yasalt-na parva, tal tukkale piste viyat.</string>
