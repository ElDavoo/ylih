    <string name="welcome_title">ylih-а килнӗ ятпа</string>
    <string name="welcome_intro">ylih кашни наушник мӑшӑрӗ мӗн чухлӗ вӑхӑт ҫыхӑнса тӑнине ҫырса пырать, ҫавӑнпа ҫулсем иртсен те эсӗ пӗр ыйтӑва хуравлама пултаратӑн — вӗсем миҫе сехет ӗҫленӗ?</string>
    <string name="welcome_point_auto_title">ҫыхӑнтар та ман</string>
    <string name="welcome_point_auto_body">bluetooth наушниксене ҫыхӑннӑ самантранах хӑйсем тӗллӗн ҫырса пыраҫҫӗ. нимӗн те ӗҫлесе тӑмалла мар.</string>
    <string name="welcome_point_lifetime_title">пӗр мӑшӑр — пӗр пурнӑҫ</string>
    <string name="welcome_point_lifetime_body">мӑшӑр ҫӗмӗрӗлсен ӑна усӑран кӑлар: унӑн шучӗ ҫавӑнта чарӑнать, ҫав наушниксен тепӗр мӑшӑрӗ нульрен пуҫлать.</string>
    <string name="welcome_point_detailed_title">пралуклисем тата сасӑ</string>
    <string name="welcome_point_detailed_body">настройкӑсенчи тӗплӗ сӑнав пралуклӑ наушниксене хушать тата сасӑ чӑннипе мӗн чухлӗ янӑранине виҫет.</string>
    <string name="welcome_privacy">пурте ҫак телефонрах юлать. аккаунт ҫук, приложенин интернет ирӗкӗ те ҫук.</string>
    <string name="welcome_start">пуҫлатпӑр</string>
    <string name="welcome_next">малалла</string>
    <string name="welcome_allow">ирӗк пар</string>
    <string name="welcome_step">утӑм %1$d / %2$d</string>
    <string name="welcome_bluetooth_title">bluetooth ирӗкӗ</string>
    <string name="welcome_bluetooth_why">android приложение хӑш bluetooth хатӗр ҫыхӑннине тата унӑн ятне bluetooth ирӗкӗ пур чухне ҫеҫ пӗлтерет. ҫавӑнпа ylih наушниксене машина динамикӗнчен уйӑрать тата пӗр мӑшӑра тепринчен палӑртать.</string>
    <string name="welcome_bluetooth_with">унпа: кашни мӑшӑра ҫыхӑннӑ самантранах ҫырса пыраҫҫӗ, нимӗн те ӗҫлесе тӑмасть тата нимӗн те астумалла мар.</string>
    <string name="welcome_bluetooth_without">унсӑр: пӗр bluetooth наушник та ҫырӑнмасть. приложенин ытти пайӗсем ӗҫлеҫҫӗ, кайран android настройкисенче ирӗк пама пулать.</string>
    <string name="welcome_notifications_title">пӗлтерӳсем</string>
    <string name="welcome_notifications_why">тӗплӗ сӑнав пӗчӗк фон служби ӗҫлеттерет, android вара ҫапла тӑвакан приложенирен пӗлтерӳ курӑнса тӑнине ыйтать.</string>
    <string name="welcome_notifications_with">унпа: пӗлтерӳ хальхи вӑхӑтра мӗн ҫырӑннине кӑтартать, тӗплӗ сӑнав чӗрӗ пулнине ҫакӑ ҫеҫ систерет.</string>
    <string name="welcome_notifications_without">унсӑр: тӗплӗ сӑнав ҫаплах ӗҫлет тата ҫырса пырать. android унӑн пӗлтерӗвне ҫеҫ кӑтартмасть.</string>
    <string name="hibernation_title">эсӗ маннӑ чухне те шутлатӑр</string>
    <string name="hibernation_body">темиҫе уйӑх уҫман приложенисене android чарса лартать тата вӗсен ирӗкӗсене каялла илет, ҫавӑн чухне ylih эсӗ ӑна уҫичченех нимӗн те ҫырмӗ. манӑҫа тухни — шӑпах ҫак приложени валли, ҫавӑнпа ӑна халех чарса лартни аван.</string>
    <string name="action_not_now">халь мар</string>

